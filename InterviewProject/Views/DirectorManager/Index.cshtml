@model IEnumerable<InterviewProject.Models.Employee>

@{
    ViewData["Title"] = "主管權限管理";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/AdminAnnouncement.css" asp-append-version="true" />
}

<div class="page-header">
    <div class="page-header-inner">
        <h1>部門主管權限管理</h1>
        <p>Manager Permissions Management</p>
    </div>
</div>

<div class="announce-manage-wrap">

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="pw-error" style="margin-bottom:16px;">@TempData["Error"]</div>
    }

    <div class="announce-toolbar">
        <a asp-controller="DirectorManager" asp-action="Create" class="btn-add">
            ＋ 新增主管
        </a>
    </div>

    <div class="announce-table">
        <div class="announce-table-head"
             style="grid-template-columns: 1fr 1fr 140px 120px;">
            <div>姓名</div>
            <div>帳號</div>
            <div>部門</div>
            <div>操作</div>
        </div>

        @if (Model != null && Model.Any())
        {
            @* 依部門分組顯示 *@
            foreach (var dept in Model.GroupBy(m => m.Department).OrderBy(g => g.Key))
            {
                <div style="padding: 8px 24px; background:#f4f7f9;
                            font-size:12px; font-weight:700;
                            color:var(--primary); letter-spacing:0.5px;">
                    @dept.Key（@dept.Count() 人）
                </div>

                foreach (var manager in dept)
                {
                    <div class="announce-row"
                         style="grid-template-columns: 1fr 1fr 140px 120px;">
                        <div style="font-weight:600;">@manager.Name</div>
                        <div style="color:#888;">@manager.Account</div>
                        <div>
                            <span class="badge-category badge-公告">@manager.Department</span>
                        </div>
                        <div class="announce-actions">
                            <a asp-controller="DirectorManager"
                               asp-action="Edit"
                               asp-route-id="@manager.Id"
                               class="btn-edit">編輯</a>
                            <form asp-controller="DirectorManager"
                                  asp-action="Delete"
                                  asp-route-id="@manager.Id"
                                  method="post"
                                  onsubmit="return confirm('確定刪除此主管？')">
                                <button type="submit" class="btn-delete">刪除</button>
                            </form>
                        </div>
                    </div>
                }
            }
        }
        else
        {
            <div class="announce-empty">目前沒有任何主管資料</div>
        }
    </div>
</div>