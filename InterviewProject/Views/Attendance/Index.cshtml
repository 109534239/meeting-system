<h2>出席紀錄</h2>

<table border="1" cellpadding="10">

    <tr>
        <th>使用者</th>
        <th>房間</th>
        <th>加入時間</th>
        <th>離開時間</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.UserName</td>
            <td>@item.RoomId</td>
            <td>@item.JoinTime</td>
            <td>@item.LeaveTime</td>
        </tr>
    }

</table>