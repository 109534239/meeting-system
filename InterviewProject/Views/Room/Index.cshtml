@model IEnumerable<InterviewProject.Models.Room>

<style>
    .action-links {
        margin-bottom: 20px;
    }

    .btn-custom {
        display: inline-block;
        padding: 8px 16px;
        margin-right: 10px;
        background-color: #2ecc71;
        color: white;
        text-decoration: none;
        border-radius: 4px;
        font-family: sans-serif;
    }

        .btn-custom.blue {
            background-color: #3498db;
        }

        .btn-custom:hover {
            opacity: 0.9;
            color: white;
        }
</style>

<h2>房間列表</h2>

<div class="action-links">
    <a href="/Room/Create" class="btn-custom">建立房間</a>
    <a href="/Room/EnterCode" class="btn-custom blue">使用房間碼進房</a>
</div>

<ul>
    @foreach (var item in Model)
    {
        <li style="margin-bottom: 10px;">
            <strong>@item.RoomName</strong>
            <span style="color: #7f8c8d; font-size: 13px;">(代碼: @item.JitsiRoomName)</span>
            &nbsp;&nbsp;
            <a href="/Room/Join?code=@item.JitsiRoomName" style="color: #3498db;">
                進入房間
            </a>
        </li>
    }
</ul>