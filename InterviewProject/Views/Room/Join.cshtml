@{
    Layout = null; // 全螢幕，不用導覽列
    var room = ViewBag.Room as InterviewProject.Models.Room;
    var memberName = Context.Session.GetString("MemberName") ?? "訪客";
    var memberRole = Context.Session.GetString("MemberRole")?.ToLower() ?? "";
    var isStaff = memberRole == "hr" || memberRole == "manager" || memberRole == "director";
    var displayName = isStaff ? $"面試官：{memberName}" : $"求職者：{memberName}";
    var jitsiRoom = $"MeetingRoom-{room.JitsiRoomName}";
    var encodedName = Uri.EscapeDataString(displayName);
}
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>面試會議 - @room.RoomName</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0
        }

        html, body {
            height: 100%;
            background: #0d1117;
            font-family: 'Segoe UI',sans-serif;
            overflow: hidden;
            color: #e6edf3
        }

        /* ── 頂部工具列 ── */
        .topbar {
            height: 52px;
            background: #161b22;
            border-bottom: 1px solid #30363d;
            display: flex;
            align-items: center;
            padding: 0 16px;
            gap: 12px;
            flex-shrink: 0;
            z-index: 100;
            position: relative
        }

        .room-name {
            font-weight: 700;
            font-size: 14px;
            color: #e6edf3
        }

        .room-code {
            font-family: monospace;
            font-size: 11px;
            background: #21262d;
            color: #79c0ff;
            padding: 2px 8px;
            border-radius: 12px;
            letter-spacing: .5px
        }

        .topbar-center {
            flex: 1;
            display: flex;
            justify-content: center;
            gap: 8px;
            flex-wrap: wrap
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0
        }

        /* 控制按鈕 */
        .ctrl-btn {
            padding: 5px 12px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 600;
            border: 1px solid transparent;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            transition: all .15s;
            white-space: nowrap
        }

            .ctrl-btn.rec-off {
                background: #21262d;
                border-color: #30363d;
                color: #8b949e
            }

            .ctrl-btn.rec-on {
                background: #3d1a1a;
                border-color: #f85149;
                color: #f85149;
                animation: rec-pulse 1.5s ease-in-out infinite
            }

            .ctrl-btn.copy {
                background: #21262d;
                border-color: #30363d;
                color: #8b949e
            }

                .ctrl-btn.copy.done {
                    background: #1a3d1a;
                    border-color: #3fb950;
                    color: #3fb950
                }

            .ctrl-btn.dl {
                background: #1a2d3d;
                border-color: #388bfd;
                color: #79c0ff
            }

            .ctrl-btn.analyze {
                background: #2d1a3d;
                border-color: #a371f7;
                color: #d2a8ff
            }

                .ctrl-btn.analyze.loading {
                    opacity: .6;
                    cursor: not-allowed
                }

        .user-badge {
            font-size: 12px;
            padding: 4px 10px;
            border-radius: 12px;
            background: #21262d;
            color: #8b949e
        }

        @@keyframes rec-pulse {
            0%, 100% {
                opacity: 1
            }

            50% {
                opacity: .6
            }
        }

        /* ── 主要區域 ── */
        .main-layout {
            display: flex;
            height: calc(100vh - 52px)
        }

        /* iframe 會議區 */
        #meet-iframe {
            flex: 1;
            border: none;
            min-width: 0
        }

        /* ── AI 面試官側欄 ── */
        .ai-panel {
            width: 260px;
            flex-shrink: 0;
            background: #161b22;
            border-left: 1px solid #30363d;
            display: flex;
            flex-direction: column;
            overflow: hidden
        }

        .ai-header {
            padding: 14px 14px 10px;
            border-bottom: 1px solid #30363d;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px
        }

        .ai-avatar-wrap {
            position: relative;
            width: 80px;
            height: 80px
        }

        .speaking-ring {
            position: absolute;
            inset: -5px;
            border-radius: 50%;
            border: 2.5px solid #3fb950;
            opacity: 0;
            transition: opacity .3s
        }

            .speaking-ring.on {
                opacity: 1;
                animation: ring-pulse 1s ease-in-out infinite
            }

        @@keyframes ring-pulse {
            0%, 100% {
                transform: scale(1);
                opacity: .9
            }

            50% {
                transform: scale(1.07);
                opacity: .5
            }
        }

        .ai-svg {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            border: 2px solid #30363d
        }

        .ai-name {
            font-size: 14px;
            font-weight: 700;
            color: #e6edf3
        }

        .ai-role {
            font-size: 11px;
            color: #8b949e
        }

        .ai-status-badge {
            font-size: 11px;
            padding: 3px 10px;
            border-radius: 12px;
            font-weight: 600
        }

            .ai-status-badge.listening {
                background: #1a3d1a;
                color: #3fb950
            }

            .ai-status-badge.speaking {
                background: #1a2d3d;
                color: #79c0ff
            }

            .ai-status-badge.thinking {
                background: #3d2d00;
                color: #d29922
            }

        .ai-body {
            flex: 1;
            display: flex;
            flex-direction: column;
            padding: 12px;
            gap: 10px;
            overflow-y: auto
        }

        .ai-msg {
            background: #21262d;
            border-radius: 10px;
            padding: 12px;
            font-size: 12px;
            line-height: 1.6;
            color: #c9d1d9;
            min-height: 60px
        }

        .typing-dot {
            display: inline-block;
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: #79c0ff;
            margin: 0 2px;
            animation: tdot 1.2s ease-in-out infinite
        }

            .typing-dot:nth-child(2) {
                animation-delay: .2s
            }

            .typing-dot:nth-child(3) {
                animation-delay: .4s
            }

        @@keyframes tdot {
            0%, 80%, 100% {
                transform: translateY(0)
            }

            40% {
                transform: translateY(-5px)
            }
        }

        .silence-section {
            background: #0d1117;
            border-radius: 8px;
            padding: 10px
        }

        .silence-label {
            font-size: 10px;
            color: #484f58;
            margin-bottom: 5px
        }

        .silence-bar {
            height: 3px;
            background: #21262d;
            border-radius: 2px;
            overflow: hidden
        }

        .silence-fill {
            height: 100%;
            width: 0%;
            background: #388bfd;
            transition: width 1s linear;
            border-radius: 2px
        }

            .silence-fill.warn {
                background: #d29922
            }

            .silence-fill.hot {
                background: #f85149
            }

        /* ── 逐字稿區域 ── */
        .transcript-panel {
            height: 180px;
            flex-shrink: 0;
            background: #0d1117;
            border-top: 1px solid #30363d;
            display: flex;
            flex-direction: column
        }

        .transcript-header {
            padding: 6px 14px;
            font-size: 11px;
            font-weight: 700;
            color: #8b949e;
            border-bottom: 1px solid #21262d;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-shrink: 0
        }

        .transcript-body {
            flex: 1;
            overflow-y: auto;
            padding: 8px 14px;
            font-size: 12px;
            line-height: 1.6
        }

        .transcript-line {
            margin-bottom: 4px
        }

            .transcript-line .speaker {
                font-weight: 700;
                color: #79c0ff;
                margin-right: 6px
            }

                .transcript-line .speaker.ai {
                    color: #a371f7
                }

            .transcript-line .speech {
                color: #c9d1d9
            }

        /* 分析 Modal */
        .modal-bg {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.7);
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px
        }

        .modal-box {
            background: #161b22;
            border: 1px solid #30363d;
            border-radius: 14px;
            padding: 28px;
            max-width: 640px;
            width: 100%;
            max-height: 80vh;
            overflow-y: auto
        }

            .modal-box h3 {
                font-size: 18px;
                font-weight: 700;
                margin-bottom: 16px;
                color: #e6edf3
            }

        .analysis-section {
            margin-bottom: 20px;
            background: #21262d;
            border-radius: 10px;
            padding: 16px
        }

            .analysis-section h4 {
                font-size: 14px;
                font-weight: 700;
                color: #79c0ff;
                margin-bottom: 10px
            }

            .analysis-section p {
                font-size: 13px;
                color: #c9d1d9;
                line-height: 1.7
            }

        .modal-actions {
            display: flex;
            gap: 10px;
            margin-top: 20px;
            flex-wrap: wrap
        }

        .modal-close {
            padding: 8px 18px;
            background: #21262d;
            border: 1px solid #30363d;
            border-radius: 8px;
            color: #8b949e;
            cursor: pointer;
            font-size: 13px
        }
    </style>
</head>
<body>

    <!-- ── 頂部工具列 ── -->
    <div class="topbar">
        <div class="room-name">🎥 @Html.Raw(room.RoomName)</div>
        <span class="room-code">@room.JitsiRoomName</span>

        <div class="topbar-center">
            <!-- 錄影按鈕 -->
            <button class="ctrl-btn rec-off" id="recBtn" onclick="toggleRecording()">
                <span id="recIcon">⏺</span> <span id="recLabel">開始錄影</span>
            </button>

            <!-- 下載錄影 -->
            <button class="ctrl-btn dl" id="dlVideoBtn" onclick="downloadVideo()" style="display:none">
                ⬇ 下載錄影
            </button>

            <!-- 下載逐字稿 -->
            <button class="ctrl-btn dl" onclick="downloadTranscript()">
                📄 下載逐字稿
            </button>

            <!-- 分析所有求職者 -->
            <button class="ctrl-btn analyze" id="analyzeBtn" onclick="analyzeAll()">
                🔍 AI 分析面試
            </button>
        </div>

        <div class="topbar-right">
            <span class="user-badge">👤 @Html.Raw(displayName)</span>
            <button class="ctrl-btn copy" id="copyBtn" onclick="copyCode()">複製代碼</button>
        </div>
    </div>

    <!-- ── 主區域 ── -->
    <div class="main-layout">

        <!-- 會議 iframe：直接開完整 Jitsi 頁面，無 5 分鐘限制 -->
        <iframe id="meet-iframe"
                allow="camera;microphone;display-capture;autoplay;clipboard-write"
                allowfullscreen
                src="https://meet.jit.si/@jitsiRoom#userInfo.displayName=%22@encodedName%22&config.prejoinPageEnabled=false&config.lobby.enableLobby=false&config.startWithAudioMuted=false&config.startWithVideoMuted=false&interfaceConfig.SHOW_JITSI_WATERMARK=false&interfaceConfig.MOBILE_APP_PROMO=false&interfaceConfig.TOOLBAR_ALWAYS_VISIBLE=true">
        </iframe>

        <!-- AI 面試官側欄 -->
        <div class="ai-panel">
            <div class="ai-header">
                <div class="ai-avatar-wrap">
                    <div class="speaking-ring" id="speakRing"></div>
                    <svg class="ai-svg" viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg">
                        <rect width="80" height="80" rx="40" fill="#21262d" />
                        <circle cx="40" cy="30" r="16" fill="#388bfd" />
                        <ellipse cx="40" cy="74" rx="26" ry="18" fill="#388bfd" />
                        <rect x="34" y="46" width="12" height="16" rx="3" fill="#1f6feb" />
                        <polygon points="40,48 37,55 40,53 43,55" fill="#1158c7" />
                    </svg>
                </div>
                <div class="ai-name">王大明</div>
                <div class="ai-role">部門主管 · AI 面試官</div>
                <div class="ai-status-badge listening" id="aiStatusBadge">👂 聆聽中</div>
            </div>

            <div class="ai-body">
                <div class="ai-msg" id="aiMsg">
                    歡迎參加今天的面試！<br><br>
                    請先做個自我介紹，告訴我您的背景與應徵動機。
                </div>
                <div class="silence-section">
                    <div class="silence-label" id="silenceLabel">冷場偵測</div>
                    <div class="silence-bar">
                        <div class="silence-fill" id="silenceFill"></div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- ── 逐字稿列 ── -->
    <div class="transcript-panel">
        <div class="transcript-header">
            <span>📝 即時逐字稿（含說話者識別）</span>
            <span id="transcriptStatus" style="color:#3fb950;font-size:10px">● 錄製中</span>
        </div>
        <div class="transcript-body" id="transcriptBody">
            <!-- 由 JS 動態填入 -->
        </div>
    </div>

    <!-- 分析結果 Modal -->
    <div class="modal-bg" id="analyzeModal" style="display:none">
        <div class="modal-box">
            <h3>🔍 面試分析報告</h3>
            <div id="analyzeContent">
                <div style="text-align:center;padding:40px;color:#8b949e">
                    <div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div>
                    <div style="margin-top:12px">Claude AI 正在分析面試內容...</div>
                </div>
            </div>
            <div class="modal-actions">
                <button class="modal-close" onclick="closeAnalyzeModal()">關閉</button>
                <button class="ctrl-btn dl" id="dlReportBtn" onclick="downloadReport()" style="display:none">
                    ⬇ 下載分析報告
                </button>
            </div>
        </div>
    </div>

    <script>
        // ════════════════════════════════════════════
        //  狀態
        // ════════════════════════════════════════════
        const DISPLAY_NAME = "@Html.Raw(displayName.Replace("\"", "\\\""))";
        const IS_STAFF     = @(isStaff ? "true" : "false");
        const SILENCE_SEC  = 20;

        let isRecording  = false;
        let mediaRecorder = null;
        let recordChunks  = [];
        let recordBlob    = null;
        let silenceTimer  = 0;
        let isSpeaking    = false;
        let questionIdx   = 0;
        let transcriptLines = [];
        let analysisText  = "";

        // ════════════════════════════════════════════
        //  逐字稿
        // ════════════════════════════════════════════
        let recognition = null;

        function initSpeechRecognition() {
            const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SR) { console.warn("瀏覽器不支援 SpeechRecognition"); return; }

            recognition = new SR();
            recognition.lang = 'zh-TW';
            recognition.continuous = true;
            recognition.interimResults = true;

            let interimTimeout = null;

            recognition.onresult = (e) => {
                let interim = '';
                for (let i = e.resultIndex; i < e.results.length; i++) {
                    const res = e.results[i];
                    if (res.isFinal) {
                        const text = res[0].transcript.trim();
                        if (text.length > 1) {
                            addTranscriptLine(DISPLAY_NAME, text);
                            // 有聲音，重置冷場計時
                            silenceTimer = 0;
                            updateSilenceBar(0);
                        }
                    } else {
                        interim += res[0].transcript;
                    }
                }
                if (interim.length > 0) {
                    silenceTimer = 0;
                    updateSilenceBar(0);
                }
            };

            recognition.onerror = (e) => {
                if (e.error !== 'no-speech') console.error('STT error:', e.error);
            };

            recognition.onend = () => {
                // 自動重啟（確保持續錄製）
                if (!isSpeaking) {
                    setTimeout(() => { try { recognition.start(); } catch {} }, 300);
                }
            };

            try { recognition.start(); } catch {}
        }

        function addTranscriptLine(speaker, text, isAi = false) {
            const line = { speaker, text, time: new Date().toLocaleTimeString('zh-TW', {hour:'2-digit',minute:'2-digit',second:'2-digit'}) };
            transcriptLines.push(line);

            const div = document.createElement('div');
            div.className = 'transcript-line';
            div.innerHTML = `<span class="speaker ${isAi ? 'ai' : ''}">[${line.time}] ${speaker}：</span><span class="speech">${text}</span>`;
            const body = document.getElementById('transcriptBody');
            body.appendChild(div);
            body.scrollTop = body.scrollHeight;
        }

        // ════════════════════════════════════════════
        //  錄影（錄製整個頁面音訊）
        // ════════════════════════════════════════════
        async function toggleRecording() {
            if (!isRecording) {
                try {
                    // 錄製頁面音訊（透過麥克風）
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
                    mediaRecorder = new MediaRecorder(stream, { mimeType: 'audio/webm;codecs=opus' });
                    recordChunks = [];

                    mediaRecorder.ondataavailable = (e) => {
                        if (e.data.size > 0) recordChunks.push(e.data);
                    };

                    mediaRecorder.onstop = () => {
                        recordBlob = new Blob(recordChunks, { type: 'audio/webm' });
                        document.getElementById('dlVideoBtn').style.display = '';
                    };

                    mediaRecorder.start(1000);
                    isRecording = true;

                    const btn = document.getElementById('recBtn');
                    btn.className = 'ctrl-btn rec-on';
                    document.getElementById('recIcon').textContent = '⏹';
                    document.getElementById('recLabel').textContent = '停止錄音';
                } catch (err) {
                    alert('無法取得麥克風權限：' + err.message);
                }
            } else {
                mediaRecorder?.stop();
                isRecording = false;

                const btn = document.getElementById('recBtn');
                btn.className = 'ctrl-btn rec-off';
                document.getElementById('recIcon').textContent = '⏺';
                document.getElementById('recLabel').textContent = '開始錄影';
            }
        }

        function downloadVideo() {
            if (!recordBlob) return;
            const url = URL.createObjectURL(recordBlob);
            const a = document.createElement('a'); a.href = url;
            a.download = `面試錄音_${new Date().toISOString().slice(0,16).replace('T','-')}.webm`;
            a.click();
        }

        // ════════════════════════════════════════════
        //  下載逐字稿
        // ════════════════════════════════════════════
        function downloadTranscript() {
            if (transcriptLines.length === 0) {
                alert('目前尚無逐字稿內容。請確認麥克風已開啟。');
                return;
            }
            const text = transcriptLines.map(l => `[${l.time}] ${l.speaker}：${l.text}`).join('\n');
            const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
            const url  = URL.createObjectURL(blob);
            const a    = document.createElement('a'); a.href = url;
            a.download = `逐字稿_${new Date().toISOString().slice(0,16).replace('T','-')}.txt`;
            a.click();
        }

        // ════════════════════════════════════════════
        //  AI 分析（呼叫 Claude API）
        // ════════════════════════════════════════════
        async function analyzeAll() {
            if (transcriptLines.length < 3) {
                alert('逐字稿內容太少，請進行一段對話後再分析。');
                return;
            }

            document.getElementById('analyzeModal').style.display = 'flex';
            document.getElementById('analyzeBtn').classList.add('loading');

            const transcriptText = transcriptLines.map(l => `[${l.time}] ${l.speaker}：${l.text}`).join('\n');

            const prompt = `以下是一份面試逐字稿，請分析每位求職者的表現。
        面試逐字稿：
        ${transcriptText}

        請依照以下格式分析（繁體中文）：

        1. 首先列出所有求職者名單
        2. 對每位求職者分別分析：
           - 語氣與表達能力（是否清晰、有自信、語速合適）
           - 答題準確度與深度（回答是否切題、有邏輯）
           - 整體表現評分（1-10分）及錄取建議
        3. 最後給出整體面試摘要

        請直接輸出分析，不需要前言。`;

            try {
                const res = await fetch("https://api.anthropic.com/v1/messages", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        model: "claude-sonnet-4-20250514",
                        max_tokens: 2000,
                        system: "你是專業的人資顧問，擅長面試分析。請用繁體中文回應，格式清晰易讀。",
                        messages: [{ role: "user", content: prompt }]
                    })
                });

                const data  = await res.json();
                analysisText = data.content?.[0]?.text || "分析失敗，請稍後重試。";

                document.getElementById('analyzeContent').innerHTML =
                    analysisText.split('\n').map(line => {
                        if (line.startsWith('#')) return `<h4 style="color:#79c0ff;margin:12px 0 6px">${line.replace(/^#+\s*/,'')}</h4>`;
                        if (line.trim() === '') return '<br>';
                        return `<p style="font-size:13px;color:#c9d1d9;line-height:1.7;margin-bottom:6px">${line}</p>`;
                    }).join('');

                document.getElementById('dlReportBtn').style.display = '';
            } catch (err) {
                document.getElementById('analyzeContent').innerHTML =
                    `<p style="color:#f85149">分析失敗：${err.message}</p>`;
            }

            document.getElementById('analyzeBtn').classList.remove('loading');
        }

        function downloadReport() {
            if (!analysisText) return;
            const blob = new Blob([analysisText], { type: 'text/plain;charset=utf-8' });
            const url  = URL.createObjectURL(blob);
            const a    = document.createElement('a'); a.href = url;
            a.download = `面試分析報告_${new Date().toISOString().slice(0,16).replace('T','-')}.txt`;
            a.click();
        }

        function closeAnalyzeModal() {
            document.getElementById('analyzeModal').style.display = 'none';
        }

        // ════════════════════════════════════════════
        //  AI 面試官：冷場偵測 + 語音
        // ════════════════════════════════════════════
        const FALLBACK_Q = [
            "請先做個自我介紹，包含您的背景與應徵動機。",
            "您在上一份工作遇到最大的挑戰是什麼？您如何克服？",
            "您認為自己最大的優點與缺點分別是什麼？",
            "請描述一個展現團隊合作精神的具體經驗。",
            "您對未來三到五年的職涯規劃是什麼？",
            "工作上與同事意見不同時，您通常如何處理？",
            "請談談您過去最有成就感的一個工作成果。",
            "您為什麼想加入我們公司？",
            "您有帶領過團隊的經驗嗎？可以分享一下嗎？",
            "您如何在高壓環境下保持工作效率？",
            "有沒有與不同部門合作的經驗？如何協調？",
            "您最近學習了什麼新技能或知識？"
        ];

        function nextQ() { return FALLBACK_Q[questionIdx++ % FALLBACK_Q.length]; }

        function setAiStatus(cls, text) {
            const el = document.getElementById('aiStatusBadge');
            el.className = 'ai-status-badge ' + cls;
            el.textContent = text;
        }

        function setRing(on) {
            document.getElementById('speakRing').classList.toggle('on', on);
        }

        function showAiTyping() {
            document.getElementById('aiMsg').innerHTML =
                '<span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span>';
        }

        function showAiMsg(text) {
            document.getElementById('aiMsg').innerHTML = text.replace(/\n/g, '<br>');
        }

        function aiSpeak(text) {
            if (isSpeaking) return;
            if (!window.speechSynthesis) { showAiMsg(text); addTranscriptLine("AI 面試官（王大明）", text, true); return; }

            window.speechSynthesis.cancel();
            isSpeaking = true;
            silenceTimer = 0;
            if (recognition) try { recognition.stop(); } catch {}

            setAiStatus('speaking', '🗣️ 說話中');
            setRing(true);
            showAiTyping();

            const utter = new SpeechSynthesisUtterance(text);
            const voices = window.speechSynthesis.getVoices();
            const zh = voices.find(v => v.lang?.startsWith('zh')) || voices[0];
            if (zh) utter.voice = zh;
            utter.lang = 'zh-TW'; utter.rate = 0.88; utter.pitch = 1; utter.volume = 1;

            utter.onstart = () => {
                showAiMsg(text);
                addTranscriptLine("AI 面試官（王大明）", text, true);
            };
            utter.onend = utter.onerror = () => {
                isSpeaking = false; silenceTimer = 0;
                setAiStatus('listening', '👂 聆聽中');
                setRing(false);
                // 重啟 STT
                if (recognition) setTimeout(() => { try { recognition.start(); } catch {} }, 300);
            };

            setTimeout(() => window.speechSynthesis.speak(utter), 200);
        }

        async function getClaudeQ() {
            try {
                const ctx = questionIdx === 0 ? "面試剛開始，尚未自我介紹"
                          : `已進行 ${questionIdx} 題，最近逐字稿：${transcriptLines.slice(-3).map(l=>l.speaker+'說：'+l.text).join('；')}`;
                const r = await fetch("https://api.anthropic.com/v1/messages", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        model: "claude-sonnet-4-20250514",
                        max_tokens: 80,
                        system: "你是台灣企業面試主管王大明。說繁體中文，語氣專業親切。每次只說一個面試問題或打破冷場的話，不超過40字，不加前綴。",
                        messages: [{ role: "user", content: `面試出現冷場。背景：${ctx}。請說一句話。` }]
                    })
                });
                const d = await r.json();
                const t = d.content?.[0]?.text?.trim();
                return (t && t.length > 4) ? t : null;
            } catch { return null; }
        }

        async function triggerAI() {
            if (isSpeaking) return;
            setAiStatus('thinking', '💭 思考中...');
            let q = await getClaudeQ();
            if (!q) q = nextQ();
            aiSpeak(q);
        }

        function updateSilenceBar(pct) {
            const f = document.getElementById('silenceFill');
            f.style.width = pct + '%';
            f.className = 'silence-fill' + (pct > 80 ? ' hot' : pct > 50 ? ' warn' : '');
            document.getElementById('silenceLabel').textContent =
                pct > 0 ? `冷場偵測 ${Math.round(pct)}%` : '冷場偵測';
        }

        // ════════════════════════════════════════════
        //  麥克風音量偵測（獨立於 STT）
        // ════════════════════════════════════════════
        async function startSilenceDetection() {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
                const ctx    = new (window.AudioContext || window.webkitAudioContext)();
                const an     = ctx.createAnalyser();
                an.fftSize   = 256;
                ctx.createMediaStreamSource(stream).connect(an);
                const buf = new Uint8Array(an.frequencyBinCount);

                setInterval(() => {
                    if (isSpeaking) { updateSilenceBar(0); return; }
                    an.getByteFrequencyData(buf);
                    const avg = buf.reduce((a, b) => a + b, 0) / buf.length;
                    if (avg > 8) {
                        silenceTimer = 0; updateSilenceBar(0);
                        setAiStatus('listening', '👂 聆聽中');
                    } else {
                        silenceTimer++;
                        const pct = Math.min((silenceTimer / SILENCE_SEC) * 100, 100);
                        updateSilenceBar(pct);
                        if (silenceTimer >= SILENCE_SEC) { silenceTimer = 0; triggerAI(); }
                    }
                }, 1000);
            } catch {
                // 無麥克風時改用純計時
                setInterval(() => {
                    if (isSpeaking) return;
                    silenceTimer++;
                    updateSilenceBar(Math.min((silenceTimer / SILENCE_SEC) * 100, 100));
                    if (silenceTimer >= SILENCE_SEC) { silenceTimer = 0; triggerAI(); }
                }, 1000);
            }
        }

        // ════════════════════════════════════════════
        //  複製代碼
        // ════════════════════════════════════════════
        function copyCode() {
            navigator.clipboard.writeText('@room.JitsiRoomName').then(() => {
                const b = document.getElementById('copyBtn');
                b.textContent = '✅ 已複製';
                b.classList.add('done');
                setTimeout(() => { b.textContent = '複製代碼'; b.classList.remove('done'); }, 2000);
            });
        }

        // ════════════════════════════════════════════
        //  初始化
        // ════════════════════════════════════════════
        window.addEventListener('load', () => {
            if (window.speechSynthesis) {
                window.speechSynthesis.getVoices();
                window.speechSynthesis.onvoiceschanged = () => window.speechSynthesis.getVoices();
            }

            // 開場問候（7秒後）
            setTimeout(() => {
                aiSpeak("您好，歡迎參加今天的面試！我是王大明，今天擔任面試主管。請先做個自我介紹，告訴我您的背景與應徵這份職位的動機。");
            }, 7000);

            // 啟動麥克風偵測
            setTimeout(() => {
                startSilenceDetection();
                initSpeechRecognition();
            }, 4000);
        });
    </script>
</body>
</html>
