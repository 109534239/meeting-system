@using InterviewProject.Services
@inject JaasJwtService JaasJwt
@{
    Layout = null;
    var room = ViewBag.Room as InterviewProject.Models.Room;
    var memberName = Context.Session.GetString("MemberName") ?? "訪客";
    var memberRole = Context.Session.GetString("MemberRole")?.ToLower() ?? "";
    var sessionMemberId = Context.Session.GetInt32("MemberId") ?? 0;
    var isStaff = memberRole == "hr" || memberRole == "manager" || memberRole == "director";
    var isHost = memberRole == "director"; // 🎯 只有最高主管是主持人，能開始/結束會議
    string staffLabel = memberRole switch
    {
        "director" => "最高主管",
        "manager" => "主管",
        "hr" => "人資",
        _ => "員工"
    };
    var displayName = isStaff ? staffLabel + "：" + memberName : "求職者：" + memberName;
    // 🎯 換成你自己申請的 JaaS AppID（原本那組是別人的示範帳號，難怪一直卡在驗證失敗）
    var jaasTenantId = "vpaas-magic-cookie-c12aeb6abc7a4349bc799bb8cb31436a";
    var jitsiDomain = "8x8.vc";
    var jitsiRoom = jaasTenantId + "/" + room.JitsiRoomName;
    var encodedName = Uri.EscapeDataString(displayName);

    // 🎯 簽發這次進場要用的 JWT：只有 director 拿到 moderator=true
    var jitsiJwt = JaasJwt.GenerateToken(room.JitsiRoomName, sessionMemberId.ToString(), displayName, isHost);
}
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>面試會議 - @room.RoomName</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0
        }

        html, body {
            height: 100%;
            background: #0d1117;
            font-family: 'Segoe UI',sans-serif;
            color: #e6edf3;
            display: flex;
            flex-direction: column;
            overflow: hidden
        }

        .topbar {
            height: 50px;
            background: #161b22;
            border-bottom: 1px solid #30363d;
            display: flex;
            align-items: center;
            padding: 0 12px;
            gap: 8px;
            flex-shrink: 0;
            z-index: 10
        }

        .room-name {
            font-weight: 700;
            font-size: 13px;
            white-space: nowrap
        }

        .room-code {
            font-family: monospace;
            font-size: 11px;
            background: #21262d;
            color: #79c0ff;
            padding: 2px 8px;
            border-radius: 10px;
            cursor: pointer
        }

        .topbar-mid {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 6px
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0
        }

        .btn {
            padding: 5px 12px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 700;
            border: 1px solid transparent;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            white-space: nowrap;
            transition: all .15s;
            font-family: inherit;
            background: none
        }

        .btn-gray {
            background: #21262d;
            border-color: #30363d;
            color: #8b949e
        }

        .btn-green {
            background: #1a3d1a;
            border-color: #3fb950;
            color: #3fb950
        }

        .btn-orange {
            background: #3d2800;
            border-color: #f0883e;
            color: #f0883e
        }

        .btn-red {
            background: #3d1a1a;
            border-color: #f85149;
            color: #f85149
        }

        .user-badge {
            font-size: 11px;
            padding: 3px 9px;
            border-radius: 10px;
            background: #21262d;
            color: #8b949e
        }

        .rec-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            display: inline-block;
            background: #484f58
        }

        .banner {
            padding: 5px 16px;
            font-size: 12px;
            font-weight: 700;
            text-align: center;
            flex-shrink: 0
        }

            .banner.wait {
                background: #3d2800;
                color: #f0883e
            }

            .banner.live {
                background: #1a3d1a;
                color: #3fb950
            }

            .banner.done {
                background: #3d1a1a;
                color: #f85149
            }

        .main {
            flex: 1;
            display: flex;
            min-height: 0
        }

        .video-wrap {
            flex: 1;
            position: relative;
            min-width: 0;
            background: #000
        }

            .video-wrap iframe {
                width: 100%;
                height: 100%;
                border: none;
                position: absolute;
                inset: 0
            }

        .ai-panel {
            width: 240px;
            flex-shrink: 0;
            background: #161b22;
            border-left: 1px solid #30363d;
            display: flex;
            flex-direction: column;
            overflow: hidden
        }

        .ai-head {
            padding: 10px;
            border-bottom: 1px solid #30363d;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px
        }

        .avw {
            position: relative;
            width: 66px;
            height: 66px
        }

        .sring {
            position: absolute;
            inset: -5px;
            border-radius: 50%;
            border: 2.5px solid #3fb950;
            opacity: 0;
            transition: opacity .3s
        }

            .sring.on {
                opacity: 1;
                animation: rp 1s ease-in-out infinite
            }

        @@keyframes rp {
            0%, 100% {
                transform: scale(1);
                opacity: .9
            }

            50% {
                transform: scale(1.07);
                opacity: .5
            }
        }

        .ai-svg {
            width: 66px;
            height: 66px;
            border-radius: 50%;
            border: 2px solid #30363d
        }

        .ai-nm {
            font-size: 13px;
            font-weight: 700
        }

        .ai-rl {
            font-size: 10px;
            color: #8b949e
        }

        .ai-st {
            font-size: 10px;
            padding: 2px 8px;
            border-radius: 10px;
            font-weight: 600
        }

            .ai-st.wa {
                background: #3d2800;
                color: #f0883e
            }

            .ai-st.li {
                background: #1a3d1a;
                color: #3fb950
            }

            .ai-st.sp {
                background: #1a2d3d;
                color: #79c0ff
            }

            .ai-st.th {
                background: #3d2d00;
                color: #d29922
            }

        .ai-body {
            flex: 1;
            display: flex;
            flex-direction: column;
            padding: 8px;
            gap: 7px;
            overflow-y: auto
        }

        .ai-msg {
            background: #21262d;
            border-radius: 8px;
            padding: 10px;
            font-size: 11px;
            line-height: 1.6;
            color: #c9d1d9;
            min-height: 44px
        }

        .tdot {
            display: inline-block;
            width: 4px;
            height: 4px;
            border-radius: 50%;
            background: #79c0ff;
            margin: 0 1.5px;
            animation: tdot 1.2s ease-in-out infinite
        }

            .tdot:nth-child(2) {
                animation-delay: .2s
            }

            .tdot:nth-child(3) {
                animation-delay: .4s
            }

        @@keyframes tdot {
            0%, 80%, 100% {
                transform: translateY(0)
            }

            40% {
                transform: translateY(-4px)
            }
        }

        .si-wrap {
            background: #0d1117;
            border-radius: 6px;
            padding: 7px
        }

        .si-lbl {
            font-size: 9px;
            color: #484f58;
            margin-bottom: 3px
        }

        .si-bar {
            height: 3px;
            background: #21262d;
            border-radius: 2px;
            overflow: hidden
        }

        .si-fill {
            height: 100%;
            width: 0%;
            background: #388bfd;
            transition: width 1s linear;
            border-radius: 2px
        }

            .si-fill.w {
                background: #d29922
            }

            .si-fill.h {
                background: #f85149
            }
        /* 彈跳視窗 */
        .modal-bg {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.78);
            z-index: 9998;
            display: none;
            align-items: center;
            justify-content: center
        }

            .modal-bg.show {
                display: flex
            }

        .modal-box {
            background: #161b22;
            border: 1px solid #30363d;
            border-radius: 16px;
            padding: 32px 36px;
            text-align: center;
            max-width: 440px;
            width: 90%
        }

            .modal-box .m-icon {
                font-size: 46px;
                margin-bottom: 12px
            }

            .modal-box h3 {
                font-size: 18px;
                font-weight: 700;
                margin-bottom: 10px
            }

            .modal-box p {
                font-size: 13px;
                color: #8b949e;
                line-height: 1.6;
                margin-bottom: 20px
            }

        .m-acts {
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap
        }
        /* 主管下載畫面 */
        .ended-screen {
            position: fixed;
            inset: 0;
            background: #0d1117;
            z-index: 9999;
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 14px
        }

            .ended-screen.show {
                display: flex
            }

            .ended-screen h2 {
                font-size: 20px;
                font-weight: 700
            }

        .dl-items {
            display: flex;
            flex-direction: column;
            gap: 7px;
            margin-top: 6px;
            min-width: 300px
        }

        .dl-item {
            font-size: 12px;
            padding: 8px 14px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 8px
        }

            .dl-item.ok {
                background: #1a3d1a;
                color: #3fb950
            }

            .dl-item.ng {
                background: #3d1a1a;
                color: #f85149
            }

            .dl-item.wait {
                background: #3d2800;
                color: #d29922
            }
    </style>
</head>
<body>

    <div class="topbar">
        <div class="room-name">🎥 @Html.Raw(room.RoomName)</div>
        <span class="room-code" onclick="copyCode()" title="點擊複製">@room.JitsiRoomName</span>
        <span class="room-code" id="scheduledAtDisplay" title="預計面試時間">
            🕒 @(room.ScheduledAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "未設定時間")
        </span>
        <div class="topbar-mid">
            <span class="btn btn-gray">
                <span class="rec-dot" id="recDot"></span>
                <span id="recTxt">等待開始</span>
            </span>
            @if (isHost)
            {
                <button class="btn btn-green" id="startBtn" onclick="hostStart()">▶ 開始會議</button>
                <button class="btn btn-orange" id="endBtn" onclick="showEndConfirm()" style="display:none">⏹ 結束會議</button>
            }
        </div>
        <div class="topbar-right">
            <span class="user-badge">👤 @Html.Raw(displayName)</span>
            <button class="btn btn-gray" onclick="copyCode()">複製代碼</button>
        </div>
    </div>

    <div class="banner wait" id="banner">⏳ 等待主管開始會議...</div>

    <div class="main">
        <div class="video-wrap" id="videoWrap">
            <div id="jitsi-container" style="width:100%;height:100%"></div>
        </div>

        <div class="ai-panel">
            <div class="ai-head">
                <div class="avw">
                    <div class="sring" id="sring"></div>
                    <svg class="ai-svg" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                        <rect width="66" height="66" rx="33" fill="#21262d" />
                        <circle cx="33" cy="25" r="13" fill="#388bfd" />
                        <ellipse cx="33" cy="61" rx="21" ry="14" fill="#388bfd" />
                        <rect x="27" y="38" width="12" height="13" rx="3" fill="#1f6feb" />
                        <polygon points="33,40 30,46 33,44 36,46" fill="#1158c7" />
                    </svg>
                </div>
                <div class="ai-nm">王大明</div>
                <div class="ai-rl">AI 面試官</div>
                <div class="ai-st wa" id="aiSt">⏳ 等待開始</div>
            </div>
            <div class="ai-body">
                <div class="ai-msg" id="aiMsg">等待主管開始會議。<br><br>會議開始後，我會在冷場時適時提問。</div>
                <div class="si-wrap">
                    <div class="si-lbl" id="siLbl">冷場偵測（會議開始後啟動）</div>
                    <div class="si-bar"><div class="si-fill" id="siFill"></div></div>
                </div>
            </div>
        </div>
    </div>

    <!-- 確認結束 -->
    <div class="modal-bg" id="endModal">
        <div class="modal-box">
            <div class="m-icon">⏹</div>
            <h3>確認結束會議</h3>
            <p>結束後，主管端將自動下載錄音與分析報告，所有人的分頁將自動關閉。</p>
            <div class="m-acts">
                <button class="btn btn-red" onclick="hostEndExecute()">確認結束</button>
                <button class="btn btn-gray" onclick="document.getElementById('endModal').classList.remove('show')">取消</button>
            </div>
        </div>
    </div>

    <!-- 會議尚未開始（求職者看到） -->
    <div class="modal-bg" id="notStartedModal">
        <div class="modal-box">
            <div class="m-icon">⏳</div>
            <h3>會議尚未開始</h3>
            <p>請稍後再試，等待主管開始會議後即可進行。<br>頁面會自動偵測，無需重新整理。</p>
            <div class="m-acts">
                <button class="btn btn-gray" onclick="document.getElementById('notStartedModal').classList.remove('show')">我知道了</button>
            </div>
        </div>
    </div>

    <!-- 主管端：下載畫面（求職者只看到空白後關閉） -->
    <div class="ended-screen" id="endedScreen">
        <div style="font-size:44px">✅</div>
        <h2 id="endTitle">面試已結束</h2>
        <p style="color:#8b949e;font-size:12px" id="endSubtitle">正在處理...</p>
        <div class="dl-items" id="dlItems"></div>
        <button class="btn btn-gray" onclick="window.location.href='/Interview/Index'" style="margin-top:14px;display:none" id="backBtn">← 返回面試管理</button>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/fix-webm-duration@1.0.6/fix-webm-duration.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script src="https://8x8.vc/vpaas-magic-cookie-c12aeb6abc7a4349bc799bb8cb31436a/external_api.js"></script>
    <script>
        // ══════════════════════════════════
        //  設定
        // ══════════════════════════════════
        const IS_STAFF   = @(isStaff ? "true" : "false");
        const IS_HOST    = @(isHost ? "true" : "false");
        const MY_NAME    = "@Html.Raw(displayName.Replace("\"", "\\\""))";
        const ROOM_CODE  = "@room.JitsiRoomName";
        const ALREADY_IN_PROGRESS = @(room.MeetingStatus == "InProgress" ? "true" : "false");
        const JITSI_ROOM = "@jitsiRoom";
        const JITSI_DOMAIN = "@jitsiDomain";
        const JITSI_JWT = "@jitsiJwt";
        const SIL_SEC    = 22;  // 冷場觸發秒數

        // ══════════════════════════════════
        //  狀態
        // ══════════════════════════════════
        let started = false, ended = false;
        let silT = 0, isSp = false;
        let audioStream = null, mediaRec = null, recChunks = [];
        let recBlob = null;
        let recStartMs = 0;
        let recognition = null;
        let trxLines = [];
        let lastSpeechMs = 0;
        let recentSpeech = [];
        let silInterval = null;

        // ══════════════════════════════════
        //  SignalR
        // ══════════════════════════════════
        const hub = new signalR.HubConnectionBuilder()
            .withUrl("/meetingHub")
            .withAutomaticReconnect()
            .build();

        // 🎯 重要修正：斷線重連後，之前用 JoinRoom 加入的群組會消失，一定要重新加入，
        //    不然主持人開始會議的廣播會收不到（卡在等待畫面不會動）
        hub.onreconnected(() => {
            hub.invoke("JoinRoom", ROOM_CODE).catch(() => {});
        });

        hub.on("MeetingStarted", () => { if (!started) onMeetingStart(); });
        hub.on("MeetingEnded",   () => { if (!ended)   onMeetingEnd(); });

        // 🎯 收到別人講話的逐字稿內容，併進自己這份（讓最後下載的逐字稿是完整的，不是只有自己說的話）
        hub.on("TranscriptReceived", (speaker, text, time) => {
            trxLines.push({ sp: speaker, tx: text, time: time });
        });

        // 🎯 最高主管改了面試時間，正在這個房間頁面等待的人（含主持人自己）立刻收到通知並更新畫面
        hub.on("ScheduledAtChanged", (newTimeText) => {
            const el = document.getElementById('scheduledAtDisplay');
            if (el) el.textContent = '🕒 ' + newTimeText;
            showMsg('⏰ 主持人已更改面試時間，新的時間是：' + newTimeText);
            alert('面試時間已更新為：' + newTimeText);
        });

        // 冷場同步：主管廣播給所有人「有聲音了」
        hub.on("SpeechDetected", () => {
            lastSpeechMs = Date.now();
            silT = 0; setSilBar(0);
            if (!isSp) setSt('li', '👂 聆聽中');
        });

        async function startHub() {
            try {
                await hub.start();
                await hub.invoke("JoinRoom", ROOM_CODE);
            } catch (e) {
                console.warn("SignalR 失敗，localStorage fallback");
                setInterval(() => {
                    const s = localStorage.getItem("meet_" + ROOM_CODE);
                    if (!started && s === "started") onMeetingStart();
                    if (!ended   && s === "ended")   onMeetingEnd();
                }, 1500);
            }
        }
        startHub();

        // ══════════════════════════════════
        //  主管操作
        // ══════════════════════════════════
        async function hostStart() {
            try { await hub.invoke("StartMeeting", ROOM_CODE); }
            catch { localStorage.setItem("meet_" + ROOM_CODE, "started"); onMeetingStart(); }
        }

        function showEndConfirm() {
            document.getElementById('endModal').classList.add('show');
        }

        async function hostEndExecute() {
            document.getElementById('endModal').classList.remove('show');
            try { await hub.invoke("EndMeeting", ROOM_CODE); }
            catch { localStorage.setItem("meet_" + ROOM_CODE, "ended"); onMeetingEnd(); }
        }

        // ══════════════════════════════════
        //  會議開始
        // ══════════════════════════════════
        function onMeetingStart() {
            if (started) return;
            started = true;

            // 🎯 這裡才是真正連線進 Jitsi 視訊會議的時機——大家（含主持人自己）
            //    收到「會議開始」廣播的當下才一起連線，計時器才會是共同、從 0 起算的
            //    修正：非主持人延遲一點點再連線，讓主持人的連線先把會議室在 Jitsi 那邊真的建立起來，
            //    不然求職者/主管的連線有時候會比主持人早一步，變成「conference not found」連不進去
            if (IS_HOST) {
                initJitsi();
            } else {
                setTimeout(initJitsi, 2000);
            }

            document.getElementById('notStartedModal').classList.remove('show');

            const b = document.getElementById('banner');
            b.className = 'banner live';
            b.textContent = '🔴 會議進行中';

            if (IS_HOST) {
                document.getElementById('startBtn').style.display = 'none';
                document.getElementById('endBtn').style.display = '';
            }

            document.getElementById('recDot').style.background = '#f85149';
            document.getElementById('recTxt').textContent = '錄音中';
            setSt('li', '👂 聆聽中');
            showMsg('會議已開始。我會在冷場時適時提問。');
            lastSpeechMs = Date.now(); // 會議開始當下不算冷場

            initAudio().then(() => {
                initSTT();
                startSilenceDetect();
            });
        }

        // ══════════════════════════════════
        //  會議結束
        // ══════════════════════════════════
        function onMeetingEnd() {
            if (ended) return;
            ended = true;

            if (window.speechSynthesis) window.speechSynthesis.cancel();
            isSp = false;
            if (recognition) { try { recognition.stop(); } catch {} }
            if (silInterval) clearInterval(silInterval);

            setSt('wa', '✅ 面試結束');
            showMsg('面試已結束，感謝所有人的參與！');

            const b = document.getElementById('banner');
            b.className = 'banner done';
            b.textContent = '🔒 面試已結束';

            if (IS_STAFF) {
                // 主管：停止錄影，觸發下載流程
                if (mediaRec && mediaRec.state !== 'inactive') {
                    mediaRec.stop(); // onstop → showEndedScreen()
                } else {
                    recBlob = null;
                    showEndedScreen();
                }
            } else {
                // ✅ 求職者：回到應徵管理頁面（原本連到 /Interview/MyInterviews 是錯的路徑，那是給員工用的）
                setTimeout(() => {
                    window.location.href = '/Member/Application';
                }, 1200);
            }
        }

        // ══════════════════════════════════
        //  錄影（螢幕錄製，含畫面+聲音）— 僅主管端；免費，但需要主持人同意分享畫面
        // ══════════════════════════════════
        async function initAudio() {
            if (!IS_STAFF) {
                // 求職者：只啟動 STT 用的麥克風，不錄影
                try {
                    audioStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
                } catch {
                    audioStream = null;
                }
                return;
            }

            // 主管端：先嘗試螢幕錄製（含畫面+聲音）
            try {
                // 螢幕錄製：會要求使用者選擇要錄的視窗/分頁
                const screenStream = await navigator.mediaDevices.getDisplayMedia({
                    video: { frameRate: 15, width: 1280, height: 720 },
                    audio: true  // 含系統聲音（需瀏覽器支援）
                });

                // 同時取麥克風（混音）
                let micStream = null;
                try {
                    micStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
                    audioStream = micStream; // 供 STT 和冷場偵測用
                } catch {}

                // 合併螢幕+麥克風
                const tracks = [...screenStream.getTracks()];
                if (micStream) {
                    micStream.getAudioTracks().forEach(t => tracks.push(t));
                }
                const combined = new MediaStream(tracks);

                const types = ['video/webm;codecs=vp9,opus','video/webm;codecs=vp8,opus','video/webm','video/mp4'];
                let mime = '';
                for (const t of types) { if (MediaRecorder.isTypeSupported(t)) { mime=t; break; } }

                mediaRec = new MediaRecorder(combined, mime ? { mimeType: mime, videoBitsPerSecond: 1500000 } : {});
                recChunks = [];
                recStartMs = Date.now();
                mediaRec.ondataavailable = e => { if (e.data.size > 0) recChunks.push(e.data); };
                mediaRec.onstop = () => {
                    const rawBlob = new Blob(recChunks, { type: mime || 'video/webm' });
                    const durationMs = Date.now() - recStartMs;
                    // 🎯 修正：MediaRecorder 產出的 webm 預設沒有寫入總長度，播放器沒辦法拖拉進度條，
                    //    用 fix-webm-duration 把正確的時長補進檔案標頭
                    if (window.ysFixWebmDuration) {
                        ysFixWebmDuration(rawBlob, durationMs, fixedBlob => {
                            recBlob = fixedBlob;
                            showEndedScreen();
                        });
                    } else {
                        recBlob = rawBlob;
                        showEndedScreen();
                    }
                };

                // 螢幕停止分享時同步停止錄製
                screenStream.getVideoTracks()[0].onended = () => {
                    if (mediaRec && mediaRec.state !== 'inactive') mediaRec.stop();
                };

                mediaRec.start(1000);
                document.getElementById('recDot').style.background = '#f85149';
                document.getElementById('recTxt').textContent = '🎬 錄影中';
                console.log('螢幕錄影已啟動，格式：', mime);

            } catch (err) {
                console.warn('螢幕錄影失敗，改為純音訊：', err.message);
                // fallback：純音訊錄音
                try {
                    audioStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
                    const types = ['audio/webm;codecs=opus','audio/webm','audio/ogg'];
                    let mime = '';
                    for (const t of types) { if (MediaRecorder.isTypeSupported(t)) { mime=t; break; } }
                    mediaRec = new MediaRecorder(audioStream, mime ? { mimeType: mime } : {});
                    recChunks = [];
                    recStartMs = Date.now();
                    mediaRec.ondataavailable = e => { if (e.data.size > 0) recChunks.push(e.data); };
                    mediaRec.onstop = () => {
                        const rawBlob = new Blob(recChunks, { type: mime || 'audio/webm' });
                        const durationMs = Date.now() - recStartMs;
                        if (window.ysFixWebmDuration) {
                            ysFixWebmDuration(rawBlob, durationMs, fixedBlob => {
                                recBlob = fixedBlob;
                                showEndedScreen();
                            });
                        } else {
                            recBlob = rawBlob;
                            showEndedScreen();
                        }
                    };
                    mediaRec.start(1000);
                } catch (err2) {
                    console.warn('純音訊也失敗：', err2.message);
                    audioStream = null;
                    showEndedScreen();
                }
            }
        }

        // ══════════════════════════════════
        //  STT — 每個人偵測自己的聲音，廣播給全場
        //  逐字稿在主管端整合（主管會看到所有人的聲音）
        // ══════════════════════════════════
        function initSTT() {
            const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SR) {
                console.warn('瀏覽器不支援 SpeechRecognition（建議用 Chrome）');
                return;
            }

            recognition = new SR();
            recognition.lang = 'zh-TW';
            recognition.continuous = true;
            recognition.interimResults = true;

            recognition.onresult = e => {
                for (let i = e.resultIndex; i < e.results.length; i++) {
                    if (e.results[i].isFinal) {
                        const txt = e.results[i][0].transcript.trim();
                        if (txt.length > 1) {
                            // ✅ 所有角色都記錄自己說的話
                            const now = new Date().toLocaleTimeString('zh-TW',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
                            trxLines.push({ sp: MY_NAME, tx: txt, time: now });
                            recentSpeech.push({ name: MY_NAME, text: txt });
                            if (recentSpeech.length > 6) recentSpeech.shift();

                            // 🎯 修正：把「文字內容」廣播出去，不只是一個空訊號 —— 每個人的 SpeechRecognition
                            //    只能聽到自己麥克風的聲音，不廣播內容的話，其他人的話永遠不會出現在逐字稿裡
                            try { hub.invoke('BroadcastTranscript', ROOM_CODE, MY_NAME, txt, now); } catch {}
                            try { hub.invoke('BroadcastSpeech', ROOM_CODE); } catch {}
                        }
                    }
                    // 中間結果也重置冷場
                    lastSpeechMs = Date.now();
                    silT = 0; setSilBar(0);
                }
            };
            recognition.onerror = e => {
                if (e.error === 'not-allowed') {
                    console.warn('麥克風被 Jitsi 佔用，改用 Jitsi 事件偵測');
                }
            };
            recognition.onend = () => {
                if (!ended && !isSp)
                    setTimeout(() => { try { recognition.start(); } catch {} }, 500);
            };
            try { recognition.start(); } catch(e) {
                console.warn('STT start 失敗：', e.message);
            }
        }

        // ══════════════════════════════════
        //  冷場偵測（基於音量 + SignalR 同步）
        // ══════════════════════════════════
        function startSilenceDetect() {
            if (audioStream) {
                const ac = new (window.AudioContext || window.webkitAudioContext)();
                const an = ac.createAnalyser(); an.fftSize = 256;
                ac.createMediaStreamSource(audioStream).connect(an);
                const buf = new Uint8Array(an.frequencyBinCount);

                silInterval = setInterval(() => {
                    if (!started || ended || isSp) { setSilBar(0); return; }
                    an.getByteFrequencyData(buf);
                    const avg = buf.reduce((a,b)=>a+b,0)/buf.length;
                    if (avg > 8) {
                        lastSpeechMs = Date.now();
                        silT = 0; setSilBar(0);
                        setSt('li','👂 聆聽中');
                        try { hub.invoke("BroadcastSpeech", ROOM_CODE); } catch {}
                    } else {
                        const secSince = (Date.now() - lastSpeechMs) / 1000;
                        const pct = Math.min((secSince / SIL_SEC) * 100, 100);
                        setSilBar(pct);
                        if (secSince >= SIL_SEC) { lastSpeechMs = Date.now(); triggerAI(); }
                    }
                }, 800);
            } else {
                // 無麥克風 fallback
                silInterval = setInterval(() => {
                    if (!started || ended || isSp) return;
                    const secSince = (Date.now() - lastSpeechMs) / 1000;
                    setSilBar(Math.min((secSince / SIL_SEC) * 100, 100));
                    if (secSince >= SIL_SEC) { lastSpeechMs = Date.now(); triggerAI(); }
                }, 800);
            }
        }

        // ══════════════════════════════════
        //  AI 面試官
        // ══════════════════════════════════
        const FQ = [
            "現在安靜了一下，請問有人想補充什麼嗎？",
            "說到這裡，有沒有具體的例子可以分享？",
            "好，我想多了解一下你的工作方式？",
            "你認為自己最大的優點是什麼？",
            "如果加入我們，你最想在哪個方面發揮？",
            "你有帶領過團隊的經驗嗎？",
            "遇到工作困難，你通常怎麼處理？",
            "你對這份職位有什麼期待？",
            "其他人有想補充的嗎？",
            "有沒有想問我們的問題？"
        ];
        let fqIdx = 0;
        function getFQ() { return FQ[fqIdx++ % FQ.length]; }

        async function triggerAI() {
            if (isSp || ended || !started) return;
            if ((Date.now() - lastSpeechMs) < 3000) return;

            setSt('th','💭 思考中...');
            const ctx = recentSpeech.slice(-3).map(s=>`${s.name}：${s.text}`).join('；') || "面試進行中";
            const prompt = `你是AI面試官王大明，協助主持「@room.RoomName」面試。最近對話：${ctx}。現在出現冷場（${SIL_SEC}秒無人說話）。請說一句自然的問題或打破冷場的話，不超過28字，直接說，不加引號或前綴。`;

            let q = null;
            try {
                const r = await fetch('/Claude/Ask', {
                    method:'POST', headers:{'Content-Type':'application/json'},
                    body: JSON.stringify({ prompt, system:"你是台灣企業面試主管，說繁體中文，語氣自然。", maxTokens:80 })
                });
                if (r.ok) { const d = await r.json(); if (d.text?.length > 3) q = d.text.trim(); }
            } catch {}

            if (!q) q = getFQ();
            aiSpeak(q);
        }

        function aiSpeak(text) {
            if (isSp || ended || !started) return;
            if (!window.speechSynthesis) { showMsg(text); return; }

            window.speechSynthesis.cancel();
            isSp = true; silT = 0;
            if (recognition) { try { recognition.stop(); } catch {} }

            setSt('sp','🗣️ 說話中'); setRing(true); showDots();

            const u = new SpeechSynthesisUtterance(text);
            const vs = window.speechSynthesis.getVoices();
            const zh = vs.find(v=>v.lang?.startsWith('zh')) || vs[0];
            if (zh) u.voice = zh;
            u.lang='zh-TW'; u.rate=0.85; u.pitch=1; u.volume=1;

            u.onstart = () => {
                showMsg(text);
                if (IS_STAFF) {
                    const now = new Date().toLocaleTimeString('zh-TW',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
                    trxLines.push({ sp:'AI 面試官（王大明）', tx:text, time:now });
                }
            };
            u.onend = u.onerror = () => {
                isSp = false; lastSpeechMs = Date.now();
                setSt('li','👂 聆聽中'); setRing(false);
                if (!ended && recognition)
                    setTimeout(()=>{ try{ recognition.start(); }catch{} }, 400);
            };
            setTimeout(()=>window.speechSynthesis.speak(u), 150);
        }

        // ══════════════════════════════════
        //  主管端：下載畫面
        // ══════════════════════════════════
        async function showEndedScreen() {
            const scr = document.getElementById('endedScreen');
            scr.classList.add('show');
            const dl = document.getElementById('dlItems');
            document.getElementById('endSubtitle').textContent = '檔案正在儲存至專案伺服器...';
            dl.innerHTML = '';

            // 1. 逐字稿 —— 存到專案的「逐字稿」資料夾（不再下載到瀏覽器）
            if (trxLines.length > 0) {
                const txt = trxLines.map(l=>`[${l.time}] ${l.sp}：${l.tx}`).join('\n');
                try {
                    const fd = new FormData();
                    fd.append('roomCode', ROOM_CODE);
                    fd.append('content', txt);
                    const r = await fetch('/Room/SaveTranscript', { method: 'POST', body: fd });
                    const d = await r.json();
                    dl.innerHTML += `<div class="dl-item ok">✅ 逐字稿（${trxLines.length} 條）已存至專案「逐字稿」資料夾：${d.fileName}</div>`;
                } catch (e) {
                    dl.innerHTML += `<div class="dl-item ng">⚠️ 逐字稿儲存失敗：${e.message}</div>`;
                }
            } else {
                dl.innerHTML += `<div class="dl-item ng">⚠️ 逐字稿為空（請確認麥克風已授權給 Chrome）</div>`;
            }

            // 2. 錄影/錄音 —— 存到專案的「錄影錄音」資料夾
            if (recBlob) {
                try {
                    const fd = new FormData();
                    fd.append('roomCode', ROOM_CODE);
                    fd.append('file', recBlob, 'recording.webm');
                    const r = await fetch('/Room/SaveRecording', { method: 'POST', body: fd });
                    const d = await r.json();
                    const label = recBlob.type.includes('video') ? '🎬 錄影檔' : '🎵 錄音檔';
                    dl.innerHTML += `<div class="dl-item ok">✅ ${label}已存至專案「錄影錄音」資料夾：${d.fileName}（.webm 可用 VLC 播放）</div>`;
                } catch (e) {
                    dl.innerHTML += `<div class="dl-item ng">⚠️ 錄影檔儲存失敗：${e.message}</div>`;
                }
            } else {
                dl.innerHTML += `<div class="dl-item ng">⚠️ 無錄影（螢幕錄製未授權或被取消）</div>`;
            }

            // 3. AI 分析
            if (trxLines.length >= 2) {
                dl.innerHTML += `<div class="dl-item wait" id="aStatus">⏳ AI 分析中...</div>`;
                const analysis = await runAnalysis();
                const aEl = document.getElementById('aStatus');
                if (analysis) {
                    dlFile(analysis, `面試分析_${ts()}.txt`, 'text/plain;charset=utf-8');
                    aEl.className = 'dl-item ok';
                    aEl.textContent = '✅ 面試分析報告已下載';
                } else {
                    aEl.className = 'dl-item ng';
                    aEl.textContent = '⚠️ AI 分析失敗（appsettings.json 中的 Gemini:ApiKey 是否正確？）';
                }
            } else {
                dl.innerHTML += `<div class="dl-item ng">⚠️ 逐字稿不足，跳過 AI 分析</div>`;
            }

            document.getElementById('endSubtitle').textContent = '所有檔案已儲存至專案伺服器';
            document.getElementById('backBtn').style.display = '';
        }

        async function runAnalysis() {
            const transcript = trxLines.map(l=>`[${l.time}] ${l.sp}：${l.tx}`).join('\n');
            const prompt = `以下是面試逐字稿，請分析每位求職者表現（繁體中文）：\n\n${transcript}\n\n請提供：1.求職者名單 2.每人：語氣表達、答題品質、評分(1-10)、錄取建議 3.整體摘要`;
            try {
                const r = await fetch('/Claude/Ask', {
                    method:'POST',
                    headers:{'Content-Type':'application/json'},
                    body: JSON.stringify({
                        prompt,
                        system: "你是專業人資顧問，說繁體中文，格式清晰條列。",
                        maxTokens: 2000
                    })
                });
                if (!r.ok) {
                    const err = await r.text();
                    console.error('AI 分析 HTTP 錯誤：', r.status, err);
                    return null;
                }
                const d = await r.json();
                return d.text || null;
            } catch(e) {
                console.error('AI 分析失敗：', e);
                return null;
            }
        }

        // ══════════════════════════════════
        //  工具
        // ══════════════════════════════════
        function dlFile(content, name, type) {
            const b = new Blob([content],{type});
            const u = URL.createObjectURL(b);
            const a = document.createElement('a'); a.href=u; a.download=name;
            document.body.appendChild(a); a.click(); document.body.removeChild(a);
            setTimeout(()=>URL.revokeObjectURL(u),5000);
        }
        function ts() { return new Date().toISOString().slice(0,16).replace('T','-'); }
        function setSt(cls,txt){ const e=document.getElementById('aiSt'); e.className='ai-st '+cls; e.textContent=txt; }
        function setRing(on){ document.getElementById('sring').classList.toggle('on',on); }
        function showDots(){ document.getElementById('aiMsg').innerHTML='<span class="tdot"></span><span class="tdot"></span><span class="tdot"></span>'; }
        function showMsg(t){ document.getElementById('aiMsg').innerHTML=t.replace(/\n/g,'<br>'); }
        function setSilBar(pct){
            const f=document.getElementById('siFill');
            f.style.width=pct+'%';
            f.className='si-fill'+(pct>80?' h':pct>50?' w':'');
            document.getElementById('siLbl').textContent=pct>0?`冷場偵測 ${Math.round(pct)}%`:'冷場偵測';
        }
        function copyCode(){
            navigator.clipboard.writeText(ROOM_CODE).then(()=>{
                const t=document.createElement('div');
                t.textContent='✅ 已複製';
                t.style.cssText='position:fixed;top:60px;right:20px;background:#1a3d1a;color:#3fb950;padding:5px 12px;border-radius:8px;font-size:12px;font-weight:700;z-index:99999';
                document.body.appendChild(t); setTimeout(()=>t.remove(),2000);
            });
        }

        // ══════════════════════════════════
        //  Jitsi External API 初始化
        // ══════════════════════════════════
        let jitsiApi = null;

        function initJitsi() {
            if (jitsiApi) return;
            if (typeof JitsiMeetExternalAPI === 'undefined') {
                console.error('Jitsi External API 尚未載入，2秒後重試');
                setTimeout(initJitsi, 2000);
                return;
            }

            jitsiApi = new JitsiMeetExternalAPI(JITSI_DOMAIN, {
                roomName:   JITSI_ROOM,
                jwt:        JITSI_JWT,
                parentNode: document.getElementById('jitsi-container'),
                width:      '100%',
                height:     '100%',
                userInfo: { displayName: MY_NAME },
                configOverwrite: {
                    prejoinPageEnabled:           false,
                    readOnlyName:                 true,
                    startWithAudioMuted:          false,
                    startWithVideoMuted:          false,
                    disableDeepLinking:           true,
                    enableNoAudioDetection:       false,
                    enableNoisyMicDetection:      false,
                    // ✅ 關閉大廳/主持人機制，任何人直接進入
                    lobby:                        { enableLobby: false },
                    securityUi:                   { hideLobbyButton: true, disableLobbyPassword: true },
                    // ✅ 完全關閉需要主持人的設定
                    requireDisplayName:           false,
                    enableWelcomePage:            false,
                    // ✅ 避免 5 分鐘限制：不使用嵌入模式的限制端點
                    p2p:                          { enabled: false },
                    toolbarButtons: IS_HOST
                        ? [
                            // 🎯 主持人不給原生「掛斷」按鈕，避免誤按只是自己離開視訊、卻沒有真的結束會議
                            //    主持人只能用畫面上方的「結束會議」按鈕，才會真正結束、寫入 EndAt、通知所有人
                            'microphone', 'camera', 'desktop', 'fullscreen',
                            'fodeviceselection', 'chat', 'settings',
                            'raisehand', 'videoquality', 'filmstrip', 'tileview', 'participants-pane'
                          ]
                        : [
                            'microphone', 'camera', 'desktop', 'fullscreen',
                            'fodeviceselection', 'hangup', 'chat', 'settings',
                            'raisehand', 'videoquality', 'filmstrip', 'tileview', 'participants-pane'
                          ]
                },
                interfaceConfigOverwrite: {
                    SHOW_JITSI_WATERMARK:             false,
                    SHOW_BRAND_WATERMARK:             false,
                    MOBILE_APP_PROMO:                 false,
                    DISABLE_TRANSCRIPTION_SUBTITLES:  true,
                    TOOLBAR_ALWAYS_VISIBLE:           true,
                    // ✅ 隱藏主持人相關 UI
                    SHOW_PROMOTIONAL_CLOSE_PAGE:      false,
                }
            });

            // 🎯 使用者自己按「掛斷」離開視訊（不是主持人結束會議），只影響自己，不影響會議本身
            //    求職者離開後導回應徵管理頁面；主管/主持人維持原本行為（留在頁面上）
            jitsiApi.addEventListener('readyToClose', () => {
                if (!IS_STAFF && !ended) {
                    window.location.href = '/Member/Application';
                }
            });

            // ✅ 使用者真的按下「加入會議」、實際進入 Jitsi 視訊房間時才觸發 —— 這時候才把 JoinedAt 寫進資料庫
            jitsiApi.addEventListener('videoConferenceJoined', e => {
                fetch('/Room/MarkJoined', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'code=' + encodeURIComponent(ROOM_CODE)
                }).catch(() => {});
            });

            // 🎯 使用者離開視訊（不管是自己按掛斷、還是斷線），記錄離開時間
            //    這只代表「他自己離開」，不會影響會議本身，會議只有主持人按「結束會議」才會真的結束
            jitsiApi.addEventListener('videoConferenceLeft', e => {
                fetch('/Room/MarkLeft', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'code=' + encodeURIComponent(ROOM_CODE)
                }).catch(() => {});
            });

            // ✅ 監聽 Jitsi 的音訊事件，直接用來做冷場偵測（不需另外取麥克風）
            jitsiApi.addEventListener('audioMuteStatusChanged', e => {
                if (!e.muted) {
                    lastSpeechMs = Date.now(); silT = 0; setSilBar(0);
                    try { hub.invoke('BroadcastSpeech', ROOM_CODE); } catch {}
                }
            });

            // 監聽 Jitsi 的語音活動事件（誰在說話）
            jitsiApi.addEventListener('dominantSpeakerChanged', e => {
                lastSpeechMs = Date.now(); silT = 0; setSilBar(0);
                try { hub.invoke('BroadcastSpeech', ROOM_CODE); } catch {}
            });

            console.log('Jitsi External API 初始化成功');
        }

        // ══════════════════════════════════
        //  初始化
        // ══════════════════════════════════
        window.addEventListener('load', ()=>{
            if (window.speechSynthesis){
                window.speechSynthesis.getVoices();
                window.speechSynthesis.onvoiceschanged = ()=>window.speechSynthesis.getVoices();
            }

            // 🎯 只有「會議已經在進行中」才立即連線（遲到 / 重新整理頁面的情況）
            //    否則一律等主持人真的按下「開始會議」，收到廣播才連線 —— 這樣所有人的視訊時鐘才會一起從 0 開始算，
            //    而不是誰先載入頁面誰的計時器就先跑
            if (ALREADY_IN_PROGRESS) {
                started = true;
                initJitsi();
                const b = document.getElementById('banner');
                b.className = 'banner live';
                b.textContent = '🔴 會議進行中';
            } else if (!IS_HOST) {
                // 求職者/主管：等待主持人開始，800ms 沒收到通知就顯示提示
                setTimeout(()=>{
                    if (!started)
                        document.getElementById('notStartedModal').classList.add('show');
                }, 800);
            }
            // 主持人：什麼都不做，等自己按下「開始會議」才會連線視訊（見 onMeetingStart）
        });
    </script>
</body>
</html>
