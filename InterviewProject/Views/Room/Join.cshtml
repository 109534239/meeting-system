@using InterviewProject.Services
@inject JaasJwtService JaasJwt
@{
    Layout = null;
    var room = ViewBag.Room as InterviewProject.Models.Room;
    var memberName = Context.Session.GetString("MemberName") ?? "訪客";
    var memberRole = Context.Session.GetString("MemberRole")?.ToLower() ?? "";
    var sessionMemberId = Context.Session.GetInt32("MemberId") ?? 0;
    var isStaff = memberRole == "hr" || memberRole == "manager" || memberRole == "director";
    var isHost = memberRole == "director"; // 🎯 只有最高主管是主持人，能開始/結束會議
    string staffLabel = memberRole switch
    {
        "director" => "最高主管",
        "manager" => "主管",
        "hr" => "人資",
        _ => "員工"
    };
    var displayName = isStaff ? staffLabel + "-" + memberName : "求職者-" + memberName;
    // 🎯 換成你自己申請的 JaaS AppID（原本那組是別人的示範帳號，難怪一直卡在驗證失敗）
    var jaasTenantId = "vpaas-magic-cookie-c12aeb6abc7a4349bc799bb8cb31436a";
    var jitsiDomain = "8x8.vc";
    var jitsiRoom = jaasTenantId + "/" + room.JitsiRoomName;
    var encodedName = Uri.EscapeDataString(displayName);

    // 🎯 簽發這次進場要用的 JWT：只有 director 拿到 moderator=true
    var jitsiJwt = JaasJwt.GenerateToken(room.JitsiRoomName, sessionMemberId.ToString(), displayName, isHost);
}
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>面試會議 - @room.RoomName</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0
        }

        html, body {
            height: 100%;
            background: #0d1117;
            font-family: 'Segoe UI',sans-serif;
            color: #e6edf3;
            display: flex;
            flex-direction: column;
            overflow: hidden
        }

        .topbar {
            height: 50px;
            background: #161b22;
            border-bottom: 1px solid #30363d;
            display: flex;
            align-items: center;
            padding: 0 12px;
            gap: 8px;
            flex-shrink: 0;
            z-index: 10
        }

        .room-name {
            font-weight: 700;
            font-size: 13px;
            white-space: nowrap
        }

        .room-code {
            font-family: monospace;
            font-size: 11px;
            background: #21262d;
            color: #79c0ff;
            padding: 2px 8px;
            border-radius: 10px;
            cursor: pointer
        }

        .topbar-mid {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 6px
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0
        }

        .btn {
            padding: 5px 12px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 700;
            border: 1px solid transparent;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            white-space: nowrap;
            transition: all .15s;
            font-family: inherit;
            background: none
        }

        .btn-gray {
            background: #21262d;
            border-color: #30363d;
            color: #8b949e
        }

        .btn-green {
            background: #1a3d1a;
            border-color: #3fb950;
            color: #3fb950
        }

        .btn-orange {
            background: #3d2800;
            border-color: #f0883e;
            color: #f0883e
        }

        .btn-red {
            background: #3d1a1a;
            border-color: #f85149;
            color: #f85149
        }

        .user-badge {
            font-size: 11px;
            padding: 3px 9px;
            border-radius: 10px;
            background: #21262d;
            color: #8b949e
        }

        .rec-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            display: inline-block;
            background: #484f58
        }

        .banner {
            padding: 5px 16px;
            font-size: 12px;
            font-weight: 700;
            text-align: center;
            flex-shrink: 0
        }

            .banner.wait {
                background: #3d2800;
                color: #f0883e
            }

            .banner.live {
                background: #1a3d1a;
                color: #3fb950
            }

            .banner.done {
                background: #3d1a1a;
                color: #f85149
            }

        .main {
            flex: 1;
            display: flex;
            min-height: 0
        }

        .video-wrap {
            flex: 1;
            position: relative;
            min-width: 0;
            background: #000
        }

            .video-wrap iframe {
                width: 100%;
                height: 100%;
                border: none;
                position: absolute;
                inset: 0
            }

        .ai-panel {
            width: 240px;
            flex-shrink: 0;
            background: #161b22;
            border-left: 1px solid #30363d;
            display: flex;
            flex-direction: column;
            overflow: hidden
        }

        .ai-head {
            padding: 10px;
            border-bottom: 1px solid #30363d;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px
        }

        .avw {
            position: relative;
            width: 66px;
            height: 66px
        }

        .sring {
            position: absolute;
            inset: -5px;
            border-radius: 50%;
            border: 2.5px solid #3fb950;
            opacity: 0;
            transition: opacity .3s
        }

            .sring.on {
                opacity: 1;
                animation: rp 1s ease-in-out infinite
            }

        @@keyframes rp {
            0%, 100% {
                transform: scale(1);
                opacity: .9
            }

            50% {
                transform: scale(1.07);
                opacity: .5
            }
        }

        .ai-svg {
            width: 66px;
            height: 66px;
            border-radius: 50%;
            border: 2px solid #30363d
        }

        .ai-nm {
            font-size: 13px;
            font-weight: 700
        }

        .ai-rl {
            font-size: 10px;
            color: #8b949e
        }

        .ai-st {
            font-size: 10px;
            padding: 2px 8px;
            border-radius: 10px;
            font-weight: 600
        }

            .ai-st.wa {
                background: #3d2800;
                color: #f0883e
            }

            .ai-st.li {
                background: #1a3d1a;
                color: #3fb950
            }

            .ai-st.sp {
                background: #1a2d3d;
                color: #79c0ff
            }

            .ai-st.th {
                background: #3d2d00;
                color: #d29922
            }

        .ai-body {
            flex: 1;
            display: flex;
            flex-direction: column;
            padding: 8px;
            gap: 7px;
            overflow-y: auto
        }

        .ai-msg {
            background: #21262d;
            border-radius: 8px;
            padding: 10px;
            font-size: 11px;
            line-height: 1.6;
            color: #c9d1d9;
            min-height: 44px
        }

        .tdot {
            display: inline-block;
            width: 4px;
            height: 4px;
            border-radius: 50%;
            background: #79c0ff;
            margin: 0 1.5px;
            animation: tdot 1.2s ease-in-out infinite
        }

            .tdot:nth-child(2) {
                animation-delay: .2s
            }

            .tdot:nth-child(3) {
                animation-delay: .4s
            }

        @@keyframes tdot {
            0%, 80%, 100% {
                transform: translateY(0)
            }

            40% {
                transform: translateY(-4px)
            }
        }

        .si-wrap {
            background: #0d1117;
            border-radius: 6px;
            padding: 7px
        }

        .si-lbl {
            font-size: 9px;
            color: #484f58;
            margin-bottom: 3px
        }

        .si-bar {
            height: 3px;
            background: #21262d;
            border-radius: 2px;
            overflow: hidden
        }

        .si-fill {
            height: 100%;
            width: 0%;
            background: #388bfd;
            transition: width 1s linear;
            border-radius: 2px
        }

            .si-fill.w {
                background: #d29922
            }

            .si-fill.h {
                background: #f85149
            }
        /* 彈跳視窗 */
        .modal-bg {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.78);
            z-index: 9998;
            display: none;
            align-items: center;
            justify-content: center
        }

            .modal-bg.show {
                display: flex
            }

        .modal-box {
            background: #161b22;
            border: 1px solid #30363d;
            border-radius: 16px;
            padding: 32px 36px;
            text-align: center;
            max-width: 440px;
            width: 90%
        }

            .modal-box .m-icon {
                font-size: 46px;
                margin-bottom: 12px
            }

            .modal-box h3 {
                font-size: 18px;
                font-weight: 700;
                margin-bottom: 10px
            }

            .modal-box p {
                font-size: 13px;
                color: #8b949e;
                line-height: 1.6;
                margin-bottom: 20px
            }

        .m-acts {
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap
        }
        /* 主管下載畫面 */
        .ended-screen {
            position: fixed;
            inset: 0;
            background: #0d1117;
            z-index: 9999;
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 14px
        }

            .ended-screen.show {
                display: flex
            }

            .ended-screen h2 {
                font-size: 20px;
                font-weight: 700
            }

        .dl-items {
            display: flex;
            flex-direction: column;
            gap: 7px;
            margin-top: 6px;
            min-width: 300px
        }

        .dl-item {
            font-size: 12px;
            padding: 8px 14px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 8px
        }

            .dl-item.ok {
                background: #1a3d1a;
                color: #3fb950
            }

            .dl-item.ng {
                background: #3d1a1a;
                color: #f85149
            }

            .dl-item.wait {
                background: #3d2800;
                color: #d29922
            }
    </style>
</head>
<body>

    <div class="topbar">
        <div class="room-name">🎥 @Html.Raw(room.RoomName)</div>
        <span class="room-code" onclick="copyCode()" title="點擊複製">@room.JitsiRoomName</span>
        <span class="room-code" id="scheduledAtDisplay" title="預計面試時間">
            🕒 @(room.ScheduledAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "未設定時間")
        </span>
        <div class="topbar-mid">
            <span class="btn btn-gray">
                <span class="rec-dot" id="recDot"></span>
                <span id="recTxt">等待開始</span>
            </span>
            @if (isHost)
            {
                <button class="btn btn-green" id="startBtn" onclick="hostStart()">▶ 開始會議</button>
                <button class="btn btn-orange" id="endBtn" onclick="showEndConfirm()" style="display:none">⏹ 結束會議</button>
            }
        </div>
        <div class="topbar-right">
            <span class="user-badge">👤 @Html.Raw(displayName)</span>
            <button class="btn btn-gray" onclick="copyCode()">複製代碼</button>
        </div>
    </div>

    <div class="banner wait" id="banner">⏳ 等待主管開始會議...</div>

    @if (isHost)
    {
        <div id="pendingPanel" style="display:none; background:#fffaf0; border-bottom:1px solid #f6d998; padding:10px 20px;">
            <div style="font-size:13px; font-weight:700; color:#b7791f; margin-bottom:6px;">⏳ 有人正在候審，等你同意才能進入：</div>
            <div id="pendingList"></div>
        </div>
    }

    <div class="main">
        <div class="video-wrap" id="videoWrap">
            <div id="jitsi-container" style="width:100%;height:100%"></div>
        </div>
    </div>

    <!-- 確認結束 -->
    <div class="modal-bg" id="endModal">
        <div class="modal-box">
            <div class="m-icon">⏹</div>
            <h3>確認結束會議</h3>
            <p>結束後，主管端將自動下載錄音與分析報告，所有人的分頁將自動關閉。</p>
            <div class="m-acts">
                <button class="btn btn-red" onclick="hostEndExecute()">確認結束</button>
                <button class="btn btn-gray" onclick="document.getElementById('endModal').classList.remove('show')">取消</button>
            </div>
        </div>
    </div>

    <!-- 會議尚未開始（求職者看到） -->
    <div class="modal-bg" id="notStartedModal">
        <div class="modal-box">
            <div class="m-icon">⏳</div>
            <h3>會議尚未開始</h3>
            <p>請稍後再試，等待主管開始會議後即可進行。<br>頁面會自動偵測，無需重新整理。</p>
            <div class="m-acts">
                <button class="btn btn-gray" onclick="document.getElementById('notStartedModal').classList.remove('show')">我知道了</button>
            </div>
        </div>
    </div>

    <!-- 主管端：下載畫面（求職者只看到空白後關閉） -->
    <div class="ended-screen" id="endedScreen">
        <div style="font-size:44px">✅</div>
        <h2 id="endTitle">面試已結束</h2>
        <p style="color:#8b949e;font-size:12px" id="endSubtitle">正在處理...</p>
        <div class="dl-items" id="dlItems"></div>
        <button class="btn btn-gray" onclick="window.location.href='/Interview/Index'" style="margin-top:14px;display:none" id="backBtn">← 返回面試管理</button>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/fix-webm-duration@1.0.6/fix-webm-duration.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script src="https://8x8.vc/vpaas-magic-cookie-c12aeb6abc7a4349bc799bb8cb31436a/external_api.js"></script>
    <script>
        // ══════════════════════════════════
        //  設定
        // ══════════════════════════════════
        const IS_STAFF   = @(isStaff ? "true" : "false");
        const IS_HOST    = @(isHost ? "true" : "false");
        const MY_NAME    = "@Html.Raw(displayName.Replace("\"", "\\\""))";
        const ROOM_CODE  = "@room.JitsiRoomName";
        const ALREADY_IN_PROGRESS = @(room.MeetingStatus == "InProgress" ? "true" : "false");
        const JITSI_ROOM = "@jitsiRoom";
        const JITSI_DOMAIN = "@jitsiDomain";
        const JITSI_JWT = "@jitsiJwt";
        const SIL_SEC    = 22;  // 冷場觸發秒數

        // ══════════════════════════════════
        //  狀態
        // ══════════════════════════════════
        let started = false, ended = false;
        let silT = 0, isSp = false;
        let audioStream = null;
        let recognition = null;
        let trxLines = [];
        let lastSpeechMs = 0;
        let recentSpeech = [];
        let silInterval = null;

        // ══════════════════════════════════
        //  SignalR
        // ══════════════════════════════════
        const hub = new signalR.HubConnectionBuilder()
            .withUrl("/meetingHub")
            .withAutomaticReconnect()
            .build();

        // 🎯 重要修正：斷線重連後，之前用 JoinRoom 加入的群組會消失，一定要重新加入，
        //    不然主持人開始會議的廣播會收不到（卡在等待畫面不會動）
        hub.onreconnected(() => {
            hub.invoke("JoinRoom", ROOM_CODE).catch(() => {});
        });

        hub.on("MeetingStarted", () => { if (!started) onMeetingStart(); });
        hub.on("MeetingEnded",   () => { if (!ended)   onMeetingEnd(); });

        // 🎯 已移除：原本靠 SignalR 的 TranscriptReceived 事件接收別人講話的內容併進自己這份，
        //    但這個機制不可靠（長時間連線容易悄悄失效），改成每個人各自把自己聽到的內容直接送到伺服器，
        //    由伺服器合併，不再依賴任何人轉傳。詳見 submitMyTranscript() 函式。

        // 🎯 最高主管改了面試時間，正在這個房間頁面等待的人（含主持人自己）立刻收到通知並更新畫面
        hub.on("ScheduledAtChanged", (newTimeText) => {
            const el = document.getElementById('scheduledAtDisplay');
            if (el) el.textContent = '🕒 ' + newTimeText;
            showMsg('⏰ 主持人已更改面試時間，新的時間是：' + newTimeText);
            alert('面試時間已更新為：' + newTimeText);
        });

        // 冷場同步：主管廣播給所有人「有聲音了」
        hub.on("SpeechDetected", () => {
            lastSpeechMs = Date.now();
            silT = 0; setSilBar(0);
            if (!isSp) setSt('li', '👂 聆聽中');
        });

        async function startHub() {
            try {
                await hub.start();
                await hub.invoke("JoinRoom", ROOM_CODE);
            } catch (e) {
                console.warn("SignalR 失敗，localStorage fallback");
                setInterval(() => {
                    const s = localStorage.getItem("meet_" + ROOM_CODE);
                    if (!started && s === "started") onMeetingStart();
                    if (!ended   && s === "ended")   onMeetingEnd();
                }, 1500);
            }
        }
        startHub();

        // 🎯 保底輪詢：不管 SignalR 廣播這次有沒有送達（長時間閒置等待時 SignalR 群組可能悄悄失效），
        //    每 4 秒主動問一次伺服器「會議現在到底是什麼狀態」，用真實資料庫狀態校正畫面，
        //    避免整個「開始/結束會議」的即時性完全依賴單一條 WebSocket 廣播是否成功送達
        setInterval(async () => {
            if (started && ended) return; // 都結束了就不用再問
            try {
                const res = await fetch('/Room/GetMeetingStatus?code=' + encodeURIComponent(ROOM_CODE));
                const d = await res.json();
                if (!started && d.meetingStatus === 'InProgress') onMeetingStart();
                if (!ended && d.meetingStatus === 'Ended') {
                    if (!started) onMeetingStart(); // 保險：萬一連「開始」都沒同步到，先補上再結束
                    onMeetingEnd();
                }
            } catch (e) { /* 輪詢失敗就等下一次，不用特別處理 */ }
        }, 4000);

        // 🎯 候審室機制：最高主管每隔幾秒問一次「現在有誰在候審」，有的話就顯示同意/拒絕按鈕
        if (IS_HOST) {
            async function pollPending() {
                if (ended) return;
                try {
                    const res = await fetch('/Room/GetPendingParticipants?code=' + encodeURIComponent(ROOM_CODE));
                    const list = await res.json();
                    const panel = document.getElementById('pendingPanel');
                    const box = document.getElementById('pendingList');
                    if (list.length === 0) {
                        panel.style.display = 'none';
                    } else {
                        panel.style.display = 'block';
                        box.innerHTML = list.map(p => `
                            <div style="display:flex; align-items:center; gap:10px; padding:4px 0; font-size:13px;">
                                <span>${p.name}（${p.role === 'Jobseeker' ? '求職者' : p.role === 'Manager' ? '部門主管' : p.role}）</span>
                                <button onclick="admitParticipant(${p.id}, true)" style="background:#2c7a7b;color:#fff;border:none;border-radius:4px;padding:3px 10px;cursor:pointer;font-size:12px;">同意</button>
                                <button onclick="admitParticipant(${p.id}, false)" style="background:#fff;color:#c0392b;border:1px solid #c0392b;border-radius:4px;padding:3px 10px;cursor:pointer;font-size:12px;">拒絕</button>
                            </div>
                        `).join('');
                    }
                } catch (e) { /* 輪詢失敗就等下一次 */ }
                setTimeout(pollPending, 3000);
            }
            pollPending();

            window.admitParticipant = async function (participantId, approve) {
                try {
                    await fetch('/Room/AdmitParticipant', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: 'participantId=' + participantId + '&approve=' + approve
                    });
                    pollPending(); // 立刻刷新一次名單
                } catch (e) { alert('操作失敗，請稍後再試'); }
            };
        }

        // ══════════════════════════════════
        //  主管操作
        // ══════════════════════════════════
        async function hostStart() {
            try { await hub.invoke("StartMeeting", ROOM_CODE); }
            catch { localStorage.setItem("meet_" + ROOM_CODE, "started"); onMeetingStart(); }
        }

        function showEndConfirm() {
            document.getElementById('endModal').classList.add('show');
        }

        async function hostEndExecute() {
            document.getElementById('endModal').classList.remove('show');
            try { await hub.invoke("EndMeeting", ROOM_CODE); }
            catch { localStorage.setItem("meet_" + ROOM_CODE, "ended"); onMeetingEnd(); }
        }

        // ══════════════════════════════════
        //  會議開始
        // ══════════════════════════════════
        function onMeetingStart() {
            if (started) return;
            started = true;

            // 🎯 修正：麥克風容易被 Jitsi 搶走獨佔權，導致語音辨識完全抓不到聲音（逐字稿整場空白）。
            //    改成先讓語音辨識/錄音去搶麥克風，搶到之後才連 Jitsi，提高語音辨識搶到麥克風的機率。
            //    這是瀏覽器/作業系統層級的裝置獨占限制，無法 100% 保證解決，需要實測確認。
            initAudio().then(() => {
                initSTT();
                startSilenceDetect();

                // 這裡才是真正連線進 Jitsi 視訊會議的時機——大家（含主持人自己）
                // 收到「會議開始」廣播的當下才一起連線，計時器才會是共同、從 0 起算的
                // 非主持人延遲一點點再連線，讓主持人的連線先把會議室在 Jitsi 那邊真的建立起來，
                // 不然求職者/主管的連線有時候會比主持人早一步，變成「conference not found」連不進去
                if (IS_HOST) {
                    initJitsi();
                } else {
                    setTimeout(initJitsi, 2000);
                }
            });

            document.getElementById('notStartedModal').classList.remove('show');

            const b = document.getElementById('banner');
            b.className = 'banner live';
            b.textContent = '🔴 會議進行中';

            if (IS_HOST) {
                document.getElementById('startBtn').style.display = 'none';
                document.getElementById('endBtn').style.display = '';
            }

            document.getElementById('recDot').style.background = '#f85149';
            document.getElementById('recTxt').textContent = '錄音中';
            setSt('li', '👂 聆聽中');
            showMsg('會議已開始。我會在冷場時適時提問。');
            lastSpeechMs = Date.now(); // 會議開始當下不算冷場
        }

        // ══════════════════════════════════
        //  會議結束
        // ══════════════════════════════════
        async function onMeetingEnd() {
            if (ended) return;
            ended = true;

            if (window.speechSynthesis) window.speechSynthesis.cancel();
            isSp = false;
            if (recognition) { try { recognition.stop(); } catch {} }
            if (silInterval) clearInterval(silInterval);

            setSt('wa', '✅ 面試結束');
            showMsg('面試已結束，感謝所有人的參與！');

            const b = document.getElementById('banner');
            b.className = 'banner done';
            b.textContent = '🔒 面試已結束';

            if (IS_HOST) {
                // 🎯 只有主持人（最高主管）需要負責逐字稿/AI分析存檔——這件事整場面試只該做一次，
                //    不能每個在場的主管都各自觸發一次（會變成大家搶著存、甚至重複呼叫 Gemini API）
                showEndedScreen();
            } else if (IS_STAFF) {
                // 部門主管（不是主持人）：送出自己聽到的片段+音檔後，跟求職者一樣直接導回列表
                //    🎯 要等音檔真的送完（Gemini 轉錄需要幾秒到幾十秒），不能提早導頁把請求中斷掉
                submitMyTranscript();
                b.textContent = '🔒 面試已結束，正在送出逐字稿內容...';
                await submitMyAudioTranscript();
                window.location.href = '/Interview/Index';
            } else {
                // ✅ 求職者：送出自己聽到的片段+音檔後，回到應徵管理頁面
                submitMyTranscript();
                b.textContent = '🔒 面試已結束，正在送出逐字稿內容...';
                await submitMyAudioTranscript();
                window.location.href = '/Member/Application';
            }
        }

        // ══════════════════════════════════
        //  麥克風（給語音辨識/冷場偵測用）
        //  🎯 錄影不再由主管的瀏覽器螢幕分享負責——已經改成 AI 面試官在伺服器端用 Playwright
        //     真的加入 Jitsi 會議室、直接錄下它自己看到的畫面（Jitsi 預設就是「目前誰在說話就放大顯示，
        //     其他人縮圖排在旁邊」的排版），不再受任何一位真人視窗縮放/被蓋住/切分頁影響，
        //     主管也不用再被瀏覽器跳出來要求「選擇要分享的畫面」
        // ══════════════════════════════════
        let myAudioRecorder = null;
        let myAudioChunks = [];

        async function initAudio() {
            try {
                audioStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
                console.log('[initAudio] 成功取得麥克風（' + MY_NAME + '）');

                // 🎯 逐字稿改用這個當主要來源：整場錄下自己的麥克風音檔，結束時送給 Gemini 轉文字，
                //    不再依賴瀏覽器原生 SpeechRecognition（已證實會被 Jitsi 搶走麥克風獨佔權，
                //    大部分人只會收到 no-speech，整場話完全沒被記錄下來）
                try {
                    const mimeCandidates = ['audio/webm;codecs=opus', 'audio/webm', 'audio/ogg'];
                    let mime = '';
                    for (const m of mimeCandidates) { if (MediaRecorder.isTypeSupported(m)) { mime = m; break; } }
                    myAudioChunks = [];
                    myAudioRecorder = new MediaRecorder(audioStream, mime ? { mimeType: mime } : {});
                    myAudioRecorder.ondataavailable = e => { if (e.data && e.data.size > 0) myAudioChunks.push(e.data); };
                    myAudioRecorder.start(1000);
                    console.log('[initAudio] 已開始錄製自己的麥克風音檔（' + MY_NAME + '）');
                } catch (e) {
                    console.warn('[initAudio] 啟動錄音失敗：' + e.message + '（' + MY_NAME + '）');
                }
            } catch (e) {
                console.warn('[initAudio] 取得麥克風失敗：' + e.message + '（' + MY_NAME + '）');
                audioStream = null;
            }
        }

        // 🎯 停止錄音、把整段音檔送給伺服器做語音轉文字（取代不可靠的瀏覽器 SpeechRecognition）
        //    要用 await 等它做完，不能像 submitMyTranscript() 那樣用 sendBeacon（音檔太大，sendBeacon 不適合傳大檔案）
        async function submitMyAudioTranscript() {
            if (!myAudioRecorder || myAudioRecorder.state === 'inactive') return;

            const stopped = new Promise(resolve => { myAudioRecorder.onstop = resolve; });
            try { myAudioRecorder.stop(); } catch (e) { return; }
            await stopped;

            if (myAudioChunks.length === 0) return;

            try {
                const blob = new Blob(myAudioChunks, { type: myAudioRecorder.mimeType || 'audio/webm' });
                const fd = new FormData();
                fd.append('audio', blob, 'audio.webm');
                const url = '/Room/SubmitAudioTranscript?roomCode=' + encodeURIComponent(ROOM_CODE) + '&speakerName=' + encodeURIComponent(MY_NAME);
                await fetch(url, { method: 'POST', body: fd });
                console.log('[submitMyAudioTranscript] 音檔已送出（' + MY_NAME + '）');
            } catch (e) {
                console.warn('[submitMyAudioTranscript] 送出失敗：' + e.message + '（' + MY_NAME + '）');
            }
        }

        // ══════════════════════════════════
        //  STT — 每個人偵測自己的聲音，廣播給全場
        //  逐字稿在主管端整合（主管會看到所有人的聲音）
        // ══════════════════════════════════
        function initSTT() {
            const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SR) {
                console.warn('瀏覽器不支援 SpeechRecognition（建議用 Chrome）');
                return;
            }

            recognition = new SR();
            recognition.lang = 'zh-TW';
            recognition.continuous = true;
            recognition.interimResults = true;

            recognition.onresult = e => {
                console.log('[STT] onresult 觸發，收到', e.results.length - e.resultIndex, '筆結果');
                for (let i = e.resultIndex; i < e.results.length; i++) {
                    if (e.results[i].isFinal) {
                        const txt = e.results[i][0].transcript.trim();
                        if (txt.length > 1) {
                            // ✅ 所有角色都記錄自己說的話
                            const now = new Date().toLocaleTimeString('zh-TW',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
                            trxLines.push({ sp: MY_NAME, tx: txt, time: now });
                            recentSpeech.push({ name: MY_NAME, text: txt });
                            if (recentSpeech.length > 6) recentSpeech.shift();

                            // 🎯 不再用 SignalR 廣播給其他人（不可靠），本機先累積，離開/結束時再一次送去伺服器
                            try { hub.invoke('BroadcastSpeech', ROOM_CODE); } catch {}
                        }
                    }
                    // 中間結果也重置冷場
                    lastSpeechMs = Date.now();
                    silT = 0; setSilBar(0);
                }
            };
            recognition.onstart = () => {
                console.log('[STT] recognition 已啟動，正在聆聽（' + MY_NAME + '）');
            };
            recognition.onerror = e => {
                // 🎯 補完整：之前只記錄 not-allowed，其他錯誤類型完全沒有記錄，
                //    導致「到底為什麼沒抓到聲音」查不出原因。現在全部錯誤類型都印出來，
                //    常見的有：not-allowed（權限被拒）、audio-capture（抓不到麥克風裝置，
                //    很可能就是被 Jitsi 佔用）、no-speech（一段時間沒偵測到語音，通常會自動重啟不用擔心）、
                //    network（網路問題）
                console.warn('[STT] onerror：' + e.error + '（' + MY_NAME + '）');
            };
            recognition.onend = () => {
                if (!ended && !isSp)
                    setTimeout(() => { try { recognition.start(); } catch {} }, 500);
            };
            try { recognition.start(); } catch(e) {
                console.warn('STT start 失敗：', e.message);
            }
        }

        // ══════════════════════════════════
        //  冷場偵測（基於音量 + SignalR 同步）
        // ══════════════════════════════════
        function startSilenceDetect() {
            if (audioStream) {
                const ac = new (window.AudioContext || window.webkitAudioContext)();
                const an = ac.createAnalyser(); an.fftSize = 256;
                ac.createMediaStreamSource(audioStream).connect(an);
                const buf = new Uint8Array(an.frequencyBinCount);

                silInterval = setInterval(() => {
                    if (!started || ended || isSp) { setSilBar(0); return; }
                    an.getByteFrequencyData(buf);
                    const avg = buf.reduce((a,b)=>a+b,0)/buf.length;
                    if (avg > 8) {
                        lastSpeechMs = Date.now();
                        silT = 0; setSilBar(0);
                        setSt('li','👂 聆聽中');
                        try { hub.invoke("BroadcastSpeech", ROOM_CODE); } catch {}
                    } else {
                        const secSince = (Date.now() - lastSpeechMs) / 1000;
                        const pct = Math.min((secSince / SIL_SEC) * 100, 100);
                        setSilBar(pct);
                        if (secSince >= SIL_SEC) { lastSpeechMs = Date.now(); triggerAI(); }
                    }
                }, 800);
            } else {
                // 無麥克風 fallback
                silInterval = setInterval(() => {
                    if (!started || ended || isSp) return;
                    const secSince = (Date.now() - lastSpeechMs) / 1000;
                    setSilBar(Math.min((secSince / SIL_SEC) * 100, 100));
                    if (secSince >= SIL_SEC) { lastSpeechMs = Date.now(); triggerAI(); }
                }, 800);
            }
        }

        // ══════════════════════════════════
        //  AI 面試官
        // ══════════════════════════════════
        const FQ = [
            "現在安靜了一下，請問有人想補充什麼嗎？",
            "說到這裡，有沒有具體的例子可以分享？",
            "好，我想多了解一下你的工作方式？",
            "你認為自己最大的優點是什麼？",
            "如果加入我們，你最想在哪個方面發揮？",
            "你有帶領過團隊的經驗嗎？",
            "遇到工作困難，你通常怎麼處理？",
            "你對這份職位有什麼期待？",
            "其他人有想補充的嗎？",
            "有沒有想問我們的問題？"
        ];
        let fqIdx = 0;
        function getFQ() { return FQ[fqIdx++ % FQ.length]; }

        async function triggerAI() {
            if (isSp || ended || !started) return;
            if ((Date.now() - lastSpeechMs) < 3000) return;

            setSt('th','💭 思考中...');
            const ctx = recentSpeech.slice(-3).map(s=>`${s.name}：${s.text}`).join('；') || "面試進行中";
            const prompt = `你是AI面試官，協助主持「@room.RoomName」面試。最近對話：${ctx}。現在出現冷場（${SIL_SEC}秒無人說話）。請說一句自然的問題或打破冷場的話，不超過28字，直接說，不加引號或前綴。`;

            let q = null;
            try {
                const r = await fetch('/Claude/Ask', {
                    method:'POST', headers:{'Content-Type':'application/json'},
                    body: JSON.stringify({ prompt, system:"你是台灣企業面試主管，說繁體中文，語氣自然。", maxTokens:80 })
                });
                if (r.ok) { const d = await r.json(); if (d.text?.length > 3) q = d.text.trim(); }
            } catch {}

            if (!q) q = getFQ();
            aiSpeak(q);
        }

        function aiSpeak(text) {
            if (isSp || ended || !started) return;

            // 🐛 這輪新增：以前這裡只有 window.speechSynthesis，只有「觸發的這個人自己的瀏覽器」聽得到，
            //    不會真的傳到會議室裡讓其他人聽到。改成同時呼叫伺服器，讓 AI 面試官這個真正的 Jitsi
            //    參與者（透過 Simli 虛擬人）把話說出來，其他人才聽得到。不擋住畫面上的文字顯示邏輯，
            //    語音合成需要幾秒鐘，用背景送出就好，不用等它回應。
            fetch('/Room/AiSpeak', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'roomCode=' + encodeURIComponent(ROOM_CODE) + '&text=' + encodeURIComponent(text)
            }).catch(() => {});

            if (!window.speechSynthesis) { showMsg(text); return; }

            window.speechSynthesis.cancel();
            isSp = true; silT = 0;
            if (recognition) { try { recognition.stop(); } catch {} }

            setSt('sp','🗣️ 說話中'); setRing(true); showDots();

            const u = new SpeechSynthesisUtterance(text);
            const vs = window.speechSynthesis.getVoices();
            const zh = vs.find(v=>v.lang?.startsWith('zh')) || vs[0];
            if (zh) u.voice = zh;
            u.lang='zh-TW'; u.rate=0.85; u.pitch=1; u.volume=1;

            u.onstart = () => {
                showMsg(text);
                if (IS_STAFF) {
                    const now = new Date().toLocaleTimeString('zh-TW',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
                    trxLines.push({ sp:'AI 面試官', tx:text, time:now });
                }
            };
            u.onend = u.onerror = () => {
                isSp = false; lastSpeechMs = Date.now();
                setSt('li','👂 聆聽中'); setRing(false);
                if (!ended && recognition)
                    setTimeout(()=>{ try{ recognition.start(); }catch{} }, 400);
            };
            setTimeout(()=>window.speechSynthesis.speak(u), 150);
        }

        // ══════════════════════════════════
        //  主管端：下載畫面
        // ══════════════════════════════════
        // 🎯 把自己（這個瀏覽器）目前累積的逐字稿片段送到伺服器，不管求職者/主管/主持人，
        //    離開視訊或會議結束時都要呼叫一次，伺服器那邊會依收到時間把大家的片段合併成完整逐字稿
        //    用 sendBeacon（跟 markLeftBeacon 同一套手法），確保就算馬上要跳轉頁面也送得出去
        function submitMyTranscript() {
            if (trxLines.length === 0) return;
            const payload = JSON.stringify(trxLines.map(l => ({ sp: l.sp, tx: l.tx, time: l.time })));
            const url = '/Room/SubmitTranscriptChunk?roomCode=' + encodeURIComponent(ROOM_CODE);
            try {
                const blob = new Blob([payload], { type: 'application/json' });
                const ok = navigator.sendBeacon(url, blob);
                if (!ok) throw new Error('sendBeacon 排入失敗');
            } catch (e) {
                fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: payload
                }).catch(() => {});
            }
        }

        async function showEndedScreen() {
            const scr = document.getElementById('endedScreen');
            scr.classList.add('show');
            const dl = document.getElementById('dlItems');
            document.getElementById('endSubtitle').textContent = '正在等待所有人送出逐字稿片段...';
            dl.innerHTML = '';

            // 🎯 先送出主持人自己這段時間聽到的內容
            await submitMyTranscript();
            await submitMyAudioTranscript();

            // 🎯 給其他參與者足夠的緩衝時間，讓他們各自的音檔也送到伺服器、給 Gemini 轉錄完成——
            //    音訊轉文字比純文字傳輸慢很多（要等 Gemini API 處理），2.5 秒完全不夠，拉長到 20 秒
            document.getElementById('endSubtitle').textContent = '正在等待所有人的音檔轉錄完成，這步驟需要一點時間...';
            await new Promise(resolve => setTimeout(resolve, 20000));

            // 1. 逐字稿 —— 伺服器端合併這個房間所有人各自送來的片段（不再是主持人自己拼的內容）
            let mergedTranscript = '';
            let transcriptIsEmpty = true;
            {
                try {
                    const fd = new FormData();
                    fd.append('roomCode', ROOM_CODE);
                    const r = await fetch('/Room/SaveTranscript', { method: 'POST', body: fd });
                    const d = await r.json();
                    if (!r.ok || !d.success) {
                        dl.innerHTML += `<div class="dl-item ng">⚠️ 逐字稿儲存失敗（HTTP ${r.status}）：${d.message || '未知錯誤'}</div>`;
                    } else if (d.isEmpty) {
                        dl.innerHTML += `<div class="dl-item ng">⚠️ 逐字稿為空已存檔：${d.fileName}（請確認所有人的麥克風都有授權給瀏覽器）</div>`;
                    } else {
                        mergedTranscript = d.content || '';
                        transcriptIsEmpty = false;
                        dl.innerHTML += `<div class="dl-item ok">✅ 逐字稿已存至雲端「逐字稿」資料夾：${d.fileName}</div>`;
                    }
                } catch (e) {
                    dl.innerHTML += `<div class="dl-item ng">⚠️ 逐字稿儲存失敗：${e.message}</div>`;
                }
            }

            // 2. 錄影 —— 現在改由 AI 面試官在伺服器端（主持人結束會議的當下）錄好並上傳到 R2。
            //    🐛 這輪修正：這裡以前是完全不檢查就無條件顯示「已完成上傳」，
            //    導致 AI 面試官其實沒加入會議室、根本沒錄到東西的時候，畫面還是騙人地顯示成功。
            //    改成真的去問伺服器目前的狀態（AI 有沒有加入成功、錄影檔案存在與否），照實際結果顯示。
            {
                dl.innerHTML += `<div class="dl-item wait" id="recStatus">⏳ 正在確認錄影上傳狀態...</div>`;
                const recEl = document.getElementById('recStatus');
                try {
                    const r = await fetch('/Room/GetRecordingStatus?roomCode=' + encodeURIComponent(ROOM_CODE));
                    const d = await r.json();
                    if (r.ok && d.success && d.recordingFileName) {
                        recEl.className = 'dl-item ok';
                        recEl.textContent = `✅ 錄影已完成上傳，可在「面試評分」頁查看／下載：${d.recordingFileName}（.webm 可用 VLC 播放）`;
                    } else if (d.aiBotErrorMessage) {
                        recEl.className = 'dl-item ng';
                        recEl.textContent = `⚠️ AI 面試官沒有成功加入會議室，這次沒有錄影：${d.aiBotErrorMessage}`;
                    } else {
                        recEl.className = 'dl-item ng';
                        recEl.textContent = '⚠️ 目前查不到錄影檔案（可能還在後台處理中，稍後可到「面試評分」頁再確認一次）';
                    }
                } catch (e) {
                    recEl.className = 'dl-item ng';
                    recEl.textContent = '⚠️ 查詢錄影狀態失敗：' + e.message;
                }
            }

            // 3. AI 分析 —— 用伺服器合併後的完整逐字稿（不是只有主持人自己聽到的），伺服器端逐位求職者各自分析、各自存檔
            if (!transcriptIsEmpty && mergedTranscript.split('\n').length >= 2) {
                dl.innerHTML += `<div class="dl-item wait" id="aStatus">⏳ AI 分析中（依人數可能要一點時間）...</div>`;
                const aEl = document.getElementById('aStatus');
                try {
                    const fd = new FormData();
                    fd.append('roomCode', ROOM_CODE);
                    fd.append('transcript', mergedTranscript);
                    const r = await fetch('/Room/SaveAiAnalysis', { method: 'POST', body: fd });
                    const d = await r.json();
                    if (!r.ok || !d.success) {
                        aEl.className = 'dl-item ng';
                        aEl.textContent = `⚠️ AI 分析失敗（HTTP ${r.status}）：${d.message || '未知錯誤'}`;
                    } else if (!d.files || d.files.length === 0) {
                        aEl.className = 'dl-item ng';
                        aEl.textContent = '⚠️ 沒有找到求職者資料，跳過 AI 分析';
                    } else {
                        aEl.remove();
                        d.files.forEach(f => {
                            if (f.success) {
                                dl.innerHTML += `<div class="dl-item ok">✅ ${f.candidateName} 的分析報告已存至雲端「AI分析」資料夾：${f.fileName}</div>`;
                            } else {
                                dl.innerHTML += `<div class="dl-item ng">⚠️ ${f.candidateName} 的分析失敗：${f.message}</div>`;
                            }
                        });
                    }
                } catch (e) {
                    aEl.className = 'dl-item ng';
                    aEl.textContent = `⚠️ AI 分析失敗：${e.message}`;
                }
            } else {
                dl.innerHTML += `<div class="dl-item ng">⚠️ 逐字稿不足，跳過 AI 分析</div>`;
            }

            document.getElementById('endSubtitle').textContent = '所有檔案已儲存，正在返回面試管理列表...';

            // 🎯 不用再讓主管自己按「返回面試管理」，存檔一完成就直接導回列表
            setTimeout(() => { window.location.href = '/Interview/Index'; }, 1200);
        }

        async function runAnalysis() {
            const transcript = trxLines.map(l=>`[${l.time}] ${l.sp}：${l.tx}`).join('\n');
            const prompt = `以下是面試逐字稿，請分析每位求職者表現（繁體中文）：\n\n${transcript}\n\n請提供：1.求職者名單 2.每人：語氣表達、答題品質、評分(1-10)、錄取建議 3.整體摘要`;
            try {
                const r = await fetch('/Claude/Ask', {
                    method:'POST',
                    headers:{'Content-Type':'application/json'},
                    body: JSON.stringify({
                        prompt,
                        system: "你是專業人資顧問，說繁體中文，格式清晰條列。",
                        maxTokens: 2000
                    })
                });
                if (!r.ok) {
                    const err = await r.text();
                    console.error('AI 分析 HTTP 錯誤：', r.status, err);
                    return null;
                }
                const d = await r.json();
                return d.text || null;
            } catch(e) {
                console.error('AI 分析失敗：', e);
                return null;
            }
        }

        // ══════════════════════════════════
        //  工具
        // ══════════════════════════════════
        function dlFile(content, name, type) {
            const b = new Blob([content],{type});
            const u = URL.createObjectURL(b);
            const a = document.createElement('a'); a.href=u; a.download=name;
            document.body.appendChild(a); a.click(); document.body.removeChild(a);
            setTimeout(()=>URL.revokeObjectURL(u),5000);
        }
        function ts() { return new Date().toISOString().slice(0,16).replace('T','-'); }
        function setSt(cls,txt){ const e=document.getElementById('aiSt'); if (e) { e.className='ai-st '+cls; e.textContent=txt; } }
        function setRing(on){ document.getElementById('sring')?.classList.toggle('on',on); }
        function showDots(){ const e=document.getElementById('aiMsg'); if (e) e.innerHTML='<span class="tdot"></span><span class="tdot"></span><span class="tdot"></span>'; }
        function showMsg(t){ const e=document.getElementById('aiMsg'); if (e) e.innerHTML=t.replace(/\n/g,'<br>'); }
        function setSilBar(pct){
            const f=document.getElementById('siFill');
            if (f) {
                f.style.width=pct+'%';
                f.className='si-fill'+(pct>80?' h':pct>50?' w':'');
            }
            const lbl = document.getElementById('siLbl');
            if (lbl) lbl.textContent=pct>0?`冷場偵測 ${Math.round(pct)}%`:'冷場偵測';
        }
        function copyCode(){
            navigator.clipboard.writeText(ROOM_CODE).then(()=>{
                const t=document.createElement('div');
                t.textContent='✅ 已複製';
                t.style.cssText='position:fixed;top:60px;right:20px;background:#1a3d1a;color:#3fb950;padding:5px 12px;border-radius:8px;font-size:12px;font-weight:700;z-index:99999';
                document.body.appendChild(t); setTimeout(()=>t.remove(),2000);
            });
        }

        // ══════════════════════════════════
        //  Jitsi External API 初始化
        // ══════════════════════════════════
        let jitsiApi = null;

        // 🎯 用 sendBeacon 記錄離開時間，就算分頁被直接關掉、來不及跑完 fetch，瀏覽器也會確保這個請求送出去
        let leftBeaconSent = false;
        function markLeftBeacon() {
            if (leftBeaconSent) return;
            leftBeaconSent = true;
            try {
                const data = new URLSearchParams();
                data.append('code', ROOM_CODE);
                navigator.sendBeacon('/Room/MarkLeft', data);
            } catch {
                fetch('/Room/MarkLeft', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'code=' + encodeURIComponent(ROOM_CODE)
                }).catch(() => {});
            }
        }
        window.addEventListener('pagehide', () => { markLeftBeacon(); submitMyTranscript(); });
        window.addEventListener('beforeunload', markLeftBeacon);

        function initJitsi() {
            if (jitsiApi) return;
            if (typeof JitsiMeetExternalAPI === 'undefined') {
                console.error('Jitsi External API 尚未載入，2秒後重試');
                setTimeout(initJitsi, 2000);
                return;
            }

            jitsiApi = new JitsiMeetExternalAPI(JITSI_DOMAIN, {
                roomName:   JITSI_ROOM,
                jwt:        JITSI_JWT,
                parentNode: document.getElementById('jitsi-container'),
                width:      '100%',
                height:     '100%',
                userInfo: { displayName: MY_NAME },
                configOverwrite: {
                    prejoinPageEnabled:           false,
                    readOnlyName:                 true,
                    startWithAudioMuted:          false,
                    startWithVideoMuted:          false,
                    disableDeepLinking:           true,
                    enableNoAudioDetection:       false,
                    enableNoisyMicDetection:      false,
                    // ✅ 關閉大廳/主持人機制，任何人直接進入
                    lobby:                        { enableLobby: false },
                    securityUi:                   { hideLobbyButton: true, disableLobbyPassword: true },
                    // ✅ 完全關閉需要主持人的設定
                    requireDisplayName:           false,
                    enableWelcomePage:            false,
                    // ✅ 避免 5 分鐘限制：不使用嵌入模式的限制端點
                    p2p:                          { enabled: false },
                    toolbarButtons: IS_HOST
                        ? [
                            // 🎯 主持人不給原生「掛斷」按鈕，避免誤按只是自己離開視訊、卻沒有真的結束會議
                            //    主持人只能用畫面上方的「結束會議」按鈕，才會真正結束、寫入 EndAt、通知所有人
                            'microphone', 'camera', 'desktop', 'fullscreen',
                            'fodeviceselection', 'chat', 'settings',
                            'raisehand', 'videoquality', 'filmstrip', 'tileview', 'participants-pane'
                          ]
                        : [
                            'microphone', 'camera', 'desktop', 'fullscreen',
                            'fodeviceselection', 'hangup', 'chat', 'settings',
                            'raisehand', 'videoquality', 'filmstrip', 'tileview', 'participants-pane'
                          ]
                },
                interfaceConfigOverwrite: {
                    SHOW_JITSI_WATERMARK:             false,
                    SHOW_BRAND_WATERMARK:             false,
                    MOBILE_APP_PROMO:                 false,
                    DISABLE_TRANSCRIPTION_SUBTITLES:  true,
                    TOOLBAR_ALWAYS_VISIBLE:           true,
                    // ✅ 隱藏主持人相關 UI
                    SHOW_PROMOTIONAL_CLOSE_PAGE:      false,
                }
            });

            // 🎯 使用者自己按「掛斷」離開視訊（不是主持人結束會議），只影響自己，不影響會議本身
            //    求職者離開後導回應徵管理頁面；主管/主持人離開後導回面試管理列表（面試排程分頁）
            jitsiApi.addEventListener('readyToClose', () => {
                if (ended) return; // 如果是走「結束會議」流程，交給 showEndedScreen() 最後自己導頁，這裡不用重複處理
                submitMyTranscript(); // 🎯 中途自己離開也要送出目前為止聽到的內容，不然這段話會整個消失
                const goTo = !IS_STAFF ? '/Member/Application' : '/Interview/Index';
                submitMyAudioTranscript().finally(() => { window.location.href = goTo; });
            });

            // ✅ 使用者真的按下「加入會議」、實際進入 Jitsi 視訊房間時才觸發 —— 這時候才把 JoinedAt 寫進資料庫
            //    🎯 加上重試機制：這支 API 沒送到伺服器，JoinedAt 就永遠不會被記錄，
            //    之前這裡是完全靜默失敗（.catch(() => {})），部分人同步失敗查不出原因就是這裡造成的
            jitsiApi.addEventListener('videoConferenceJoined', e => {
                markJoinedWithRetry(3);
            });

            async function markJoinedWithRetry(retriesLeft) {
                try {
                    const r = await fetch('/Room/MarkJoined', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: 'code=' + encodeURIComponent(ROOM_CODE)
                    });
                    const d = await r.json().catch(() => ({}));
                    if (!r.ok || d.success === false) {
                        console.warn('[MarkJoined] 失敗 HTTP ' + r.status + '，剩餘重試次數：' + retriesLeft, d);
                        if (retriesLeft > 0) setTimeout(() => markJoinedWithRetry(retriesLeft - 1), 2000);
                    } else {
                        console.log('[MarkJoined] 成功');
                    }
                } catch (err) {
                    console.warn('[MarkJoined] 網路錯誤：' + err.message + '，剩餘重試次數：' + retriesLeft);
                    if (retriesLeft > 0) setTimeout(() => markJoinedWithRetry(retriesLeft - 1), 2000);
                }
            }

            // 🎯 使用者離開視訊（不管是自己按掛斷、還是斷線），記錄離開時間
            //    這只代表「他自己離開」，不會影響會議本身，會議只有主持人按「結束會議」才會真的結束
            jitsiApi.addEventListener('videoConferenceLeft', e => {
                markLeftBeacon();
            });

            // ✅ 監聽 Jitsi 的音訊事件，直接用來做冷場偵測（不需另外取麥克風）
            jitsiApi.addEventListener('audioMuteStatusChanged', e => {
                if (!e.muted) {
                    lastSpeechMs = Date.now(); silT = 0; setSilBar(0);
                    try { hub.invoke('BroadcastSpeech', ROOM_CODE); } catch {}
                }
            });

            // 監聽 Jitsi 的語音活動事件（誰在說話）
            jitsiApi.addEventListener('dominantSpeakerChanged', e => {
                lastSpeechMs = Date.now(); silT = 0; setSilBar(0);
                try { hub.invoke('BroadcastSpeech', ROOM_CODE); } catch {}
            });

            console.log('Jitsi External API 初始化成功');
        }

        // ══════════════════════════════════
        //  初始化
        // ══════════════════════════════════
        window.addEventListener('load', ()=>{
            if (window.speechSynthesis){
                window.speechSynthesis.getVoices();
                window.speechSynthesis.onvoiceschanged = ()=>window.speechSynthesis.getVoices();
            }

            // 🎯 只有「會議已經在進行中」才立即連線（遲到 / 重新整理頁面的情況）
            //    否則一律等主持人真的按下「開始會議」，收到廣播才連線 —— 這樣所有人的視訊時鐘才會一起從 0 開始算，
            //    而不是誰先載入頁面誰的計時器就先跑
            if (ALREADY_IN_PROGRESS) {
                started = true;
                initJitsi();
                const b = document.getElementById('banner');
                b.className = 'banner live';
                b.textContent = '🔴 會議進行中';
            } else if (!IS_HOST) {
                // 求職者/主管：等待主持人開始，800ms 沒收到通知就顯示提示
                setTimeout(()=>{
                    if (!started)
                        document.getElementById('notStartedModal').classList.add('show');
                }, 800);
            }
            // 主持人：什麼都不做，等自己按下「開始會議」才會連線視訊（見 onMeetingStart）
        });
    </script>
</body>
</html>
