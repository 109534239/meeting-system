@{
    var room = ViewBag.Room;
}

<style>
    html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        width: 100%;
        background: #202124;
        font-family: sans-serif;
        overflow: hidden;
    }

    .topbar {
        height: 60px;
        background: #2d2e30;
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 20px;
        box-sizing: border-box;
        position: relative;
        z-index: 10;
    }

    .room-info {
        font-size: 16px;
        font-weight: bold;
    }

    #meet {
        height: calc(100% - 60px);
        width: 100%;
    }

    /* 🚀 AI 面試官連線狀態提示標籤 */
    .bot-status {
        font-size: 13px;
        padding: 6px 14px;
        border-radius: 20px;
        background-color: #f39c12;
        color: white;
        font-weight: bold;
    }

    .bot-status.ready {
        background-color: #2ecc71;
    }
</style>

<div class="topbar">
    <div class="room-info">
        <span>房間名稱: @room.RoomName</span>
        <span style="color: #bcbcbc; margin-left: 15px; font-size:14px;">代碼: @room.JitsiRoomName</span>
    </div>
    <div>
        <span id="botStatusLabel" class="bot-status">🤖 正在呼叫 AI 面試官...</span>
    </div>
</div>

<div id="meet"></div>

<script src="https://8x8.vc/external_api.js"></script>
<script>
    // 🚀 修正對接：使用 8x8 雲端高速伺服器
    const domain = "8x8.vc"; 

    const options = {
        // 🌟 關鍵修正：將 magic-cookie 填入 tenant 屬性中
        tenant: "vpaas-magic-cookie-00203058b8f244a0a520be67d341b527",
        // 🌟 房間名稱保持純代碼，絕不要自己加斜線拼接
        roomName: "@room.JitsiRoomName",
        width: "100%",
        height: "100%",
        parentNode: document.getElementById('meet'),
        configOverwrite: {
            startWithAudioMuted: false,
            startWithVideoMuted: false,
            prejoinPageEnabled: false, // 跳過預檢畫面
            lobby: {
                enableLobby: false     // 關閉大廳隔離
            }
        },
        interfaceConfigOverwrite: {
            SHOW_JITSI_WATERMARK: false,
            SHOW_BRAND_WATERMARK: false
        },
        userInfo: {
            displayName: "求職者 (您)"
        }
    };

    // 掛載 Jitsi Iframe
    const api = new JitsiMeetExternalAPI(domain, options);

    console.log("網頁載入就緒，主動請求後端部署 AI 面試官...");

    // 觸發後端 Playwright 機器人進房
    fetch('/Room/TriggerBot?roomCode=@room.JitsiRoomName', {
        method: 'POST'
    })
    .then(response => response.json())
    .then(data => {
        const statusLabel = document.getElementById('botStatusLabel');
        if (data.success) {
            console.log("AI 面試官已成功抵達會議！");
            statusLabel.innerText = "🤖 AI 面試官已就位";
            statusLabel.classList.add('ready');
        } else {
            console.error("AI 面試官啟動失敗: " + data.message);
            statusLabel.innerText = "❌ AI 面試官連線失敗";
            statusLabel.style.backgroundColor = "#e74c3c";
        }
    })
    .catch(err => {
        console.error("發送進房觸發失敗:", err);
    });
</script>