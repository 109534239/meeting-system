@model InterviewProject.Models.FAQReport

@{
    ViewData["Title"] = "Q&A 回報詳細資料";
    var role = ViewBag.MemberRole?.ToString()?.ToLower();
    bool isHr = role == "hr";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/AdminFAQ.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Job_search.css" asp-append-version="true" />
}

<div class="page-header">
    <div class="page-header-inner">
        <h1>Q&A 回報詳細資料</h1>
        <p>FAQ Report Detail</p>
    </div>
</div>

<div class="faq-report-detail-wrap">

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-error">
            @TempData["Error"]
        </div>
    }

    <div class="report-detail-grid">

        @* ── 左側卡片：回報內容 ── *@
        <div class="report-card">

            <div class="detail-card-header">
                <h2>回報內容</h2>
                <p>Applicant Question</p>
            </div>

            <div class="field-item">
                <label class="field-label">姓名</label>
                <div class="field-input">@Model.Name</div>
            </div>

            <div class="field-item">
                <label class="field-label">電話</label>
                <div class="field-input">@Model.PhoneCountryCode @Model.Phone</div>
            </div>

            <div class="field-item">
                <label class="field-label">Email</label>
                <div class="field-input">
                    @(string.IsNullOrWhiteSpace(Model.Email) ? "-" : Model.Email)
                </div>
            </div>

            <div class="field-item">
                <label class="field-label">問題類別</label>
                <div class="field-input">@Model.Category</div>
            </div>

            <div class="field-item field-item--full">
                <label class="field-label">信件主旨</label>
                <div class="field-input">@Model.Subject</div>
            </div>

            <div class="field-item field-item--full">
                <label class="field-label">信件內容</label>
                <div class="report-content-box">@Model.Content</div>
            </div>

        </div>

        @* ── 右側卡片：處理資訊 ── *@
        <div class="report-card">

            <div class="detail-card-header">
                <h2>處理資訊</h2>
                <p>Internal Handling</p>
            </div>

            <div class="field-item">
                <label class="field-label">目前狀態</label>
                <div class="field-input">@Model.Status</div>
            </div>

            <div class="field-item">
                <label class="field-label">目前指派</label>
                <div class="field-input">
                    @(string.IsNullOrWhiteSpace(Model.AssignedRole) ? "HR" : Model.AssignedRole)
                </div>
            </div>

            <div class="field-item">
                <label class="field-label">送出時間</label>
                <div class="field-input">
                    @Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                </div>
            </div>

            <div class="field-item">
                <label class="field-label">回覆時間</label>
                <div class="field-input">
                    @(Model.RepliedAt?.ToString("yyyy/MM/dd HH:mm") ?? "-")
                </div>
            </div>

            @if (isHr)
            {
                @* ── HR：轉交主管 ── *@
                <form asp-action="TransferReport"
                      method="post"
                      class="field-item field-item--full report-inline-form">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="id" value="@Model.Id" />

                    <label class="field-label">轉交主管</label>

                    <select name="assignedRole" class="field-input">
                        <option value="">不轉交</option>
                        <option value="manager">部門主管 Manager</option>
                        <option value="director">部門最高主管 Director</option>
                    </select>

                    <button type="submit" class="btn-save btn-full">
                        轉交主管
                    </button>
                </form>
            }

            @* ── 回覆內容 ── *@
            <form asp-action="ReplyReport"
                  method="post"
                  class="field-item field-item--full report-inline-form">

                @Html.AntiForgeryToken()

                <input type="hidden" name="id" value="@Model.Id" />

                <label class="field-label">回覆內容</label>

                <textarea name="replyContent"
                          class="field-input field-textarea reply-textarea"
                          rows="6"
                          placeholder="請輸入要回覆給求職者的內容...">@Model.ReplyContent</textarea>

                <label class="field-label">內部備註</label>

                <textarea name="internalNote"
                          class="field-input internal-note-textarea"
                          rows="4"
                          placeholder="可填寫內部處理備註...">@Model.InternalNote</textarea>

                <div class="form-actions report-detail-actions">
                    <a asp-action="Index"
                       asp-route-tab="report"
                       class="btn-cancel">
                        返回 Q&A 回報
                    </a>

                    <button type="submit" class="btn-save">
                        儲存回覆
                    </button>
                </div>

            </form>

        </div>

    </div>

</div>