@model InterviewProject.Models.FAQReport

@{
    // 依回報者身份決定標題與返回時應停留在哪個分頁
    bool isJobseeker = Model.Role == "求職者";
    string pageTitle = isJobseeker ? "求職者回覆" : "訪客回覆";
    string backTab = isJobseeker ? "jobseeker" : "visitor";

    ViewData["Title"] = pageTitle;
}

@section Styles {
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/AdminFAQ.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Job_search.css" asp-append-version="true" />
}

<div class="page-header">
    <div class="page-header-inner">
        <h1>@pageTitle</h1>
    </div>
</div>

<div class="faq-report-detail-wrap">

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-error">
            @TempData["Error"]
        </div>
    }

    <div class="report-detail-grid" style="grid-template-columns: 1fr; justify-items: center;">

        <div class="report-card" style="width: 100%; max-width: 640px;">

            <div class="field-item">
                <label class="field-label">姓名</label>
                <div class="field-input">@Model.Name</div>
            </div>

            <div class="field-item">
                <label class="field-label">問題類別</label>
                <div class="field-input">@Model.Category</div>
            </div>

            <div class="field-item field-item--full">
                <label class="field-label">主旨</label>
                <div class="field-input">@Model.Subject</div>
            </div>

            <div class="field-item field-item--full">
                <label class="field-label">內容</label>
                <div class="report-content-box">@Model.Content</div>
            </div>

            <form asp-action="ReplyReport"
                  method="post"
                  class="field-item field-item--full report-inline-form">

                @Html.AntiForgeryToken()

                <input type="hidden" name="id" value="@Model.Id" />

                <label class="field-label">回覆內容</label>

                <textarea name="replyContent"
                          class="field-input field-textarea reply-textarea"
                          rows="6"
                          placeholder="請輸入要回覆的內容...">@Model.ReplyContent</textarea>

                <div class="form-actions report-detail-actions">
                    <a asp-action="Index"
                       asp-route-tab="@backTab"
                       class="btn-cancel">
                        返回
                    </a>

                    <button type="submit" class="btn-save">
                        送出
                    </button>
                </div>

            </form>

        </div>

    </div>

</div>
