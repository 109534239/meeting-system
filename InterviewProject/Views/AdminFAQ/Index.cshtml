@model IEnumerable<InterviewProject.Models.FAQ>
@using InterviewProject.Models

@{
    ViewData["Title"] = "求職Q&A管理";

    var visitorReports = ViewBag.VisitorReports as List<FAQReport> ?? new List<FAQReport>();
    var jobseekerReports = ViewBag.JobseekerReports as List<FAQReport> ?? new List<FAQReport>();

    string visitorStatus = ViewBag.VisitorStatus ?? "pending";
    string visitorSort = ViewBag.VisitorSort ?? "asc";
    string jobseekerStatus = ViewBag.JobseekerStatus ?? "pending";
    string jobseekerSort = ViewBag.JobseekerSort ?? "asc";

    int visitorPendingCount = ViewBag.VisitorPendingCount ?? 0;
    int jobseekerPendingCount = ViewBag.JobseekerPendingCount ?? 0;

    var departmentOptions = ViewBag.DepartmentOptions as List<string> ?? new List<string>();

    string role = ViewBag.MemberRole ?? "";
    bool isHr = role == "hr";
}

@{
    var currentTab = Context.Request.Query["tab"].ToString();

    if (string.IsNullOrEmpty(currentTab))
    {
        currentTab = isHr ? "faq" : "visitor";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/AdminFAQ.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Job_search.css" asp-append-version="true" />
    <style>
        .report-filter-bar {
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
            margin-bottom: 14px;
        }

        .report-filter-bar label {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 14px;
            color: #555;
        }

        .report-filter-bar select {
            padding: 6px 10px;
            border-radius: 6px;
            border: 1px solid #d0d0d0;
            font-size: 14px;
        }
    </style>
}

<!-- PAGE HEADER -->
<div class="page-header">
    <div class="page-header-inner">
        <h1>求職Q&A管理</h1>
        <p>FAQ & Report Management</p>
    </div>
</div>

<div class="faq-manage-wrap">

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">
            @TempData["Success"]
        </div>
    }

    @* ── Tab 切換區 ── *@
    <div class="faq-tabs">
        @if (isHr)
        {
            <button type="button"
                    class="faq-tab @(currentTab == "faq" ? "active" : "")"
                    data-tab="faq"
                    onclick="showFaqTab('faq')">
                FAQ 管理
            </button>
        }

        <button type="button"
                class="faq-tab @(currentTab == "visitor" ? "active" : "")"
                data-tab="visitor"
                onclick="showFaqTab('visitor')">
            訪客回覆
            <span class="tab-count">@visitorPendingCount</span>
        </button>

        <button type="button"
                class="faq-tab @(currentTab == "jobseeker" ? "active" : "")"
                data-tab="jobseeker"
                onclick="showFaqTab('jobseeker')">
            求職者回覆
            <span class="tab-count">@jobseekerPendingCount</span>
        </button>
    </div>

    @* ── FAQ 管理：僅 HR 顯示 ── *@
    @if (isHr)
    {
        <div id="faq-tab-content" class="faq-tab-content @(currentTab == "faq" ? "active" : "")">

            <!-- 工具列 -->
            <div class="faq-toolbar">
                <a asp-action="Create" class="btn-add">
                    ＋ 新增 FAQ
                </a>
            </div>

            <!-- FAQ Table -->
            <div class="faq-table">

                <div class="faq-table-head">
                    <div>排序</div>
                    <div>問題</div>
                    <div>狀態</div>
                    <div>操作</div>
                </div>

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <div class="faq-row">

                            <div>
                                @item.SortOrder
                            </div>

                            <div class="faq-title">
                                @item.Question
                            </div>

                            <div>
                                <button class="btn-toggle @(item.IsActive ? "active" : "inactive")"
                                        onclick="toggleActive(@item.Id,this)">
                                    @(item.IsActive ? "顯示中" : "已停用")
                                </button>
                            </div>

                            <div class="faq-actions">

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn-edit">
                                    編輯
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@item.Id"
                                      method="post"
                                      onsubmit="return confirm('確定刪除此 FAQ？')">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn-delete">
                                        刪除
                                    </button>

                                </form>

                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="faq-empty">
                        目前尚未建立任何 FAQ
                    </div>
                }

            </div>
        </div>
    }

    @* ── 訪客回覆 ── *@
    <div id="visitor-tab-content" class="faq-tab-content @(currentTab == "visitor" ? "active" : "")">

        <form method="get" class="report-filter-bar">
            <input type="hidden" name="tab" value="visitor" />
            <input type="hidden" name="jobseekerStatus" value="@jobseekerStatus" />
            <input type="hidden" name="jobseekerSort" value="@jobseekerSort" />

            <label>
                狀態：
                <select name="visitorStatus" onchange="this.form.submit()">
                    <option value="pending" selected="@(visitorStatus == "pending")">待處理</option>
                    <option value="replied" selected="@(visitorStatus == "replied")">已回覆</option>
                    <option value="all" selected="@(visitorStatus == "all")">全部</option>
                </select>
            </label>

            <label>
                排序：
                <select name="visitorSort" onchange="this.form.submit()">
                    <option value="asc" selected="@(visitorSort == "asc")">時間由舊到新</option>
                    <option value="desc" selected="@(visitorSort == "desc")">時間由新到舊</option>
                </select>
            </label>
        </form>

        <div class="faq-table">

            <div class="faq-table-head report-head">
                <div>時間</div>
                <div>姓名</div>
                <div>類別</div>
                <div>主旨</div>
                <div>狀態</div>
                <div>操作</div>
            </div>

            @if (visitorReports.Any())
            {
                foreach (var item in visitorReports)
                {
                    <div class="faq-row report-row">

                        <div>
                            @item.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                        </div>

                        <div class="faq-title">
                            @item.Name
                        </div>

                        <div>
                            @item.Category
                        </div>

                        <div class="faq-title">
                            @item.Subject
                        </div>

                        <div>
                            <span class="btn-toggle @(item.Status == "已回覆" ? "active" : "inactive")">
                                @item.Status
                            </span>
                        </div>

                        <div class="faq-actions">
                            <a asp-action="ReportDetail"
                               asp-route-id="@item.Id"
                               class="btn-edit">
                                回覆
                            </a>

                            <select name="department"
                                    class="dept-select"
                                    onchange="assignDepartment(@item.Id, this)">
                                <option value="" selected="@(string.IsNullOrWhiteSpace(item.Department) || item.Department == "人力資源")">選擇部門</option>
                                @foreach (var dept in departmentOptions)
                                {
                                    <option value="@dept" selected="@(item.Department == dept)">@dept</option>
                                }
                            </select>
                        </div>

                    </div>
                }
            }
            else
            {
                <div class="faq-empty">
                    目前沒有符合條件的訪客回報
                </div>
            }

        </div>

    </div>

    @* ── 求職者回覆 ── *@
    <div id="jobseeker-tab-content" class="faq-tab-content @(currentTab == "jobseeker" ? "active" : "")">

        <form method="get" class="report-filter-bar">
            <input type="hidden" name="tab" value="jobseeker" />
            <input type="hidden" name="visitorStatus" value="@visitorStatus" />
            <input type="hidden" name="visitorSort" value="@visitorSort" />

            <label>
                狀態：
                <select name="jobseekerStatus" onchange="this.form.submit()">
                    <option value="pending" selected="@(jobseekerStatus == "pending")">待處理</option>
                    <option value="replied" selected="@(jobseekerStatus == "replied")">已回覆</option>
                    <option value="all" selected="@(jobseekerStatus == "all")">全部</option>
                </select>
            </label>

            <label>
                排序：
                <select name="jobseekerSort" onchange="this.form.submit()">
                    <option value="asc" selected="@(jobseekerSort == "asc")">時間由舊到新</option>
                    <option value="desc" selected="@(jobseekerSort == "desc")">時間由新到舊</option>
                </select>
            </label>
        </form>

        <div class="faq-table">

            <div class="faq-table-head report-head">
                <div>時間</div>
                <div>姓名</div>
                <div>類別</div>
                <div>主旨</div>
                <div>狀態</div>
                <div>操作</div>
            </div>

            @if (jobseekerReports.Any())
            {
                foreach (var item in jobseekerReports)
                {
                    <div class="faq-row report-row">

                        <div>
                            @item.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                        </div>

                        <div class="faq-title">
                            @item.Name
                        </div>

                        <div>
                            @item.Category
                        </div>

                        <div class="faq-title">
                            @item.Subject
                        </div>

                        <div>
                            <span class="btn-toggle @(item.Status == "已回覆" ? "active" : "inactive")">
                                @item.Status
                            </span>
                        </div>

                        <div class="faq-actions">
                            <a asp-action="ReportDetail"
                               asp-route-id="@item.Id"
                               class="btn-edit">
                                回覆
                            </a>

                            <select name="department"
                                    class="dept-select"
                                    onchange="assignDepartment(@item.Id, this)">
                                <option value="" selected="@(string.IsNullOrWhiteSpace(item.Department) || item.Department == "人力資源")">選擇部門</option>
                                @foreach (var dept in departmentOptions)
                                {
                                    <option value="@dept" selected="@(item.Department == dept)">@dept</option>
                                }
                            </select>
                        </div>

                    </div>
                }
            }
            else
            {
                <div class="faq-empty">
                    目前沒有符合條件的求職者回報
                </div>
            }

        </div>

    </div>

</div>

@section Scripts {
    <script>
        function showFaqTab(tabName) {
            document.querySelectorAll(".faq-tab").forEach(btn => {
                btn.classList.remove("active");
            });

            document.querySelectorAll(".faq-tab-content").forEach(content => {
                content.classList.remove("active");
            });

            const targetBtn = document.querySelector(`.faq-tab[data-tab="${tabName}"]`);
            const targetContent = document.getElementById(`${tabName}-tab-content`);

            if (targetBtn) {
                targetBtn.classList.add("active");
            }

            if (targetContent) {
                targetContent.classList.add("active");
            }

            const url = new URL(window.location.href);
            url.searchParams.set("tab", tabName);
            window.history.replaceState({}, "", url);
        }

        async function toggleActive(id, btn) {
            const res = await fetch('/AdminFAQ/ToggleActive/' + id, {
                method: 'POST'
            });

            const data = await res.json();

            if (!data.success) {
                alert(data.message);
                return;
            }

            btn.textContent = data.isActive ? '顯示中' : '已停用';

            btn.className = 'btn-toggle ' + (data.isActive ? 'active' : 'inactive');
        }

        async function assignDepartment(id, selectEl) {
            const department = selectEl.value;
            const previousValue = selectEl.dataset.prevValue || department;

            const res = await fetch('/AdminFAQ/AssignDepartment/' + id, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'department=' + encodeURIComponent(department)
            });

            const data = await res.json();

            if (!data.success) {
                alert(data.message);
                selectEl.value = previousValue;
                return;
            }

            window.location.reload();
        }
    </script>
}
