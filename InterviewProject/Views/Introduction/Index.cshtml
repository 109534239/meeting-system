@{
    ViewData["Title"] = "公司介紹";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Introduction.css" asp-append-version="true" />
}

<!-- HERO -->
<section class="intro-hero">
    <div class="hero-inner">
        <div class="hero-label">About Us</div>
        <h1>關於面試力達母公司</h1>
        <p>我們結合生成式 AI 與多模態分析技術，<br class="hero-br">致力於消除招募偏誤與溝通成本，重構企業智慧面試體驗。</p>
    </div>
</section>

<main class="intro-main">

    <!-- 公司簡介 -->
    <section>
        <div class="section-header">
            <h2>公司簡介</h2>
            <p>Company Overview</p>
            <div class="section-divider"></div>
        </div>
        <div class="about-grid">
            <div class="about-text">
                <h3>重構企業招募，打造智慧面試新體驗</h3>
                <p>面試力達母公司成立於 2024 年，是一家專注於人資科技（HR Tech）領域的新創團隊。我們致力於解決企業招募中「時間與認知負擔高昂」以及「跨部門協調困難」等核心痛點，研發出全新的 <strong>AI 協同面試系統</strong>。</p>
                <p>結合生成式 AI 與多模態分析技術，我們的系統提供 2D/3D 擬真 AI 虛擬面試官主動補位提問，並能自動產生聲紋辨識逐字稿，以及整合語音、表情與語意多維度的求職者表現分析報告，幫助企業建立精準、客觀且高效率的一站式招募工作流。</p>
                <p>我們相信科技能讓招募回歸人本價值。團隊正在持續擴大中，期待找到對 AI 技術與 HR 數位轉型充滿熱情的夥伴，一起重構招募的未來！</p>
            </div>
            <div class="about-stats">
                <div class="stat-card">
                    <div class="stat-number">95%+</div>
                    <div class="stat-label">AI 聲紋辨識精準度</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">50%+</div>
                    <div class="stat-label">降低面試時間成本</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">5 大</div>
                    <div class="stat-label">核心 AI 研發模組</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">100%</div>
                    <div class="stat-label">一站式數位招募</div>
                </div>
            </div>
        </div>
    </section>

    <!-- 核心價值 -->
    <section>
        <div class="section-header">
            <h2>核心價值</h2>
            <p>Core Values</p>
            <div class="section-divider"></div>
        </div>
        <div class="values-section">
            <div class="values-grid">
                <div class="value-card">
                    <div class="value-icon">🤖</div>
                    <div class="value-title">AI 前瞻突破</div>
                    <div class="value-desc">持續探索生成式 AI 與多模態技術，用科技賦能招募流程</div>
                </div>
                <div class="value-card">
                    <div class="value-icon">⚖️</div>
                    <div class="value-title">客觀與公平</div>
                    <div class="value-desc">以量化數據與多維度行為分析減少面試偏誤，創造友善評估環境</div>
                </div>
                <div class="value-card">
                    <div class="value-icon">⚡</div>
                    <div class="value-title">極致高效</div>
                    <div class="value-desc">優化跨角色協同作業，大幅降低企業溝通與決策的時間成本</div>
                </div>
                <div class="value-card">
                    <div class="value-icon">🤝</div>
                    <div class="value-title">開放共融</div>
                    <div class="value-desc">扁平化的溝通氛圍，鼓勵夥伴勇於提出想法與多模態創意</div>
                </div>
            </div>
        </div>
    </section>

    <!-- 福利制度 -->
    <section>
        <div class="section-header">
            <h2>福利制度</h2>
            <p>Employee Benefits</p>
            <div class="section-divider"></div>
        </div>
        <div class="benefits-grid">
            <div class="benefit-card">
                <div class="benefit-icon-row">
                    <div class="benefit-icon">💰</div>
                    <div class="benefit-title">薪酬與獎金</div>
                </div>
                <ul class="benefit-list">
                    <li>具市場競爭力的薪資與技術津貼</li>
                    <li>年終獎金與核心專案績效分紅</li>
                    <li>優秀人才股票期權（ESOP）計畫</li>
                    <li>內部人才推薦獎金</li>
                </ul>
            </div>
            <div class="benefit-card">
                <div class="benefit-icon-row">
                    <div class="benefit-icon">💻</div>
                    <div class="benefit-title">靈活彈性工作</div>
                </div>
                <ul class="benefit-list">
                    <li>彈性上下班時間，自主規劃工作節奏</li>
                    <li>每週可申請 Remote 遠端工作</li>
                    <li>提供頂級 Mac / 高階工作站電腦配置</li>
                    <li>舒適無壓力的開放式辦公空間</li>
                </ul>
            </div>
            <div class="benefit-card">
                <div class="benefit-icon-row">
                    <div class="benefit-icon">📚</div>
                    <div class="benefit-title">學習與成長</div>
                </div>
                <ul class="benefit-list">
                    <li>每年專屬 AI / 技術研討會與研習補助</li>
                    <li>購買專業書籍 / 線上課程全額報銷</li>
                    <li>與頂尖 AI 團隊面對面交流技術挑戰</li>
                    <li>清晰的雙軌職涯晉升通道</li>
                </ul>
            </div>
            <div class="benefit-card">
                <div class="benefit-icon-row">
                    <div class="benefit-icon">🏥</div>
                    <div class="benefit-title">健康與保障</div>
                </div>
                <ul class="benefit-list">
                    <li>標準勞健保與高額團體意外/醫療險</li>
                    <li>年度高階健檢全額補助</li>
                    <li>免費無限量精品咖啡、零食與飲料吧</li>
                    <li>定期專業肩頸按摩放鬆服務</li>
                </ul>
            </div>
            <div class="benefit-card">
                <div class="benefit-icon-row">
                    <div class="benefit-icon">🏖️</div>
                    <div class="benefit-title">休假與生活 balance</div>
                </div>
                <ul class="benefit-list">
                    <li>優於勞基法的首年帶薪特休假</li>
                    <li>每個月 1 天帶薪 Sick Day / 充電假</li>
                    <li>全額補助的節慶聚餐與 Team Building</li>
                    <li>彈性育嬰及家庭照顧支援機制</li>
                </ul>
            </div>
            <div class="benefit-card">
                <div class="benefit-icon-row">
                    <div class="benefit-icon">🎉</div>
                    <div class="benefit-title">團隊活動</div>
                </div>
                <ul class="benefit-list">
                    <li>海外/國內年度員工旅遊</li>
                    <li>定期舉辦 AI Hackathon 內部創新競賽</li>
                    <li>跨部門電競/桌遊/運動社團補助</li>
                    <li>節慶禮品與生日專屬慶祝活動</li>
                </ul>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
        <div class="cta-inner">
            <h2>準備好一起翻轉招募未來了嗎？</h2>
            <p>加入我們，探索最新 AI 技術職缺，與熱情團隊共創智慧 HR Tech 的無限可能</p>
            <a class="cta-btn" asp-controller="Job" asp-action="Job_search">立即探索職缺</a>
        </div>
    </section>

</main>