@model IEnumerable<InterviewProject.Models.Job>

@{
    ViewData["Title"] = "首頁";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Home.css" asp-append-version="true" />
}

<section class="hero">
    <h1>加入我們，共創未來</h1>
    <p>探索 XXX 公司最新職缺，找到最適合你的舞台</p>
    <div class="hero-btn-group">
        @* <a href="#" class="hero-btn">填履歷表</a> *@
        @* <a href="@Url.Action("Job_search", "Job")" class="hero-btn">查詢職缺</a> *@
    </div>
</section>

<main class="home-main">
    <div class="home-main-inner">

        <section>
            <div class="section-label">最新公告</div>
            <div class="announce-card">
                <ul class="announce-list">
                    @if (ViewBag.Announcements != null)
                    {
                        foreach (var a in ViewBag.Announcements)
                        {
                            <li class="announce-item" onclick="openAnnounceModal('@a.Date.ToString("yyyy-MM-dd")', '@a.Category', '@a.BadgeClass', '@System.Web.HttpUtility.JavaScriptStringEncode(a.Title)', '@System.Web.HttpUtility.JavaScriptStringEncode(a.Content)')">
                                <span class="announce-date">@a.Date.ToString("yyyy-MM-dd")</span>
                                <span class="badge-category @a.BadgeClass">@a.Category</span>
                                <span class="announce-title">@a.Title</span>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="announce-item">
                            <span class="announce-title" style="color:#aaa;">目前沒有公告</span>
                        </li>
                    }
                </ul>
            </div>
        </section>

        <section>
            <div class="section-label">最新職缺</div>

            <div class="job-grid">
                @if (Model != null && Model.Any())
                {
                    @foreach (var job in Model)
                    {
                        <a asp-controller="Job" asp-action="Job_detail" asp-route-id="@job.Id" class="job-card">
                            <div class="job-dept">@job.Department</div>
                            <div class="job-title">@job.Title</div>
                            <div class="job-tags">
                                <span class="tag">@job.Location</span>
                                <span class="tag">
                                    @(job.JobType == "fulltime" ? "全職" : job.JobType == "parttime" ? "兼職" : "實習")
                                </span>
                                <span class="tag">
                                    @(string.IsNullOrEmpty(job.ExperienceRequired) ? "不限" : job.ExperienceRequired)
                                </span>
                            </div>
                        </a>
                    }
                }
                else
                {
                    <div style="grid-column: 1 / -1; padding: 40px; text-align: center; color: #888; background: #fff; border-radius: 8px; width: 100%;">
                        目前資料庫內沒有符合條件開放中的最新職缺。
                    </div>
                }
            </div>
        </section>

    </div>
</main>

@* ── 🎯 隱藏的彈出視窗 HTML 結構 ── *@
<div id="announceModal" class="announce-modal" onclick="closeAnnounceModal(event)">
    <div class="announce-modal-card" onclick="event.stopPropagation()">
        <!-- 右上角關閉按鈕 -->
        <button class="modal-close-btn" onclick="closeAnnounceModalDirectly()">&times;</button>

        <div class="modal-meta">
            <!-- 🎯 Modal 裡面的分類標籤 -->
            <span id="modalBadge" class="badge-category"></span>
            <span id="modalDate" class="modal-date"></span>
        </div>

        <h3 id="modalTitle" class="modal-title"></h3>
        <div class="modal-divider"></div>
        <div id="modalContent" class="modal-content"></div>
    </div>
</div>

@section Scripts {
    <script>
        // 🎯 接收 5 個參數（包含 badgeClass）
        function openAnnounceModal(date, category, badgeClass, title, content) {
            document.getElementById('modalDate').innerText = date;
            document.getElementById('modalTitle').innerText = title;
            document.getElementById('modalContent').innerText = content;

            // 🎯 設定 Modal 標籤的文字與 dynamic CSS class
            const badgeElem = document.getElementById('modalBadge');
            badgeElem.innerText = category;

            // 重新賦予 className（保留基礎 .badge-category 並加上如 .badge-最新 / .badge-活動）
            badgeElem.className = `badge-category ${badgeClass}`;

            // 顯示 Modal
            document.getElementById('announceModal').style.display = 'flex';
        }

        function closeAnnounceModal(event) {
            if (event.target.id === 'announceModal') {
                document.getElementById('announceModal').style.display = 'none';
            }
        }

        function closeAnnounceModalDirectly() {
            document.getElementById('announceModal').style.display = 'none';
        }
    </script>
}