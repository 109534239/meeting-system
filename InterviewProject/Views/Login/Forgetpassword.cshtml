@{
    ViewData["Title"] = "忘記密碼";
}
@section Styles {
    <link rel="stylesheet" href="~/css/Forgetpassword.css" asp-append-version="true" />
}

<div class="login-page">
    <div class="login-card">
        <div class="login-title">
            <h1>忘記密碼</h1>
            <p id="step-hint">請驗證您的 Email 並輸入驗證碼</p>
        </div>

        <div id="section-verify-area">
            <div class="form-group">
                <div style="display: flex; gap: 8px; align-items: center;">
                    <input type="email" id="email" class="form-control"
                           placeholder="請輸入註冊 Email" required
                           style="flex: 3; text-align: left; margin: 0; padding: 12px 15px;" />

                    <button type="button" class="btn-login" onclick="sendCode()"
                            style="flex: 1; width: auto; margin: 0; padding: 10px 5px; font-size: 13px; white-space: nowrap; min-width: 100px;">
                        發送驗證碼
                    </button>
                </div>
            </div>

            <div class="form-group" style="margin-top: 20px;">
                <label for="verifyCode" style="font-size: 0.9em; color: #666; display: block; margin-bottom: 5px;">驗證碼</label>
                <input type="text" id="verifyCode" class="form-control" placeholder="請輸入 6 位數字代碼" />
            </div>
            <button type="button" class="btn-login" onclick="checkCode()"
                    style="background-color: #2c3e50; color: #ffffff; font-weight: 700; width: 100%; border: none;">
                提交驗證碼
            </button>
        </div>

        <div id="div-step-password" style="display:none; border-top: 1px solid #eee; margin-top: 20px; padding-top: 20px;">
            <div class="form-group">
                <input type="password" id="newPassword" class="form-control" placeholder="輸入新密碼" />
            </div>
            <div class="form-group">
                <input type="password" id="confirmPassword" class="form-control" placeholder="再次確認新密碼" />
            </div>
            <button type="button" class="btn-login" onclick="resetPassword()">設定完成</button>
        </div>

        <div class="forgot-pw" style="margin-top:20px;">
            <a asp-action="Index">返回登入</a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // 1. 發送驗證碼 (測試模式)
        function sendCode() {
            const email = document.getElementById('email').value;
                if (!email) {
            Swal.fire('提示', '請先填寫 Email', 'warning');
            return;
        }

        fetch('/Login/SendVerificationCode?email=' + encodeURIComponent(email), { method: 'POST' })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                // 在訊息中加入有效時間提示
                Swal.fire({
                    title: '驗證碼已寄出',
                    html: `您的代碼是：<b style="color:red; font-size:24px;">${data.code}</b><br>` +
                          `請於 <b style="color:blue;">${data.expiryTime}</b> 前輸入完畢`,
                    icon: 'success'
                });
            } else {
                Swal.fire('錯誤', data.message, 'error');
            }
        });
        }

        // 2. 提交驗證碼
        function checkCode() {
            const email = document.getElementById('email').value;
            const code = document.getElementById('verifyCode').value;

            if (!code) {
                Swal.fire('提示', '請輸入驗證碼', 'warning');
                return;
            }

            const formData = new URLSearchParams();
            formData.append('email', email);
            formData.append('code', code);

            fetch('/Login/VerifyCodeOnly', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    Swal.fire('驗證成功', '請設定您的新密碼', 'success');
                    // 驗證成功後，隱藏上面的驗證區塊，開啟密碼區塊
                    document.getElementById('section-verify-area').style.display = 'none';
                    document.getElementById('div-step-password').style.display = 'block';
                    document.getElementById('step-hint').innerText = "最後一步：設定新密碼";
                } else {
                    Swal.fire('失敗', data.message, 'error');
                }
            });
        }

        // 3. 重設密碼 (ResetPassword 邏輯不變)
        function resetPassword() {
            const email = document.getElementById('email').value;
            const code = document.getElementById('verifyCode').value;
            const newPw = document.getElementById('newPassword').value;
            const confirmPw = document.getElementById('confirmPassword').value;

            if (!newPw || newPw !== confirmPw) {
                Swal.fire('錯誤', '兩次密碼輸入不一致', 'error');
                return;
            }

            const formData = new FormData();
            formData.append('email', email);
            formData.append('code', code);
            formData.append('newPassword', newPw);

            fetch('/Login/ResetPassword', { method: 'POST', body: formData })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    Swal.fire('成功', '密碼重設成功', 'success').then(() => {
                        window.location.href = '/Login/Index';
                    });
                } else {
                    Swal.fire('失敗', data.message, 'error');
                }
            });
        }
    </script>
}