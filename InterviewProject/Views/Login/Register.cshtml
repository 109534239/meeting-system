@{
    ViewData["Title"] = "註冊帳號";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Register.css" asp-append-version="true" />
}

<div class="register-page">
    <div class="register-card">

        <div class="register-title">
            <h1>註冊帳號</h1>
            <p id="step-indicator">第一步：帳號密碼設定</p>
        </div>

        <form id="register-form" method="post"
              asp-controller="Login" asp-action="Register"
              onsubmit="return validateForm(event)">
            @Html.AntiForgeryToken()

            @if (TempData["RegisterError"] != null)
            {
                <div class="alert-error">@TempData["RegisterError"]</div>
            }

            <div class="form-step active" id="step-1">
                <div class="form-group">
                    <label>電子郵件<span class="required">*</span></label>
                    <input type="email" id="email" name="email" class="form-control" placeholder="請輸入電子郵件" required />
                </div>

                <div class="form-group">
                    <label>手機號碼 <span class="required">*</span></label>
                    <input type="tel" id="phone" name="phone" class="form-control" placeholder="請輸入手機號碼" required />
                </div>

                <div class="form-group">
                    <label>密碼 <span class="required">*</span></label>
                    <input type="password" id="password" name="password" class="form-control" placeholder="請設定密碼" required />
                </div>

                <div class="form-group">
                    <label>確認密碼 <span class="required">*</span></label>
                    <input type="password" id="confirm-password" class="form-control" placeholder="請再次輸入密碼" required />
                </div>

                <div class="btn-group">
                    <button type="button" class="btn-next" onclick="nextStep()">下一步</button>
                </div>
            </div>

            <div class="form-step" id="step-2">
                <div class="form-group">
                    <label>姓名 <span class="required">*</span></label>
                    <input type="text" id="name" name="name" class="form-control" placeholder="請輸入姓名" required />
                </div>

                <div class="form-group">
                    <label>性別 <span class="required">*</span></label>
                    <select id="gender" name="gender" class="form-control" required>
                        <option value="">-- 請選擇 --</option>
                        <option value="男">男</option>
                        <option value="女">女</option>
                        <option value="不透露">不透露</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>身分證字號 <span class="required">*</span></label>
                    <input type="text" id="idNumber" name="idNumber" class="form-control" placeholder="請輸入身分證字號" required />
                </div>

                <div class="form-group">
                    <label>生日 <span class="required">*</span></label>
                    <input type="date" id="birthday" name="birthday" class="form-control" required />
                </div>

                <div class="form-group">
                    <label>居住地址 <span class="required">*</span></label>
                    <input type="text" id="address" name="address" class="form-control" placeholder="請輸入居住地址" required />
                </div>

                <div class="btn-group">
                    <button type="button" class="btn-prev" onclick="prevStep()">上一步</button>
                    <button type="submit" class="btn-submit">送出註冊</button>
                </div>
            </div>

        </form>

        <div class="back-login">
            已有帳號？ <a asp-controller="Login" asp-action="Index">返回登入</a>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        // 🎯 修正：改成 async 方法，按下下一步時立刻異步檢查第一步的資料
        async function nextStep() {
            const email = document.getElementById('email').value.trim();
            const phone = document.getElementById('phone').value.trim();
            const password = document.getElementById('password').value;
            const confirm = document.getElementById('confirm-password').value;

            if (!email || !phone || !password || !confirm) {
                alert('請完整填寫第一步的所有必填欄位');
                return;
            }

            if (password !== confirm) {
                alert('密碼與確認密碼不一致，請重新輸入');
                return;
            }

            // 🎯 發送 AJAX 檢查第一步的 Mail 與電話是否有人用過
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const response = await fetch('/Login/CheckDuplicate', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: `email=${encodeURIComponent(email)}&phone=${encodeURIComponent(phone)}`
                });

                if (response.ok) {
                    const result = await response.json();
                    if (result.isDuplicate) {
                        alert(result.message); // 跳出「此電子郵件已被註冊！」或手機重複的提示
                        return; // 卡在第一步，不往下切換
                    }
                } else {
                    alert('系統驗證連線異常，請稍後再試');
                    return;
                }
            } catch (err) {
                console.error(err);
                alert('驗證時發生未知錯誤');
                return;
            }

            document.getElementById('step-1').classList.remove('active');
            document.getElementById('step-2').classList.add('active');
            document.getElementById('step-indicator').innerText = "第二步：個人詳細資料";
        }

        function prevStep() {
            document.getElementById('step-2').classList.remove('active');
            document.getElementById('step-1').classList.add('active');
            document.getElementById('step-indicator').innerText = "第一步：帳號密碼設定";
        }

        // 🎯 修正：加入 async 與 event 阻擋控制。按下送出時，異步檢查第二步的身分證字號
        async function validateForm(event) {
            event.preventDefault(); // 先阻止表單直接送出刷新網頁

            const name = document.getElementById('name').value.trim();
            const gender = document.getElementById('gender').value;
            const idNumber = document.getElementById('idNumber').value.trim();
            const birthday = document.getElementById('birthday').value;
            const address = document.getElementById('address').value.trim();

            if (!name || !gender || !idNumber || !birthday || !address) {
                alert('請完整填寫個人詳細資料欄位');
                return false;
            }

            // 🎯 發送 AJAX 檢查第二步的身分證字號是否被用過
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const response = await fetch('/Login/CheckDuplicate', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: `idNumber=${encodeURIComponent(idNumber)}`
                });

                if (response.ok) {
                    const result = await response.json();
                    if (result.isDuplicate) {
                        alert(result.message); // 跳出「此身分證字號已被註冊！」
                        return false;
                    }
                } else {
                    alert('系統驗證連線異常，請稍後再試');
                    return false;
                }
            } catch (err) {
                console.error(err);
                alert('驗證身分證時發生未知錯誤');
                return false;
            }

            // 兩步驗證全部大獲全勝，手動提交表單
            document.getElementById('register-form').submit();
        }
    </script>
}