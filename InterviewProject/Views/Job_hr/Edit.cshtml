@model InterviewProject.Models.Job

@{
    ViewData["Title"] = "修改職缺";
}

@section Styles {
    <link rel="stylesheet" href="~/css/HrJob.css" asp-append-version="true" />
}

<div class="hrjob-form-page">
    <div class="hrjob-form-header">
        <a asp-action="Index" class="btn-back">← 返回列表</a>
        <h2>修改職缺</h2>
    </div>

    <form method="post" asp-action="Edit" class="hrjob-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />

        <div class="form-group">
            <label>職缺名稱</label>
            <input type="text" name="Title" class="form-control" value="@Model.Title" required />
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>部門</label>
                <input type="text" name="Department" class="form-control" value="@Model.Department" required />
            </div>
            <div class="form-group">
                <label>工作地點</label>
                <input type="text" name="Location" class="form-control" value="@Model.Location" required />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>職缺類型</label>
                <select name="JobType" class="form-control">
                    <option value="fulltime" selected="@(Model.JobType == "fulltime")">全職</option>
                    <option value="parttime" selected="@(Model.JobType == "parttime")">兼職</option>
                    <option value="intern" selected="@(Model.JobType == "intern")">實習</option>
                </select>
            </div>
            <div class="form-group">
                <label>月薪（元）</label>
                <input type="number" name="Salary" class="form-control" value="@Model.Salary" min="0" required />
            </div>
        </div>

        <div class="form-group">
            <label>職缺描述</label>
            <textarea name="Description" class="form-control" rows="5" required>@Model.Description</textarea>
        </div>

        <div class="form-group">
            <label>應徵條件</label>
            <textarea name="Requirements" class="form-control" rows="4" required>@Model.Requirements</textarea>
        </div>

        <div class="form-group checkbox-group">
            <label>
                <input type="checkbox" name="IsActive" value="true" @(Model.IsActive ? "checked" : "") />
                上架中
            </label>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn-cancel">取消</a>
            <button type="submit" class="btn-submit">儲存修改</button>
        </div>
    </form>
</div>