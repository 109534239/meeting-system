@{
    ViewData["Title"] = "新增職缺";
}

@section Styles {
    <link rel="stylesheet" href="~/css/HrJob.css" asp-append-version="true" />
    <style>
        /* ✨ 精準區分必填與選填的視覺樣式 */
        .text-danger {
            color: #e53e3e;
            margin-left: 4px;
            font-weight: bold;
        }

        .text-muted {
            color: #a0aec0;
            font-size: 13px;
            margin-left: 6px;
            font-weight: normal;
        }
    </style>
}

<div class="hrjob-form-page">

    <div class="hrjob-form-header">
        <a asp-action="Index" class="btn-back">← 返回列表</a>
        <h2>新增職缺</h2>
    </div>

    <form method="post" asp-action="Create">

        @Html.AntiForgeryToken()

        @* ═══════════════════════════════
            基本資訊 (全數為必填)
           ═══════════════════════════════ *@
        <div class="hrjob-form">

            <div class="form-section-title">
                基本資訊
            </div>

            <div class="form-grid-1">
                <div class="form-group">
                    <label>職缺名稱<span class="text-danger">*</span></label>

                    <input type="text"
                           name="Title"
                           class="form-control"
                           placeholder="例：專案經理"
                           required />
                </div>
            </div>

            <div class="form-grid-2">

                <div class="form-group">
                    <label>職缺類別（部門）<span class="text-danger">*</span></label>

                    <select name="Department"
                            class="form-control"
                            required>

                        <option value="">-- 請選擇職缺類別 --</option>
                        <option value="專案管理">專案管理</option>
                        <option value="資訊技術">資訊技術</option>
                        <option value="人力資源">人力資源</option>
                        <option value="行銷企劃">行銷企劃</option>
                        <option value="財務會計">財務會計</option>
                        <option value="業務銷售">業務銷售</option>

                    </select>
                </div>

                <div class="form-group">
                    <label>工作地點<span class="text-danger">*</span></label>

                    <input type="text"
                           name="Location"
                           class="form-control"
                           placeholder="例：台北市內湖"
                           required />
                </div>

            </div>

            <div class="form-grid-2">

                <div class="form-group">
                    <label>職缺類型<span class="text-danger">*</span></label>

                    <select name="JobType"
                            class="form-control"
                            required>

                        <option value="fulltime">全職</option>
                        <option value="parttime">兼職</option>
                        <option value="intern">實習</option>

                    </select>
                </div>

                <div class="form-group">
                    <label>需求人數<span class="text-danger">*</span></label>

                    <input type="text"
                           name="HeadCount"
                           class="form-control"
                           placeholder="例：1人、2人、不限"
                           required />
                </div>

            </div>

            <div class="form-grid-2">

                <div class="form-group">
                    <label>上班時段<span class="text-danger">*</span></label>

                    <select name="WorkShift"
                            class="form-control"
                            required>

                        <option value="">-- 請選擇上班時段 --</option>
                        <option value="day">日班</option>
                        <option value="night">夜班</option>
                        <option value="rotating">輪班</option>

                    </select>
                </div>

                <div class="form-group">
                    <label>休假制度<span class="text-danger">*</span></label>

                    <select name="LeavePolicy"
                            class="form-control"
                            required>

                        <option value="">-- 請選擇休假制度 --</option>
                        <option value="twodays">週休二日</option>
                        <option value="oneday">週休一日</option>
                        <option value="flexible">彈性休假</option>

                    </select>
                </div>

            </div>

        </div>

        @* ═══════════════════════════════
            薪資範圍 (全數為必填)
           ═══════════════════════════════ *@
        <div class="hrjob-form">

            <div class="form-section-title">
                薪資範圍
            </div>

            <div class="form-grid-2">

                <div class="form-group">
                    <label>最低月薪（元）<span class="text-danger">*</span></label>

                    <input type="number"
                           name="SalaryMin"
                           class="form-control"
                           min="0"
                           placeholder="例：40000"
                           required />
                </div>

                <div class="form-group">
                    <label>最高月薪（元）<span class="text-danger">*</span></label>

                    <input type="number"
                           name="SalaryMax"
                           class="form-control"
                           min="0"
                           placeholder="例：60000"
                           required />
                </div>

            </div>

        </div>

        @* ═══════════════════════════════
            主管資訊 (依照最新規格，全數改為必填)
           ═══════════════════════════════ *@
        <div class="hrjob-form">

            <div class="form-section-title">
                主管資訊
            </div>

            <div class="form-grid-2">

                <div class="form-group">
                    <label>部門主管<span class="text-danger">*</span></label>

                    <input type="text"
                           name="ManagerName"
                           class="form-control"
                           placeholder="例：王小明"
                           required />
                </div>

                <div class="form-group">
                    <label>職稱階級<span class="text-danger">*</span></label>

                    <input type="text"
                           name="ReportToName"
                           class="form-control"
                           placeholder="例：技術長"
                           required />
                </div>

            </div>

        </div>

        @* ═══════════════════════════════
            工作內容 (必填)
           ═══════════════════════════════ *@
        <div class="hrjob-form">

            <div class="form-section-title">
                工作內容
            </div>

            <div class="form-grid-1">

                <div class="form-group">
                    <label>職缺描述（工作內容）<span class="text-danger">*</span></label>

                    <textarea name="Description"
                              class="form-control"
                              rows="6"
                              placeholder="請條列主要工作職責"
                              required></textarea>
                </div>

            </div>

        </div>

        @* ═══════════════════════════════
            條件要求 (全數為選填)
           ═══════════════════════════════ *@
        <div class="hrjob-form">

            <div class="form-section-title">
                條件要求
            </div>

            <div class="form-grid-2">

                <div class="form-group">

                    <label>工作經歷<span class="text-muted">(選填)</span></label>

                    <input type="hidden"
                           name="ExperienceRequired"
                           id="experience-value"
                           value="不限" />

                    <div style="display:flex; gap:10px; align-items:center;">

                        <select id="exp-type"
                                class="form-control"
                                style="width:130px; flex-shrink:0;"
                                onchange="updateExperience()">

                            <option value="unlimited">不限</option>
                            <option value="years">要求</option>

                        </select>

                        <input type="number"
                               id="exp-years"
                               class="form-control"
                               min="1"
                               max="30"
                               placeholder="輸入年數"
                               style="display:none;"
                               oninput="updateExperience()" />

                    </div>

                </div>

                <div class="form-group">

                    <label>學歷需求<span class="text-muted">(選填)</span></label>

                    <select name="EducationRequired"
                            class="form-control">
                        <option value="">-- 不限 --</option>
                        <option value="highschool">高中職以上</option>
                        <option value="college">專科以上</option>
                        <option value="bachelor">大學以上</option>
                        <option value="master">碩士以上</option>
                        <option value="phd">博士以上</option>

                    </select>

                </div>

            </div>

            <div class="form-grid-2">

                <div class="form-group">
                    <label>產業經歷<span class="text-muted">(選填)</span></label>

                    <input type="text"
                           name="IndustryExperience"
                           class="form-control"
                           placeholder="例：電腦及其週邊設備業、半導體業" />
                </div>

                <div class="form-group">
                    <label>科系需求<span class="text-muted">(選填)</span></label>

                    <input type="text"
                           name="MajorRequired"
                           class="form-control"
                           placeholder="例：資訊工程、電機、工業工程或商管相關科系尤佳" />
                </div>

            </div>

            <div class="form-grid-1">

                <div class="form-group">
                    <label>語文條件<span class="text-muted">(選填)</span></label>

                    <input type="text"
                           name="LanguageRequired"
                           class="form-control"
                           placeholder="例：英文 — 中等（能撰寫英文技術文件）" />
                </div>

            </div>

            <div class="form-grid-1">

                <div class="form-group">
                    <label>知識技能<span class="text-muted">(選填)</span></label>

                    <textarea name="Requirements"
                              class="form-control"
                              rows="4"
                              placeholder="例：熟悉 MS Project、跨部門協調能力"></textarea>
                </div>

            </div>

            <div class="form-grid-2">

                <div class="form-group">
                    <label>必要證照<span class="text-muted">(選填)</span></label>

                    <input type="text"
                           name="CertRequired"
                           class="form-control"
                           placeholder="例：無特定要求" />
                </div>

                <div class="form-group">
                    <label>其他條件<span class="text-muted">(選填)</span></label>

                    <textarea name="OtherRequirements"
                              class="form-control"
                              rows="3"
                              placeholder="例：主動積極，能在高壓環境下有效處理多項任務"></textarea>
                </div>

            </div>

        </div>

        @* ═══════════════════════════════
            技能標籤
           ═══════════════════════════════ *@
        <div class="hrjob-form">

            <div class="form-section-title">
                技能標籤
            </div>

            <div class="form-grid-1">

                <div class="form-group">

                    <label>技能標籤<span class="text-muted">(選填)</span></label>

                    <input type="text"
                           name="SkillTags"
                           class="form-control"
                           placeholder="以逗號分隔，例：產品管理, 專案規劃, 英文溝通" />

                </div>

            </div>

        </div>

        @* ═══════════════════════════════
            上架設定 (截止日期為必填)
           ═══════════════════════════════ *@
        <div class="hrjob-form">

            <div class="form-section-title">
                上架設定
            </div>

            <div class="form-grid-2">

                <div class="form-group">

                    <label>截止日期<span class="text-danger">*</span></label>

                    <input type="date"
                           name="Deadline"
                           class="form-control"
                           required />

                </div>

                <div class="form-group checkbox-group" style="padding-top: 32px;">

                    <label style="cursor: pointer; font-weight: normal;">
                        <input type="checkbox"
                               name="IsActive"
                               value="true"
                               checked />

                        立即上架此職缺
                    </label>

                </div>

            </div>

        </div>

        <div class="form-actions">

            <a asp-action="Index"
               class="btn-cancel">

                取消

            </a>

            <button type="submit"
                    class="btn-submit">

                新增職缺

            </button>

        </div>

    </form>

</div>

@section Scripts {

    <script>

        function updateExperience() {

            const type = document.getElementById('exp-type').value;
            const yearsInput = document.getElementById('exp-years');
            const hidden = document.getElementById('experience-value');

            if (type === 'unlimited') {

                yearsInput.style.display = 'none';
                yearsInput.value = '';
                hidden.value = '不限';

            } else {

                yearsInput.style.display = 'block';

                const y = parseInt(yearsInput.value);

                hidden.value =
                    (y > 0)
                    ? y + '年以上工作經驗'
                    : '';

            }
        }

        // 監聽數字輸入，當有更動時自動更新隱藏欄位的文字內容
        document.getElementById('exp-years').addEventListener('input', updateExperience);

    </script>

}