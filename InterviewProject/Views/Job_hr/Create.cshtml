@{
    ViewData["Title"] = "新增職缺";
}

@section Styles {
    <link rel="stylesheet" href="~/css/HrJob.css" asp-append-version="true" />
}

<div class="hrjob-form-page">
    <div class="hrjob-form-header">
        <a asp-action="Index" class="btn-back">← 返回列表</a>
        <h2>新增職缺</h2>
    </div>

    <form method="post" asp-action="Create" class="hrjob-form">
        @Html.AntiForgeryToken()

        <!-- 基本資訊 -->
        <div class="form-group">
            <label>職缺名稱</label>
            <input type="text" name="Title" class="form-control" placeholder="例：NB產品經理_260502001" required />
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>部門 / 職缺類型（分類）</label>
                <input type="text" name="Department" class="form-control" placeholder="例：專案管理" required />
            </div>
            <div class="form-group">
                <label>工作地點</label>
                <input type="text" name="Location" class="form-control" placeholder="例：新北市汐止" required />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>工作性質</label>
                <select name="JobType" class="form-control">
                    <option value="全職">全職</option>
                    <option value="兼職">兼職</option>
                    <option value="實習">實習</option>
                </select>
            </div>
            <div class="form-group">
                <label>月薪 / 薪資待遇（元）</label>
                <input type="number" name="Salary" class="form-control" min="0" required />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>上班時段</label>
                <input type="text" name="WorkHours" class="form-control" placeholder="例：日班" value="日班" />
            </div>
            <div class="form-group">
                <label>休假制度</label>
                <input type="text" name="LeaveSystem" class="form-control" placeholder="例：週休二日" value="週休二日" />
            </div>
            <div class="form-group">
                <label>需求人數</label>
                <input type="text" name="NeedPeople" class="form-control" placeholder="例：1 ～ 3 人" required />
            </div>
        </div>

        <hr />

        <!-- 條件要求 -->
        <div class="form-row">
            <div class="form-group">
                <label>工作經歷要求</label>
                <input type="text" name="ExpRequired" class="form-control" placeholder="例：3年以上" required />
            </div>
            <div class="form-group">
                <label>學歷需求</label>
                <input type="text" name="EduRequired" class="form-control" placeholder="例：大學以上" required />
            </div>
        </div>

        <div class="form-group">
            <label>條件詳細說明（對應詳細頁的表格細項）</label>
            <div style="background: #f9f9f9; padding: 15px; border-radius: 4px; border: 1px solid #ddd;">
                <div class="form-group">
                    <label style="font-size: 0.9em; color: #555;">產業經歷</label>
                    <input type="text" name="IndustryExp" class="form-control" placeholder="例：電腦及其週邊設備業、半導體業" />
                </div>
                <div class="form-group">
                    <label style="font-size: 0.9em; color: #555;">科系需求</label>
                    <input type="text" name="DeptRequired" class="form-control" placeholder="例：資訊工程、電機、商管相關科系尤佳" />
                </div>
                <div class="form-group">
                    <label style="font-size: 0.9em; color: #555;">語文條件</label>
                    <input type="text" name="LanguageRequired" class="form-control" placeholder="例：英文 — 中等" />
                </div>
                <div class="form-group">
                    <label style="font-size: 0.9em; color: #555;">知識技能</label>
                    <input type="text" name="SkillsRequired" class="form-control" placeholder="例：熟悉產品開發流程、MS Project" />
                </div>
                <div class="form-group">
                    <label style="font-size: 0.9em; color: #555;">必要證照</label>
                    <input type="text" name="CertificatesRequired" class="form-control" placeholder="例：無特定要求" value="無特定要求" />
                </div>
                <div class="form-group">
                    <label style="font-size: 0.9em; color: #555;">其他條件</label>
                    <input type="text" name="OtherRequired" class="form-control" placeholder="例：主動積極，能在高壓環境下有效處理多項任務" />
                </div>
            </div>
        </div>

        <hr />

        <!-- 內文與標籤 -->
        <div class="form-group">
            <label>工作內容（建議以換行或項目列表呈現）</label>
            <textarea name="Description" class="form-control" rows="5" placeholder="請輸入詳細工作內容..." required></textarea>
        </div>

        <div class="form-group">
            <label>技能標籤（請以逗號 `,` 分隔）</label>
            <input type="text" name="SkillTags" class="form-control" placeholder="例：產品管理,專案規劃,NB產品,跨部門協作" />
        </div>

        <div class="form-group checkbox-group">
            <label>
                <input type="checkbox" name="IsActive" value="true" checked />
                立即上架
            </label>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn-cancel">取消</a>
            <button type="submit" class="btn-submit">新增職缺</button>
        </div>
    </form>
</div>