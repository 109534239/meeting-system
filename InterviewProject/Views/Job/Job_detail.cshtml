@model InterviewProject.Models.Job

@{
    ViewData["Title"] = "詳細職缺";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Job_detail.css" asp-append-version="true" />
}

<style>
    .job-header-title {
        font-size: 26px !important;
        font-weight: 1000 !important;
        color: var(--primary) !important;
        letter-spacing: 0.5px !important;
        line-height: 1.3 !important;
    }
</style>

<!-- BREADCRUMB -->
<div class="custom-breadcrumb">
    <div class="breadcrumb-inner">
        <a asp-controller="Home" asp-action="Index" style="color: #999; text-decoration: none;">首頁</a>
        <span class="breadcrumb-sep">›</span>
        <a asp-controller="Job" asp-action="Job_search" style="color: #999; text-decoration: none;">職缺搜尋</a>
        <span class="breadcrumb-sep">›</span>
        <span>@Model.Title</span>
    </div>
</div>

<!-- JOB HEADER -->
<div class="job-header">
    <div class="job-header-inner">
        <div class="job-header-top">
            <div>
                <div class="job-badge-row">
                    <span class="badge badge-full">
                        @(Model.JobType == "fulltime" ? "全職" : Model.JobType == "parttime" ? "兼職" : "實習")
                    </span>
                </div>
                <div class="job-header-title" id="job-title">@Model.Title</div>
                <div class="job-header-dept">@Model.Department</div>
                <div class="job-header-meta">
                    <div class="meta-item">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
                            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" stroke="#206c8b" stroke-width="2" fill="none"/>
                            <circle cx="12" cy="9" r="2.5" stroke="#206c8b" stroke-width="2" fill="none"/>
                        </svg>
                        @Model.Location
                    </div>
                    <span class="meta-sep">|</span>
                    <div class="meta-item">@(string.IsNullOrEmpty(Model.ExperienceRequired) ? "不限" : Model.ExperienceRequired)</div>
                    <span class="meta-sep">|</span>
                    <div class="meta-item">
                        @switch (Model.EducationRequired)
                        {
                            case "highschool": @:高中職以上
                                break;
                            case "college": @:專科以上
                                break;
                            case "bachelor": @:大學以上
                                break;
                            case "master": @:碩士以上
                                break;
                            case "phd": @:博士以上
                                break;
                            default: @:不限
                                break;
                        }
                    </div>
                </div>
            </div>
            <div class="job-header-actions">
                @* 按鈕邏輯 *@
                @if (ViewBag.HasApplied == true)
                {
                    @* 已投過：點擊顯示漂亮彈窗 *@
                    <a href="javascript:void(0)"
                       class="btn-apply-lg"
                       onclick="showPendingAlert()">立即應徵</a>
                }
                else
                {
                    @* 未投過：執行原本的 openModal 並跳轉至 Resume 頁面 *@
                    <a href="javascript:void(0)"
                       class="btn-apply-lg"
                       onclick="openModal(@Model.Id)">立即應徵</a>
                }
                <button class="btn-icon-lg btn-favorite" title="收藏" data-job-id="@Model.Id" data-job-title="@Model.Title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                        <path d="M12 21C12 21 3 14 3 8a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 6-9 13-9 13z" stroke="#206c8b" stroke-width="2" fill="none"/>
                    </svg>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- MAIN CONTENT -->
<main class="main">

    <!-- 左側：詳細內容 -->
    <div class="content-left">
        <div class="content-card">
            <div class="section-title">工作內容</div>
            <div class="job-desc-content" style="white-space: pre-line; line-height: 1.6;">
                @Model.Description
            </div>
        </div>

        <div class="content-card">
            <div class="section-title">條件要求</div>
            <div class="condition-table">
                <div class="condition-row">
                    <span class="condition-label">工作經歷</span>
                    <span class="condition-value">
                        @(string.IsNullOrEmpty(Model.ExperienceRequired) ? "不限" : Model.ExperienceRequired)
                    </span>
                </div>
                <div class="condition-row">
                    <span class="condition-label">產業經歷</span>
                    <span class="condition-value">
                        @(string.IsNullOrEmpty(Model.IndustryExperience) ? "不限" : Model.IndustryExperience)
                    </span>
                </div>
                <div class="condition-row">
                    <span class="condition-label">學歷需求</span>
                    <span class="condition-value">
                        @switch (Model.EducationRequired)
                        {
                            case "highschool": @:高中職以上
                                break;
                            case "college": @:專科以上
                                break;
                            case "bachelor": @:大學以上
                                break;
                            case "master": @:碩士以上
                                break;
                            case "phd": @:博士以上
                                break;
                            default: @:不限
                                break;
                        }
                    </span>
                </div>
                <div class="condition-row">
                    <span class="condition-label">科系需求</span>
                    <span class="condition-value">
                        @(string.IsNullOrEmpty(Model.MajorRequired) ? "不限" : Model.MajorRequired)
                    </span>
                </div>
                <div class="condition-row">
                    <span class="condition-label">語文條件</span>
                    <span class="condition-value">
                        @(string.IsNullOrEmpty(Model.LanguageRequired) ? "不限" : Model.LanguageRequired)
                    </span>
                </div>
                <div class="condition-row">
                    <span class="condition-label">知識技能</span>
                    <span class="condition-value">
                        @(string.IsNullOrEmpty(Model.Requirements) ? "不限" : Model.Requirements)
                    </span>
                </div>
                <div class="condition-row">
                    <span class="condition-label">必要證照</span>
                    <span class="condition-value">
                        @(string.IsNullOrEmpty(Model.CertRequired) ? "無特定要求" : Model.CertRequired)
                    </span>
                </div>
                <div class="condition-row">
                    <span class="condition-label">其他條件</span>
                    <span class="condition-value" style="white-space: pre-line;">
                        @(string.IsNullOrEmpty(Model.OtherRequirements) ? "無" : Model.OtherRequirements)
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- 右側：職缺資訊 -->
    <div class="content-right">
        <div class="sidebar-card">
            <div class="sidebar-title">職缺資訊</div>
            <div class="info-row">
                <div class="info-item">
                    <span class="info-label">職缺類型</span>
                    <span class="info-value">@Model.Department</span>
                </div>
                <div class="info-item">
                    <span class="info-label">工作性質</span>
                    <span class="info-value">
                        @(Model.JobType == "fulltime" ? "全職" : Model.JobType == "parttime" ? "兼職" : "實習")
                    </span>
                </div>
                <div class="info-item">
                    <span class="info-label">工作地點</span>
                    <span class="info-value">@Model.Location</span>
                </div>
                <div class="info-item">
                    <span class="info-label">經歷要求</span>
                    <span class="info-value">@(string.IsNullOrEmpty(Model.ExperienceRequired) ? "不限" : Model.ExperienceRequired)</span>
                </div>
                <div class="info-item">
                    <span class="info-label">學歷要求</span>
                    <span class="info-value">
                        @switch (Model.EducationRequired)
                        {
                            case "highschool": @:高中職
                                break;
                            case "college": @:專科
                                break;
                            case "bachelor": @:大學
                                break;
                            case "master": @:碩士
                                break;
                            case "phd": @:博士
                                break;
                            default: @:不限
                                break;
                        }
                    </span>
                </div>
                <div class="info-item">
                    <span class="info-label">上班時段</span>
                    <span class="info-value">
                        @switch (Model.WorkShift)
                        {
                            case "day": @:日班
                                break;
                            case "night": @:夜班
                                break;
                            case "holiday": @:假日班
                                break;
                            default: @:日班
                                break;
                        }
                    </span>
                </div>
                <div class="info-item">
                    <span class="info-label">休假制度</span>
                    <span class="info-value">
                        @(Model.LeavePolicy == "twodays" ? "週休二日" : "依公司規定")
                    </span>
                </div>
                <div class="info-item">
                    <span class="info-label">需求人數</span>
                    <span class="info-value">@(string.IsNullOrEmpty(Model.HeadCount) ? "不限人數" : $"{Model.HeadCount} 人")</span>
                </div>
                <div class="info-item">
                    <span class="info-label">刊登日期</span>
                    <span class="info-value">@Model.CreatedAt.ToString("yyyy-MM-dd")</span>
                </div>
            </div>
        </div>

        <div class="sidebar-card">
            <div class="sidebar-title">技能標籤</div>
            <div class="tag-list">
                @if (Model.TagList != null && Model.TagList.Length > 0)
                {
                    foreach (var tag in Model.TagList)
                    {
                        <span class="tag">@tag</span>
                    }
                }
                else
                {
                    <span class="tag" style="background:#eee; color:#999;">無標籤</span>
                }
            </div>
        </div>

        @* 按鈕邏輯 *@
        @if (ViewBag.HasApplied == true)
        {
            @* 已投過：點擊顯示漂亮彈窗 *@
            <a href="javascript:void(0)"
               class="btn-apply-lg"
               onclick="showPendingAlert()">立即應徵</a>
        }
        else
        {
            @* 未投過：執行原本的 openModal 並跳轉至 Resume 頁面 *@
            <a href="javascript:void(0)"
               class="btn-apply-lg"
               onclick="openModal(@Model.Id)">立即應徵</a>
        }
    </div>

</main>

<!-- 應徵 MODAL -->
<div class="modal-overlay" id="apply-modal">
    <div class="modal-card">
        <div class="modal-header">
            <div class="modal-title">立即應徵</div>
            <div class="modal-job-name">應徵職位：<span id="modal-job-title"></span></div>
        </div>

        <div class="modal-body">
            <a id="btn-new-resume" class="modal-btn" style="text-decoration: none; display: inline-block; text-align: center;">
                建立全新履歷
            </a>

            <div id="existing-resume-section" style="margin-top:20px; border-top:1px solid #ddd; padding-top:15px; text-align:left; display:none;">
                <label style="font-size:14px; font-weight:bold;">套用現有履歷：</label>
                <select id="select-existing-pos" class="form-control" style="margin: 10px 0;">
                    <option value="">-- 請選擇職位 --</option>
                </select>
                <button class="modal-btn" onclick="goExistingResume()">套用並開啟</button>
            </div>
        </div>

        <div class="modal-footer">
            <button class="modal-btn-back" onclick="closeModal()">返回</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 💡 與 Job_search 保持一致
        const IS_LOGGED_IN = @Json.Serialize((bool)ViewBag.IsLoggedIn);
        const MEMBER_ID    = @Json.Serialize((int)ViewBag.MemberId);

        // ============================
        // 收藏功能
        // ============================
        function getFavorites() {
            return JSON.parse(localStorage.getItem(`favorites_${MEMBER_ID}`) || '[]');
        }

        function saveFavorites(list) {
            localStorage.setItem(`favorites_${MEMBER_ID}`, JSON.stringify(list));
        }

        function toggleFavorite(btn) {
            if (!IS_LOGGED_IN) {
                const go = confirm('需要登入才能收藏職缺\n\n是否前往登入頁面？');
                if (go) window.location.href = '/Login';
                return;
            }

            const jobId    = btn.dataset.jobId;
            const favorites = getFavorites();
            const index    = favorites.indexOf(jobId);

            if (index === -1) {
                favorites.push(jobId);
                btn.classList.add('favorited');
            } else {
                favorites.splice(index, 1);
                btn.classList.remove('favorited');
            }
            saveFavorites(favorites);
        }

        // 還原收藏狀態
        function restoreFavorites() {
            if (!IS_LOGGED_IN) return;
            const favorites = getFavorites();
            const btn = document.querySelector('.btn-favorite');
            if (btn && favorites.includes(btn.dataset.jobId)) {
                btn.classList.add('favorited');
            }
        }

        // 綁定收藏按鈕
        const favoriteBtn = document.querySelector('.btn-favorite');
        if (favoriteBtn) {
            favoriteBtn.addEventListener('click', () => toggleFavorite(favoriteBtn));
        }

        // ============================
        // 應徵 Modal
        // ============================
               // 全域變數或透過參數傳遞
        function openModal(currentJobId) {
            const isLoggedIn = localStorage.getItem('isLoggedIn') === 'true';
            // 💡 同樣改用 Session 判斷，不再用 localStorage
            if (!IS_LOGGED_IN) {
                if (confirm('需要登入才能應徵職缺\n\n是否前往登入頁面？')) {
                    window.location.href = '/Login';
                }
                return;
            }

            // 1. 抓取當前畫面的職位名稱顯示在 Modal
            const jobTitle = document.getElementById('job-title').textContent.trim();
            document.getElementById('modal-job-title').textContent = jobTitle;

            // A. 設定「新建履歷」按鈕 (改傳 jobId)
            const newUrl = `/Resume/Resume?jobId=${currentJobId}&mode=new`;
            document.getElementById('btn-new-resume').href = newUrl;

            // B. 設定「套用現有」按鈕的行為 (傳入 currentJobId)
            const applyBtn = document.querySelector('#existing-resume-section button');
            applyBtn.onclick = function() { goExistingResume(currentJobId); };

                    // C. 抓取下拉選單資料
        fetch('/Job/GetSavedPositions') // 確保路徑對應到 JobController
            .then(res => res.json())
            .then(data => {
                const select = document.getElementById('select-existing-pos');
                const section = document.getElementById('existing-resume-section');
                select.innerHTML = '<option value="">-- 請選擇職位 --</option>';

                if (data && data.length > 0) {
                    section.style.display = 'block';
                    data.forEach(item => {
                        const opt = document.createElement('option');
                        // 🎯 這裡要對應後端傳回的小寫欄位名 id 和 title
                        opt.value = item.id;
                        opt.textContent = item.title;
                        select.appendChild(opt);
                    });
                } else {
                    // 如果沒資料，也要隱藏區塊
                    section.style.display = 'none';
                }
            });

            document.getElementById('apply-modal').classList.add('show');
        }

                function goExistingResume(currentJobId) {
            const fromJobId = document.getElementById('select-existing-pos').value;
            if (!fromJobId) {
                alert("請選擇一個現有職位！");
                return;
            }
            // 傳送參數：jobId (目標), fromJobId (來源範本), mode (模式)
            window.location.href = `/Resume/Resume?jobId=${currentJobId}&fromJobId=${fromJobId}&mode=apply`;
        }

        function closeModal() {
            document.getElementById('apply-modal').classList.remove('show');
            document.body.style.overflow = '';
        }

        document.getElementById('apply-modal').addEventListener('click', function (e) {
            if (e.target === this) closeModal();
        });

        // ============================
        // 初始化
        // ============================
        window.addEventListener('load', function () {
            restoreFavorites();
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // 供「已投過」按鈕使用的函式
        function showPendingAlert() {
            Swal.fire({
                title: '履歷待審核中',
                text: '您已投遞過此職缺，請靜候佳音。',
                icon: 'info',
                confirmButtonColor: '#3085d6',
                confirmButtonText: '確定'
            });
        }

        // 處理從 SaveResume 跳轉回來後的成功通知
        @if (TempData["ShowSuccessAlert"] != null)
        {
                    <text>
                    Swal.fire({
                        title: '履歷已完成！',
                        text: '您的履歷已成功送出，目前待審核中。',
                        icon: 'success',
                        confirmButtonText: '確定'
                    });
                    </text>
        }
    </script>

}