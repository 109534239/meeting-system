@{
    ViewData["Title"] = "職缺搜尋";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Job_search.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
}
@{
    ViewData["Title"] = "職缺搜尋";

    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var locations = ViewBag.Locations as List<string> ?? new List<string>();
    var jobTypes = ViewBag.JobTypes as List<string> ?? new List<string>();

    string selectedCategory = ViewBag.SelectedCategory as string ?? "";
    string selectedLocation = ViewBag.SelectedLocation as string ?? "";
    string selectedType = ViewBag.SelectedType as string ?? "";
    string keyword = ViewBag.Keyword as string ?? "";
}

<div class="page-wrapper">
    <div class="page-header">
        <div class="page-header-inner">
            <h1>搜尋條件</h1>
            <p>Search Conditions</p>
        </div>
    </div>

    <!-- SEARCH BAR -->
    <div class="search-bar">
        <div class="search-inner">
            @* 1. 職缺類別 *@
            <div class="search-field">
                <label for="sel-category"><i class="fa-solid fa-layer-group"></i> 職缺類別</label>
                <select id="sel-category">
                    <option value="">全部類別</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat" selected="@(selectedCategory == cat)">@cat</option>
                    }
                </select>
            </div>

            @* 2. 工作地址 *@
            <div class="search-field">
                <label for="sel-location"><i class="fa-solid fa-location-dot"></i> 工作地址</label>
                <select id="sel-location">
                    <option value="">全部地址</option>
                    @foreach (var loc in locations)
                    {
                        <option value="@loc" selected="@(selectedLocation == loc)">@loc</option>
                    }
                </select>
            </div>

            @* 3. 工作性質 *@
            <div class="search-field">
                <label for="sel-type"><i class="fa-solid fa-briefcase"></i> 工作性質</label>
                <select id="sel-type">
                    <option value="">全部性質</option>
                    @foreach (var type in jobTypes)
                    {
                        string typeDisplay = type switch
                        {
                            "fulltime" => "全職",
                            "parttime" => "兼職",
                            "intern" => "實習",
                            _ => type
                        };
                        <option value="@type" selected="@(selectedType == type)">@typeDisplay</option>
                    }
                </select>
            </div>

            @* 4. 關鍵字搜尋 *@
            <div class="search-field keyword">
                <label for="kw-input"><i class="fa-solid fa-font"></i> 關鍵字搜尋</label>
                <input type="text" id="kw-input" value="@keyword" placeholder="輸入職缺、技能、證照等關鍵字" />
            </div>

            @* 5. 按鈕區域 *@
            <div class="filter-actions">
                <button class="search-btn" onclick="doSearch()"><i class="fa-solid fa-magnifying-glass"></i> 搜尋</button>
                <button class="reset-btn" onclick="resetSearch()"><i class="fa-solid fa-rotate-left"></i> 重置</button>
                <button class="fav-filter-btn" id="btn-toggle-fav-filter" onclick="toggleFavoriteFilter(this)" title="僅顯示收藏職缺">
                    <i class="fa-regular fa-heart"></i> 我的收藏
                </button>
            </div>
        </div>
    </div>

    <main class="main">
        <div class="job-table-head">
            <div><button type="button" class="job-sort-btn" data-sort-key="dept">職缺類型 <span class="sort-icon">⇅</span></button></div>
            <div><button type="button" class="job-sort-btn" data-sort-key="title">職缺名稱 <span class="sort-icon">⇅</span></button></div>
            <div><button type="button" class="job-sort-btn" data-sort-key="location">工作地點 <span class="sort-icon">⇅</span></button></div>
            <div><button type="button" class="job-sort-btn" data-sort-key="exp">經歷要求 <span class="sort-icon">⇅</span></button></div>
            <div><button type="button" class="job-sort-btn" data-sort-key="edu">學歷要求 <span class="sort-icon">⇅</span></button></div>
            <div><button type="button" class="job-sort-btn" data-sort-key="deadline">截止日期 <span class="sort-icon">⇅</span></button></div>
            <div></div>
            <div></div>
        </div>

        @model IEnumerable<InterviewProject.Models.Job>
        <div class="job-list" id="job-list">
            @if (Model != null && Model.Any())
            {
                foreach (var job in Model)
                {
                    @* 🎯 排序用的資料：學歷依等級轉成數字，截止日期轉成 yyyyMMdd *@
                    int eduRank = job.EducationRequired switch
                    {
                        "highschool" => 1,
                        "college" => 2,
                        "bachelor" => 3,
                        "master" => 4,
                        "phd" => 5,
                        _ => 0
                    };

                    <div class="job-row"
                         data-job-id="@job.Id"
                         data-dept="@job.Department"
                         data-title="@job.Title"
                         data-location="@job.Location"
                         data-exp="@(job.ExperienceRequired ?? "")"
                         data-edu="@eduRank"
                         data-deadline="@job.Deadline.ToString("yyyyMMdd")">

                        @* 1. 職缺類型（部門） *@
                        <div class="job-type-text">@job.Department</div>

                        @* 2. 職缺名稱 *@
                        @{
                            string bgStyle = job.JobType == "fulltime" ? "background:#e8f4ff; color:#1a6fb5;" :
                            job.JobType == "parttime" ? "background:#fff3e0; color:#e07b3a;" :
                            "background:#e8f5e9; color:#2e7d32;";
                        }
                        <div class="job-name-cell">
                            <span class="job-fulltime" style="@bgStyle">
                                @(job.JobType == "fulltime" ? "全職" : job.JobType == "parttime" ? "兼職" : "實習")
                            </span>
                            <a class="job-title-link"
                               asp-controller="Job"
                               asp-action="Job_detail"
                               asp-route-id="@job.Id">@job.Title</a>
                        </div>

                        @* 3. 工作地點 *@
                        <div class="job-cell" data-label="工作地點">@job.Location</div>

                        @* 4. 經歷要求 *@
                        <div class="job-cell" data-label="經歷要求">
                            @(string.IsNullOrEmpty(job.ExperienceRequired) ? "不限" : job.ExperienceRequired)
                        </div>

                        @* 5. 學歷要求 *@
                        <div class="job-cell" data-label="學歷要求">
                            @switch (job.EducationRequired)
                            {
                                case "highschool":
                                    @:高中職以上
                                    break;
                                case "college":
                                    @:專科以上
                                    break;
                                case "bachelor":
                                    @:大學以上
                                    break;
                                case "master":
                                    @:碩士以上
                                    break;
                                case "phd":
                                    @:博士以上
                                    break;
                                default:
                                    @:不限
                                    break;
                            }
                        </div>

                        @* 6. 截止日期 *@
                        <div class="job-cell" data-label="截止日期">@job.Deadline.ToString("yyyy/MM/dd HH:mm")</div>

                        @* 7. 立即應徵按鈕 *@
                        <div class="job-actions action-apply">
                            <a asp-controller="Job"
                               asp-action="Job_detail"
                               asp-route-id="@job.Id"
                               class="btn-apply">立即應徵</a>
                        </div>

                        @* 8. 收藏按鈕 *@
                        <div class="job-actions action-fav">
                            <button class="btn-icon btn-favorite"
                                    title="收藏"
                                    data-job-id="@job.Id"
                                    data-job-title="@job.Title"
                                    onclick="toggleFavorite(this)">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                                    <path d="M12 21C12 21 3 14 3 8a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 6-9 13-9 13z"
                                          stroke="#206c8b" stroke-width="2" fill="none" />
                                </svg>
                            </button>
                        </div>

                    </div>
                }
            }
            else
            {
                <div style="padding: 40px; text-align:center; color:#888; width: 100%;">
                    目前資料庫內沒有符合條件開放中的職缺
                </div>
            }
        </div>

        <div class="pagination" id="pagination"></div>
    </main>
</div>

@section Scripts {
    <script>
        const IS_LOGGED_IN = @Json.Serialize((bool)(ViewBag.IsLoggedIn ?? false));
        const MEMBER_ID    = @Json.Serialize((int)(ViewBag.MemberId ?? 0));

        const PAGE_SIZE = 10;
        let currentPage = 1;
        let isOnlyShowFavorites = false;

        function getFavorites() {
            const list = JSON.parse(localStorage.getItem(`favorites_${MEMBER_ID}`) || '[]');
            return list.map(id => String(id));
        }

        function saveFavorites(list) {
            localStorage.setItem(`favorites_${MEMBER_ID}`, JSON.stringify(list));
        }

        function toggleFavoriteFilter(filterBtn) {
            if (!IS_LOGGED_IN) {
                const go = confirm('需要登入才能看到你的收藏\n\n是否前往登入頁面？');
                if (go) window.location.href = '/Login';
                return;
            }

            isOnlyShowFavorites = !isOnlyShowFavorites;

            if (filterBtn) {
                filterBtn.classList.toggle('active', isOnlyShowFavorites);
            }

            currentPage = 1;
            renderPagination();
        }

        function toggleFavorite(btn) {
            if (!IS_LOGGED_IN) {
                const go = confirm('需要登入才能收藏職缺\n\n是否前往登入頁面？');
                if (go) window.location.href = '/Login';
                return;
            }

            const jobId = String(btn.dataset.jobId);
            const favorites = getFavorites();
            const index = favorites.indexOf(jobId);

            if (index === -1) {
                favorites.push(jobId);
                btn.classList.add('favorited');
            } else {
                favorites.splice(index, 1);
                btn.classList.remove('favorited');
            }
            saveFavorites(favorites);

            if (isOnlyShowFavorites) {
                renderPagination();
            }
        }

        function restoreFavorites() {
            if (!IS_LOGGED_IN) return;
            const favorites = getFavorites();
            document.querySelectorAll('.btn-favorite').forEach(btn => {
                if (favorites.includes(String(btn.dataset.jobId))) {
                    btn.classList.add('favorited');
                }
            });
        }

        function getEligibleRows() {
            const allRows = Array.from(document.querySelectorAll('#job-list .job-row'));
            if (!isOnlyShowFavorites) {
                return allRows;
            }
            const favorites = getFavorites();
            return allRows.filter(row => favorites.includes(String(row.dataset.jobId)));
        }

        function showPage(page) {
            const allRows = document.querySelectorAll('#job-list .job-row');
            const eligibleRows = getEligibleRows();
            const start = (page - 1) * PAGE_SIZE;
            const end = start + PAGE_SIZE;

            allRows.forEach(row => row.style.display = 'none');

            eligibleRows.slice(start, end).forEach(row => {
                row.style.display = '';
            });
        }

        function renderPagination() {
            const eligibleRows = getEligibleRows();
            const total = eligibleRows.length;
            const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));

            if (currentPage > totalPages) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;

            const pg = document.getElementById('pagination');
            if (!pg) return;
            pg.innerHTML = '';

            if (total === 0) {
                document.querySelectorAll('#job-list .job-row').forEach(row => row.style.display = 'none');
                pg.innerHTML = '<span class="no-data-text" style="color:#888;">無符合的職缺</span>';
                return;
            }

            const prev = document.createElement('button');
            prev.className = 'page-arrow';
            prev.innerHTML = '&#8249;';
            prev.onclick = () => { if (currentPage > 1) goPage(currentPage - 1); };
            pg.appendChild(prev);

            for (let i = 1; i <= totalPages; i++) {
                const btn = document.createElement('button');
                btn.className = 'page-num' + (i === currentPage ? ' active' : '');
                btn.textContent = i;
                btn.onclick = () => goPage(i);
                pg.appendChild(btn);
            }

            const next = document.createElement('button');
            next.className = 'page-arrow';
            next.innerHTML = '&#8250;';
            next.onclick = () => { if (currentPage < totalPages) goPage(currentPage + 1); };
            pg.appendChild(next);

            const countText = document.createElement('span');
            countText.className = 'page-total-count';
            countText.textContent = `共 ${total} 筆職缺`;
            pg.appendChild(countText);

            showPage(currentPage);
        }

        function goPage(page) {
            currentPage = page;
            renderPagination();
        }

        function doSearch() {
            const category = document.getElementById('sel-category').value;
            const location = document.getElementById('sel-location').value;
            const type     = document.getElementById('sel-type').value;
            const keyword  = document.getElementById('kw-input').value.trim();

            const params = new URLSearchParams();
            if (category) params.append('category', category);
            if (location) params.append('location', location);
            if (type)     params.append('type', type);
            if (keyword)  params.append('keyword', keyword);

            window.location.href = '/Job/Job_search?' + params.toString();
        }

        function resetSearch() {
            window.location.href = '/Job/Job_search';
        }

        // 表頭排序（職缺類型 / 職缺名稱 / 工作地點 / 經歷要求 / 學歷要求 / 截止日期）
        // 每次只套用一種排序；點同一個欄位依序切換：預設方向 → 相反方向 → 恢復原始順序
        function initSorting() {
            const jobList = document.getElementById('job-list');
            const sortButtons = Array.from(document.querySelectorAll('.job-sort-btn[data-sort-key]'));
            if (!jobList || sortButtons.length === 0) return;

            const rows = Array.from(jobList.querySelectorAll('.job-row'));
            rows.forEach((row, i) => row.dataset.originalIndex = i);

            const text = key => row => (row.dataset[key] || '').trim() || null;

            // 經歷要求：取文字中的年數（例如「3年以上」→ 3），「不限」或空白視為 0
            const expYears = row => {
                const value = (row.dataset.exp || '').trim();
                const match = value.match(/\d+(\.\d+)?/);
                return match ? parseFloat(match[0]) : 0;
            };

            const sortConfigs = {
                dept:     { type: 'text',   getValue: text('dept'),     first: 'asc', titles: { asc: '職缺類型 A → Z', desc: '職缺類型 Z → A' } },
                title:    { type: 'text',   getValue: text('title'),    first: 'asc', titles: { asc: '職缺名稱 A → Z', desc: '職缺名稱 Z → A' } },
                location: { type: 'text',   getValue: text('location'), first: 'asc', titles: { asc: '工作地點 A → Z', desc: '工作地點 Z → A' } },
                exp:      { type: 'number', getValue: expYears,         first: 'asc', titles: { asc: '經歷要求由低到高', desc: '經歷要求由高到低' } },
                edu:      { type: 'number', getValue: row => Number(row.dataset.edu || 0), first: 'asc', titles: { asc: '學歷要求由低到高', desc: '學歷要求由高到低' } },
                deadline: { type: 'number', getValue: row => row.dataset.deadline ? Number(row.dataset.deadline) : null, first: 'asc', titles: { asc: '截止日期由近到遠', desc: '截止日期由遠到近' } }
            };

            const icons = { none: '⇅', asc: '↑', desc: '↓' };
            const byOriginal = (a, b) => a.dataset.originalIndex - b.dataset.originalIndex;

            function setButtonState(btn, state) {
                const config = sortConfigs[btn.dataset.sortKey];
                if (!config) return;

                btn.dataset.sort = state;
                btn.classList.toggle('active', state !== 'none');

                const icon = btn.querySelector('.sort-icon');
                if (icon) icon.textContent = icons[state];

                btn.title = state === 'none' ? '點擊排序' : '目前：' + config.titles[state];
            }

            sortButtons.forEach(btn => {
                const config = sortConfigs[btn.dataset.sortKey];
                if (!config) return;

                setButtonState(btn, 'none');

                btn.addEventListener('click', function () {
                    const current = this.dataset.sort || 'none';
                    const opposite = config.first === 'asc' ? 'desc' : 'asc';
                    const next = current === 'none'
                        ? config.first
                        : current === config.first ? opposite : 'none';

                    sortButtons.forEach(other => {
                        if (other !== this) setButtonState(other, 'none');
                    });
                    setButtonState(this, next);

                    const sorted = rows.slice().sort((a, b) => {
                        if (next === 'none') return byOriginal(a, b);

                        const va = config.getValue(a);
                        const vb = config.getValue(b);

                        // 沒有資料的職缺永遠排最後
                        if (va === null && vb === null) return byOriginal(a, b);
                        if (va === null) return 1;
                        if (vb === null) return -1;

                        const diff = config.type === 'text'
                            ? va.localeCompare(vb, 'zh-Hant-TW')
                            : va - vb;

                        const result = next === 'asc' ? diff : -diff;
                        return result !== 0 ? result : byOriginal(a, b); // 相同時維持原順序
                    });

                    // 移動既有節點（收藏按鈕狀態會保留），再從第 1 頁重新分頁
                    jobList.append(...sorted);
                    currentPage = 1;
                    renderPagination();
                });
            });
        }

        window.addEventListener('load', function () {
            restoreFavorites();
            initSorting();
            renderPagination();
        });
    </script>
}