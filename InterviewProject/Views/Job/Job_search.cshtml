        </div>


        <!-- PAGINATION -->
        <div class="pagination" id="pagination"></div>
    </main>
</div>




@section Scripts {
  <script>
    const PAGE_SIZE = 20;
    let currentPage = 1;

    function checkLogin(jobTitle, btn) {
      const isLoggedIn = localStorage.getItem('isLoggedIn') === 'true';
      if (!isLoggedIn) {
        const go = confirm('需要登入才能收藏職缺\n\n是否前往登入頁面？');
        if (go) window.location.href = '/Login';
        return;
      }

      // 已登入 → 切換收藏狀態
      const favorites = JSON.parse(localStorage.getItem('favorites') || '[]');
      const index = favorites.indexOf(jobTitle);

      if (index === -1) {
        // 尚未收藏 → 加入，按鈕變淺藍
        favorites.push(jobTitle);
        btn.style.background = 'var(--primary-light)';
      } else {
        // 已收藏 → 取消，按鈕還原灰色
        favorites.splice(index, 1);
        btn.style.background = 'var(--gray)';
      }

      localStorage.setItem('favorites', JSON.stringify(favorites));
    }

    function getTotalRows() {
      return document.querySelectorAll('#job-list .job-row').length;
    }

    function renderPagination() {
      const total = getTotalRows();
      const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
      const pg = document.getElementById('pagination');
      pg.innerHTML = '';

      const prev = document.createElement('button');
      prev.className = 'page-arrow';
      prev.innerHTML = '&#8249;';
      prev.onclick = () => { if (currentPage > 1) goPage(currentPage - 1); };
      pg.appendChild(prev);

      for (let i = 1; i <= totalPages; i++) {
        const btn = document.createElement('button');
        btn.className = 'page-num' + (i === currentPage ? ' active' : '');
        btn.textContent = i;
        btn.onclick = () => goPage(i);
        pg.appendChild(btn);
      }

      const next = document.createElement('button');
      next.className = 'page-arrow';
      next.innerHTML = '&#8250;';
      next.onclick = () => { if (currentPage < totalPages) goPage(currentPage + 1); };
      pg.appendChild(next);
    }

    function goPage(page) {
      currentPage = page;
      renderPagination();
    }

    function setActive(btn) {
      document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    }

    function removeFilter() {
      document.getElementById('active-filter').style.display = 'none';
    }

    function doSearch() {
      const kw = document.getElementById('kw-input').value;
      if (kw) alert('搜尋關鍵字：' + kw + '\n（此為示範，實際串接後端後會過濾結果）');
    }

    function resetSearch() {
      document.getElementById('sel-category').value = '';
      document.getElementById('sel-location').value = '';
      document.getElementById('sel-type').value = '';
      document.getElementById('kw-input').value = '';
    }
  </script>
}
