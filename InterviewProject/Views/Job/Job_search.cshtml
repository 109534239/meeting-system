@{
    ViewData["Title"] = "職缺搜尋";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Job_search.css" asp-append-version="true" />
}

<!-- PAGE HEADER -->
<div class="page-wrapper">
    <div class="page-header">
        <div class="page-header-inner">
        <h1>搜尋條件</h1>
        <p>Search Conditions</p>
        </div>
    </div>

    <!-- SEARCH BAR -->
    <div class="search-bar">
        <div class="search-inner">
        <div class="search-field">
            <label>職缺類別</label>
            <select id="sel-category">
            <option value="">全部類別</option>
            <option value="pm">專案管理</option>
            <option value="it">資訊技術</option>
            <option value="hr">人力資源</option>
            <option value="mkt">行銷企劃</option>
            <option value="fin">財務會計</option>
            <option value="sales">業務銷售</option>
            </select>
        </div>
        <div class="search-field">
            <label>工作地址</label>
            <select id="sel-location">
            <option value="">全部地址</option>
            <option value="taipei">台北內湖</option>
            <option value="xinbei">新北汐止</option>
            <option value="hsinchu1">新竹竹北</option>
            <option value="hsinchu2">新竹湖口</option>
            </select>
        </div>
        <div class="search-field">
            <label>工作性質</label>
            <select id="sel-type">
            <option value="">全部性質</option>
            <option value="full">全職</option>
            <option value="part">兼職</option>
            <option value="intern">實習</option>
            </select>
        </div>
        <div class="search-field keyword">
            <label>關鍵字搜尋</label>
            <input type="text" id="kw-input" placeholder="輸入職缺、技能、證照等關鍵字" />
        </div>
        <button class="search-btn" onclick="doSearch()">搜尋</button>
        <button class="reset-btn" onclick="resetSearch()">重置</button>
        </div>
    </div>

    <!-- MAIN -->
    <main class="main">

        <!-- RESULT META -->
        <div class="result-meta">
        <div class="result-count">共 <span id="result-num">7</span> 筆職缺</div>
        <div class="filter-tag" id="active-filter" style="display:none">
            專案管理 <button onclick="removeFilter()">×</button>
        </div>
        </div>

        <!-- TABLE HEADER -->
        <div class="job-table-head">
        <div>職缺類型</div>
        <div>職缺名稱</div>
        <div>工作地點</div>
        <div class="sortable">經歷</div>
        <div class="sortable">學歷</div>
        <div></div>
        <div></div>
        </div>

        <!-- JOB LIST -->
        <div class="job-list" id="job-list">

            <div class="job-row">
                <div class="job-type-text">專案管理</div>
                <div class="job-name-cell">
                    <span class="job-fulltime">全職</span>
                    <a class="job-title-link" href="@Url.Action("Job_detail", "Job")">NB產品經理_260502001</a>
                </div>
                <div class="job-cell">新北汐止</div>
                <div class="job-cell">3年以上</div>
                <div class="job-cell">大學以上</div>
                <div class="job-actions">
                    <a href="@Url.Action("Job_detail", "Job")" class="btn-apply">立即應徵</a>
                </div> 
                <div class="job-actions">
                    <button class="btn-icon" title="收藏" onclick="checkLogin('NB產品經理_260502001', this)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                            <path d="M12 21C12 21 3 14 3 8a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 6-9 13-9 13z" stroke="#206c8b" stroke-width="2" fill="none"/>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="job-row">
                <div class="job-type-text">資訊技術</div>
                <div class="job-name-cell">
                    <span class="job-fulltime">全職</span>
                    <a class="job-title-link" href="@Url.Action("Job_detail", "Job")">前端工程師_260502002</a>
                </div>
                <div class="job-cell">台北內湖</div>
                <div class="job-cell">3年以上</div>
                <div class="job-cell">大學以上</div>
                <div class="job-actions">
                    <a href="@Url.Action("Job_detail", "Job")" class="btn-apply">立即應徵</a>
                </div>  
                <div class="job-actions"> 
                    <button class="btn-icon" title="收藏" onclick="checkLogin('前端工程師_260502002', this)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                            <path d="M12 21C12 21 3 14 3 8a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 6-9 13-9 13z" stroke="#206c8b" stroke-width="2" fill="none"/>
                        </svg>
