@{
    ViewData["Title"] = "職缺搜尋";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Job_search.css" asp-append-version="true" />
}

<div class="page-wrapper">
    <div class="page-header">
        <div class="page-header-inner">
            <h1>搜尋條件</h1>
            <p>Search Conditions</p>
        </div>
    </div>

    <div class="search-bar">
        <div class="search-inner">
            <div class="search-field">
                <label>職缺類別</label>
                <select id="sel-category">
                    <option value="">全部類別</option>
                    <option value="pm" selected="@(ViewBag.SelectedCategory == "pm")">專案管理</option>
                    <option value="it" selected="@(ViewBag.SelectedCategory == "it")">資訊技術</option>
                    <option value="mkt" selected="@(ViewBag.SelectedCategory == "mkt")">行銷企劃</option>
                    <option value="fin" selected="@(ViewBag.SelectedCategory == "fin")">財務會計</option>
                    <option value="sales" selected="@(ViewBag.SelectedCategory == "sales")">業務銷售</option>
                </select>
            </div>
            <div class="search-field">
                <label>工作地址</label>
                <select id="sel-location">
                    <option value="">全部地址</option>
                    <option value="taipei" selected="@(ViewBag.SelectedLocation == "taipei")">台北內湖</option>
                    <option value="xinbei" selected="@(ViewBag.SelectedLocation == "xinbei")">新北汐止</option>
                    <option value="hsinchu1" selected="@(ViewBag.SelectedLocation == "hsinchu1")">新竹竹北</option>
                    <option value="hsinchu2" selected="@(ViewBag.SelectedLocation == "hsinchu2")">新竹湖口</option>
                </select>
            </div>
            <div class="search-field">
                <label>工作性質</label>
                <select id="sel-type">
                    <option value="">全部性質</option>
                    <option value="full" selected="@(ViewBag.SelectedType == "full")">全職</option>
                    <option value="part" selected="@(ViewBag.SelectedType == "part")">兼職</option>
                    <option value="intern" selected="@(ViewBag.SelectedType == "intern")">實習</option>
                </select>
            </div>
            <div class="search-field keyword">
                <label>關鍵字搜尋</label>
                <input type="text" id="kw-input" value="@ViewBag.Keyword" placeholder="輸入職缺、技能、證照等關鍵字" />
            </div>
            <button class="search-btn" onclick="doSearch()">搜尋</button>
            <button class="reset-btn" onclick="resetSearch()">重置</button>
        </div>
    </div>

    <main class="main">

        <div class="result-meta">
            <div class="filter-tag" id="active-filter" style="display:none">
                專案管理 <button onclick="removeFilter()">×</button>
            </div>
        </div>

        <div class="job-table-head">
            <div>職缺類型</div>
            <div>職缺名稱</div>
            <div>工作地點</div>
            <div>經歷要求</div>
            <div>學歷要求</div>
            <div>截止日期</div>
            <div></div>
            <div></div>
        </div>

        @model IEnumerable<InterviewProject.Models.Job>
        <div class="job-list" id="job-list">
            @if (Model != null && Model.Any())
            {
                foreach (var job in Model)
                {
                    <div class="job-row">

                        @* 1. 職缺類型（部門） *@
                        <div class="job-type-text">@job.Department</div>

                        @* 2. 職缺名稱 *@
                        <div class="job-name-cell">
                            <span class="job-fulltime">
                                @(job.JobType == "fulltime" ? "全職" : job.JobType == "parttime" ? "兼職" : "實習")
                            </span>
                            <a class="job-title-link"
                               asp-controller="Job"
                               asp-action="Job_detail"
                               asp-route-id="@job.Id">@job.Title</a>
                        </div>

                        @* 3. 工作地點 *@
                        <div class="job-cell">@job.Location</div>

                        @* 4. 經歷要求 *@
                        <div class="job-cell">
                            @(string.IsNullOrEmpty(job.ExperienceRequired) ? "不限" : job.ExperienceRequired)
                        </div>

                        @* 5. 學歷要求 *@
                        <div class="job-cell">
                            @switch (job.EducationRequired)
                            {
                                case "highschool": @:高中職以上
                                    break;
                                case "college": @:專科以上
                                    break;
                                case "bachelor": @:大學以上
                                    break;
                                case "master": @:碩士以上
                                    break;
                                case "phd": @:博士以上
                                    break;
                                default: @:不限
                                    break;
                            }
                        </div>

                        @* 6. 截止日期 *@
                        <div class="job-cell">@job.Deadline.ToString("yyyy/MM/dd")</div>

                        @* 7. 立即應徵按鈕 *@
                        <div class="job-actions">
                            <a asp-controller="Job"
                               asp-action="Job_detail"
                               asp-route-id="@job.Id"
                               class="btn-apply">立即應徵</a>
                        </div>

                        @* 8. 收藏按鈕 *@
                        <div class="job-actions">
                            <button class="btn-icon btn-favorite"
                                    title="收藏"
                                    data-job-id="@job.Id"
                                    data-job-title="@job.Title">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                                    <path d="M12 21C12 21 3 14 3 8a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 6-9 13-9 13z"
                                        stroke="#206c8b" stroke-width="2" fill="none" />
                                </svg>
                            </button>
                        </div>

                    </div>
                }
            }
            else
            {
                <div style="padding: 40px; text-align:center; color:#888; width: 100%;">
                    目前資料庫內沒有符合條件開放中的職缺
                </div>
            }
        </div>

        <div class="pagination" id="pagination"></div>
    </main>
</div>

@section Scripts {
    <script>
        // 💡 修正：View 裡要用 HttpContext
        const IS_LOGGED_IN = @Json.Serialize((bool)ViewBag.IsLoggedIn);
        const MEMBER_ID    = @Json.Serialize((int)ViewBag.MemberId);

        const PAGE_SIZE = 10;
        let currentPage = 1;

        // ============================
        // 收藏功能
        // ============================
        function getFavorites() {
            return JSON.parse(localStorage.getItem(`favorites_${MEMBER_ID}`) || '[]');
        }

        function saveFavorites(list) {
            localStorage.setItem(`favorites_${MEMBER_ID}`, JSON.stringify(list));
        }

        function toggleFavorite(btn) {
            // 未登入 → 提示並跳轉
            if (!IS_LOGGED_IN) {
                const go = confirm('需要登入才能收藏職缺\n\n是否前往登入頁面？');
                if (go) window.location.href = '/Login';
                return;
            }

            const jobId = btn.dataset.jobId;
            const favorites = getFavorites();
            const index = favorites.indexOf(jobId);

            if (index === -1) {
                favorites.push(jobId);
                btn.classList.add('favorited');
            } else {
                favorites.splice(index, 1);
                btn.classList.remove('favorited');
            }
            saveFavorites(favorites);
        }

        // 頁面載入時，還原已收藏的按鈕狀態
        function restoreFavorites() {
            if (!IS_LOGGED_IN) return;
            const favorites = getFavorites();
            document.querySelectorAll('.btn-favorite').forEach(btn => {
                if (favorites.includes(btn.dataset.jobId)) {
                    btn.classList.add('favorited');
                }
            });
        }

        // 綁定所有收藏按鈕
        document.querySelectorAll('.btn-favorite').forEach(btn => {
            btn.addEventListener('click', () => toggleFavorite(btn));
        });

        // ============================
        // 分頁
        // ============================
        function getTotalRows() {
            return document.querySelectorAll('#job-list .job-row').length;
        }

         // 依目前頁碼，只顯示該頁應出現的職缺列，其餘隱藏
        function showPage(page) {
            const rows = document.querySelectorAll('#job-list .job-row');
            const start = (page - 1) * PAGE_SIZE;
            const end = start + PAGE_SIZE;
            rows.forEach((row, idx) => {
                row.style.display = (idx >= start && idx < end) ? '' : 'none';
            });
        }

        function renderPagination() {
            const total = getTotalRows();
            const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));

             // 頁碼超出範圍時自動修正（例如篩選後總筆數變少）
            if (currentPage > totalPages) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;

            const pg = document.getElementById('pagination');
            if (!pg) return;
            pg.innerHTML = '';

            const prev = document.createElement('button');
            prev.className = 'page-arrow';
            prev.innerHTML = '&#8249;';
            prev.onclick = () => { if (currentPage > 1) goPage(currentPage - 1); };
            pg.appendChild(prev);

            for (let i = 1; i <= totalPages; i++) {
                const btn = document.createElement('button');
                btn.className = 'page-num' + (i === currentPage ? ' active' : '');
                btn.textContent = i;
                btn.onclick = () => goPage(i);
                pg.appendChild(btn);
            }

            const next = document.createElement('button');
            next.className = 'page-arrow';
            next.innerHTML = '&#8250;';
            next.onclick = () => { if (currentPage < totalPages) goPage(currentPage + 1); };
            pg.appendChild(next);

             // 總筆數文字，顯示在頁碼按鈕之後
            const countText = document.createElement('span');
            countText.className = 'page-total-count';
            countText.style.marginLeft = '12px';
            countText.style.color = '#666';
            countText.style.fontSize = '14px';
            countText.textContent = `共 ${total} 筆職缺`;
            pg.appendChild(countText);

            showPage(currentPage);
        }

        function goPage(page) {
            currentPage = page;
            renderPagination();
        }

        function removeFilter() {
            document.getElementById('active-filter').style.display = 'none';
        }

        function doSearch() {
            const category = document.getElementById('sel-category').value;
            const location = document.getElementById('sel-location').value;
            const type     = document.getElementById('sel-type').value;
            const keyword  = document.getElementById('kw-input').value.trim();

            const params = new URLSearchParams();
            if (category) params.append('category', category);
            if (location) params.append('location', location);
            if (type)     params.append('type', type);
            if (keyword)  params.append('keyword', keyword);

            window.location.href = '/Job/Job_search?' + params.toString();
        }

        function resetSearch() {
            window.location.href = '/Job/Job_search';
        }

        // ============================
        // 初始化
        // ============================
        window.addEventListener('load', function () {
            restoreFavorites();
            renderPagination();
        });
    </script>
}