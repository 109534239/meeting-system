<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InterviewProject</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/InterviewProject.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="nav-container">
                <a class="nav-brand" href="home - 複製.html">
                    <div class="logo-circle">LOGO</div>
                    <span class="brand-name">XXX公司</span>
                </a>
                <div class="nav-links">
                    <a class="nav-btn active" asp-controller="Home" asp-action="Index">首頁</a>
                    <a href="job_search.html" class="nav-btn">職缺搜尋</a>
                    <a href="introduction.html" class="nav-btn">公司介紹</a>
                    <a href="faq.html" class="nav-btn">求職Q&A</a>
                </div>
                <!-- 未登入 -->
                <a href="/Login" class="nav-user" id="btn-login"><span>登入</span></a>

                <!-- 登入後（預設隱藏，登入後顯示） -->
                <div class="nav-user-logged" id="user-logged" style="display:none">
                    <div class="nav-avatar" onclick="toggleDropdown()">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                            <circle cx="12" cy="8" r="4" fill="#fff" />
                            <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" stroke="#fff" stroke-width="2" stroke-linecap="round" fill="none" />
                        </svg>
                    </div>
                    <div class="dropdown-menu" id="dropdown-menu">
                        <a href="profile.html" class="dropdown-item">基本資料</a>
                        <a href="resume.html" class="dropdown-item">我的履歷</a>
                        <a href="applications.html" class="dropdown-item">應徵管理</a>
                        <a href="favorites.html" class="dropdown-item">我的收藏</a>
                        <button class="dropdown-item logout" onclick="logout()">登出</button>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container text-center">
            <p>© 2026 XXX公司 版權所有 ｜ <a href="#">隱私權政策</a> ｜ <a href="#">聯絡我們</a></p>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
