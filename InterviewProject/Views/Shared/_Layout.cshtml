@{ 
    var controller = ViewContext.RouteData.Values["controller"]?.ToString(); 
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var memberId = Context.Session.GetInt32("MemberId");
    var memberName = Context.Session.GetString("MemberName");
    var memberRole = Context.Session.GetString("MemberRole");
    var isLoggedIn = memberId.HasValue;
    var roleLabel = memberRole == "employee" ? "人資" : "求職者";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InterviewProject</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@ViewData["BodyClass"]">
    <header>
        <nav class="navbar">
            <div class="nav-container">
                <a class="nav-brand" asp-controller="Home" asp-action="Index">
                    <div class="logo-circle">LOGO</div>
                    <span class="brand-name">XXX公司</span>
                </a>

                <div class="nav-links">
                    <a class="nav-btn @(controller == "Home" && action == "Index" ? "active" : "")" 
                    asp-controller="Home" asp-action="Index">首頁</a>
                    
                    <a class="nav-btn @(controller == "Job" && action == "Job_search" ? "active" : "")" 
                    asp-controller="Job" asp-action="Job_search">職缺搜尋</a>
                    
                    <a class="nav-btn @(controller == "Introduction" && action == "Index" ? "active" : "")"
                    asp-controller="Introduction" asp-action="Index">公司介紹</a>
                    
                    <a class="nav-btn @(controller == "FAQ" && action == "Index" ? "active" : "")" 
                    asp-controller="FAQ" asp-action="Index">求職Q&A</a>
                </div>

                @if (!isLoggedIn)
                {
                    <!-- 未登入 -->
                    <a href="/Login" class="nav-user"><span>登入</span></a>
                }
                else
                {
                    <!-- 登入後身份顯示 -->
                    <div class="nav-identity">
                        <span>@roleLabel：@memberName</span>
                    </div>

                    <!-- 頭像下拉 -->
                    <div class="nav-user-logged">
                        <div class="nav-avatar" onclick="toggleDropdown()">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                                <circle cx="12" cy="8" r="4" fill="#fff" />
                                <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" stroke="#fff" stroke-width="2" stroke-linecap="round" fill="none" />
                            </svg>
                        </div>
                        <div class="dropdown-menu" id="dropdown-menu">
                            <a asp-controller="Member" asp-action="Profile" class="dropdown-item">基本資料</a>
                            <a asp-controller="Member" asp-action="Resume" class="dropdown-item">我的履歷</a>
                            <a asp-controller="Member" asp-action="Application" class="dropdown-item">應徵管理</a>
                            <a asp-controller="Member" asp-action="Favorites" class="dropdown-item">我的收藏</a>
                            <a asp-controller="Login" asp-action="Logout" class="dropdown-item logout">登出</a>
                        </div>
                    </div>
                }
            </div>
        </nav>
    </header>
    
    @RenderBody()

    <footer class="footer">
        <div class="container text-center">
            <p>© 2026 XXX公司 版權所有 ｜ <a href="#">隱私權政策</a> ｜ <a href="#">聯絡我們</a></p>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function toggleDropdown() {
            document.getElementById('dropdown-menu').classList.toggle('show');
        }

        document.addEventListener('click', function (e) {
            const userLogged = document.querySelector('.nav-user-logged');
            if (userLogged && !userLogged.contains(e.target)) {
                const menu = document.getElementById('dropdown-menu');
                if (menu) menu.classList.remove('show');
            }
        });
    </script>
</body>
</html>