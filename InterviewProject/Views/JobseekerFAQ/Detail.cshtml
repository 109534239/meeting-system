@model InterviewProject.Models.FAQReport

@{
    ViewData["Title"] = "查看 Q&A";
    var isReplied = Model.Status == "已回覆";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_Layout.css"asp-append-version="true" />
    <link rel="stylesheet" href="~/css/JobseekerFAQ.css"asp-append-version="true" />
}

<div class="page-header">
    <div class="page-header-inner">
        <h1>查看 Q&amp;A</h1>
        <p>Question &amp; Answer Details</p>
    </div>
</div>

<main class="qa-detail-wrap">

    <!-- 頁面頂部資訊 -->
    <section class="qa-page-summary">
        <div class="qa-page-title">
            <span class="qa-category">@Model.Category</span>
            <h2>@Model.Subject</h2>
        </div>
        <span class="qa-status @(isReplied ? "is-replied" : "is-pending")">
            <span class="qa-status-dot"></span>
            @Model.Status
        </span>

    </section>

    <!-- 問題與回覆雙卡片 -->
    <div class="qa-content-grid">
        <!-- 我的提問卡片 -->
        <article class="qa-content-card question-card">
            <header class="qa-content-card-header">
                <div class="qa-section-icon question-icon">
                    Q
                </div>
                <div>
                    <h3>我的提問</h3>
                    <p>您提交給企業的問題內容</p>
                </div>
            </header>
            <div class="qa-content-body">@Model.Content</div>
        </article>

        <!-- 企業回覆卡片 -->
        <article class="qa-content-card answer-card">
            <header class="qa-content-card-header">
                <div class="qa-section-icon answer-icon">
                    A
                </div>
                <div>
                    <h3>企業回覆</h3>
                    <p>
                        @(isReplied
                            ? "企業對此問題的回覆內容"
                            : "目前尚未收到企業的回覆")
                    </p>
                </div>
            </header>

            @if (!string.IsNullOrWhiteSpace(Model.ReplyContent))
            {
                <div class="qa-content-body answer-content">@Model.ReplyContent</div>
            }
            else
            {
                <div class="qa-pending-box">
                    <div class="qa-pending-icon">
                        •••
                    </div>
                    <div>
                        <h4>問題等待回覆中</h4>
                        <p>企業尚未回覆此問題，請耐心等候。</p>
                    </div>
                </div>
            }
        </article>

    </div>

    <!-- 操作按鈕 -->
    <div class="qa-detail-actions">
        <a asp-controller="JobseekerFAQ"
           asp-action="Index"
           class="btn-back">
            返回我的 Q&amp;A
        </a>
    </div>

</main>

@section Scripts {
    <script>
        function closeThisTab() {
            if (window.opener && !window.opener.closed) {
                window.close();
                return;
            }

            window.location.href =
                '@Url.Action("Index", "JobseekerFAQ")';
        }
    </script>
}