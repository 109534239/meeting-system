@{
    ViewData["Title"] = "我的收藏";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Job_search.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Favorites.css" asp-append-version="true" />
}

<div class="page-wrapper">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="page-header-inner">
            <h1>我的收藏</h1>
            <p>My Favorites</p>
        </div>
    </div>

    <!-- MAIN -->
    <main class="main">

        <!-- RESULT META -->
        <div class="result-meta">
            <div class="result-count">共 <span id="result-num">0</span> 筆收藏</div>
        </div>

        <!-- TABLE HEADER -->
        <div class="job-table-head">
            <div>職缺類型</div>
            <div>職缺名稱</div>
            <div>工作地點</div>
            <div>經歷</div>
            <div>學歷</div>
            <div></div>
            <div></div>
        </div>

        <!-- JOB LIST -->
        <div class="job-list" id="favorites-list">
            <!-- 由 JavaScript 動態產生 -->
        </div>

        <!-- 無收藏提示 -->
        <div class="empty-msg" id="empty-msg" style="display:none">
            <p>目前沒有收藏的職缺</p>
            <a asp-controller="Job" asp-action="Job_search" class="btn-go-search">前往搜尋職缺</a>
        </div>

    </main>
</div>

@section Scripts {
<script>
    // 靜態職缺資料（之後串接後端）
    const allJobs = [
        { title: 'NB產品經理_260502001', type: '專案管理', location: '新北汐止', exp: '3年以上', edu: '大學以上' },
        { title: '前端工程師_260502002', type: '資訊技術', location: '台北內湖', exp: '3年以上', edu: '大學以上' },
        { title: 'HR 招募專員_260502003', type: '人力資源', location: '新竹竹北', exp: '1年以上', edu: '大學以上' },
        { title: '數位行銷專員_260502004', type: '行銷企劃', location: '新北汐止', exp: '2年以上', edu: '大學以上' },
        { title: '財務分析師_260502005', type: '財務會計', location: '新竹湖口', exp: '3年以上', edu: '大學以上' },
        { title: '業務開發專員_260502006', type: '業務銷售', location: '台北內湖', exp: '2年以上', edu: '大學以上' },
        { title: '行政助理_260502007', type: '行政管理', location: '新竹竹北', exp: '不限', edu: '大學以上' },
    ];

    function renderFavorites() {
        const favorites = JSON.parse(localStorage.getItem('favorites') || '[]');
        const list = document.getElementById('favorites-list');
        const emptyMsg = document.getElementById('empty-msg');
        const resultNum = document.getElementById('result-num');

        list.innerHTML = '';

        const favJobs = allJobs.filter(job => favorites.includes(job.title));
        resultNum.textContent = favJobs.length;

        if (favJobs.length === 0) {
            emptyMsg.style.display = 'block';
            return;
        }

        emptyMsg.style.display = 'none';

        favJobs.forEach(job => {
            const row = document.createElement('div');
            row.className = 'job-row';
            row.innerHTML = `
                <div class="job-type-text">${job.type}</div>
                <div class="job-name-cell">
                    <span class="job-fulltime">全職</span>
                    <a class="job-title-link" href="/Job/Job_detail">${job.title}</a>
                </div>
                <div class="job-cell">${job.location}</div>
                <div class="job-cell">${job.exp}</div>
                <div class="job-cell">${job.edu}</div>
                <div class="job-actions">
                    <a href="/Job/Job_detail" class="btn-apply">立即應徵</a>
                </div>
                <div class="job-actions">
                    <button class="btn-icon favorited" title="取消收藏" onclick="removeFavorite('${job.title}', this)" style="background: var(--primary-light)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                            <path d="M12 21C12 21 3 14 3 8a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 6-9 13-9 13z" stroke="#206c8b" stroke-width="2" fill="none"/>
                        </svg>
                    </button>
                </div>
            `;
            list.appendChild(row);
        });
    }

    function removeFavorite(jobTitle, btn) {
        const favorites = JSON.parse(localStorage.getItem('favorites') || '[]');
        const index = favorites.indexOf(jobTitle);
        if (index !== -1) {
            favorites.splice(index, 1);
            localStorage.setItem('favorites', JSON.stringify(favorites));
        }
        renderFavorites();
    }

    // 頁面載入時渲染
    window.addEventListener('load', renderFavorites);
</script>
}