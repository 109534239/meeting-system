@{
    ViewData["Title"] = "我的收藏";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Favorites.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Job_search.css" asp-append-version="true" />
}

<div class="page-wrapper">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="page-header-inner">
            <h1>我的收藏</h1>
            <p>My Favorites</p>
        </div>
    </div>

    <!-- MAIN -->
    <main class="main">

        <!-- RESULT META -->
        <div class="result-meta">
            <div class="result-count">共 <span id="result-num">0</span> 筆收藏</div>
        </div>

        <!-- TABLE HEADER -->
        <div class="job-table-head">
            <div>職缺類型</div>
            <div>職缺名稱</div>
            <div>工作地點</div>
            <div>經歷</div>
            <div>學歷</div>
            <div></div>
            <div></div>
        </div>

        <!-- JOB LIST -->
        <div class="job-list" id="favorites-list">
            <!-- 由 JavaScript 動態產生 -->
        </div>

        <!-- 無收藏提示 -->
        <div class="empty-msg" id="empty-msg" style="display:none">
            <p>目前沒有收藏的職缺</p>
            <a asp-controller="Job" asp-action="Job_search" class="btn-go-search">前往搜尋職缺</a>
        </div>

    </main>
</div>

@section Scripts {
    <script>
        const MEMBER_ID = @Json.Serialize((int)ViewBag.MemberId);

        function getFavorites() {
            return JSON.parse(localStorage.getItem(`favorites_${MEMBER_ID}`) || '[]');
        }

        function saveFavorites(list) {
            localStorage.setItem(`favorites_${MEMBER_ID}`, JSON.stringify(list));
        }

        async function renderFavorites() {
            const favorites = getFavorites();
            const list      = document.getElementById('favorites-list');
            const emptyMsg  = document.getElementById('empty-msg');
            const resultNum = document.getElementById('result-num');

            list.innerHTML = '';

            if (favorites.length === 0) {
                resultNum.textContent = 0;
                emptyMsg.style.display = 'block';
                return;
            }

            // 💡 向後端查詢這些 Id 的職缺資料
            const res  = await fetch(`/Job/GetJobsByIds?ids=${favorites.join(',')}`);
            const jobs = await res.json();

            resultNum.textContent = jobs.length;

            if (jobs.length === 0) {
                emptyMsg.style.display = 'block';
                return;
            }

            emptyMsg.style.display = 'none';

            jobs.forEach(job => {
                const eduMap = {
                    highschool: '高中職以上', college: '專科以上',
                    bachelor: '大學以上', master: '碩士以上', phd: '博士以上'
                };
                const edu     = eduMap[job.educationRequired] || '不限';
                const exp     = job.experienceRequired || '不限';
                const jobType = job.jobType === 'fulltime' ? '全職'
                            : job.jobType === 'parttime' ? '兼職' : '實習';

                const row = document.createElement('div');
                row.className = 'job-row';
                row.innerHTML = `
                    <div class="job-type-text">${job.department}</div>
                    <div class="job-name-cell">
                        <span class="job-fulltime">${jobType}</span>
                        <a class="job-title-link" href="/Job/Job_detail/${job.id}">${job.title}</a>
                    </div>
                    <div class="job-cell">${job.location}</div>
                    <div class="job-cell">${exp}</div>
                    <div class="job-cell">${edu}</div>
                    <div class="job-actions">
                        <a href="/Job/Job_detail/${job.id}" class="btn-apply">立即應徵</a>
                    </div>
                    <div class="job-actions">
                        <button class="btn-icon btn-favorite favorited"
                                title="取消收藏"
                                data-job-id="${job.id}"
                                onclick="removeFavorite('${job.id}', this)">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                                <path d="M12 21C12 21 3 14 3 8a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 6-9 13-9 13z"
                                    stroke="#206c8b" stroke-width="2" fill="#206c8b"/>
                            </svg>
                        </button>
                    </div>
                `;
                list.appendChild(row);
            });
        }

        function removeFavorite(jobId, btn) {
            const favorites = getFavorites();
            const index = favorites.indexOf(String(jobId));
            if (index !== -1) {
                favorites.splice(index, 1);
                saveFavorites(favorites);
            }
            renderFavorites();
        }

        window.addEventListener('load', renderFavorites);
    </script>
}