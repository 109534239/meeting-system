@model IEnumerable<InterviewProject.Models.Resume>
@{
    ViewData["Title"] = "應徵管理";
    var roomsByResumeId = ViewBag.RoomsByResumeId as Dictionary<int, InterviewProject.Models.Room>
                        ?? new Dictionary<int, InterviewProject.Models.Room>();
    var completedTestResumeIds = ViewBag.CompletedTestResumeIds as HashSet<int>
                        ?? new HashSet<int>();
    // 取得當前選取的條件與動態選單資料
    string currentSort = ViewBag.VisitorSort as string ?? "desc";
    string currentStatus = ViewBag.SelectedStatus as string ?? "";
    string currentInterviewStatus = ViewBag.SelectedInterviewStatus as string ?? "";
    string currentAdmissionResult = ViewBag.SelectedAdmissionResult as string ?? "";

    var statusList = ViewBag.StatusList as List<string> ?? new List<string>();
    var interviewStatusList = ViewBag.InterviewStatusList as List<string> ?? new List<string>();
    var admissionResultList = ViewBag.AdmissionResultList as List<string> ?? new List<string>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Application.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Job_search.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.5);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

            .modal-overlay.active {
                display: flex;
            }

        .modal-box {
            position: relative;
            background: #fff;
            border-radius: 10px;
            max-width: 560px;
            width: 92%;
            max-height: 85vh;
            overflow-y: auto;
            padding: 28px 26px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.25);
        }

        .modal-close {
            position: absolute;
            top: 12px;
            right: 16px;
            border: none;
            background: none;
            font-size: 22px;
            line-height: 1;
            cursor: pointer;
            color: #888;
        }

            .modal-close:hover {
                color: #333;
            }

        .modal-loading, .modal-error {
            text-align: center;
            padding: 30px 0;
            color: #888;
        }

        .apt-question {
            margin-bottom: 16px;
            padding-bottom: 14px;
            border-bottom: 1px solid #eee;
        }

        .apt-question-text {
            margin: 0 0 8px 0;
            font-size: 14px;
            color: #333;
        }

        .apt-scale {
            display: flex;
            justify-content: space-between;
            gap: 6px;
        }

        .apt-scale-option {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            font-size: 12px;
            color: #666;
            cursor: pointer;
        }
    </style>
}

<!-- PAGE HEADER -->
<div class="page-header">
    <div class="page-header-inner">
        <h1>應徵管理</h1>
        <p>Application Management</p>
    </div>
</div>

<!-- FILTER BAR -->
<form id="filterForm" method="get" action="@Url.Action("Application", "Member")">
    <div class="search-bar">
        <div class="search-inner">
            @* 1. 投遞時間（排序） *@
            <div class="search-field">
                <label for="sel-sort"><i class="fa-regular fa-clock"></i> 投遞時間</label>
                <select id="sel-sort" name="visitorSort" onchange="this.form.submit()">
                    <option value="desc" selected="@(currentSort == "desc")">時間由新到舊</option>
                    <option value="asc" selected="@(currentSort == "asc")">時間由舊到新</option>
                </select>
            </div>

            @* 2. 履歷狀態 *@
            <div class="search-field">
                <label for="sel-status"><i class="fa-regular fa-file-lines"></i> 履歷狀態</label>
                <select id="sel-status" name="status">
                    <option value="">全部狀態</option>
                    @foreach (var st in statusList)
                    {
                        <option value="@st" selected="@(currentStatus == st)">@st</option>
                    }
                </select>
            </div>

            @* 3. 面試狀態 *@
            <div class="search-field">
                <label for="sel-interview"><i class="fa-regular fa-comments"></i> 面試狀態</label>
                <select id="sel-interview" name="interviewStatus">
                    <option value="">全部狀態</option>
                    @foreach (var ist in interviewStatusList)
                    {
                        <option value="@ist" selected="@(currentInterviewStatus == ist)">@ist</option>
                    }
                </select>
            </div>

            @* 4. 錄取/未錄取狀態 *@
            <div class="search-field">
                <label for="sel-admission"><i class="fa-solid fa-award"></i> 錄取狀態</label>
                <select id="sel-admission" name="admissionResult">
                    <option value="">全部狀態</option>
                    @foreach (var adm in admissionResultList)
                    {
                        <option value="@adm" selected="@(currentAdmissionResult == adm)">@adm</option>
                    }
                </select>
            </div>

            <div class="filter-actions">
                <button type="submit" class="search-btn"><i class="fa-solid fa-filter"></i> 篩選</button>
                <button type="button" class="reset-btn" onclick="resetFilter()"><i class="fa-solid fa-rotate-left"></i> 重置</button>
            </div>
        </div>
    </div>
</form>

<main class="main">
    <!-- 電腦版表頭 -->
    <div class="app-table-head">
        <div>投遞時間</div>
        <div>職缺名稱</div>
        <div>履歷狀態</div>
        <div>面試狀態</div>
        <div>錄取狀態</div>
        <div>詳細動作</div>
    </div>

    <!-- ROWS -->
    <div class="app-list">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                string status = item.Status ?? "待審核";
                string? interviewStatus = item.InterviewStatus;
                string? admissionResult = item.AdmissionResult;
                InterviewProject.Models.Room? room = roomsByResumeId.TryGetValue(item.Id, out var r) ? r : null;

                var (admissionText, admissionClass) = GetAdmissionStatus(status, interviewStatus ?? "", admissionResult ?? "");

                string viewAction = "";
                if (status == "已通過")
                {
                    if (string.IsNullOrEmpty(interviewStatus))
                        viewAction = "aptitude";
                    else if (interviewStatus == InterviewProject.Models.InterviewStatusValues.WaitingSchedule)
                    {
                        viewAction = completedTestResumeIds.Contains(item.Id) ? "waiting" : "aptitude";
                    }
                    else if (interviewStatus == InterviewProject.Models.InterviewStatusValues.Scheduled
                    || interviewStatus == InterviewProject.Models.InterviewStatusValues.InProgress)
                        viewAction = "interview";
                    else if (interviewStatus == InterviewProject.Models.InterviewStatusValues.Ended
                    && admissionResult == InterviewProject.Models.AdmissionResultValues.Admitted)
                        viewAction = "onboarding";
                }

                <div class="app-row-wrap">
                    <div class="app-row">
                        @* 1. 投遞時間 *@
                        <div class="row-time">
                            <span class="mobile-label">投遞時間</span>
                            <span class="time-text">@item.ResumeTime.ToString("yyyy/MM/dd HH:mm")</span>
                        </div>

                        @* 2. 職缺名稱 *@
                        <div class="row-position">
                            @{
                                // 抓取 Job 的 JobType
                                string jobType = item.Job?.JobType ?? "";

                                // 依照類型決定顯示文字與 CSS class
                                string badgeText = "未指定";
                                string badgeClass = "badge-secondary"; // 預設樣式

                                if (jobType == "fulltime")
                                {
                                    badgeText = "全職";
                                    badgeClass = "badge-full";
                                }
                                else if (jobType == "parttime")
                                {
                                    badgeText = "兼職";
                                    badgeClass = "badge-part";
                                }
                                else if (jobType == "intern")
                                {
                                    badgeText = "實習";
                                    badgeClass = "badge-intern";
                                }
                            }

                            <span class="job-badge @badgeClass">@badgeText</span>
                            <span class="job-title">@(item.Job?.Title ?? "未指定職缺")</span>
                        </div>

                        @* 3. 履歷狀態 *@
                        <div class="row-col text-center">
                            <span class="mobile-label">履歷狀態</span>
                            <span class="status-pill @GetStatusClass(status)">
                                <i class="fa-solid fa-circle dot"></i>@status
                            </span>
                        </div>

                        @* 4. 面試狀態 *@
                        <div class="row-col text-center">
                            <span class="mobile-label">面試狀態</span>
                            @if (!string.IsNullOrEmpty(interviewStatus))
                            {
                                <span class="status-pill @GetInterviewStatusClass(interviewStatus)">
                                    <i class="fa-solid fa-circle dot"></i>@interviewStatus
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </div>

                        @* 5. 錄取/未錄取 *@
                        <div class="row-col text-center">
                            <span class="mobile-label">錄取狀態</span>
                            @if (!string.IsNullOrEmpty(admissionText) && admissionText != "-")
                            {
                                <span class="status-pill @admissionClass">
                                    <i class="fa-solid fa-circle dot"></i>@admissionText
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </div>

                        @* 6. 查看詳細按鈕 *@
                        <div class="row-col text-center row-actions">
                            @if (!string.IsNullOrEmpty(viewAction))
                            {
                                <button class="btn-action btn-view" data-resume-id="@item.Id" data-view-action="@viewAction" onclick="openDetailByAction(this)">
                                    <i class="fa-regular fa-eye"></i> 查看資訊
                                </button>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </div>
                    </div>

                    @if (viewAction == "interview")
                    {
                        <template id="tpl-interview-@item.Id">
                            <div class="detail-section-title">
                                <span class="title-text">
                                    <i class="fa-regular fa-calendar-check me-2"></i> 面試資訊
                                </span>
                                <span class="status-pill @(room != null ? "status-scheduled" : "status-waiting")">
                                    @interviewStatus
                                </span>
                            </div>
                            <div class="detail-card">
                                @if (room != null)
                                {
                                    <div class="detail-notice-box">
                                        <p><i class="fa-solid fa-circle-info me-1"></i> 請於面試時間前 10 分鐘登入</p>
                                        <p><i class="fa-solid fa-circle-info me-1"></i> 請確保視訊與音訊設備正常</p>
                                        <p><i class="fa-solid fa-circle-info me-1"></i> 會議尚未開始前無法進入，請準時上線</p>
                                    </div>
                                    <div class="detail-info-group">
                                        <div class="detail-row">
                                            <span class="detail-label">面試方式</span>
                                            <span class="detail-value">線上視訊面試</span>
                                        </div>
                                        <div class="detail-row">
                                            <span class="detail-label">面試時間</span>
                                            <span class="detail-value">@(room.ScheduledAt?.ToString("yyyy/MM/dd HH:mm") ?? "尚未排定")</span>
                                        </div>
                                        <div class="detail-row">
                                            <span class="detail-label">會議房間碼</span>
                                            <span class="detail-value code-text">@room.JitsiRoomName</span>
                                        </div>
                                    </div>
                                    <div class="detail-action">
                                        <a class="btn-primary-action" href="@Url.Action("Join", "Room", new { code = room.JitsiRoomName })">
                                            <i class="fa-solid fa-video me-1"></i> 進入面試房間
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <div class="detail-notice-box warning">
                                        <p><i class="fa-solid fa-triangle-exclamation me-1"></i> 資料異常：目前查不到對應的面試房間，請聯繫人資確認。</p>
                                    </div>
                                }
                            </div>
                        </template>
                    }
                </div>
            }
        }
        else
        {
            <div class="no-data">
                <div class="no-data-icon"><i class="fa-regular fa-folder-open"></i></div>
                <p>目前尚無應徵紀錄</p>
                <a href="@Url.Action("Job_search", "Job")" class="btn-go-search">前往搜尋職缺</a>
            </div>
        }
    </div>
</main>

<!-- 🎯 共用置中彈窗 Modal -->
<div id="detailModalOverlay" class="modal-overlay" onclick="if(event.target===this) closeDetailModal()">
    <div class="modal-box">
        <button type="button" class="modal-close" onclick="closeDetailModal()">&times;</button>
        <div id="detailModalContent"></div>
    </div>
</div>


@functions {
    // 1. 履歷審核狀態
    public string GetStatusClass(string status)
    {
        return status switch
        {
            "待審核" => "status-waiting",
            "未通過" => "status-fail",
            "已通過" => "status-pass",
            _ => ""
        };
    }

    // 2. 面試狀態
    public string GetInterviewStatusClass(string status)
    {
        return status switch
        {
            "等待安排面試" => "status-waiting",
            "已安排面試" => "status-scheduled",
            "面試中" => "status-processing",
            "面試結束" => "status-finished",
            _ => "status-review"
        };
    }

    // 🎯 3. 錄取結果狀態（依據面試狀態動態改變）
    public (string Text, string Class) GetAdmissionStatus(string resumeStatus, string interviewStatus, string dbAdmissionResult)
    {
        // 情況 A：履歷根本沒通過審核
        if (resumeStatus == "未通過")
        {
            return ("未錄取", "status-fail");
        }
        if (resumeStatus == "待審核")
        {
            return ("-", "");
        }

        // 情況 B：履歷通過了，但面試還沒到最後階段
        if (interviewStatus == "等待安排面試" || interviewStatus == "已安排面試" || interviewStatus == "面試中")
        {
            return ("等待結果中", "status-pending-result");
        }

        // 情況 C：面試結束了，顯示真正的結果（例如資料庫存的 "錄取" / "未錄取"）
        if (interviewStatus == "面試結束")
        {
            if (dbAdmissionResult == "錄取") return ("錄取", "status-pass");
            if (dbAdmissionResult == "未錄取") return ("未錄取", "status-fail");
            return ("等待結果中", "status-pending-result"); // 防呆：面試結束但主管還沒點選結果
        }

        return ("-", "");
    }
}
<script>
    function resetFilter() {
        window.location.href = '@Url.Action("Application", "Member")';
    }
</script>
@section Scripts {
    <script>
        function openDetailModal() {
            document.getElementById('detailModalOverlay').classList.add('active');
        }
        function closeDetailModal() {
            document.getElementById('detailModalOverlay').classList.remove('active');
        }

        // 🎯 依「查看」按鈕上的 data-view-action 分流到對應的彈窗內容
        function openDetailByAction(btn) {
            const resumeId = btn.dataset.resumeId;
            const action = btn.dataset.viewAction;
            if (action === 'aptitude') openAptitudeModal(resumeId);
            else if (action === 'waiting') openWaitingModal();
            else if (action === 'interview') openInterviewModal(resumeId);
            else if (action === 'onboarding') openOnboardingModal();
        }

        // 狀態4：已通過，但測驗/房間其中一項還沒到齊
        function openWaitingModal() {
            const content = document.getElementById('detailModalContent');
            content.innerHTML =
                '<div class="detail-section-title">' +
                '  <span class="title-text">面試資訊</span>' +
                '  <span class="detail-badge badge-waiting">等待安排面試</span>' +
                '</div>' +
                '<div class="detail-card">' +
                '  <div class="detail-notice-box">' +
                '    <p>目前正在安排面試中，排定後會顯示面試時間與會議碼，請耐心等候通知。</p>' +
                '  </div>' +
                '</div>';
            openDetailModal();
        }

        // 狀態9：面試結束且錄取（報到資訊，目前先用提示文字佔位，之後會接評分/報到流程做完的內容）
        function openOnboardingModal() {
            const content = document.getElementById('detailModalContent');
            content.innerHTML =
                '<div class="detail-section-title">' +
                '  <span class="title-text">錄取通知</span>' +
                '  <span class="detail-badge badge-scheduled">錄取</span>' +
                '</div>' +
                '<div class="detail-card">' +
                '  <div class="detail-notice-box">' +
                '    <p>恭喜您錄取本次職缺！詳細報到時間與注意事項，人資將會另行通知您。</p>' +
                '  </div>' +
                '</div>';
            openDetailModal();
        }

        // 🎯 面試資訊：直接把該筆履歷的隱藏樣板複製進彈窗顯示（資料已經在頁面上，不用另外打 API）
        function openInterviewModal(resumeId) {
            const tpl = document.getElementById('tpl-interview-' + resumeId);
            const content = document.getElementById('detailModalContent');
            content.innerHTML = '';
            if (tpl) content.appendChild(tpl.content.cloneNode(true));
            openDetailModal();
        }

        // 🎯 適性測驗：開啟時打 API 問「這份履歷測驗完成了沒」，動態渲染題目或已完成畫面
        async function openAptitudeModal(resumeId) {
            const content = document.getElementById('detailModalContent');
            content.innerHTML = '<p class="modal-loading">載入中...</p>';
            openDetailModal();

            try {
                const res = await fetch('/AptitudeTest/GetStatus?resumeId=' + resumeId);
                const data = await res.json();

                if (!data.success) {
                    content.innerHTML = '<p class="modal-error">' + (data.message || '載入失敗，請稍後再試') + '</p>';
                    return;
                }

                if (data.completed) {
                    content.innerHTML =
                        '<div class="detail-section-title">' +
                        '  <span class="title-text">適性測驗</span>' +
                        '  <span class="detail-badge badge-scheduled">已完成</span>' +
                        '</div>' +
                        '<div class="detail-card">' +
                        '  <div class="detail-notice-box">' +
                        '    <p>您已於 ' + data.submittedAt + ' 完成適性測驗，感謝您的作答。</p>' +
                        '    <p>系統會依照職缺招募進度安排後續面試，請耐心等候通知。</p>' +
                        '  </div>' +
                        '</div>';
                    return;
                }

                const questionsHtml = data.questions.map(function (q) {
                    const options = [1, 2, 3, 4, 5].map(function (s) {
                        return '<label class="apt-scale-option">' +
                               '<input type="radio" name="q_' + q.id + '" value="' + s + '" required />' +
                               '<span>' + s + '</span></label>';
                    }).join('');
                    return '<div class="apt-question">' +
                           '<p class="apt-question-text">' + q.id + '. ' + q.text + '</p>' +
                           '<div class="apt-scale">' + options + '</div>' +
                           '</div>';
                }).join('');

                content.innerHTML =
                    '<div class="detail-section-title">' +
                    '  <span class="title-text">適性測驗</span>' +
                    '  <span class="detail-badge badge-pending">未完成</span>' +
                    '</div>' +
                    '<div class="detail-card">' +
                    '  <div class="detail-notice-box">' +
                    '    <p>1. 共 ' + data.questions.length + ' 題，採 1～5 分量表作答（1：非常不同意 ～ 5：非常同意）</p>' +
                    '    <p>2. 請依真實情況作答，送出後即完成測驗，無法重測</p>' +
                    '  </div>' +
                    '  <form id="aptitudeForm">' + questionsHtml +
                    '    <div class="detail-action">' +
                    '      <button type="submit" class="btn-action btn-action--primary">送出測驗</button>' +
                    '    </div>' +
                    '  </form>' +
                    '</div>';

                document.getElementById('aptitudeForm').addEventListener('submit', async function (e) {
                    e.preventDefault();

                    const answers = data.questions.map(function (q) {
                        const checked = document.querySelector('input[name="q_' + q.id + '"]:checked');
                        return { questionId: q.id, score: checked ? parseInt(checked.value) : 0 };
                    });

                    if (answers.some(function (a) { return a.score === 0; })) {
                        alert('請完成所有題目再送出');
                        return;
                    }

                    const submitBtn = e.target.querySelector('button[type="submit"]');
                    submitBtn.disabled = true;
                    submitBtn.textContent = '送出中...';

                    try {
                        const submitRes = await fetch('/AptitudeTest/Submit', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ resumeId: resumeId, answers: answers })
                        });
                        const submitData = await submitRes.json();

                        if (submitData.success) {
                            alert('測驗已送出，感謝您的作答！');
                            closeDetailModal();
                            location.reload();
                        } else {
                            alert(submitData.message || '送出失敗，請稍後再試');
                            submitBtn.disabled = false;
                            submitBtn.textContent = '送出測驗';
                        }
                    } catch (err) {
                        alert('送出失敗，請稍後再試');
                        submitBtn.disabled = false;
                        submitBtn.textContent = '送出測驗';
                    }
                });

            } catch (err) {
                content.innerHTML = '<p class="modal-error">載入失敗，請稍後再試</p>';
            }
        }

        // 🎯 從面試房間被導回來、要求先完成適性測驗時，網址會帶 ?openTest=履歷Id，
        //    頁面一載入就自動彈出測驗彈窗，不用使用者自己在列表裡再找一次「查看」按鈕
        (function autoOpenTestFromRedirect() {
            const params = new URLSearchParams(window.location.search);
            const openTestResumeId = params.get('openTest');
            if (openTestResumeId) {
                openAptitudeModal(openTestResumeId);
                // 清掉網址上的參數，避免使用者重新整理又跳出一次
                const cleanUrl = window.location.pathname;
                window.history.replaceState({}, document.title, cleanUrl);
            }
        })();
    </script>
}