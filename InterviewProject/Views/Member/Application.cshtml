@model IEnumerable<InterviewProject.Models.Resume>
@{
    ViewData["Title"] = "應徵管理";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Application.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Job_search.css" asp-append-version="true" />
}

<div class="app-wrapper">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="page-header-inner">
            <h1>應徵管理</h1>
            <p>Application Management</p>
        </div>
    </div>

    <!-- FILTER BAR -->
    <div class="app-page">
        <div class="app-filter">
            <div class="filter-group">
                <label>投遞時間</label>
                <select id="sel-date">
                    <option value="">請選擇</option>
                    <option value="2026-05">2026/05</option>
                </select>
            </div>
            <div class="filter-group">
                <label>職缺類型</label>
                <select id="sel-type">
                    <option value="">請選擇</option>
                </select>
            </div>
            <button class="filter-btn" onclick="doFilter()">篩選</button>
        </div>
            <div class="app-table-head">
                <div>投遞時間</div>
                <div>職缺名稱</div>
                <div>履歷狀態</div>
                <div>面試狀態</div>
                <div>錄取/未錄取</div>
                <div>查看詳細</div>
            </div>

        <!-- ROWS -->
        <div class="app-list">
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    bool isPassed = item.Status == "通過";

                    @* 💡 加上 app-row-wrap 容器，解決 JS toggle 找不到外層的問題 *@
                    <div class="app-row-wrap">
                        <div class="app-row">
                            @* 1. 投遞時間 *@
                            <div class="row-time">@item.ResumeTime.ToString("yyyy/MM/dd HH:mm:ss")</div>

                            @* 2. 職缺名稱 *@
                            <div class="row-position">@(item.Job?.Title ?? "未指定職缺")</div>

                            @* 3. 審核狀態 *@
                            <div class="row-status text-center">
                                <span class="@GetStatusClass(item.Status ?? "待審核") status-label">
                                    @(string.IsNullOrEmpty(item.Status) ? "待審核" : item.Status)
                                </span>
                            </div>

                            @* 4. 面試狀態 (動態套用對應標籤樣式) *@
                            <div class="text-center">
                                @if (isPassed)
                                {
                                    @* 💡 預設抓取資料庫面試狀態，若無則顯示 "等待安排面試" *@
                                    var interviewStatus = item.Status ?? "等待安排面試";
                                    <span class="@GetInterviewStatusClass(interviewStatus) status-label">
                                        @interviewStatus
                                    </span>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </div>

                            @* 5. 錄取/未錄取 *@
                            <div class="text-center">
                                @* {
                                    // 先取得當前的面試狀態（防呆 Null）
                                    var currentInterviewStatus = item.Interview?.Status ?? "等待安排面試";
                                    // 取得當前的資料庫錄取結果（假設欄位叫 AdmissionResult，可依你實際的改，如 item.Interview?.Result）
                                    var dbResult = item.Interview?.AdmissionResult ?? "";

                                    // 呼叫動態判斷方法
                                    var admission = GetAdmissionStatus(item.Status ?? "待審核", currentInterviewStatus, dbResult);
                                }

                                @if (admission.Text != "-")
                                {
                                    <span class="@admission.Class status-label">
                                        @admission.Text
                                    </span>
                                }
                                else
                                {
                                    <span>-</span>
                                }*@
                            </div>

                            @* 6. 查看詳細按鈕 *@
                            <div class="text-center">
                                @if (isPassed)
                                {
                                    <button class="btn-view" onclick="toggleDetail(this)">
                                        查看 <i class="fa fa-chevron-down"></i>
                                    </button>
                                }
                            </div>
                        </div>

                        @if (isPassed)
                        {
                            <div class="app-detail" style="display: none;">
                                <div class="detail-grid">
                                    <div class="detail-section">
                                        <div class="detail-section-title">
                                            <span class="title-text">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                                                    <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                                                    <rect x="9" y="3" width="6" height="4" rx="1" stroke="currentColor" stroke-width="2" />
                                                </svg>
                                                適性測驗
                                            </span>
                                            <span class="detail-badge badge-pending">未完成</span>
                                        </div>
                                        <div class="detail-card">
                                            <div class="detail-notice-box">
                                                <p>1. 測驗時間約 15 分鐘，請確保網路穩定</p>
                                                <p>2. 測驗開始後不可中途離開</p>
                                                <p>3. 請於截止日期前完成</p>
                                            </div>
                                            <div class="detail-info-group">
                                                <div class="detail-row">
                                                    <span class="detail-label">截止日期</span>
                                                    <span class="detail-value">2026/05/10</span>
                                                </div>
                                            </div>
                                            <div class="detail-action">
                                                <button class="btn-action btn-action--primary">前往測驗</button>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="detail-section">
                                        <div class="detail-section-title">
                                            <span class="title-text">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                                                    <rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2" />
                                                    <path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                                                </svg>
                                                面試資訊
                                            </span>
                                            <span class="detail-badge badge-waiting">@(item.Status ?? "等待安排面試")</span>
                                        </div>
                                        <div class="detail-card">
                                            <div class="detail-notice-box">
                                                <p>1. 請於面試時間前 10 分鐘登入</p>
                                                <p>2. 請確保視訊與音訊設備正常</p>
                                            </div>
                                            <div class="detail-info-group">
                                                <div class="detail-row">
                                                    <span class="detail-label">面試方式</span>
                                                    <span class="detail-value">視訊面試</span>
                                                </div>
                                                <div class="detail-row">
                                                    <span class="detail-label">面試時間</span>
                                                    <span class="detail-value">2026/05/15 14:00</span>
                                                </div>
                                            </div>
                                            <div class="detail-action">
                                                <button class="btn-action btn-action--primary">前往面試</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="no-data">目前尚無投遞紀錄。</div>
            }
        </div>
    </div>
</div>
@functions {
    // 1. 履歷審核狀態
    public string GetStatusClass(string status)
    {
        return status switch
        {
            "待審核" => "status-review",
            "不通過" => "status-fail",
            "通過" => "status-pass",
            _ => ""
        };
    }

    // 2. 面試狀態
    public string GetInterviewStatusClass(string status)
    {
        return status switch
        {
            "等待安排面試" => "status-waiting",
            "已安排面試" => "status-scheduled",
            "面試中" => "status-processing",
            "面試結束" => "status-finished",
            _ => "status-review"
        };
    }

    // 🎯 3. 錄取結果狀態（依據面試狀態動態改變）
    public (string Text, string Class) GetAdmissionStatus(string resumeStatus, string interviewStatus, string dbAdmissionResult)
    {
        // 情況 A：履歷根本沒通過審核
        if (resumeStatus == "不通過") {
            return ("未錄取", "status-fail");
        }
        if (resumeStatus == "待審核") {
            return ("-", "");
        }

        // 情況 B：履歷通過了，但面試還沒到最後階段
        if (interviewStatus == "等待安排面試" || interviewStatus == "已安排面試" || interviewStatus == "面試中") {
            return ("等待結果中", "status-pending-result");
        }

        // 情況 C：面試結束了，顯示真正的結果（例如資料庫存的 "錄取" / "未錄取"）
        if (interviewStatus == "面試結束") {
            if (dbAdmissionResult == "錄取") return ("錄取", "status-pass");
            if (dbAdmissionResult == "未錄取") return ("未錄取", "status-fail");
            return ("等待結果中", "status-pending-result"); // 防呆：面試結束但主管還沒點選結果
        }

        return ("-", "");
    }
}
@section Scripts {
    <script>
        function toggleDetail(btn) {
            const wrap = btn.closest('.app-row-wrap');
            const detail = wrap.querySelector('.app-detail');
            const icon = btn.querySelector('i');

            if (detail.style.display === 'none' || detail.style.display === '') {
                detail.style.display = 'block';
                btn.classList.add('active');
                if(icon) icon.className = 'fa fa-chevron-up';
            } else {
                detail.style.display = 'none';
                btn.classList.remove('active');
                if(icon) icon.className = 'fa fa-chevron-down';
            }
        }
    </script>
}