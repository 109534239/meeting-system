@{
    ViewData["Title"] = "應徵管理";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Application.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Job_search.css" asp-append-version="true" />
}

<div class="app-wrapper">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="page-header-inner">
            <h1>應徵管理</h1>
            <p>Application Management</p>
        </div>
    </div>

    <!-- FILTER BAR -->
    <div class="search-bar">
        <div class="search-inner">
            <div class="search-field">
                <label>投遞時間</label>
                <select id="sel-date">
                    <option value="">請選擇</option>
                    <option value="2024-04">2026/04</option>
                    <option value="2026-04">2026/03</option>
                </select>
            </div>
            <div class="search-field">
                <label>職缺類型</label>
                <select id="sel-type">
                    <option value="">請選擇</option>
                    <option value="pm">專案管理</option>
                    <option value="it">資訊技術</option>
                </select>
            </div>
            <button class="search-btn" onclick="doFilter()">篩選</button>
        </div>
    </div>

    <!-- TABLE -->
    <div class="app-page">
        <!-- TABLE HEADER -->
        <div class="app-table-head">
            <div>投遞時間</div>
            <div>職缺名稱</div>
            <div>履歷</div>
            <div>面試</div>
            <div>錄取/未錄取</div>
            <div>查看詳細</div>
        </div>

        <!-- ROWS -->
        <div class="app-list">

            <!-- Row 1：無查看按鈕 -->
            <div class="app-row-wrap">
                <div class="app-row">
                    <div>2024/04/10</div>
                    <div>NB產品經理_260502001</div>
                    <div class="status-review">審核中</div>
                    <div></div>
                    <div></div>
                    <div></div>
                </div>
            </div>

            <!-- Row 2：無查看按鈕 -->
            <div class="app-row-wrap">
                <div class="app-row">
                    <div>2024/04/15</div>
                    <div>前端工程師_260502002</div>
                    <div class="status-fail">未通過</div>
                    <div></div>
                    <div></div>
                    <div></div>
                </div>
            </div>

            <!-- Row 3：有查看按鈕 -->
            <div class="app-row-wrap">
                <div class="app-row">
                    <div>2026/04/30</div>
                    <div>NB產品經理_260502001</div>
                    <div class="status-pass">通過</div>
                    <div class="status-waiting">待面試</div>
                    <div></div>
                    <div><button class="btn-view" onclick="toggleDetail(this)">查看</button></div>
                </div>
                <div class="app-detail">
                    <div class="detail-grid">

                        <div class="detail-section">
                            <div class="detail-section-title">
                                <span class="title-text">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                                        <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                        <rect x="9" y="3" width="6" height="4" rx="1" stroke="currentColor" stroke-width="2"/>
                                    </svg>
                                    適性測驗
                                </span>
                                <span class="detail-badge badge-pending">未完成</span>
                            </div>

                            <div class="detail-card">
                                <div class="detail-notice-box">
                                    <p>1. 測驗時間約 15 分鐘，請確保網路穩定</p>
                                    <p>2. 測驗開始後不可中途離開，否則視為放棄</p>
                                    <p>3. 請於截止日期前完成，逾期將無法補測</p>
                                </div>

                                <div class="detail-info-group">
                                    <div class="detail-row">
                                        <span class="detail-label">測驗方式</span>
                                        <span class="detail-value">線上測驗</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-label">截止日期</span>
                                        <span class="detail-value">2026/05/10</span>
                                    </div>
                                </div>

                                <div class="detail-action">
                                    <button class="btn-action btn-action--primary">前往測驗</button>
                                </div>
                            </div>
                        </div>

                        <div class="detail-section">
                            <div class="detail-section-title">
                                <span class="title-text">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                                        <rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/>
                                        <path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                    </svg>
                                    面試資訊
                                </span>
                                <span class="detail-badge badge-waiting">待面試</span>
                            </div>

                            <div class="detail-card">
                                <div class="detail-notice-box">
                                    <p>1. 請於面試時間前 10 分鐘登入視訊平台</p>
                                    <p>2. 請確保攝影機、麥克風及網路連線穩定</p>
                                    <p>3. 如需取消或更改時間，請提前 2 天以電子郵件聯繫人資</p>
                                </div>

                                <div class="detail-info-group">
                                    <div class="detail-row">
                                        <span class="detail-label">面試方式</span>
                                        <span class="detail-value">視訊面試</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-label">面試時間</span>
                                        <span class="detail-value">2026/05/15 14:00</span>
                                    </div>
                                </div>

                                <div class="detail-action">
                                    <button class="btn-action btn-action--primary">前往面試</button>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Row 4：有查看按鈕 -->
            <div class="app-row-wrap">
                <div class="app-row">
                    <div>2026/04/30</div>
                    <div>NB產品經理_260502001</div>
                    <div class="status-pass">通過</div>
                    <div class="status-pass">通過</div>
                    <div class="status-hired">錄取</div>
                    <div><button class="btn-view" onclick="toggleDetail(this)">查看</button></div>
                </div>
                <div class="app-detail">
                    <div class="detail-grid">

                        <div class="detail-section">
                            <div class="detail-section-title">
                                <span class="title-text">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                                        <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                        <rect x="9" y="3" width="6" height="4" rx="1" stroke="currentColor" stroke-width="2"/>
                                    </svg>
                                    適性測驗
                                </span>
                                <span class="detail-badge badge-done">已完成</span>
                            </div>

                            <div class="detail-card">
                                <div class="detail-notice-box">
                                    <p>1. 測驗時間約 15 分鐘，請確保網路穩定</p>
                                    <p>2. 測驗開始後不可中途離開，否則視為放棄</p>
                                    <p>3. 請於截止日期前完成，逾期將無法補測</p>
                                </div>

                                <div class="detail-info-group">
                                    <div class="detail-row">
                                        <span class="detail-label">測驗方式</span>
                                        <span class="detail-value">線上測驗</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-label">截止時間日期</span>
                                        <span class="detail-value">2026/05/04</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="detail-section">
                            <div class="detail-section-title">
                                <span class="title-text">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                                        <rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/>
                                        <path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                    </svg>
                                    面試資訊
                                </span>
                                <span class="detail-badge badge-pass">已通過</span>
                            </div>

                            <div class="detail-card">
                                <div class="detail-notice-box">
                                    <p>1. 請於面試時間前 10 分鐘登入視訊平台</p>
                                    <p>2. 請確保攝影機、麥克風及網路連線穩定</p>
                                    <p>3. 如需取消或更改時間，請提前 2 天以電子郵件聯繫人資</p>
                                </div>

                                <div class="detail-info-group">
                                    <div class="detail-row">
                                        <span class="detail-label">面試方式</span>
                                        <span class="detail-value">線上面試</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-label">面試時間</span>
                                        <span class="detail-value">2026/05/05 10:00</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
<script>
    function toggleDetail(btn) {
        const wrap = btn.closest('.app-row-wrap');
        const detail = wrap.querySelector('.app-detail');
        const isOpen = detail.classList.contains('open');

        // 關閉其他已展開的
        document.querySelectorAll('.app-detail.open').forEach(d => {
            d.classList.remove('open');
            d.closest('.app-row-wrap').querySelector('.btn-view').textContent = '查看';
        });

        if (!isOpen) {
            detail.classList.add('open');
            btn.textContent = '收起';
        }
    }
</script>
}