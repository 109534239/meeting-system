@model InterviewProject.Models.Member

@{
    ViewData["Title"] = "基本資料";
    var roleLabel = Context.Session.GetString("MemberRole") == "employee" ? "人資" : "求職者";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Profile.css" asp-append-version="true" />
}

<div class="page-header">
    <div class="page-header-inner">
        <h1>基本資料</h1>
        <p>Profile Management</p>
    </div>
</div>

<div class="profile-main">
    <div class="profile-wrap">

        <div class="profile-sidebar">
            <div class="profile-avatar" id="avatar-preview">
                @if (!string.IsNullOrEmpty(Model.ProfileImagePath))
                {
                    <img src="@Model.ProfileImagePath" alt="avatar" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />
                }
                else
                {
                    <svg width="54" height="54" viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="8" r="4" fill="#fff" />
                        <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" stroke="#fff" stroke-width="2" stroke-linecap="round" fill="none"/>
                    </svg>
                }
            </div>
            <div class="sidebar-name">@Model.Name</div>
            <div class="sidebar-role">@roleLabel</div>
            <label class="btn-upload">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <polyline points="17 8 12 3 7 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <line x1="12" y1="3" x2="12" y2="15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                更換大頭照
                <input type="file" id="avatar-file-input" accept="image/*" style="display:none" onchange="previewAvatar(event)" />
            </label>
        </div>

        <div class="profile-content">

            <div class="profile-card">
                <div class="card-header">
                    <h2>個人資料</h2>
                </div>

                @if (TempData["SaveSuccess"] != null)
                {
                    <div class="alert-success">個人資料已儲存！</div>
                }
                @if (TempData["SaveError"] != null)
                {
                    <div class="pw-error" style="background-color: #ffebee; color: #c62828; padding: 10px; border-radius: 4px; margin-bottom: 15px;">@TempData["SaveError"]</div>
                }

                <form method="post" asp-controller="Member" asp-action="ProfileSave">
                    @Html.AntiForgeryToken()
                    
                    <input type="hidden" id="profileImageBase64" name="profileImageBase64" value="@Model.ProfileImagePath" />
                    <input type="hidden" name="idNumber" value="@Model.IdNumber" />

                    <div class="fields-grid">

                        <div class="field-item">
                            <label class="field-label">姓名 <span class="required" style="color: red;">*</span></label>
                            <input class="field-input" name="name" type="text"
                                   value="@Model.Name" placeholder="請輸入姓名" required />
                        </div>

                        <div class="field-item">
                            <label class="field-label">性別 <span class="required" style="color: red;">*</span></label>
                            <select class="field-input" name="gender" required>
                                @{
                                    if (string.IsNullOrEmpty(Model.Gender))
                                    {
                                        <option value="" disabled selected>-- 請選擇 --</option>
                                    }
                                    else
                                    {
                                        <option value="" disabled>-- 請選擇 --</option>
                                    }
                                    var genders = new[] { "男", "女" };
                                    foreach (var g in genders)
                                    {
                                        if (Model.Gender == g)
                                        {
                                            <option value="@g" selected>@g</option>
                                        }
                                        else
                                        {
                                            <option value="@g">@g</option>
                                        }
                                    }
                                }
                            </select>
                        </div>

                        <div class="field-item">
                            <label class="field-label">身分證字號</label>
                            <input class="field-input field-readonly" type="text" value="@Model.IdNumber" readonly />
                        </div>

                        <div class="field-item">
                            <label class="field-label">生年月日 <span class="required" style="color: red;">*</span></label>
                            <input class="field-input" name="birthday" type="date"
                                   value="@Model.Birthday.ToString("yyyy-MM-dd")" required />
                        </div>

                        <div class="field-item">
                            <label class="field-label">手機號碼</label>
                            <input class="field-input field-readonly" name="phone" type="tel" value="@Model.Phone" readonly />
                        </div>

                        <div class="field-item field-item--full">
                            <label class="field-label">電子郵件</label>
                            <input class="field-input field-readonly" name="email" type="email" value="@Model.Email" readonly />
                        </div>

                        <div class="field-item field-item--full">
                            <label class="field-label">居住地址 <span class="required" style="color: red;">*</span></label>
                            <input class="field-input" name="address" type="text"
                                   value="@Model.Address" placeholder="請輸入地址" required />
                        </div>

                    </div>
                    <div class="card-actions">
                        <button type="submit" class="btn-save">儲存變更</button>
                    </div>
                </form>
            </div>

            <div class="profile-card">
                <div class="card-header">
                    <h2>修改密碼</h2>
                </div>

                @if (TempData["PwError"] != null)
                {
                    <div class="pw-error">@TempData["PwError"]</div>
                }
                @if (TempData["PwSuccess"] != null)
                {
                    <div class="alert-success">密碼已更新！</div>
                }

                <form method="post" asp-controller="Member" asp-action="ChangePassword">
                    @Html.AntiForgeryToken()
                    <div class="fields-grid">

                        <div class="field-item field-item--full">
                            <label class="field-label">目前密碼 <span class="required" style="color: red;">*</span></label>
                            <div class="input-password-wrap">
                                <input class="field-input" name="currentPassword" type="password" placeholder="請輸入目前密碼" required />
                                <button class="btn-eye" type="button" onclick="togglePw(this)">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/></svg>
                                </button>
                            </div>
                        </div>

                        <div class="field-item">
                            <label class="field-label">新密碼 <span class="required" style="color: red;">*</span></label>
                            <div class="input-password-wrap">
                                <input class="field-input" name="newPassword" type="password" placeholder="請輸入新密碼" required />
                                <button class="btn-eye" type="button" onclick="togglePw(this)">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/></svg>
                                </button>
                            </div>
                        </div>

                        <div class="field-item">
                            <label class="field-label">確認新密碼 <span class="required" style="color: red;">*</span></label>
                            <div class="input-password-wrap">
                                <input class="field-input" name="confirmPassword" type="password" placeholder="請再次輸入新密碼" required />
                                <button class="btn-eye" type="button" onclick="togglePw(this)">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/></svg>
                                </button>
                            </div>
                        </div>

                    </div>
                    <div class="card-actions">
                        <button type="submit" class="btn-save">更新密碼</button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
<script>
    function togglePw(btn) {
        const input = btn.closest('.input-password-wrap').querySelector('input');
        const isText = input.type === 'text';
        input.type = isText ? 'password' : 'text';
        btn.style.opacity = isText ? '0.4' : '1';
    }

    function previewAvatar(event) {
        const file = event.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = e => {
            // 1. 更新大頭照即時預覽
            const av = document.getElementById('avatar-preview');
            av.innerHTML = `<img src="${e.target.result}" alt="avatar" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />`;
            
            // 2. 將大頭照的 Base64 填入表單內的隱藏輸入框
            document.getElementById('profileImageBase64').value = e.target.result;
        };
        reader.readAsDataURL(file);
    }
</script>
}