      // 🎯 上傳履歷檔並解析填入（具備自動重試機制，專為企業級穩定度打造）
        function uploadAndApplyResume() {
            console.log("「套用」按鈕被點擊了！");

            const fileInput = document.getElementById('resumeUploadFile');
            if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
                alert('請先選擇要上傳的履歷檔案 (.pdf, .docx, .doc)。');
                return;
            }

            const fileName = fileInput.files[0].name;
            const formData = new FormData();
            formData.append('resumeFile', fileInput.files[0]);

            // 1. 彈出「資料正在套用中」的讀取視窗
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    title: '資料正在套用中，請稍後...',
                    text: `正在套用 ${fileName} 檔案內容`,
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
            } else {
                const script = document.createElement('script');
                script.src = 'https://cdn.jsdelivr.net/npm/sweetalert2@11';
                document.head.appendChild(script);
            }

            // 內部執行的非同步請求與自動重試函式
            const attemptParse = (retriesLeft) => {
                fetch('@Url.Action("ParseResumeFile", "Resume")', {
                    method: 'POST',
                    body: formData
                })
                .then(async res => {
                    const text = await res.text();
                    try {
                        return JSON.parse(text);
                    } catch (e) {
                        throw new Error("伺服器處理異常（回傳非 JSON 格式）");
                    }
                })
                .then(data => {
                    if (!data.success) throw new Error(data.message || '套用失敗');

