        console.warn('[大頭照上傳] 找不到 #resumePhotoFileInput，事件沒有綁上。');
        return;
    }
    resumePhotoInput.addEventListener('change', function (event) {
        console.log('[大頭照上傳] change 事件觸發');
        const file = event.target.files[0];
        if (!file) {
            console.warn('[大頭照上傳] 沒有選到檔案');
            return;
        }
        const preview = document.getElementById('resume-photo-preview');
        const hiddenInput = document.getElementById('resumePhotoBase64Input');
        if (!preview || !hiddenInput) {
            console.warn('[大頭照上傳] 找不到預覽區塊或 hidden input，DOM id 對不上');
            return;
        }
        const reader = new FileReader();
        reader.onerror = function () {
            console.error('[大頭照上傳] FileReader 讀取失敗', reader.error);
        };
        reader.onload = function (e) {
            console.log('[大頭照上傳] 讀取完成，更新預覽');
            preview.innerHTML = `<img src="${e.target.result}" alt="個人照" />`;
            hiddenInput.value = e.target.result;
        };
        reader.readAsDataURL(file);
    });
});

// 🎯 「工作內容」欄位文字打多了，高度自動長高（而不是被表格 overflow:hidden 吃掉，或擠出內建捲軸看不到）
function autoGrowTextarea(el) {
    if (!el) return;
    el.style.height = 'auto';
    el.style.height = el.scrollHeight + 'px';
}

function removeWorkRow(btn) {
    const row = btn.closest('.dynamic-row-work');
    const container = row.parentElement;
    // 🎯 工作經歷允許整組刪光（刪光就代表無工作經歷），跟語文能力同一套邏輯
    row.remove();
    updateNoWorkExpHint();
}

function addWorkRow() {
    const container = document.getElementById('work-list');
    const row = document.createElement('tr');
    row.className = 'dynamic-row-work';
    row.innerHTML = `
        <td><input type="text" name="CompanyNameList" class="form-control work-company" placeholder="公司名稱" /></td>
        <td><input type="text" name="JobTitleList" class="form-control work-title" placeholder="職位" /></td>
        <td><textarea name="JobDescriptionList" class="form-control" placeholder="工作內容" rows="1"></textarea></td>
        <td><input type="month" name="WorkStartDateList" class="form-control" /></td>
        <td><input type="month" name="WorkEndDateList" class="form-control" /></td>
        <td class="remove-cell"><button type="button" class="btn-remove-row no-print-in-readonly" onclick="removeWorkRow(this)">✕</button></td>
    `;
    container.appendChild(row);
    updateNoWorkExpHint();
}

// 🎯 作品集：跟工作經歷同一套 table 列模式，另外多處理「上傳檔案」欄位
function updateNoPortfolioHint() {
    const list = document.getElementById('portfolio-list');
    const hint = document.getElementById('noPortfolioHint');
    if (!list || !hint) return;
    hint.style.display = list.children.length > 0 ? 'none' : '';
}

function removePortfolioRow(btn) {
    const row = btn.closest('.dynamic-row-portfolio');
    const container = row.parentElement;
    // 🎯 作品集允許整組刪光（刪光就代表無作品集），跟工作經歷同一套邏輯
    row.remove();
    updateNoPortfolioHint();
}

// 🎯 使用者選了新檔案要取代舊檔案：既有檔案的 hidden input 值清空，
//    後端看到「有新檔案上傳」就會直接用新檔案覆蓋，不會再去看這個舊路徑
function markPortfolioFileReplaced(fileInput) {
    const cell = fileInput.closest('.portfolio-file-cell');
    if (!cell) return;
    const hiddenInput = cell.querySelector('.portfolio-existing-file');
    if (hiddenInput) hiddenInput.value = '';
    const existingWrap = cell.querySelector('.portfolio-existing-wrap');
    if (existingWrap) existingWrap.remove();
}

// 🎯 使用者按「✕」明確要移除既有檔案、且不打算另外上傳新檔案
function clearExistingPortfolioFile(btn) {
    const wrap = btn.closest('.portfolio-existing-wrap');
    const cell = btn.closest('.portfolio-file-cell');
    if (cell) {
        const hiddenInput = cell.querySelector('.portfolio-existing-file');
        if (hiddenInput) hiddenInput.value = '';
    }
    if (wrap) wrap.remove();
}

function addPortfolioRow() {
    const container = document.getElementById('portfolio-list');
    const row = document.createElement('tr');
    row.className = 'dynamic-row-portfolio';
    row.innerHTML = `
        <td><input type="text" name="PortfolioTitleList" class="form-control" placeholder="作品名稱" /></td>
        <td><textarea name="PortfolioDescList" class="form-control" placeholder="作品說明"></textarea></td>
        <td><input type="url" name="PortfolioLinkList" class="form-control" placeholder="https://" /></td>
        <td class="portfolio-file-cell">
            <input type="hidden" name="PortfolioExistingFileList" class="portfolio-existing-file" value="" />
            <input type="file" name="PortfolioFileList" class="form-control no-print-in-readonly" onchange="markPortfolioFileReplaced(this)" />
        </td>
        <td class="remove-cell"><button type="button" class="btn-remove-row no-print-in-readonly" onclick="removePortfolioRow(this)">✕</button></td>
    `;
    container.appendChild(row);
    updateNoPortfolioHint();
}
</script>

@* 🚨 負責攔截後端 TempData 錯誤並顯示的 SweetAlert 腳本 🚨 *@
@if (TempData["ApiError"] != null)
{
    var apiErrorHtml = TempData["ApiError"]?.ToString()?.Replace("\n", "<br/>").Replace("\r", "") ?? "";
    var apiErrorText = TempData["ApiError"]?.ToString()?.Replace("\n", "\\n").Replace("\r", "") ?? "";

    @Html.Raw($@"
    <script>
    document.addEventListener('DOMContentLoaded', function() {{
        if (typeof Swal !== 'undefined') {{
            Swal.fire({{
                icon: 'error',
                title: '儲存失敗',
                html: '{apiErrorHtml}'
            }});
        }} else {{
            alert('{apiErrorText}');
        }}
    }});
    </script>
    ")
}

@if (TempData["ShowSuccessAlert"] != null)
{
    var successText = TempData["ShowSuccessAlert"]?.ToString()?.Replace("\n", "\\n").Replace("\r", "") ?? "";

    @Html.Raw($@"
    <script>
    document.addEventListener('DOMContentLoaded', function() {{
        if (typeof Swal !== 'undefined') {{
            Swal.fire({{
                icon: 'success',
                title: '成功',
                text: '{successText}'
            }});
        }} else {{
            alert('{successText}');
        }}
    }});
    </script>
    ")
}