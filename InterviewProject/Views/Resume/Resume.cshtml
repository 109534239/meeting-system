        // 2. 處理唯讀檢視下的「列印 PDF」按鈕 (.btn-pdf-export)
        const pdfExportBtn = document.querySelector('.btn-pdf-export');
        if (pdfExportBtn) {
            pdfExportBtn.addEventListener('click', function (e) {
                e.preventDefault();
                const form = document.getElementById('resumeForm');
                const actionUrl = pdfExportBtn.getAttribute('formaction') || '@Url.Action("ExportToPdf", "Resume")';
                const formData = new FormData(form);
                executePdfDownload(actionUrl, formData, 'POST');
            });
        }
    });

        // 共用的 PDF 非同步下載與 SweetAlert 控管函式
    function executePdfDownload(url, data, method) {
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                title: '檔案下載中，請稍候...',
                text: '正在產生 PDF 履歷檔案，請勿關閉視窗。',
                allowOutsideClick: false,
                allowEscapeKey: false,
                showConfirmButton: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });
        }

        const fetchOptions = {
            method: method || 'GET'
        };
        if (data) {
            fetchOptions.body = data;
        }

        let extractedFilename = '履歷表.pdf'; // 預設備用檔名

        fetch(url, fetchOptions)
            .then(async response => {
                const contentType = response.headers.get("content-type");

                // 🎯 檢查後端是否回傳 HTML（例如未安裝工具的錯誤導引訊息）
                if (contentType && contentType.includes("text/html")) {
                    const htmlText = await response.text();
                    document.open();
                    document.write(htmlText);
                    document.close();
                    return null;
                }

                if (!response.ok) throw new Error('下載失敗');

                // 🎯 從後端的 Content-Disposition Header 抓取真實的檔案名稱
                const disposition = response.headers.get("content-disposition");
                if (disposition && disposition.indexOf("attachment") !== -1) {
                    // 支援標準 filename*=UTF-8''... 與一般 filename="..." 的解析
                    const filenameUtf8Match = disposition.match(/filename\*=UTF-8''([^;\n]+)/);
                    if (filenameUtf8Match && filenameUtf8Match[1]) {
                        extractedFilename = decodeURIComponent(filenameUtf8Match[1].replace(/['"]/g, ''));
                    } else {
                        const filenameMatch = disposition.match(/filename="?([^";\n]+)"?/);
                        if (filenameMatch && filenameMatch[1]) {
                            extractedFilename = decodeURIComponent(filenameMatch[1]);
                        }
                    }
                }

                return response.blob();
            })
            .then(blob => {
                if (!blob) return; // 若前面已經處理過 HTML 錯誤，直接跳過

                // 建立暫時的下載連結並觸發瀏覽器存檔（使用後端帶過來的動態檔名）
                const blobUrl = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = blobUrl;
                a.download = extractedFilename;
                document.body.appendChild(a);
                a.click();
                a.remove();
                window.URL.revokeObjectURL(blobUrl);

                // 📥 檔案已經完整下載完畢，此時才關閉提示視窗
                if (typeof Swal !== 'undefined') {
                    Swal.close();
                }
            })
            .catch(err => {
                console.error('PDF 下載發生錯誤:', err);
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'error',
                        title: '下載失敗',
                        text: '無法順利產生 PDF，請稍後再試。'
                    });
                }
            });
    }

// 🎯 自動判斷證照是否為「分數」、「級別」或「無級別/隱藏」
function updateCertLevelOptions(certItemEl) {
    const nameInput = certItemEl.querySelector('.cert-select');
    const levelInput = certItemEl.querySelector('.cert-level-select');
    const levelWrap = certItemEl.querySelector('.cert-level-wrap');
    if (!nameInput || !levelInput) return;

    const levelDatalist = document.getElementById(levelInput.getAttribute('list'));
    if (levelDatalist) levelDatalist.innerHTML = '';

    const typedName = nameInput.value.trim();

    // 1. 欄位還沒填證照名稱：維持預設顯示
    if (!typedName) {
        if (levelWrap) levelWrap.style.display = '';
        resetLevelInputToDefault(levelInput, levelWrap);
        return;
    }

    // -------------------------------------------------------------
    // 2. 自動判斷：分數型證照 (多益、托福、雅思等)
    // -------------------------------------------------------------
    const isScoreBased = /多益|TOEIC|TOEFL|托福|IELTS|雅思/i.test(typedName);
    if (isScoreBased) {
        if (levelWrap) levelWrap.style.display = '';
        
        // 變更標籤文字為「分數：」
        setCertLevelLabel(levelWrap, '分數：');

        levelInput.placeholder = '請輸入分數 (如: 850)';
        levelInput.type = 'number';
        if (/多益|TOEIC/i.test(typedName)) {
            levelInput.min = '10';
            levelInput.max = '990';
        } else {
            levelInput.removeAttribute('min');
            levelInput.removeAttribute('max');
        }
        return;
    }

    // -------------------------------------------------------------
    // 3. 自動判斷：查詢對照表 (globalCertList)
    // -------------------------------------------------------------
    resetLevelInputToDefault(levelInput, levelWrap);

    if (!globalCertList) {
        if (levelWrap) levelWrap.style.display = '';
        return;
    }

    // 尋找符合的證照資料
    const certData = globalCertList.find(x => {
        const currentName = x.CertName || x.certName || "";
        return currentName.trim().toLowerCase() === typedName.toLowerCase();
    });

    if (certData) {
        const levelsArray = certData.Levels || certData.levels || [];
        const hasLevels = Array.isArray(levelsArray) && levelsArray.length > 0;

        // 如果資料庫中該證照明確無級別 (或為單一級且無其它選項)，則隱藏級別欄位
        if (!hasLevels || (levelsArray.length === 1 && levelsArray[0] === "單一級")) {
            if (levelWrap) levelWrap.style.display = 'none';
            levelInput.value = ''; // 自動清空殘留值
            return;
        }

        // 有級別資料：顯示並帶入 datalist 選項
        if (levelWrap) levelWrap.style.display = '';
        if (levelDatalist) {
            levelsArray.forEach(lvl => {
                const opt = document.createElement('option');
                opt.value = lvl.trim();
                levelDatalist.appendChild(opt);
            });
        }
    } else {
        // 4. 自訂證照（對照表中找不到）：保留輸入框讓使用者自由填寫
        if (levelWrap) levelWrap.style.display = '';
        levelInput.placeholder = '級別/分數（無則留空）';
    }
}

// 💡 輔助函式：切換標籤文字
function setCertLevelLabel(levelWrap, text) {
    if (!levelWrap) return;
    const labelEl = levelWrap.querySelector('.cert-level-label');
    if (labelEl) {
        labelEl.textContent = text;
    } else {
        const labelNode = Array.from(levelWrap.childNodes).find(node => node.nodeType === Node.TEXT_NODE && (node.textContent.includes('級別') || node.textContent.includes('分數')));
        if (labelNode) labelNode.textContent = text;
    }
}

// 💡 輔助函式：還原級別欄位為預設狀態
function resetLevelInputToDefault(levelInput, levelWrap) {
    setCertLevelLabel(levelWrap, '級別：');
    levelInput.placeholder = '級別（無則留空）';
    levelInput.type = 'text';
    levelInput.removeAttribute('min');
    levelInput.removeAttribute('max');
}

// 🎯 把依職缺比對出的推薦證照（IsRecommended === true）渲染成一排小按鈕，
//    點了就直接把名稱填進第一個空的證照列（沒有空列就新增一列），並自動帶出級別選項
function renderCertRecommendChips() {
    const wrap = document.getElementById('certRecommendWrap');
    const chipsEl = document.getElementById('certRecommendChips');
    if (!wrap || !chipsEl) return;

    const recommended = (globalCertList || []).filter(x => x.IsRecommended);
    chipsEl.innerHTML = '';

    if (recommended.length === 0) {
        wrap.style.display = 'none';
        return;
    }

    recommended.forEach(item => {
        const cName = item.CertName || item.certName;
        if (!cName) return;
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'cert-recommend-chip';
        chip.textContent = cName;
        chip.onclick = function () {
            fillCertByName(cName);
        };
        chipsEl.appendChild(chip);
    });

    wrap.style.display = '';
}

// 🎯 找第一個「證照名稱還是空的」列直接填入；如果每一列都填過了，就新增一列再填
function fillCertByName(certName) {
    const items = document.querySelectorAll('.cert-item');
    let target = null;
    items.forEach(item => {
        if (!target) {
            const input = item.querySelector('.cert-select');
            if (input && !input.value.trim()) target = item;
        }
    });
    if (!target) {
        addCertRow();
        const allItems = document.querySelectorAll('.cert-item');
        target = allItems[allItems.length - 1];
    }
    const nameInput = target.querySelector('.cert-select');
    nameInput.value = certName;
    autoGrowInputWidth(nameInput);
    updateCertLevelOptions(target);
}

