    document.querySelectorAll('#work-list .dynamic-row-work').forEach(row => {
        const wraps = row.querySelectorAll('.ym-select-wrap');
        const startHidden = row.querySelector('input[name="WorkStartDateList"]');
        const endHidden = row.querySelector('input[name="WorkEndDateList"]');
        if (wraps.length === 2 && startHidden && endHidden) {
            initYmRange(wraps[0], startHidden, wraps[1], endHidden);
        }
    });

    document.querySelectorAll('#education-list .dynamic-row-edu').forEach(applyEduInProgressStatus);

   // ------ 1. 處理語文能力反填（改成動態列，資料有幾筆就補幾列；
    //           "不具外文能力" 已不再是使用者手動勾選的值，純粹代表「一筆都沒填」，
    //           所以這裡遇到它直接當作沒有資料，語言列表維持空白即可） ------
    const langData = `@Html.Raw(Model?.LanguageSkills ?? "")`;
    if (langData && langData.trim() !== "" && langData.trim() !== "不具外文能力") {
