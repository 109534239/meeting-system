        });
    }
    updateNoLangHint();

    // ------ 2. 處理駕照種類 ------
    const licenseData = "@Html.Raw(Model?.DriverLicense ?? "")";
    if (licenseData) {
        const parts = licenseData.split(', ');
        parts.forEach(p => {
            if (p.includes('(')) {
                const typeName = p.split('(')[0].trim();
                const subValues = p.split('(')[1].replace(')', '').split('/');
                const row = document.querySelector(`.license-row[data-type="${typeName}"]`);
                if (row) {
