            addLanguageRow();
            const rows = document.querySelectorAll('#language-list .dynamic-row-simple');
            const row = rows[rows.length - 1];
            const nameSelect = row.querySelector('.lang-name-select');
            const otherInput = row.querySelector('.lang-name-other');
            const lvSelect = row.querySelector('.lang-lv-select');
            if (nameSelect && name) {
                const matched = Array.from(nameSelect.options).some(opt => opt.value === name);
                if (matched) {
                    nameSelect.value = name;
                } else {
                    // 🎯 舊資料存的語言名稱若不在目前清單裡（例如之前是自由輸入的），
                    //    歸類到「其他」，並把原本文字帶進旁邊的自訂輸入框，不會憑空消失
                    nameSelect.value = '其他';
                    if (otherInput) {
                        otherInput.value = name;
                        otherInput.style.display = '';
