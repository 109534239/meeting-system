function renderExistingPortfolioFiles(cell) {
    if (!cell) return;
    const hiddenInput = cell.querySelector('.portfolio-existing-file');
    const listEl = cell.querySelector('.portfolio-existing-list');
    if (!hiddenInput || !listEl) return;

    listEl.innerHTML = '';
    const paths = (hiddenInput.value || '').split('|').map(p => p.trim()).filter(p => p !== '');

    paths.forEach(path => {
        const item = document.createElement('div');
        item.className = 'portfolio-existing-wrap';

        const link = document.createElement('a');
        link.href = path;
        link.target = '_blank';
        link.rel = 'noopener';
        link.textContent = path.split('/').pop();
        link.title = '點一下查看內容';

        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'btn-remove-row no-print-in-readonly';
        delBtn.textContent = '✕';
        delBtn.title = '刪除這個檔案';
        delBtn.onclick = function () {
            const remaining = (hiddenInput.value || '').split('|').map(p => p.trim()).filter(p => p !== '' && p !== path);
            hiddenInput.value = remaining.join('|');
            renderExistingPortfolioFiles(cell);
        };

        item.appendChild(link);
        item.appendChild(delBtn);
        listEl.appendChild(item);
    });
}

function handlePortfolioFileSelect(fileInput) {
    renderNewPortfolioFiles(fileInput);
}

function renderNewPortfolioFiles(fileInput) {
    const cell = fileInput.closest('.portfolio-file-cell');
    if (!cell) return;
    const listEl = cell.querySelector('.portfolio-new-files');
    if (!listEl) return;

    listEl.innerHTML = '';
    Array.from(fileInput.files || []).forEach((file, idx) => {
        const item = document.createElement('div');
        item.className = 'portfolio-new-file-item';

        const link = document.createElement('a');
        link.href = '#';
        link.textContent = file.name;
        link.title = '點一下查看內容';
        link.onclick = function (e) {
            e.preventDefault();
            const url = URL.createObjectURL(file);
            window.open(url, '_blank');
            setTimeout(() => URL.revokeObjectURL(url), 60000);
        };

        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'btn-remove-row no-print-in-readonly';
        delBtn.textContent = '✕';
        delBtn.title = '取消選擇這個檔案';
        delBtn.onclick = function () {
            removeNewPortfolioFile(fileInput, idx);
        };

        item.appendChild(link);
        item.appendChild(delBtn);
        listEl.appendChild(item);
    });
}

function removeNewPortfolioFile(fileInput, removeIdx) {
    const dt = new DataTransfer();
    Array.from(fileInput.files || []).forEach((file, i) => {
        if (i !== removeIdx) dt.items.add(file);
    });
    fileInput.files = dt.files;
    renderNewPortfolioFiles(fileInput);
}

function preparePortfolioFilesForSubmit() {
    document.querySelectorAll('#portfolio-list .dynamic-row-portfolio').forEach((row, idx) => {
        const fileInput = row.querySelector('.portfolio-file-input');
        if (fileInput) fileInput.name = 'PortfolioFileList_' + idx;
    });
}

function autoGrowInputWidth(el) {
    if (!el) return;
    const minWidth = 340;
    const row = el.closest('.dynamic-row-simple');
    const maxWidth = row ? Math.max(minWidth, row.clientWidth - 40) : 600;

    let ruler = window.__certWidthRuler;
    if (!ruler) {
        ruler = document.createElement('span');
        ruler.className = 'input-width-ruler';
        document.body.appendChild(ruler);
        window.__certWidthRuler = ruler;
    }
    const computed = window.getComputedStyle(el);
    ruler.style.font = computed.font;
    ruler.textContent = el.value || el.placeholder || '';

    const neededWidth = ruler.offsetWidth + 24;
    el.style.width = Math.min(Math.max(neededWidth, minWidth), maxWidth) + 'px';
}

function autoSizeInput(el) {
    if (!el) return;
    const wrap = el.closest('.scroll-input-wrap');
    if (!wrap) return;

    let ruler = wrap.querySelector('.input-width-ruler');
    if (!ruler) {
        ruler = document.createElement('span');
        ruler.className = 'input-width-ruler';
        wrap.appendChild(ruler);
    }
    const computed = window.getComputedStyle(el);
    ruler.style.font = computed.font;
    ruler.textContent = el.value || el.placeholder || '';

    const neededWidth = ruler.offsetWidth + 16;
    const minWidth = wrap.clientWidth;
    el.style.width = Math.max(neededWidth, minWidth) + 'px';
}

