    // ------ 5. 處理電腦能力（改成動態列） ------
    const compData = "@Html.Raw(Model?.ComputerSkills ?? "")";
    if (compData && compData.trim() !== "") {
        // 🎯 分隔符改用 "; "，避免電腦能力內容本身含有逗號被誤判成分隔符
        const compArray = compData.split('; ').map(s => s.trim()).filter(s => s !== "");
        // 🎯 修正：原本第一筆(index===0)沒有呼叫 addCompSkillRow()，
        //    但 #compskill-list 一開始是空的，會導致 inputs[inputs.length-1] 是 undefined，
        //    寫入時直接噴例外，讓整段反填中斷（電腦能力因此整塊空白）。改成每筆都先新增一列再填值。
        compArray.forEach((val) => {
