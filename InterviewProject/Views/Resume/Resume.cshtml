const ISO_639_1_CODES = ['aa','ab','ae','af','ak','am','an','ar','as','av','ay','az','ba','be','bg','bh','bi','bm','bn','bo','br','bs','ca','ce','ch','co','cr','cs','cu','cv','cy','da','de','dv','dz','ee','el','en','eo','es','et','eu','fa','ff','fi','fj','fo','fr','fy','ga','gd','gl','gn','gu','gv','ha','he','hi','ho','hr','ht','hu','hy','hz','ia','id','ie','ig','ii','ik','io','is','it','iu','ja','jv','ka','kg','ki','kj','kk','kl','km','kn','ko','kr','ks','ku','kv','kw','ky','la','lb','lg','li','ln','lo','lt','lu','lv','mg','mh','mi','mk','ml','mn','mr','ms','mt','my','na','nb','nd','ne','ng','nl','nn','no','nr','nv','ny','oc','oj','om','or','os','pa','pi','pl','ps','pt','qu','rm','rn','ro','ru','rw','sa','sc','sd','se','sg','si','sk','sl','sm','sn','so','sq','sr','ss','st','su','sv','sw','ta','te','tg','th','ti','tk','tl','tn','to','tr','ts','tt','tw','ty','ug','uk','ur','uz','ve','vi','vo','wa','wo','xh','yi','yo','za','zh','zu'];

function normalizeLangName(str) {
    return (str || '')
        .trim()
        .toLowerCase()
        .replace(/[（(].*?[）)]/g, '')
        .replace(/\s+/g, '')
        .replace(/[語文話]$/g, '');
}

function getKnownLanguageNameSet() {
    if (window.__knownLangSet) return window.__knownLangSet;
    const set = new Set();
    document.querySelectorAll('.lang-name-select option').forEach(opt => {
        if (opt.value && opt.value !== '其他') set.add(normalizeLangName(opt.value));
    });
    try {
        const zhDn = new Intl.DisplayNames(['zh-Hant'], { type: 'language' });
        const enDn = new Intl.DisplayNames(['en'], { type: 'language' });
        ISO_639_1_CODES.forEach(code => {
            try {
                const zhName = zhDn.of(code);
                if (zhName) set.add(normalizeLangName(zhName));
            } catch (e) {}
            try {
                const enName = enDn.of(code);
                if (enName) set.add(normalizeLangName(enName));
            } catch (e) {}
        });
    } catch (e) {}
    window.__knownLangSet = set;
    return set;
}

function isRecognizedLanguageName(name) {
    const set = getKnownLanguageNameSet();
    if (set.size === 0) return true;
    return set.has(normalizeLangName(name));
}

function setLangOtherError(inputEl, hasError, message) {
    const wrap = inputEl.closest('.lang-other-wrap');
    const msgEl = wrap ? wrap.querySelector('.lang-other-error-msg') : null;
    if (hasError) {
        inputEl.classList.add('input-error');
        if (msgEl) {
            msgEl.textContent = message || '請輸入正確語言';
            msgEl.style.display = '';
        }
    } else {
        inputEl.classList.remove('input-error');
        if (msgEl) msgEl.style.display = 'none';
    }
}

function checkLangOtherMatch(inputEl, isFinal) {
    const row = inputEl.closest('.dynamic-row-simple');
    if (!row) return;
    const nameSelect = row.querySelector('.lang-name-select');
    if (!nameSelect) return;
    const typed = inputEl.value.trim();

    if (inputEl.__langCheckTimer) {
        clearTimeout(inputEl.__langCheckTimer);
        inputEl.__langCheckTimer = null;
    }
    if (!typed) {
        setLangOtherError(inputEl, false);
        return;
    }

    const typedNorm = normalizeLangName(typed);
    const matchedOption = Array.from(nameSelect.options).find(
        opt => opt.value !== '其他' && normalizeLangName(opt.value) === typedNorm
    );
    if (matchedOption) {
        nameSelect.value = matchedOption.value;
        inputEl.value = '';
        inputEl.style.display = 'none';
        setLangOtherError(inputEl, false);
        return;
    }

    if (isFinal) {
        if (!isRecognizedLanguageName(typed)) {
            setLangOtherError(inputEl, true, '請輸入正確語言');
        } else {
            setLangOtherError(inputEl, false);
        }
        return;
    }

    inputEl.__langCheckTimer = setTimeout(() => {
        if (document.body.contains(inputEl) && inputEl.value.trim() === typed) {
            checkLangOtherMatch(inputEl, true);
        }
    }, 600);
}

function toggleLangOtherInput(selectEl) {
