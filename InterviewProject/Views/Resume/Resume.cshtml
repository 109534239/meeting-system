@model InterviewProject.Models.Resume
@{
    ViewData["Title"] = "填寫履歷";
    bool isReadOnly = ViewBag.IsReadOnly ?? false;
}

@section Styles {
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Resume.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
}

@* 在最外層標籤加上動態 Class *@
<div class="resume-paper @(isReadOnly ? "is-readonly" : "")">
    <div class="resume-title">履    歷    表</div>

    <div style="text-align:right; margin-bottom:10px; color:#666;">
        應徵職位：
        <span style="color: #d9534f; font-weight: bold;">
            @* 1. 優先顯示關聯的 Job Title *@
            @if (Model.Job != null)
            {
                @Model.Job.Title
            }
            @* 2. 如果沒關聯，顯示 JobsId 原始值 *@
            else
            {
                @(Model.JobsId.ToString() ?? "未指定職缺")
            }
        </span>
    </div>

    @if (!isReadOnly)
    {
        <div class="parse-resume-bar no-print">
            <div class="parse-resume-info">
                <i class="fa-solid fa-file-arrow-up text-primary" style="font-size: 1.5rem;"></i>
                <div>
                    <strong>匯入既有履歷檔</strong>
                    <div class="text-muted style-small" style="font-size:0.85rem;">上傳您現有的履歷檔案（如附件 PDF / Word），點擊「套用」即可自動將資料填入下方欄位。</div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <input type="file" id="resumeUploadFile" class="form-control form-control-sm" accept=".pdf,.doc,.docx,.txt" style="max-width: 250px;" />
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="uploadAndApplyResume()">
                    <i class="fa-solid fa-wand-magic-sparkles"></i> 套用
                </button>
            </div>
        </div>
    }

    @* 🎯 修改重點：加入 id="resumeForm" 確保下方腳本綁定正確表單 *@
    <form id="resumeForm" method="post" asp-controller="Resume" asp-action="SaveResume" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="JobsId" />
        <input type="hidden" asp-for="MembersId" />
        <input type="hidden" name="Id" value="@Model.Id" />
        <input type="hidden" name="JobsId" value="@Model.JobsId" />

         @* 🎯 工作年資改為依「工作經歷」列表自動換算，不再需要使用者手動選擇/輸入 *@
        <input type="hidden" asp-for="WorkExperienceYears" id="workYearsInput" />

        <table class="main-table">
            <tr>
                <td rowspan="7" class="label-bg">基本<br />資料</td>
                <td>姓名</td>
                <td>
                    <input class="full-input" value="@ViewBag.UserName" readonly />
                </td>
                <td>性別</td>
                <td>
                    <input type="radio" name="Gender" value="男" @(ViewBag.UserGender == "男" ? "checked" : "") disabled />男
                    <input type="radio" name="Gender" value="女" @(ViewBag.UserGender == "女" ? "checked" : "") disabled />女
                </td>
               <td rowspan="4" class="photo-cell">
                    <div class="photo-preview" id="resume-photo-preview">
                        @if (!string.IsNullOrEmpty(ViewBag.UserPhotoBase64))
                        {
                            <img src="@ViewBag.UserPhotoBase64" alt="個人照" />
                        }
                        else
                        {
                            <span>無照片</span>
                        }
                    </div>
                    @* 🎯 比照 Profile.cshtml 的做法：選檔案 → FileReader 轉 base64 → 即時預覽 →
                       存進這個 hidden input，隨 SaveResume 表單一起送出，後端要存回 Member.ProfileImagePath *@
                    <input type="hidden" name="ProfileImageBase64" id="resumePhotoBase64Input" value="@ViewBag.UserPhotoBase64" />
                    <label class="btn-upload-photo no-print-in-readonly">
                        更換照片
                        <input type="file" id="resumePhotoFileInput" accept="image/*" style="display:none" />
                    </label>
                </td>
            </tr>
            <tr>
                <td>身分證號碼</td>
                <td>
                    <input class="full-input" value="@ViewBag.UserIdNumber" readonly />
                </td>
                <td>出生日期</td>
                <td><input class="full-input" value="@ViewBag.UserBirthday" readonly /></td>
            </tr>
            <tr>
               <td class="field-label"><a class="required-mark">*</a>聯絡地址</td>
                <td colspan="3">
                    <input class="full-input" asp-for="ContactAddress" required />
                </td>
            </tr>
            <tr>
                <td class="field-label"><a class="required-mark">*</a>婚姻狀況</td>
                <td>
                    <input type="radio" asp-for="MaritalStatus" value="已婚" required />已婚
                    <input type="radio" asp-for="MaritalStatus" value="單身" required />單身
                </td>
                <td class="field-label"><a class="required-mark">*</a>兵役狀況</td>
                <td>
                    <input type="radio" asp-for="MilitaryService" value="免役" required />免役
                    <input type="radio" asp-for="MilitaryService" value="役畢" required />役畢<br />
                    <input type="radio" asp-for="MilitaryService" value="未役" required />未役
                    <input type="radio" asp-for="MilitaryService" value="待役中" required />待役中
                </td>
            </tr>

            <tr>
                <td class="field-label"><a class="required-mark">*</a>聯絡電話</td>
                <td colspan="5">
                    <input asp-for="Phone1" class="input-inline" style="width:220px" required placeholder="行動電話" />
                    <span class="text-muted">(預設帶入您註冊時填寫的手機號碼，若這次應徵想留其他聯絡方式可直接修改)</span>
                </td>
            </tr>

            <tr>
                <td class="field-label">電子信箱</td>
                <td colspan="5"><input class="full-input" value="@ViewBag.UserEmail" readonly /></td>
            </tr>

            <tr>
               <td class="field-label"><a class="required-mark">*</a>學歷<span class="text-muted">(可新增多筆，第一筆請填最高學歷)</span></td>
                <td colspan="5">
                    <div class="edu-table-wrap">
                    <table class="edu-table">
                        <colgroup>
                            <col style="width:13%">
                            <col style="width:21%">
                            <col style="width:19%">
                            <col style="width:14%">
                            <col style="width:13%">
                            <col style="width:13%">
                            <col style="width:40px">
                        </colgroup>
                        <thead>
                            <tr>
                                <th>學歷</th>
                                <th>學校名稱</th>
                                <th>科系所</th>
                                <th>畢(肄)業狀況</th>
                                <th>入學年月</th>
                                <th>畢業年月</th>
                            </tr>
                        </thead>
                        <tbody id="education-list">
                            @{
                                var eduList = (Model?.Educations != null && Model.Educations.Any())
                                    ? Model.Educations.OrderBy(e => e.SortOrder).ToList()
                                    : new List<InterviewProject.Models.Education> { new InterviewProject.Models.Education() };
                            }
                            @for (int i = 0; i < eduList.Count; i++)
                            {
                                var edu = eduList[i];
                                <tr class="dynamic-row-edu">
                                    <td>
                                        <select name="EduLevelList" class="form-control" required>
                                            <option value="" disabled selected="@(string.IsNullOrEmpty(edu.EduLevel))">請選擇</option>
                                            <option value="博士" selected="@(edu.EduLevel == "博士")">博士</option>
                                            <option value="碩士" selected="@(edu.EduLevel == "碩士")">碩士</option>
                                            <option value="大學" selected="@(edu.EduLevel == "大學")">大學</option>
                                            <option value="專科" selected="@(edu.EduLevel == "專科")">專科</option>
                                            <option value="高職" selected="@(edu.EduLevel == "高職")">高職</option>
                                            <option value="高中" selected="@(edu.EduLevel == "高中")">高中</option>
                                            <option value="國中" selected="@(edu.EduLevel == "國中")">國中</option>
                                            <option value="國小" selected="@(edu.EduLevel == "國小")">國小</option>
                                        </select>
                                    </td>
                                    <td>
                                        <div class="scroll-input-wrap">
                                            <input type="text" name="SchoolNameList" class="form-control" value="@edu.SchoolName" placeholder="學校名稱" required oninput="autoSizeInput(this)" />
                                        </div>
                                    </td>
                                    <td>
                                        <div class="scroll-input-wrap">
                                            <input type="text" name="MajorList" class="form-control" value="@edu.Major" placeholder="科系所" required oninput="autoSizeInput(this)" />
                                        </div>
                                    </td>
                                    <td>
                                        <select name="EduStatusList" class="form-control" required>
                                            <option value="" disabled selected="@(string.IsNullOrEmpty(edu.EduStatus))">請選擇</option>
                                            <option value="畢業" selected="@(edu.EduStatus == "畢業")">畢業</option>
                                            <option value="肄業" selected="@(edu.EduStatus == "肄業")">肄業</option>
                                            <option value="在學" selected="@(edu.EduStatus == "在學")">在學</option>
                                        </select>
                                    </td>
                                    <td>
                                        <div class="ym-select-wrap">
                                            <select class="form-control" data-part="year" required></select>
                                            <select class="form-control" data-part="month" required></select>
                                        </div>
                                        <input type="hidden" name="StartDateList" value="@(edu.StartDate?.ToString("yyyy-MM"))" />
                                    </td>
                                    <td>
                                        <div class="ym-select-wrap">
                                            <select class="form-control" data-part="year" required></select>
                                            <select class="form-control" data-part="month" required></select>
                                        </div>
                                        <input type="hidden" name="EndDateList" value="@(edu.EndDate?.ToString("yyyy-MM"))" />
                                    </td>
                                    <td class="remove-cell"><button type="button" class="btn-remove-row no-print-in-readonly" onclick="removeRow(this)">✕</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                    <button type="button" class="btn-add-row no-print-in-readonly" onclick="addEducationRow()">＋ 新增學歷</button>
                </td>
            </tr>

            <tr>
                <td class="label-bg">工作<br />經歷</td>
                <td colspan="5">
                    <div class="edu-table-wrap">
                    <table class="edu-table work-table">
                        <colgroup>
                            <col style="width:18%">
                            <col style="width:15%">
                            <col style="width:38%">
                            <col style="width:12%">
                            <col style="width:12%">
                            <col style="width:40px">
                        </colgroup>
                        <thead>
                            <tr>
                                <th>公司名稱</th>
                                <th>職位</th>
                                <th>工作內容</th>
                                <th>開始日期</th>
                                <th>結束日期</th>
                            </tr>
                        </thead>
                        <tbody id="work-list">
                            @{
                                var workList = (Model?.WorkExperiences != null && Model.WorkExperiences.Any())
                                    ? Model.WorkExperiences.OrderBy(w => w.SortOrder).ToList()
                                    : new List<InterviewProject.Models.WorkExperience>();
                            }
                            @for (int i = 0; i < workList.Count; i++)
                            {
                                var work = workList[i];
                                <tr class="dynamic-row-work">
                                    <td><textarea name="CompanyNameList" class="form-control work-company" placeholder="公司名稱" rows="1" oninput="autoGrowTextarea(this)">@work.CompanyName</textarea></td>
                                    <td><textarea name="JobTitleList" class="form-control work-title" placeholder="職位" rows="1" oninput="autoGrowTextarea(this)">@work.JobTitle</textarea></td>
                                    <td><textarea name="JobDescriptionList" class="form-control" placeholder="工作內容" rows="1" oninput="autoGrowTextarea(this)">@work.JobDescription</textarea></td>
                                    <td>
                                        <div class="ym-select-wrap">
                                            <select class="form-control" data-part="year"></select>
                                            <select class="form-control" data-part="month"></select>
                                        </div>
                                        <input type="hidden" name="WorkStartDateList" value="@(work.StartDate?.ToString("yyyy-MM"))" />
                                    </td>
                                    <td>
                                        <div class="ym-select-wrap">
                                            <select class="form-control" data-part="year"></select>
                                            <select class="form-control" data-part="month"></select>
                                        </div>
                                        <input type="hidden" name="WorkEndDateList" value="@(work.EndDate?.ToString("yyyy-MM"))" />
                                    </td>
                                    <td class="remove-cell"><button type="button" class="btn-remove-row no-print-in-readonly" onclick="removeWorkRow(this)">✕</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                    <button type="button" class="btn-add-row no-print-in-readonly" onclick="addWorkRow()">＋ 新增工作經歷</button>
                    <div id="noWorkExpHint" class="text-muted" style="margin-top:6px; @(workList.Any() ? "display:none;" : "")">目前尚未新增任何工作經歷，將視為「無工作經歷」。</div>
                </td>
            </tr>

            <tr>
                <td class="label-bg">作品集</td>
                <td colspan="5">
                    <div class="edu-table-wrap">
                    <table class="edu-table portfolio-table">
                        <colgroup>
                            <col style="width:25%">
                            <col style="width:30%">
                            <col style="width:25%">
                            <col style="width:25%">
                            <col style="width:40px">
                        </colgroup>
                        <thead>
                            <tr>
                                <th>作品名稱</th>
                                <th>作品說明</th>
                                <th>連結</th>
                                <th>上傳檔案</th>
                            </tr>
                        </thead>
                       <tbody id="portfolio-list">
                            @{
                                var portfolioList = (Model?.Portfolios != null && Model.Portfolios.Any())
                                    ? Model.Portfolios.OrderBy(p => p.SortOrder).ToList()
                                    : new List<InterviewProject.Models.Portfolio>();
                            }
                            @for (int i = 0; i < portfolioList.Count; i++)
                            {
                                var pf = portfolioList[i];
                                <tr class="dynamic-row-portfolio">
                                    <td><textarea name="PortfolioTitleList" class="form-control" placeholder="作品名稱" rows="1" oninput="autoGrowTextarea(this)">@pf.Title</textarea></td>
                                    <td><textarea name="PortfolioDescList" class="form-control" placeholder="作品說明" rows="1" oninput="autoGrowTextarea(this)">@pf.Description</textarea></td>
                                    <td><textarea name="PortfolioLinkList" class="form-control portfolio-link" placeholder="https://" rows="1" autocomplete="off" oninput="autoGrowTextarea(this)">@pf.Link</textarea></td>
                                    <td class="portfolio-file-cell">
                                        <input type="hidden" name="PortfolioExistingFileList" class="portfolio-existing-file" value="@pf.FilePath" />
                                        <div class="portfolio-existing-list"></div>
                                        <label class="btn-upload-file no-print-in-readonly">
                                            選擇檔案
                                            <input type="file" name="PortfolioFileList" class="portfolio-file-input no-print-in-readonly" multiple onchange="handlePortfolioFileSelect(this)" />
                                        </label>
                                        <div class="portfolio-new-files"></div>
                                    </td>
                                    <td class="remove-cell"><button type="button" class="btn-remove-row no-print-in-readonly" onclick="removePortfolioRow(this)">✕</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                    <button type="button" class="btn-add-row no-print-in-readonly" onclick="addPortfolioRow()">＋ 新增作品</button>
                    <div id="noPortfolioHint" class="text-muted" style="margin-top:6px; @(portfolioList.Any() ? "display:none;" : "")">目前尚未新增任何作品集，將視為「無」。</div>
                </td>
            </tr>

            <tr>
                <td rowspan="5" class="label-bg">背景<br />及<br />專長</td>
                <td>語文能力<br />(可新增多筆，未新增即視為不具外文能力)</td>
                <td colspan="4">
                    <input type="hidden" asp-for="LanguageSkills" id="finalLanguageSkills" />
                    <div id="language-list" style="margin-top:6px;">
                    </div>
                    <button type="button" class="btn-add-row no-print-in-readonly" onclick="addLanguageRow()">＋ 新增語言</button>
                    @{
                        var hasLangData = !string.IsNullOrWhiteSpace(Model?.LanguageSkills) && Model.LanguageSkills.Trim() != "不具外文能力";
                    }
                    <div id="noLangHint" class="text-muted" style="margin-top:6px; @(hasLangData ? "display:none;" : "")">目前尚未新增任何語言，將視為「不具外文能力」。</div>
                </td>
            </tr>

            <tr>
                <td>駕照種類<br />(可複選)</td>
                <td colspan="4">
                    <input type="hidden" asp-for="DriverLicense" id="finalDriverLicense" />
                    <div id="licenseGroup">
                        <div class="license-row" data-type="普通">
                            普通：
                            <input type="checkbox" class="license-chk" value="小型車" />小型車
                            <input type="checkbox" class="license-chk" value="大貨車" />大貨車
                            <input type="checkbox" class="license-chk" value="大客車" />大客車
                            <input type="checkbox" class="license-chk" value="連結車" />連結車
                        </div>
                        <div class="license-row" data-type="職業">
                            職業：
                            <input type="checkbox" class="license-chk" value="小型車" />小型車
                            <input type="checkbox" class="license-chk" value="大貨車" />大貨車
                            <input type="checkbox" class="license-chk" value="大客車" />大客車
                            <input type="checkbox" class="license-chk" value="連結車" />連結車
                        </div>
                        <div class="license-row" data-type="機車">
                            機車：
                            <input type="checkbox" class="license-chk" value="輕型" />輕型
                            <input type="checkbox" class="license-chk" value="普通重型" />普通重型
                            <input type="checkbox" class="license-chk" value="大型重型" />大型重型
                        </div>
                        <div class="license-row" data-type="汽(機)車">
                            汽(機)車：
                            <input type="checkbox" class="license-chk" value="無" />無
                            <input type="checkbox" class="license-chk" value="自備" />自備
                        </div>
                    </div>
                </td>
            </tr>

             <tr>
                <td>專長<br />(可新增多筆，未新增即視為無)</td>
                <td colspan="4">
                    <input type="hidden" asp-for="Specialty" id="finalSpecialty" />
                    <div id="specialty-list">
                    </div>
                    <button type="button" class="btn-add-row no-print-in-readonly" onclick="addSpecialtyRow()">＋ 新增專長</button>
                    @{
                        var hasSpecData = !string.IsNullOrWhiteSpace(Model?.Specialty);
                    }
                    <div id="noSpecHint" class="text-muted" style="margin-top:6px; @(hasSpecData ? "display:none;" : "")">目前尚未新增任何專長，將視為「無」。</div>
                </td>
            </tr>
           <tr>
               <td>證照職類及級別<br />(可輸入自訂項目，未列在建議清單也能填)</td>
               <td colspan="4">
                    <input type="hidden" asp-for="Certificates" id="finalCertificates" />

                    @* 🎯 依應徵職位比對出的推薦證照，會用小按鈕呈現在最上面方便快速點選 *@
                    <div id="certRecommendWrap" style="display:none; margin-bottom:8px;">
                        <span class="text-muted">依此職缺推薦：</span>
                        <span id="certRecommendChips"></span>
                    </div>

                    <div id="cert-list">
                        <div class="cert-item dynamic-row-simple" style="margin-bottom: 8px;">
                            <input type="text" class="cert-select" list="certNameOptions" placeholder="輸入或選擇證照名稱" oninput="autoGrowInputWidth(this)" />
                            <span class="cert-level-wrap">
                                <span class="cert-level-label">級別：</span>
                                <input type="text" class="cert-level-select" list="certLevelOptions_0" placeholder="級別（無則留空）" />
                                <datalist id="certLevelOptions_0"></datalist>
                            </span>
                            <button type="button" class="btn-remove-row no-print-in-readonly" onclick="removeSimpleRow(this)">✕</button>
                        </div>
                    </div>
                    <datalist id="certNameOptions"></datalist>
                    <button type="button" class="btn-add-row no-print-in-readonly" onclick="addCertRow()">＋ 新增證照</button>
                </td>
            </tr>

            <tr>
                <td>使用電腦能力<br />(可新增多筆，未新增即視為無)</td>
                <td colspan="4">
                    <input type="hidden" asp-for="ComputerSkills" id="finalComputerSkills" />
                    <div id="compskill-list">
                    </div>
                    <button type="button" class="btn-add-row no-print-in-readonly" onclick="addCompSkillRow()">＋ 新增電腦能力</button>
                    @{
                        var hasCompData = !string.IsNullOrWhiteSpace(Model?.ComputerSkills);
                    }
                    <div id="noCompHint" class="text-muted" style="margin-top:6px; @(hasCompData ? "display:none;" : "")">目前尚未新增任何電腦能力，將視為「無」。</div>
                </td>
            </tr>

            <tr>
                <td class="label-bg"><a class="required-mark">*</a>自傳</td>
                <td colspan="5">
                    <textarea asp-for="Autobiography"
                              rows="12"
                              class="autobiography-textarea"
                              required
                              readonly="@(ViewBag.IsReadOnly == true ? "readonly" : null)"></textarea>
                </td>
            </tr>
        </table>
        <input type="hidden" asp-for="ResumeTime" id="finalResumeTime" />
        <div style="margin-top: 20px; text-align: center;" class="no-print">
        <button type="button" class="btn btn-outline-secondary" onclick="history.back()">
            <i class="fa-solid fa-arrow-left"></i> 回上一頁
        </button>

            @if (isReadOnly)
            {
                <button type="submit" asp-controller="Resume" asp-action="ExportToPdf" class="btn btn-secondary btn-pdf-export" formnovalidate>
                    列印 PDF
                </button>
            }
        else
        {
            <button type="submit" name="submitType" value="draft" class="btn btn-success" formnovalidate>
                暫存
            </button>
            <button type="submit" name="submitType" value="submit" class="btn btn-primary">
                儲存繳交
            </button>
        }
        </div>
      
    </form>
</div>

<script>
// 💡 1. 宣告全域變數（放最外層）
var globalCertList = [];
var certListLoaded = false; // 🚨 證照對照表是非同步 fetch 回來的；若使用者在資料還沒抓回來前就送出表單，
