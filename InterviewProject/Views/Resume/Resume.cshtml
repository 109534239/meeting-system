@model InterviewProject.Models.Resume
@{
    ViewData["Title"] = "填寫履歷";
    bool isReadOnly = ViewBag.IsReadOnly ?? false;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Resume.css" asp-append-version="true" />
    @if (isReadOnly)
    {
        <style>
            /* 鎖定容器內所有的控制項 */
            .is-readonly input,
            .is-readonly textarea,
            .is-readonly select {
                background-color: #f9f9f9 !important;
                border-color: #ccc !important;
                pointer-events: none; /* 徹底禁止滑鼠互動 */
                cursor: not-allowed;
            }

                /* 讓 Radio / Checkbox 看起來是灰色的 */
                .is-readonly input[type="radio"],
                .is-readonly input[type="checkbox"] {
                    filter: grayscale(1);
                    opacity: 0.6;
                }

            /* 隱藏不必要的提示或按鈕 */
            .is-readonly .no-print-in-readonly {
                display: none !important;
            }
        </style>
    }
}

@* 在最外層標籤加上動態 Class *@
<div class="resume-paper @(isReadOnly ? "is-readonly" : "")">
    <div class="resume-title">履    歷    表</div>

    <div style="text-align:right; margin-bottom:10px; color:#666;">
        應徵職位：
        <span style="color: #d9534f; font-weight: bold;">
            @* 1. 優先顯示關聯的 Job Title *@
            @if (Model.Job != null)
            {
                @Model.Job.Title
            }
            @* 2. 如果沒關聯，顯示 JobsId 原始值 *@
            else
            {
                @(Model.JobsId.ToString() ?? "未指定職缺")
            }
        </span>
    </div>

    @* 🎯 修改重點：加入 id="resumeForm" 確保下方腳本綁定正確表單 *@
    <form id="resumeForm" method="post" asp-action="SaveResume">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="JobsId" />
        <input type="hidden" asp-for="MembersId" />

        <table class="main-table">
            <tr>
                <td rowspan="7" class="label-bg">基本<br />資料</td>
                <td>姓名</td>
                <td>
                    <input class="full-input" value="@ViewBag.UserName" readonly />
                </td>
                <td>性別</td>
                <td>
                    <input type="radio" name="Gender" value="男" @(ViewBag.UserGender == "男" ? "checked" : "") disabled />男
                    <input type="radio" name="Gender" value="女" @(ViewBag.UserGender == "女" ? "checked" : "") disabled />女
                </td>
                <td rowspan="4" class="photo-cell">
                    @if (!string.IsNullOrEmpty(ViewBag.UserPhotoBase64))
                    {
                        <img src="@ViewBag.UserPhotoBase64" alt="個人照" />
                    }
                    else
                    {
                        <span>無照片</span>
                    }
                </td>
            </tr>
            <tr>
                <td>身分證號碼</td>
                <td>
                    <input class="full-input" value="@ViewBag.UserIdNumber" readonly />
                </td>
                <td>出生日期</td>
                <td><input class="full-input" value="@ViewBag.UserBirthday" readonly /></td>
            </tr>
            <tr>
                <td><a class="required-mark">*</a>聯絡地址</td>
                <td colspan="3">
                    <input class="full-input" value="@ViewBag.UserAddress" readonly />
                </td>
            </tr>
            <tr>
                <td><a class="required-mark">*</a>婚姻狀況</td>
                <td>
                    <input type="radio" asp-for="MaritalStatus" value="已婚" required />已婚
                    <input type="radio" asp-for="MaritalStatus" value="單身" required />單身
                </td>
                <td><a class="required-mark">*</a>兵役狀況</td>
                <td>
                    <input type="radio" asp-for="MilitaryService" value="免役" required />免役
                    <input type="radio" asp-for="MilitaryService" value="役畢" required />役畢<br />
                    <input type="radio" asp-for="MilitaryService" value="未役" required />未役
                    <input type="radio" asp-for="MilitaryService" value="待役中" required />待役中
                </td>
            </tr>

            <tr>
                <td>聯絡電話</td>
                <td colspan="5">
                    <div style="display:flex; flex-wrap:wrap; gap: 10px;">
                        <span><a class="required-mark">*</a>電話1：<input asp-for="Phone1" class="input-inline" style="width:150px" required /></span>
                        <span>電話2：<input asp-for="Phone2" class="input-inline" style="width:150px" /></span>
                        <span><a class="required-mark">*</a>行動：<input asp-for="Mobile" class="input-inline" style="width:150px" required /></span>
                    </div>
                </td>
            </tr>

            <tr>
                <td><a class="required-mark">*</a>學歷</td>
                <td colspan="5">
                    <div style="margin-bottom: 10px; padding-left: 10px;">
                        <input type="radio" asp-for="EduLevel" value="博士" required />博士
                        <input type="radio" asp-for="EduLevel" value="碩士" />碩士
                        <input type="radio" asp-for="EduLevel" value="大學" />大學
                        <input type="radio" asp-for="EduLevel" value="專科" />專科
                        <input type="radio" asp-for="EduLevel" value="高職" />高職
                        <input type="radio" asp-for="EduLevel" value="高中" />高中
                        <input type="radio" asp-for="EduLevel" value="國中" />國中
                        <input type="radio" asp-for="EduLevel" value="國小" />國小
                        <input type="radio" asp-for="EduLevel" id="radioOther" value="Other" style="display:none" />
                        其他：<input type="text" id="otherEduLevel" class="input-inline" style="width:80px" />
                    </div>
                    <table style="width:100%; border-collapse:collapse; margin:-8px;">
                        <tr style="text-align:center; background:#eee;">
                            <td style="border:1px solid black; width:30%;">學校名稱</td>
                            <td style="border:1px solid black; width:25%;">科系所</td>
                            <td style="border:1px solid black; width:25%;">畢(肄)業狀況</td>
                            <td style="border:1px solid black; width:20%;">年月</td>
                        </tr>
                        <tr>
                            <td style="border:1px solid black"><input asp-for="SchoolName" class="full-input" required /></td>
                            <td style="border:1px solid black"><input asp-for="Major" class="full-input" required /></td>
                            <td style="border:1px solid black" id="eduStatusArea">
                                <input type="hidden" asp-for="EduStatus" id="finalEduStatus" />
                                <input type="checkbox" class="edu-chk" value="畢業" />畢業
                                <input type="checkbox" class="edu-chk" value="肄業" />肄業
                                <input type="checkbox" class="edu-chk" value="在學" />在學
                            </td>
                            <td style="border:1px solid black"><input type="month" asp-for="EduDate" class="full-input" required /></td>
                        </tr>
                    </table>
                </td>
            </tr>

            <tr>
                <td>電子信箱</td>
                <td colspan="5"><input class="full-input" value="@ViewBag.UserEmail" readonly /></td>
            </tr>

            <tr>
                <td class="label-bg"><a class="required-mark">*</a>工作<br />經歷</td>
                <td colspan="5">
                    <div style="padding: 10px;">
                        <label>
                            <input type="radio" name="workExpType"
                                   checked="@(Model.WorkExperienceYears == 0)"
                                   onclick="setWorkExp(0)" /> 無工作經歷
                        </label>

                        <label style="margin-left: 20px;">
                            <input type="radio" name="workExpType"
                                   checked="@(Model.WorkExperienceYears > 0)"
                                   onclick="setWorkExp(1)" /> 工作總年資：

                            <input asp-for="WorkExperienceYears" id="workYearsInput"
                                   type="number" class="input-inline" style="width:50px"
                                   value="@(Model.WorkExperienceYears <= 0 ? "" : Model.WorkExperienceYears.ToString())"
                                   readonly="@(Model.WorkExperienceYears <= 0)" /> 年
                        </label>
                    </div>
                    <table style="width:100%; border-collapse:collapse; margin:-8px;">
                        <tr style="text-align:center; background:#eee;">
                            <td style="border:1px solid black; width:33%;">公司名稱</td>
                            <td style="border:1px solid black; width:33%;">工作職稱</td>
                            <td style="border:1px solid black; width:33%;">工作說明</td>
                        </tr>
                        <tr>
                            <td style="border:1px solid black"><input asp-for="CompanyName" id="CompanyName" class="full-input" /></td>
                            <td style="border:1px solid black"><input asp-for="JobTitle" id="JobTitle" class="full-input" /></td>
                            <td style="border:1px solid black"><input asp-for="JobDescription" id="JobDescription" class="full-input" /></td>
                        </tr>
                    </table>
                </td>
            </tr>
            <tr>
                <td rowspan="5" class="label-bg">背景<br />及<br />專長</td>
                <td>語文能力<br />(可複選)</td>
                <td colspan="4">
                    <input type="hidden" asp-for="LanguageSkills" id="finalLanguageSkills" />
                    <div class="lang-group">
                        1. <input type="checkbox" class="lang-node" value="不具外文能力" />不具外文能力<br />

                        <div class="lang-row">
                            2. <span class="lang-label">英語</span>：
                            <input type="checkbox" class="lang-lv" value="精通" />精通
                            <input type="checkbox" class="lang-lv" value="良好" />良好
                            <input type="checkbox" class="lang-lv" value="普通" />普通
                            <input type="checkbox" class="lang-lv" value="稍懂" />稍懂
                        </div>

                        <div class="lang-row">
                            3. <span class="lang-label">日語</span>：
                            <input type="checkbox" class="lang-lv" value="精通" />精通
                            <input type="checkbox" class="lang-lv" value="良好" />良好
                            <input type="checkbox" class="lang-lv" value="普通" />普通
                            <input type="checkbox" class="lang-lv" value="稍懂" />稍懂
                        </div>

                        <div class="lang-row">
                            4. <span class="lang-label">台語</span>：
                            <input type="checkbox" class="lang-lv" value="精通" />精通
                            <input type="checkbox" class="lang-lv" value="良好" />良好
                            <input type="checkbox" class="lang-lv" value="普通" />普通
                            <input type="checkbox" class="lang-lv" value="稍懂" />稍懂
                        </div>

                        <div class="lang-row">
                            5. <span class="lang-label">客語</span>：
                            <input type="checkbox" class="lang-lv" value="精通" />精通
                            <input type="checkbox" class="lang-lv" value="良好" />良好
                            <input type="checkbox" class="lang-lv" value="普通" />普通
                            <input type="checkbox" class="lang-lv" value="稍懂" />稍懂
                        </div>

                        <div class="lang-row">
                            6. <span class="lang-label">其他</span>：<input type="text" id="otherLangName" class="input-inline" style="width:80px" />
                            <input type="checkbox" class="lang-lv" value="精通" />精通
                            <input type="checkbox" class="lang-lv" value="良好" />良好
                            <input type="checkbox" class="lang-lv" value="普通" />普通
                            <input type="checkbox" class="lang-lv" value="稍懂" />稍懂
                        </div>
                    </div>
                </td>
            </tr>
            <tr>
                <td>駕照種類<br />(可複選)</td>
                <td colspan="4">
                    <input type="hidden" asp-for="DriverLicense" id="finalDriverLicense" />
                    <div id="licenseGroup">
                        <div class="license-row" data-type="自用">
                            自用：
                            <input type="checkbox" class="license-chk" value="小" />小
                            <input type="checkbox" class="license-chk" value="大" />大
                        </div>
                        <div class="license-row" data-type="職業">
                            職業：
                            <input type="checkbox" class="license-chk" value="小" />小
                            <input type="checkbox" class="license-chk" value="大" />大
                            <input type="checkbox" class="license-chk" value="客" />客
                        </div>
                        <div class="license-row" data-type="機車">
                            機車：
                            <input type="checkbox" class="license-chk" value="輕型" />輕型
                            <input type="checkbox" class="license-chk" value="重型" />重型
                        </div>
                        <div class="license-row" data-type="汽(機)車">
                            汽(機)車：
                            <input type="checkbox" class="license-chk" value="無" />無
                            <input type="checkbox" class="license-chk" value="自備" />自備
                        </div>
                    </div>
                </td>
            </tr>
            <tr>
                <td>專長</td>
                <td colspan="4">
                    <input type="hidden" asp-for="Specialty" id="finalSpecialty" />
                    1.<input type="text" class="spec-input" style="width:80%" /><br />
                    2.<input type="text" class="spec-input" style="width:80%" /><br />
                    3.<input type="text" class="spec-input" style="width:80%" />
                </td>
            </tr>
           <tr>
    <td>證照職類及級別</td>
    <td colspan="4">
        <input type="hidden" asp-for="Certificates" id="finalCertificates" />
        
        <div class="cert-item" style="margin-bottom: 8px;">
            1. <select class="cert-select" style="width:200px;"><option value="">--請選擇證照--</option></select>
            級別：<select class="cert-level-select" style="width:100px;"><option value="">--級別--</option></select>
        </div>
        <div class="cert-item" style="margin-bottom: 8px;">
            2. <select class="cert-select" style="width:200px;"><option value="">--請選擇證照--</option></select>
            級別：<select class="cert-level-select" style="width:100px;"><option value="">--級別--</option></select>
        </div>
        <div class="cert-item">
            3. <select class="cert-select" style="width:200px;"><option value="">--請選擇證照--</option></select>
            級別：<select class="cert-level-select" style="width:100px;"><option value="">--級別--</option></select>
        </div>
    </td>
</tr>

            <tr>
                <td>使用電腦能力<br />(可複選)</td>
                <td colspan="4">
                    <input type="hidden" asp-for="ComputerSkills" id="finalComputerSkills" />
                    <input type="checkbox" class="comp-chk" value="電腦基本操作" />電腦基本操作
                    <input type="checkbox" class="comp-chk" value="文書處理" />文書處理
                    <input type="checkbox" class="comp-chk" value="網際網路" />網際網路
                    <input type="checkbox" class="comp-chk" value="網頁編輯" />網頁編輯
                    <input type="checkbox" class="comp-chk" value="商業軟體" />商業軟體
                    <input type="checkbox" class="comp-chk" value="程式設計" />程式設計<br />
                    <input type="checkbox" class="comp-chk" value="其他" />其他：
                    <input type="text" id="otherCompName" class="input-inline" style="width:80px" />
                </td>
            </tr>

            <tr>
                <td class="label-bg"><a class="required-mark">*</a>自傳</td>
                <td colspan="5">
                    <textarea asp-for="Autobiography"
                              rows="12"
                              class="autobiography-textarea"
                              required
                              readonly="@(ViewBag.IsReadOnly == true ? "readonly" : null)"></textarea>
                </td>
            </tr>
        </table>
        <input type="hidden" asp-for="ResumeTime" id="finalResumeTime" />

        <div style="margin-top: 20px; text-align: center;" class="no-print">
            <button type="button" class="btn btn-warning" onclick="history.back()">
                回上一頁
            </button>

            @if (isReadOnly)
            {
                <button type="submit" asp-controller="Resume" asp-action="ExportToPdf" class="btn btn-secondary" formnovalidate>
                    列印 PDF
                </button>
            }
            else
            {
                <button type="submit" class="btn btn-primary">
                    儲存並繳交
                </button>
            }
        </div>
    </form>
</div>

<script>
// 💡 1. 宣告全域變數（放最外層）
var globalCertList = [];

// 💡 2. 將非同步的 fetch 移到最外層，網頁一開立刻背景撈取資料，不卡畫面
fetch('/Resume/GetCertificates', {
    method: 'GET'
})
.then(response => {
    if (!response.ok) throw new Error("網路回應不成功：" + response.status);
    return response.json();
})
.then(data => {
    globalCertList = data;
    console.log("後端回傳的證照資料：", globalCertList);
    
    // 用原生 JS 把證照名稱塞入所有的 select 選項中
    const certSelects = document.querySelectorAll('.cert-select');
    certSelects.forEach(select => {
        while (select.options.length > 1) { select.remove(1); } // 清空舊資料
        
        globalCertList.forEach(item => {
            let cName = item.CertName || item.certName; // 容錯大、小寫
            if (cName) {
                let opt = document.createElement('option');
                opt.value = cName;
                opt.textContent = cName;
                select.appendChild(opt);
            }
        });
    });

    // 💡 確保下拉選單都有「證照名稱」後，才執行反填
    parseAndFillExistingCerts();
})
.catch(err => {
    console.error("無法成功取得證照清單：", err);
});


// 💡 3. 將所有依賴 jQuery ($) 與視窗載入的邏輯，安全地包裹在 window.onload 內
window.onload = function() {
    
    // ------ 1. 處理語文能力反填 ------
    const langData = `@Html.Raw(Model?.LanguageSkills ?? "")`;
    if (langData && langData.trim() !== "") {
        const items = langData.split(', ');
        const knownLangs = ["英語", "日語", "台語", "客語"];

        items.forEach(item => {
            if (item === "不具外文能力") {
                const node = document.querySelector('.lang-node');
                if(node) node.checked = true;
                return;
            }

            const name = item.split('(')[0];
            const lvMatch = item.match(/\(([^)]+)\)/);
            const lvValue = lvMatch ? lvMatch[1] : "";

            if (knownLangs.includes(name)) {
                document.querySelectorAll('.lang-row').forEach(row => {
                    const labelElement = row.querySelector('.lang-label');
                    if (labelElement && labelElement.innerText.includes(name)) {
                        const lvChk = Array.from(row.querySelectorAll('.lang-lv')).find(c => c.value === lvValue);
                        if (lvChk) lvChk.checked = true;
                    }
                });
            } else {
                const otherRow = Array.from(document.querySelectorAll('.lang-row')).find(row => {
                    const lbl = row.querySelector('.lang-label');
                    return lbl && lbl.innerText.includes("其他");
                });
                if (otherRow) {
                    const otherLangInput = document.getElementById('otherLangName');
                    if (otherLangInput) otherLangInput.value = name;
                    
                    const lvChk = Array.from(otherRow.querySelectorAll('.lang-lv')).find(c => c.value === lvValue);
                    if (lvChk) lvChk.checked = true;
                }
            }
        });
    }

    // ------ 2. 處理駕照種類 ------
    const licenseData = "@Html.Raw(Model?.DriverLicense ?? "")";
    if (licenseData) {
        const parts = licenseData.split(', ');
        parts.forEach(p => {
            if (p.includes('(')) {
                const typeName = p.split('(')[0].trim();
                const subValues = p.split('(')[1].replace(')', '').split('/');
                const row = document.querySelector(`.license-row[data-type="${typeName}"]`);
                if (row) {
                    subValues.forEach(v => {
                        const chk = row.querySelector(`.license-chk[value="${v}"]`);
                        if (chk) chk.checked = true;
                    });
                }
            } else {
                const row = document.querySelector(`.license-row[data-type="汽(機)車"]`);
                if (row) {
                    const subValues = p.split('/');
                    subValues.forEach(v => {
                        const chk = row.querySelector(`.license-chk[value="${v}"]`);
                        if (chk) chk.checked = true;
                    });
                }
            }
        });
    }

    // ------ 3. 處理專長反填 ------
    const specData = "@Html.Raw(Model?.Specialty ?? "")";
    if (specData) {
        const specs = specData.split('; ');
        const specInputs = document.querySelectorAll('.spec-input');
        specs.forEach((val, index) => {
             if(specInputs[index]) specInputs[index].value = val;
        });
    }

    // ------ 5. 處理電腦能力 ------
    const compData = "@Html.Raw(Model?.ComputerSkills ?? "")";
    if (compData) {
        const compArray = compData.split(',').map(s => s.trim());
        document.querySelectorAll('.comp-chk').forEach(chk => {
            if (compArray.includes(chk.value)) chk.checked = true;
        });
        if (compData.includes("其他:")) {
            const match = compData.match(/其他:([^,]+)/);
            if (match) {
                const otherCompInput = document.getElementById('otherCompName');
                if (otherCompInput) otherCompInput.value = match[1].trim();
                
                const otherChk = Array.from(document.querySelectorAll('.comp-chk')).find(c => c.value === "其他");
                if(otherChk) otherChk.checked = true;
            }
        }
    }

    // ------ 6. 處理學歷狀況 ------
    const eduData = "@Html.Raw(Model?.EduStatus ?? "")";
    if (eduData) {
        document.querySelectorAll('#eduStatusArea .edu-chk').forEach(chk => {
            if (eduData.includes(chk.value)) chk.checked = true;
        });
    }

    // ------ 7. 年資欄位初始化 ------
    const workYearsInput = document.getElementById('workYearsInput');
    if (workYearsInput && parseInt(workYearsInput.value) <= 0) {
        workYearsInput.value = "";
    }

    // ------ 8. 互斥限制邏輯 ------
    document.querySelectorAll('.lang-row').forEach(row => {
        const lvs = row.querySelectorAll('.lang-lv');
        lvs.forEach(chk => {
            chk.addEventListener('change', function() {
                if (this.checked) {
                    lvs.forEach(other => { if(other !== this) other.checked = false; });
                }
            });
        });
    });

    const eduChks = document.querySelectorAll('#eduStatusArea .edu-chk');
    eduChks.forEach(chk => {
        chk.addEventListener('change', function() {
            if (this.checked) {
                eduChks.forEach(other => { if(other !== this) other.checked = false; });
            }
        });
    });

    const eduLevelValue = "@Html.Raw(Model?.EduLevel ?? "")";
    const presetLevels = ["博士", "碩士", "大學", "專科", "高職", "高中", "國中", "國小"];

    if (eduLevelValue && !presetLevels.includes(eduLevelValue)) {
        const otherEduInput = document.getElementById('otherEduLevel');
        const radioOther = document.getElementById('radioOther');
        if (otherEduInput) otherEduInput.value = eduLevelValue;
        if (radioOther) {
            radioOther.checked = true;
            radioOther.value = eduLevelValue;
        }
    }

    // 💡 【重要移入】確保 jQuery 載入後才綁定 change 事件，手動切換選單時級別才會出來！
    $(document).on('change', '.cert-select', function () {
        const selectedCert = $(this).val();
        const $levelSelect = $(this).closest('.cert-item').find('.cert-level-select');
        
        $levelSelect.empty().append('<option value="">--級別--</option>');

        if (selectedCert && globalCertList) {
            // 大小寫全面相容比對
            const certData = globalCertList.find(x => {
                const currentName = x.CertName || x.certName || "";
                return currentName.trim() === selectedCert.trim();
            });
            
            let levelsArray = certData ? (certData.Levels || certData.levels) : null;
            
            if (levelsArray && Array.isArray(levelsArray)) {
                levelsArray.forEach(lvl => {
                    let formattedLvl = lvl.trim();
                    $levelSelect.append(`<option value="${formattedLvl}">${formattedLvl}</option>`);
                });
            }
        }
    });

    // 其他教育程度 Focus 處理
    const otherEduLevelEl = document.getElementById('otherEduLevel');
    if (otherEduLevelEl) {
        otherEduLevelEl.addEventListener('focus', function() {
            const radioOther = document.getElementById('radioOther');
            if (radioOther) radioOther.checked = true;
        });
    }
}; // window.onload 結束


// 🎯 拆解既有證照欄位字串並自動反填
function parseAndFillExistingCerts() {
    // 同時支援原本的 id 與隱藏 name 屬性選取器
    const $finalCert = $('#finalCertificates').length ? $('#finalCertificates') : $('input[name="Certificates"]');
    if (!$finalCert.length) return;
    
    const rawValue = $finalCert.val();
    if (!rawValue) return;

    const certList = rawValue.split(', ');
    $('.cert-item').each(function (index) {
        if (index < certList.length) {
            const current = certList[index];
            const match = current.match(/(.+)\((.+)\)/);
            
            const $certSelect = $(this).find('.cert-select');
            const $levelSelect = $(this).find('.cert-level-select');

            if (match) {
                const name = match[1].trim();
                const lvl = match[2].trim(); 

                // 1. 反填證照名稱
                $certSelect.val(name);
                
                // 2. 立即動態塞入該證照對應的級別選單 (全面相容大、小寫屬性)
                $levelSelect.empty().append('<option value="">--級別--</option>');
                if (globalCertList) {
                    const certData = globalCertList.find(x => {
                        const currentName = x.CertName || x.certName || "";
                        return currentName.trim() === name;
                    });
                    
                    let levelsArray = certData ? (certData.Levels || certData.levels) : null;

                    if (levelsArray && Array.isArray(levelsArray)) {
                        levelsArray.forEach(l => {
                            let formattedLvl = l.trim();
                            $levelSelect.append(`<option value="${formattedLvl}">${formattedLvl}</option>`);
                        });
                    }
                }

                // 3. 反填級別值
                $levelSelect.val(lvl);
            } else {
                $certSelect.val(current.trim()).trigger('change');
            }
        }
    });
}

function setWorkExp(val) {
    const input = document.getElementById('workYearsInput');
    const company = document.getElementById('CompanyName');
    const title = document.getElementById('JobTitle');
    const desc = document.getElementById('JobDescription');

    if (!input) return;

    if (val === 0) {
        input.value = "";
        input.readOnly = true;
        if(company) company.value = "";
        if(title) title.value = "";
        if(desc) desc.value = "";
    } else {
        if(input.value === "" || parseInt(input.value) <= 0) {
            input.value = 1;
        }
        input.readOnly = false;
    }
}

// 🎯 綁定明確的表單 ID
const resumeFormEl = document.getElementById('resumeForm');
if (resumeFormEl) {
    resumeFormEl.addEventListener('submit', function (e) {
        const workYearsInput = document.getElementById('workYearsInput');
        const workExpType = document.querySelector('input[name="workExpType"]:checked');

        if (!workExpType) {
            Swal.fire('提示', '請選擇是否有工作經歷', 'warning');
            e.preventDefault();
            return false;
        }

        const isHaveExp = workExpType.getAttribute('onclick') && workExpType.getAttribute('onclick').includes('1');
        const yearsValue = workYearsInput ? workYearsInput.value.trim() : "";

        if (isHaveExp) {
            const years = parseInt(yearsValue);
            if (!yearsValue || isNaN(years) || years <= 0) {
                Swal.fire('提示', '請輸入正確的工作年資', 'warning');
                e.preventDefault();
                return false;
            }
            const compEl = document.getElementById('CompanyName');
            const titleEl = document.getElementById('JobTitle');
            if ((compEl && !compEl.value.trim()) || (titleEl && !titleEl.value.trim())) {
                Swal.fire('提示', '您已填寫年資，請完整填寫公司名稱與職稱', 'warning');
                e.preventDefault();
                return false;
            }
        } else {
            if (workYearsInput) workYearsInput.value = 0;
        }

        const otherEduInput = document.getElementById('otherEduLevel');
        const radioOther = document.getElementById('radioOther');
        if (otherEduInput && radioOther) {
            const otherVal = otherEduInput.value.trim();
            if (otherVal !== "") {
                radioOther.checked = true;
                radioOther.value = otherVal;
            }
        }

        const finalTimeEl = document.getElementById('finalResumeTime');
        if (finalTimeEl) {
            const now = new Date();
            finalTimeEl.value = now.toISOString();
        }

        let langResults = [];
        const isNoLang = document.querySelector('.lang-node:checked');
        if (isNoLang) {
            langResults.push("不具外文能力");
        } else {
            document.querySelectorAll('.lang-row').forEach(row => {
                let label = row.querySelector('.lang-label') ? row.querySelector('.lang-label').innerText : "";
                if (label.includes("其他")) {
                    const otherLangInput = document.getElementById('otherLangName');
                    label = otherLangInput ? otherLangInput.value.trim() : "";
                }
                let lv = row.querySelector('.lang-lv:checked');
                if (lv && label) {
                    langResults.push(`${label.replace('：','').trim()}(${lv.value})`);
                }
            });
        }
        const finalLangEl = document.getElementById('finalLanguageSkills');
        if (finalLangEl) finalLangEl.value = langResults.join(', ');

        let licenseResults = [];
        document.querySelectorAll('.license-row').forEach(row => {
            let type = row.getAttribute('data-type');
            let selected = [];
            row.querySelectorAll('.license-chk:checked').forEach(chk => selected.push(chk.value));

            if (selected.length > 0) {
                if (type === "汽(機)車") {
                    licenseResults.push(selected.join('/'));
                } else {
                    licenseResults.push(`${type}(${selected.join('/')})`);
                }
            }
        });
        const finalLicenseEl = document.getElementById('finalDriverLicense');
        if (finalLicenseEl) finalLicenseEl.value = licenseResults.join(', ');

        let specResults = [];
        document.querySelectorAll('.spec-input').forEach(input => {
            if(input.value.trim()) specResults.push(input.value.trim());
        });
        const finalSpecEl = document.getElementById('finalSpecialty');
        if (finalSpecEl) finalSpecEl.value = specResults.join('; ');

        // 🎯 證照組合區塊
        let certResults = [];
        $('.cert-item').each(function () {
            const certName = $(this).find('.cert-select').val();
            const certLvl = $(this).find('.cert-level-select').val();
            if (certName) {
                certResults.push(certLvl ? `${certName}(${certLvl})` : certName);
            }
        });
        const finalCertEl = document.getElementById('finalCertificates');
        if (finalCertEl) finalCertEl.value = certResults.join(', ');
                   
        let compResults = [];
        document.querySelectorAll('.comp-chk:checked').forEach(chk => {
            if (chk.value.includes("程式設計") || chk.value.includes("城市設計")) {
                compResults.push(chk.value);
            } else if (chk.value === "其他") {
                const otherCompInput = document.getElementById('otherCompName');
                compResults.push("其他:" + (otherCompInput ? otherCompInput.value.trim() : ""));
            } else {
                compResults.push(chk.value);
            }
        });
        const finalCompEl = document.getElementById('finalComputerSkills');
        if (finalCompEl) finalCompEl.value = compResults.join(', ');

        let selectedEdu = document.querySelector('#eduStatusArea .edu-chk:checked');
        const finalEduEl = document.getElementById('finalEduStatus');
        if (finalEduEl) finalEduEl.value = selectedEdu ? selectedEdu.value : "";

        return true;
    });
}
</script>

@* 🚨 負責攔截後端 TempData 錯誤並顯示的 SweetAlert 腳本 🚨 *@
@if (TempData["ApiError"] != null)
{
    var apiErrorHtml = TempData["ApiError"]?.ToString()?.Replace("\n", "<br/>").Replace("\r", "") ?? "";
    var apiErrorText = TempData["ApiError"]?.ToString()?.Replace("\n", "\\n").Replace("\r", "") ?? "";

    @Html.Raw($@"
    <script>
    document.addEventListener('DOMContentLoaded', function() {{
        if (typeof Swal !== 'undefined') {{
            Swal.fire({{
                icon: 'error',
                title: '儲存失敗',
                html: '{apiErrorHtml}'
            }});
        }} else {{
            alert('{apiErrorText}');
        }}
    }});
    </script>
    ")
}

@if (TempData["ShowSuccessAlert"] != null)
{
    var successText = TempData["ShowSuccessAlert"]?.ToString()?.Replace("\n", "\\n").Replace("\r", "") ?? "";

    @Html.Raw($@"
    <script>
    document.addEventListener('DOMContentLoaded', function() {{
        if (typeof Swal !== 'undefined') {{
            Swal.fire({{
                icon: 'success',
                title: '成功',
                text: '{successText}'
            }});
        }} else {{
            alert('{successText}');
        }}
    }});
    </script>
    ")
}