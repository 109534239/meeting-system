// ======================================================================
// 🎯 作品集「上傳檔案」欄位：改成可一次選多個檔案（不限類型），
//    每個檔案都顯示檔名，點一下可以開新分頁預覽內容，也能個別刪除，
//    不用整組重選。既有檔案（伺服器上已存的）跟這次新選的檔案分開兩區顯示，
//    但共用同一個 hidden input（value 用「|」串接路徑）跟送出邏輯。
// ======================================================================

// 🎯 頁面載入時，把伺服器帶回來的既有檔案路徑（可能用「|」串接多個）畫成清單，
//    每個檔案都可以點開連結查看、也可以按 ✕ 單獨移除
function renderExistingPortfolioFiles(cell) {
    if (!cell) return;
    const hiddenInput = cell.querySelector('.portfolio-existing-file');
    const listEl = cell.querySelector('.portfolio-existing-list');
    if (!hiddenInput || !listEl) return;

    listEl.innerHTML = '';
    const paths = (hiddenInput.value || '').split('|').map(p => p.trim()).filter(p => p !== '');

    paths.forEach(path => {
        const item = document.createElement('div');
        item.className = 'portfolio-existing-wrap';

        const link = document.createElement('a');
        link.href = path;
        link.target = '_blank';
        link.rel = 'noopener';
        link.textContent = path.split('/').pop();
        link.title = '點一下查看內容';

        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'btn-remove-row no-print-in-readonly';
        delBtn.textContent = '✕';
        delBtn.title = '刪除這個檔案';
        delBtn.onclick = function () {
            const remaining = (hiddenInput.value || '').split('|').map(p => p.trim()).filter(p => p !== '' && p !== path);
            hiddenInput.value = remaining.join('|');
            renderExistingPortfolioFiles(cell);
        };

        item.appendChild(link);
        item.appendChild(delBtn);
        listEl.appendChild(item);
    });
}

// 🎯 使用者透過檔案選取視窗新選了檔案（可能一次選了好幾個），畫出可預覽/可個別刪除的清單
function handlePortfolioFileSelect(fileInput) {
    renderNewPortfolioFiles(fileInput);
}

function renderNewPortfolioFiles(fileInput) {
    const cell = fileInput.closest('.portfolio-file-cell');
    if (!cell) return;
    const listEl = cell.querySelector('.portfolio-new-files');
    if (!listEl) return;

    listEl.innerHTML = '';
    Array.from(fileInput.files || []).forEach((file, idx) => {
        const item = document.createElement('div');
        item.className = 'portfolio-new-file-item';

        const link = document.createElement('a');
        link.href = '#';
        link.textContent = file.name;
        link.title = '點一下查看內容';
        link.onclick = function (e) {
            e.preventDefault();
            const url = URL.createObjectURL(file);
            window.open(url, '_blank');
            // 🎯 開新分頁後這個暫時網址就沒用了，晚一點釋放記憶體即可，不用等分頁關閉
            setTimeout(() => URL.revokeObjectURL(url), 60000);
        };

        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'btn-remove-row no-print-in-readonly';
        delBtn.textContent = '✕';
        delBtn.title = '取消選擇這個檔案';
        delBtn.onclick = function () {
            removeNewPortfolioFile(fileInput, idx);
        };

        item.appendChild(link);
        item.appendChild(delBtn);
        listEl.appendChild(item);
    });
}

// 🎯 input.files 是唯讀的 FileList，要移除其中一個檔案得靠 DataTransfer 重新組一份再塞回去
function removeNewPortfolioFile(fileInput, removeIdx) {
    const dt = new DataTransfer();
    Array.from(fileInput.files || []).forEach((file, i) => {
        if (i !== removeIdx) dt.items.add(file);
    });
    fileInput.files = dt.files;
    renderNewPortfolioFiles(fileInput);
}

// 🎯 表單送出前，把每一列的檔案 input 依照目前在畫面上的實際順序，
//    重新命名成後端要求的 name="PortfolioFileList_{列序}"（見 ResumeController.SaveResume），
//    這樣後端才知道「這幾個檔案是屬於第幾列作品集」
function preparePortfolioFilesForSubmit() {
    document.querySelectorAll('#portfolio-list .dynamic-row-portfolio').forEach((row, idx) => {
        const fileInput = row.querySelector('.portfolio-file-input');
        if (fileInput) fileInput.name = 'PortfolioFileList_' + idx;
    });
}

// 🎯 證照名稱欄位：內容太長（例如「Google Cloud Professional Cloud Architect」）原本欄寬固定，
//    看不到完整名稱。這裡用 JS 依實際輸入內容量出所需寬度，讓欄位跟著撐開；
//    因為這一列是 flex-wrap，撐開後如果真的放不下，會自然換到下一行，不會被截斷看不到。
function autoGrowInputWidth(el) {
    if (!el) return;
    const minWidth = 340; // 🎯 修正：跟 CSS .cert-select 的 min-width 對齊，原本 260 偏窄
    const row = el.closest('.dynamic-row-simple');
    // 上限抓「目前所在列的可用寬度」，避免單一欄位無限撐開把版面弄壞
    const maxWidth = row ? Math.max(minWidth, row.clientWidth - 40) : 600;

    let ruler = window.__certWidthRuler;
    if (!ruler) {
        ruler = document.createElement('span');
        ruler.className = 'input-width-ruler';
        document.body.appendChild(ruler);
        window.__certWidthRuler = ruler;
    }
    const computed = window.getComputedStyle(el);
    ruler.style.font = computed.font;
    ruler.textContent = el.value || el.placeholder || '';

    const neededWidth = ruler.offsetWidth + 24; // 保留一點緩衝空間
    el.style.width = Math.min(Math.max(neededWidth, minWidth), maxWidth) + 'px';
}

// 🎯 學歷「學校名稱」「科系所」欄位：內容太長就不換行，改成讓外層可以橫向捲動查看，
//    用一個隱形的量尺元素量出目前輸入內容實際需要多寬，讓 input 跟著撐開，
//    超出欄位可視範圍的部分就交給 .scroll-input-wrap 的 overflow-x:auto 捲動
function autoSizeInput(el) {
    if (!el) return;
    const wrap = el.closest('.scroll-input-wrap');
    if (!wrap) return;

    let ruler = wrap.querySelector('.input-width-ruler');
    if (!ruler) {
        ruler = document.createElement('span');
        ruler.className = 'input-width-ruler';
        wrap.appendChild(ruler);
    }
    const computed = window.getComputedStyle(el);
    ruler.style.font = computed.font;
    ruler.textContent = el.value || el.placeholder || '';

    const neededWidth = ruler.offsetWidth + 16; // 保留一點緩衝空間
    const minWidth = wrap.clientWidth;
    el.style.width = Math.max(neededWidth, minWidth) + 'px';
}

function addPortfolioRow() {
    const container = document.getElementById('portfolio-list');
    const row = document.createElement('tr');
    row.className = 'dynamic-row-portfolio';
    row.innerHTML = `
        <td><textarea name="PortfolioTitleList" class="form-control" placeholder="作品名稱" rows="1" oninput="autoGrowTextarea(this)"></textarea></td>
        <td><textarea name="PortfolioDescList" class="form-control" placeholder="作品說明" rows="1" oninput="autoGrowTextarea(this)"></textarea></td>
        <td><textarea name="PortfolioLinkList" class="form-control portfolio-link" placeholder="https://" rows="1" autocomplete="off" oninput="autoGrowTextarea(this)"></textarea></td>
        <td class="portfolio-file-cell">
            <input type="hidden" name="PortfolioExistingFileList" class="portfolio-existing-file" value="" />
            <div class="portfolio-existing-list"></div>
            <label class="btn-upload-file no-print-in-readonly">
                選擇檔案
                <input type="file" name="PortfolioFileList" class="portfolio-file-input no-print-in-readonly" multiple onchange="handlePortfolioFileSelect(this)" />
            </label>
            <div class="portfolio-new-files"></div>
        </td>
        <td class="remove-cell"><button type="button" class="btn-remove-row no-print-in-readonly" onclick="removePortfolioRow(this)">✕</button></td>
    `;
    container.appendChild(row);
    updateNoPortfolioHint();
}
</script>

@* 🚨 負責攔截後端 TempData 錯誤並顯示的 SweetAlert 腳本 🚨 *@
@if (TempData["ApiError"] != null)
{
    var apiErrorHtml = TempData["ApiError"]?.ToString()?.Replace("\n", "<br/>").Replace("\r", "") ?? "";
    var apiErrorText = TempData["ApiError"]?.ToString()?.Replace("\n", "\\n").Replace("\r", "") ?? "";

    @Html.Raw($@"
    <script>
    document.addEventListener('DOMContentLoaded', function() {{
        if (typeof Swal !== 'undefined') {{
            Swal.fire({{
                icon: 'error',
                title: '儲存失敗',
                html: '{apiErrorHtml}'
            }});
        }} else {{
            alert('{apiErrorText}');
        }}
    }});
    </script>
    ")
}

@if (TempData["ShowSuccessAlert"] != null)
{
    var title = TempData["AlertTitle"]?.ToString() ?? "成功";
    var message = TempData["ShowSuccessAlert"]?.ToString() ?? "";

    // 轉義字串，防止引號或換行造成 JS 語法崩潰
    var encodedTitle = System.Web.HttpUtility.JavaScriptStringEncode(title);
    var encodedMessage = System.Web.HttpUtility.JavaScriptStringEncode(message);

    <!-- 載入 SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var alertTitle = '@Html.Raw(encodedTitle)';
            var alertMessage = '@Html.Raw(encodedMessage)';

            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'success',
                    title: alertTitle,
                    text: alertMessage,
                    confirmButtonText: '確定'
                });
            } else {
                alert(alertTitle + "\n" + alertMessage);
            }
        });
    </script>
}