        // 💡 日期清理輔助函式：將各種日期格式（如 2025/9、2025.09）統一轉為 yyyy-MM 格式
    function cleanDateString(dateStr) {
        if (!dateStr) return '';
        let str = String(dateStr).trim().replace(/\.|\//g, '-');
        const parts = str.split('-');
        if (parts.length >= 2) {
            const y = parts[0];
            const m = parts[1].padStart(2, '0');
            return `${y}-${m}`;
        }
        return str;
    }

        // 🎯 統一處理 PDF 下載與「列印 PDF」按鈕，等檔案完全下載後才關閉視窗
