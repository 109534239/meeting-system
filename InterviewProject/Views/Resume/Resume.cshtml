            finalTimeEl.value = now.toISOString();
        }

        let langResults = [];
        document.querySelectorAll('#language-list .dynamic-row-simple').forEach(row => {
            const nameInput = row.querySelector('.lang-name-input');
            const lvSelect = row.querySelector('.lang-lv-select');
            const name = nameInput ? nameInput.value.trim() : "";
            if (name && lvSelect) {
                langResults.push(`${name}(${lvSelect.value})`);
            }
        });
        // 🎯 一筆都沒填，就自動視為「不具外文能力」，不用使用者手動勾選
