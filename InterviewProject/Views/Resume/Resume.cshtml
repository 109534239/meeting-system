@* 🚨 負責攔截後端 TempData 錯誤並顯示的 SweetAlert 腳本 🚨 *@
@if (TempData["ApiError"] != null)
{
    var rawError = TempData["ApiError"]?.ToString() ?? "";
    // 使用 System.Web.HttpUtility.JavaScriptStringEncode 進行安全的字串轉義，防止單雙引號與換行破壞 JS 語法
    var encodedHtml = System.Web.HttpUtility.JavaScriptStringEncode(rawError.Replace("\r", "").Replace("\n", "<br/>"));
    var encodedText = System.Web.HttpUtility.JavaScriptStringEncode(rawError);

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var apiErrorHtml = '@Html.Raw(encodedHtml)';
            var apiErrorText = '@Html.Raw(encodedText)';

            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'error',
                    title: '儲存失敗',
                    html: apiErrorHtml
                });
            } else {
                alert(apiErrorText);
            }
        });
    </script>
}

@if (TempData["ShowSuccessAlert"] != null)
{
    var title = TempData["AlertTitle"]?.ToString() ?? "成功";
    var message = TempData["ShowSuccessAlert"]?.ToString() ?? "";

    // 轉義字串，防止引號或換行造成 JS 語法崩潰
    var encodedTitle = System.Web.HttpUtility.JavaScriptStringEncode(title);
    var encodedMessage = System.Web.HttpUtility.JavaScriptStringEncode(message);

    <!-- 載入 SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var alertTitle = '@Html.Raw(encodedTitle)';
            var alertMessage = '@Html.Raw(encodedMessage)';

            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'success',
                    title: alertTitle,
                    text: alertMessage,
                    confirmButtonText: '確定'
                });
            } else {
                alert(alertTitle + "\n" + alertMessage);
            }
        });
    </script>
}