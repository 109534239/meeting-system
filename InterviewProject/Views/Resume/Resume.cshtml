// 💡 3. 將所有依賴 jQuery ($) 與視窗載入的邏輯，安全地包裹在 window.onload 內
window.onload = function() {

    // ------ 0. 工作經歷「工作內容」欄位，如果是編輯既有履歷、內容本來就有好幾行文字，
    //           一進頁面就先量一次高度，不用等使用者打字才長高 ------
    document.querySelectorAll('.work-table textarea').forEach(autoGrowTextarea);
    document.querySelectorAll('.portfolio-table textarea').forEach(autoGrowTextarea);
    document.querySelectorAll('.edu-table .scroll-input-wrap input').forEach(autoSizeInput);
    document.querySelectorAll('.portfolio-file-cell').forEach(renderExistingPortfolioFiles);

    // 🎯 學歷/工作經歷的起訖年月下拉選單：頁面載入時就存在的既有列，逐列初始化互動
    //    （新增出來的列，是在 addEducationRow / addWorkRow 裡各自呼叫）
    document.querySelectorAll('#education-list .dynamic-row-edu').forEach(row => {
        const wraps = row.querySelectorAll('.ym-select-wrap');
        const startHidden = row.querySelector('input[name="StartDateList"]');
        const endHidden = row.querySelector('input[name="EndDateList"]');
        if (wraps.length === 2 && startHidden && endHidden) {
            setupEduRowAutoDates(row);
        }
    });
    document.querySelectorAll('#work-list .dynamic-row-work').forEach(row => {
        const wraps = row.querySelectorAll('.ym-select-wrap');
        const startHidden = row.querySelector('input[name="WorkStartDateList"]');
        const endHidden = row.querySelector('input[name="WorkEndDateList"]');
        if (wraps.length === 2 && startHidden && endHidden) {
            initYmRange(wraps[0], startHidden, wraps[1], endHidden);
        }
    });

    document.querySelectorAll('#education-list .dynamic-row-edu').forEach(applyEduInProgressStatus);

   // ------ 1. 處理語文能力反填（改成動態列，資料有幾筆就補幾列；
    //           "不具外文能力" 已不再是使用者手動勾選的值，純粹代表「一筆都沒填」，
    //           所以這裡遇到它直接當作沒有資料，語言列表維持空白即可） ------
    const langData = `@Html.Raw(Model?.LanguageSkills ?? "")`;
    if (langData && langData.trim() !== "" && langData.trim() !== "不具外文能力") {
        const items = langData.split(', ').filter(s => s.trim() !== "");
        items.forEach((item) => {
            const name = item.split('(')[0];
            const lvMatch = item.match(/\(([^)]+)\)/);
            const lvValue = lvMatch ? lvMatch[1] : "";

            addLanguageRow();
            const rows = document.querySelectorAll('#language-list .dynamic-row-simple');
            const row = rows[rows.length - 1];
            const nameSelect = row.querySelector('.lang-name-select');
            const otherInput = row.querySelector('.lang-name-other');
            const lvSelect = row.querySelector('.lang-lv-select');
            if (nameSelect && name) {
                const matched = Array.from(nameSelect.options).some(opt => opt.value === name);
                if (matched) {
                    nameSelect.value = name;
                } else {
                    // 🎯 舊資料存的語言名稱若不在目前清單裡（例如之前是自由輸入的），
                    //    歸類到「其他」，並把原本文字帶進旁邊的自訂輸入框，不會憑空消失
                    nameSelect.value = '其他';
                    if (otherInput) {
                        otherInput.value = name;
                        otherInput.style.display = '';
                    }
                }
            }
            if (lvSelect && lvValue) lvSelect.value = lvValue;
        });
    }
    updateNoLangHint();

    // ------ 2. 處理駕照種類 ------
    const licenseData = "@Html.Raw(Model?.DriverLicense ?? "")";
    if (licenseData) {
        const parts = licenseData.split(', ');
        parts.forEach(p => {
            if (p.includes('(')) {
                const typeName = p.split('(')[0].trim();
                const subValues = p.split('(')[1].replace(')', '').split('/');
                const row = document.querySelector(`.license-row[data-type="${typeName}"]`);
                if (row) {
                    subValues.forEach(v => {
                        const chk = row.querySelector(`.license-chk[value="${v}"]`);
                        if (chk) chk.checked = true;
                    });
                }
            } else {
                const row = document.querySelector(`.license-row[data-type="汽(機)車"]`);
                if (row) {
                    const subValues = p.split('/');
                    subValues.forEach(v => {
                        const chk = row.querySelector(`.license-chk[value="${v}"]`);
                        if (chk) chk.checked = true;
                    });
                }
            }
        });
    }

    // ------ 3. 處理專長反填（改成動態列；跟語文能力一樣，不再預設留一列） ------
    const specData = "@Html.Raw(Model?.Specialty ?? "")";
    if (specData && specData.trim() !== "") {
        const specs = specData.split('; ').filter(s => s.trim() !== "");
        specs.forEach((val) => {
            addSpecialtyRow();
            const inputs = document.querySelectorAll('.spec-input');
            const lastInput = inputs[inputs.length - 1];
            lastInput.value = val;
            autoGrowTextarea(lastInput);
        });
    }
    updateNoSpecHint();

    // ------ 5. 處理電腦能力（改成動態列） ------
    const compData = "@Html.Raw(Model?.ComputerSkills ?? "")";
    if (compData && compData.trim() !== "") {
        // 🎯 分隔符改用 "; "，避免電腦能力內容本身含有逗號被誤判成分隔符
        const compArray = compData.split('; ').map(s => s.trim()).filter(s => s !== "");
        compArray.forEach((val) => {
            addCompSkillRow();
            const inputs = document.querySelectorAll('.comp-input');
            const lastInput = inputs[inputs.length - 1];
            lastInput.value = val;
            autoGrowTextarea(lastInput);
        });
    }

    // 💡 【重要移入】確保 jQuery 載入後才綁定事件；證照名稱改成 input 之後，
    //    打字/選 datalist 建議、或欄位失焦時都要重新比對出對應的級別選項
    $(document).on('input change', '.cert-select', function () {
        const certItemEl = $(this).closest('.cert-item')[0];
        if (certItemEl) updateCertLevelOptions(certItemEl);
    });

    // 欄位打完字離開時，仍然要重新比對一次級別選項，確保跟目前欄位值同步（只是不再清空原本的值）
    $(document).on('blur', '.cert-select', function () {
        const certItemEl = this.closest('.cert-item');
        if (certItemEl) updateCertLevelOptions(certItemEl);
    });
}; // window.onload 結束


// 🎯 拆解既有證照欄位字串並自動反填
function parseAndFillExistingCerts() {
    const $finalCert = $('#finalCertificates').length ? $('#finalCertificates') : $('input[name="Certificates"]');
    if (!$finalCert.length) return;
    
    const rawValue = $finalCert.val();
    if (!rawValue) return;

    const certList = rawValue.split(', ');

    while ($('.cert-item').length < certList.length) {
        addCertRow();
    }

    $('.cert-item').each(function (index) {
        if (index < certList.length) {
            const current = certList[index];
            const match = current.match(/(.+)\((.+)\)/);
            
            const $certSelect = $(this).find('.cert-select');
            const $levelSelect = $(this).find('.cert-level-select');

            if (match) {
                const name = match[1].trim();
                const lvl = match[2].trim(); 

                $certSelect.val(name);
                autoGrowInputWidth($certSelect[0]);
                updateCertLevelOptions(this);
                $levelSelect.val(lvl);

                if (lvl) {
                    const $levelWrap = $(this).find('.cert-level-wrap');
                    if ($levelWrap.length) $levelWrap.show();
                }
            } else {
                $certSelect.val(current.trim()).trigger('change');
                autoGrowInputWidth($certSelect[0]);

                const $levelWrap = $(this).find('.cert-level-wrap');
                if ($levelWrap.length) $levelWrap.hide();
                $levelSelect.val('');
            }
        }
    });
}

// 🎯 年份選項改為動態產生
const YM_CURRENT_YEAR = new Date().getFullYear();
const YM_MIN_YEAR = YM_CURRENT_YEAR - 70;
const YM_MAX_YEAR = YM_CURRENT_YEAR + 10;

function buildYearOptions(select, minYear) {
    const fromYear = minYear ? Math.max(YM_MIN_YEAR, minYear) : YM_MIN_YEAR;
    let html = '<option value="">年</option>';
    for (let y = YM_MAX_YEAR; y >= fromYear; y--) {
        html += `<option value="${y}">${y}年</option>`;
    }
    select.innerHTML = html;
}

function buildMonthOptions(select, minMonth) {
    const fromMonth = minMonth ? Math.max(1, minMonth) : 1;
    let html = '<option value="">月</option>';
    for (let m = fromMonth; m <= 12; m++) {
        const mm = String(m).padStart(2, '0');
        html += `<option value="${mm}">${m}月</option>`;
    }
    select.innerHTML = html;
}

function syncYmHidden(wrap, hidden) {
    const y = wrap.querySelector('[data-part="year"]').value;
    const m = wrap.querySelector('[data-part="month"]').value;
    hidden.value = (y && m) ? `${y}-${m}` : '';
}

function applyYmMinBound(wrap, minVal) {
    const yearSel = wrap.querySelector('[data-part="year"]');
    const monthSel = wrap.querySelector('[data-part="month"]');
    const [minYStr, minMStr] = (minVal || '').split('-');
    const minY = minYStr ? Number(minYStr) : null;
    const minM = minMStr ? Number(minMStr) : null;

    const prevYear = yearSel.value;
    buildYearOptions(yearSel, minY);
    yearSel.value = (prevYear && Array.from(yearSel.options).some(o => o.value === prevYear)) ? prevYear : '';

    const curYear = yearSel.value;
    const monthLowerBound = (minY && curYear === String(minY)) ? minM : null;
    const prevMonth = monthSel.value;
    buildMonthOptions(monthSel, monthLowerBound);
    monthSel.value = (prevMonth && Array.from(monthSel.options).some(o => o.value === prevMonth)) ? prevMonth : '';
}

function getYmBoundValue(wrap) {
    const y = wrap.querySelector('[data-part="year"]').value;
    const m = wrap.querySelector('[data-part="month"]').value;
    if (!y) return '';
    return `${y}-${m || '01'}`;
}

function initYmRange(startWrap, startHidden, endWrap, endHidden, onStartChangeExtra) {
    [startWrap, endWrap].forEach(wrap => {
        buildYearOptions(wrap.querySelector('[data-part="year"]'));
        buildMonthOptions(wrap.querySelector('[data-part="month"]'));
    });

    [[startWrap, startHidden], [endWrap, endHidden]].forEach(([wrap, hidden]) => {
        const [y, m] = (hidden.value || '').split('-');
        if (y) wrap.querySelector('[data-part="year"]').value = y;
        if (m) wrap.querySelector('[data-part="month"]').value = m;
    });

    const refreshEndBound = () => applyYmMinBound(endWrap, getYmBoundValue(startWrap));

    const onStartChange = () => {
        syncYmHidden(startWrap, startHidden);
        refreshEndBound();
        syncYmHidden(endWrap, endHidden);
        onAnyYmChanged(startWrap);
        if (typeof onStartChangeExtra === 'function') onStartChangeExtra();
    };
    const onEndChange = () => {
        refreshEndBound();
        syncYmHidden(endWrap, endHidden);
        onAnyYmChanged(endWrap);
    };

    startWrap.querySelectorAll('select').forEach(sel => sel.addEventListener('change', onStartChange));
    endWrap.querySelectorAll('select').forEach(sel => sel.addEventListener('change', onEndChange));

    refreshEndBound();
}

const EDU_LEVEL_DURATION_YEARS = {
    '國小': 6,
    '國中': 3,
    '高中': 3,
    '高職': 3,
    '專科': 2,
    '大學': 4,
    '碩士': 2,
    '博士': 4
};

function autoFillEduDates(row) {
    const levelSel = row.querySelector('select[name="EduLevelList"]');
    const wraps = row.querySelectorAll('.ym-select-wrap');
    if (!levelSel || wraps.length < 2) return;
    const startWrap = wraps[0];
    const endWrap = wraps[1];
    const startYearSel = startWrap.querySelector('[data-part="year"]');
    const startMonthSel = startWrap.querySelector('[data-part="month"]');
    const endYearSel = endWrap.querySelector('[data-part="year"]');
    const endMonthSel = endWrap.querySelector('[data-part="month"]');
    if (!startYearSel || !startMonthSel || !endYearSel || !endMonthSel) return;

    if (startYearSel.value && !startMonthSel.value) {
        if (Array.from(startMonthSel.options).some(o => o.value === '09')) {
            startMonthSel.value = '09';
            startMonthSel.dispatchEvent(new Event('change'));
        }
    }

    const duration = EDU_LEVEL_DURATION_YEARS[levelSel.value];
    if (duration && startYearSel.value && !endYearSel.value && !endMonthSel.value) {
        const suggestedYear = String(Number(startYearSel.value) + duration);
        if (Array.from(endYearSel.options).some(o => o.value === suggestedYear)) {
            endYearSel.value = suggestedYear;
            endYearSel.dispatchEvent(new Event('change'));
        }
        if (Array.from(endMonthSel.options).some(o => o.value === '06')) {
            endMonthSel.value = '06';
            endMonthSel.dispatchEvent(new Event('change'));
        }
    }
}

function setupEduRowAutoDates(row) {
    const levelSel = row.querySelector('select[name="EduLevelList"]');
    const wraps = row.querySelectorAll('.ym-select-wrap');
    const startHidden = row.querySelector('input[name="StartDateList"]');
    const endHidden = row.querySelector('input[name="EndDateList"]');
    if (!levelSel || wraps.length < 2 || !startHidden || !endHidden) return;

    const runAutoFill = () => autoFillEduDates(row);
    initYmRange(wraps[0], startHidden, wraps[1], endHidden, runAutoFill);
    levelSel.addEventListener('change', runAutoFill);
}

function onAnyYmChanged(wrapEl) {
    const eduRow = wrapEl.closest('.dynamic-row-edu');
    if (eduRow) applyEduInProgressStatus(eduRow);
}

function isEndBeforeStart(startVal, endVal) {
    return !!(startVal && endVal && endVal < startVal);
}

function applyEduInProgressStatus(row) {
    const endEl = row.querySelector('input[name="EndDateList"]');
    const statusEl = row.querySelector('select[name="EduStatusList"]');
    if (!endEl || !endEl.value || !statusEl) return;
    const todayYm = new Date().toISOString().slice(0, 7);
    if (endEl.value > todayYm) {
        statusEl.value = '在學';
    }
}

function calcWorkExperienceYears() {
    let totalMonths = 0;
    document.querySelectorAll('#work-list .dynamic-row-work').forEach(row => {
        const company = row.querySelector('.work-company');
        const startEl = row.querySelector('input[name="WorkStartDateList"]');
        const endEl = row.querySelector('input[name="WorkEndDateList"]');
        if (!company || !company.value.trim()) return;
        if (!startEl || !startEl.value) return;

        const [sy, sm] = startEl.value.split('-').map(Number);
        let ey, em;
        if (endEl && endEl.value) {
            [ey, em] = endEl.value.split('-').map(Number);
        } else {
            const now = new Date();
            ey = now.getFullYear();
            em = now.getMonth() + 1;
        }
        const months = (ey - sy) * 12 + (em - sm);
        if (months > 0) totalMonths += months;
    });
    return Math.round(totalMonths / 12);
}

function scrollToAndFlagField(el) {
    if (!el) return;
    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    setTimeout(() => {
        try { el.focus({ preventScroll: true }); } catch (e) { el.focus(); }
    }, 300);
    el.classList.add('field-error-flash');
    setTimeout(() => el.classList.remove('field-error-flash'), 2000);
}

function showValidationAlert(title, text) {
    if (typeof Swal !== 'undefined' && typeof Swal.fire === 'function') {
        try {
            Swal.fire(title, text, 'warning');
            return;
        } catch (err) {
            console.error('Swal.fire 執行失敗，改用原生 alert：', err);
        }
    }
    alert(title + '\n' + text);
}

const resumeFormEl = document.getElementById('resumeForm');
if (resumeFormEl) {
    resumeFormEl.addEventListener('submit', function (e) {

        const submitter = e.submitter;

        const isDraft = submitter && (
            submitter.value === 'draft' || 
            (submitter.getAttribute('name') === 'actionType' && submitter.value === 'draft')
        );

        const resetLoadingState = () => {
            if (typeof Swal !== 'undefined' && Swal.isVisible()) {
                Swal.close();
            }
            resumeFormEl.querySelectorAll('button[type="submit"], input[type="submit"]').forEach(btn => {
                btn.disabled = false;
            });
        };

        const triggerValidationAlert = (title, message, targetEl) => {
            resetLoadingState();
            if (targetEl) {
                scrollToAndFlagField(targetEl);
            }
            if (typeof showValidationAlert === 'function') {
                showValidationAlert(title, message);
            } else if (typeof Swal !== 'undefined') {
                Swal.fire({ icon: 'warning', title: title, text: message });
            } else {
                alert(`${title}: ${message}`);
            }
        };

        if (typeof preparePortfolioFilesForSubmit === 'function') {
            preparePortfolioFilesForSubmit();
        }

        // =========================================================
        // 🚨 僅在「正式繳交」(!isDraft) 時執行的嚴格驗證
        // =========================================================
        if (!isDraft) {
            // 1. 大頭照必填
            const resumePhotoInputEl = document.getElementById('resumePhotoBase64Input');
            if (!resumePhotoInputEl || !resumePhotoInputEl.value.trim()) {
                e.preventDefault();
                const photoPreviewEl = document.getElementById('resume-photo-preview');
                triggerValidationAlert('提示', '請上傳大頭照後再送出。', photoPreviewEl);
                return false;
            }

            // 2. 學歷/畢業年月必填
            let eduEndMissingEl = null;
            document.querySelectorAll('#education-list .dynamic-row-edu').forEach(row => {
                if (eduEndMissingEl) return;
                const endHidden = row.querySelector('input[name="EndDateList"]');
                if (!endHidden || !endHidden.value) {
                    const endWrap = row.querySelectorAll('.ym-select-wrap')[1];
                    eduEndMissingEl = endWrap ? endWrap.querySelector('[data-part="year"]') : endHidden;
                }
            });
            if (eduEndMissingEl) {
                e.preventDefault();
                triggerValidationAlert('提示', '請選擇每一筆學歷的畢業年月。', eduEndMissingEl);
                return false;
            }

            // 3. 日期前後關係檢查
            let dateOrderErrorEl = null;
            document.querySelectorAll('#education-list .dynamic-row-edu').forEach(row => {
                if (typeof applyEduInProgressStatus === 'function') applyEduInProgressStatus(row);
                if (dateOrderErrorEl) return;
                const s = row.querySelector('input[name="StartDateList"]')?.value;
                const en = row.querySelector('input[name="EndDateList"]')?.value;
                if (typeof isEndBeforeStart === 'function' && isEndBeforeStart(s, en)) {
                    const endWrap = row.querySelectorAll('.ym-select-wrap')[1];
                    dateOrderErrorEl = endWrap ? endWrap.querySelector('[data-part="year"]') : null;
                }
            });
            document.querySelectorAll('#work-list .dynamic-row-work').forEach(row => {
                if (dateOrderErrorEl) return;
                const s = row.querySelector('input[name="WorkStartDateList"]')?.value;
                const en = row.querySelector('input[name="WorkEndDateList"]')?.value;
                if (typeof isEndBeforeStart === 'function' && isEndBeforeStart(s, en)) {
                    const endWrap = row.querySelectorAll('.ym-select-wrap')[1];
                    dateOrderErrorEl = endWrap ? endWrap.querySelector('[data-part="year"]') : null;
                }
            });
            if (dateOrderErrorEl) {
                e.preventDefault();
                triggerValidationAlert('提示', '有學歷或工作經歷的結束日期早於開始日期，請修正後再送出。', dateOrderErrorEl);
                return false;
            }

            // 4. 工作經歷檢查
            let workRowErrorEl = null;
            document.querySelectorAll('#work-list .dynamic-row-work').forEach(row => {
                if (workRowErrorEl) return;
                const company = row.querySelector('.work-company');
                const startEl = row.querySelector('input[name="WorkStartDateList"]');
                if (company && company.value.trim() && (!startEl || !startEl.value)) {
                    const startWrap = row.querySelectorAll('.ym-select-wrap')[0];
                    workRowErrorEl = startWrap ? startWrap.querySelector('[data-part="year"]') : company;
                }
            });
            if (workRowErrorEl) {
                e.preventDefault();
                triggerValidationAlert('提示', '已填寫的工作經歷請至少補上「開始日期」', workRowErrorEl);
                return false;
            }

            // 5. 語言欄位檢查
            let langOtherErrorEl = null;
            document.querySelectorAll('#language-list .dynamic-row-simple').forEach(row => {
                const nameSelect = row.querySelector('.lang-name-select');
                const otherInput = row.querySelector('.lang-name-other');
                if (nameSelect && nameSelect.value === '其他') {
                    const typed = otherInput ? otherInput.value.trim() : '';
                    if (!typed || (typeof isRecognizedLanguageName === 'function' && !isRecognizedLanguageName(typed))) {
                        if (otherInput && typeof setLangOtherError === 'function') {
                            setLangOtherError(otherInput, true, typed ? '請輸入正確語言' : '請輸入語言名稱');
                        }
                        if (!langOtherErrorEl) langOtherErrorEl = otherInput || nameSelect;
                    }
                }
            });
            if (langOtherErrorEl) {
                e.preventDefault();
                triggerValidationAlert('提示', '語文能力「其他」欄位有語言名稱還沒填對，請修正標紅的欄位。', langOtherErrorEl);
                return false;
            }

            // 6. 證照對照表載入檢查
            if (typeof certListLoaded !== 'undefined' && !certListLoaded) {
                let hasAnyCertTyped = false;
                document.querySelectorAll('.cert-item .cert-select').forEach(nameInput => {
                    if (nameInput.value.trim()) hasAnyCertTyped = true;
                });
                if (hasAnyCertTyped) {
                    e.preventDefault();
                    triggerValidationAlert('提示', '證照資料仍在載入中，請稍候幾秒後再送出履歷。');
                    return false;
                }
            }

            // 7. 證照級別檢查
            let certLevelMissingEl = null;
            document.querySelectorAll('.cert-item').forEach(item => {
                if (certLevelMissingEl) return;
                const nameInput = item.querySelector('.cert-select');
                const levelInput = item.querySelector('.cert-level-select');
                const levelWrap = item.querySelector('.cert-level-wrap');
                if (!nameInput || !levelInput) return;

                if (!nameInput.value.trim()) return;

                const isLevelFieldVisible = !levelWrap || levelWrap.style.display !== 'none';
                if (!isLevelFieldVisible) return;

                const levelDatalist = document.getElementById(levelInput.getAttribute('list'));
                const hasLevelOptions = !!levelDatalist && levelDatalist.options && levelDatalist.options.length > 0;

                if (hasLevelOptions && !levelInput.value.trim()) {
                    certLevelMissingEl = levelInput;
                }
            });
            if (certLevelMissingEl) {
                e.preventDefault();
                triggerValidationAlert('提示', '此證照有級別可選，請選擇對應的級別後再送出。', certLevelMissingEl);
                return false;
            }

            // 8. 多益分數檢查
            let invalidToeicScoreEl = null;
            document.querySelectorAll('.cert-item').forEach(item => {
                if (invalidToeicScoreEl) return;
                const nameInput = item.querySelector('.cert-select');
                const levelInput = item.querySelector('.cert-level-select');

                if (nameInput && levelInput && /多益|TOEIC/i.test(nameInput.value.trim())) {
                    const scoreVal = levelInput.value.trim();
                    const score = parseInt(scoreVal, 10);
                    if (!scoreVal || isNaN(score) || score < 10 || score > 990) {
                        invalidToeicScoreEl = levelInput;
                    }
                }
            });

            if (invalidToeicScoreEl) {
                e.preventDefault();
                triggerValidationAlert('提示', '請輸入有效的多益分數 (10 ~ 990)。', invalidToeicScoreEl);
                return false;
            }
        }

        // =========================================================
        // 🛠️ 資料處理與組裝（暫存與正式繳交皆會執行）
        // =========================================================
        const workYearsInput = document.getElementById('workYearsInput');
        if (workYearsInput && typeof calcWorkExperienceYears === 'function') {
            workYearsInput.value = calcWorkExperienceYears();
        }

        const finalTimeEl = document.getElementById('finalResumeTime');
        if (finalTimeEl) {
            finalTimeEl.value = new Date().toISOString();
        }

        // 語文能力組裝
        let langResults = [];
        document.querySelectorAll('#language-list .dynamic-row-simple').forEach(row => {
            const nameSelect = row.querySelector('.lang-name-select');
            const otherInput = row.querySelector('.lang-name-other');
            const lvSelect = row.querySelector('.lang-lv-select');
            let name = nameSelect ? nameSelect.value.trim() : "";
            if (name === '其他') {
                name = otherInput ? otherInput.value.trim() : "";
            }
            if (name && lvSelect) {
                langResults.push(`${name}(${lvSelect.value})`);
            }
        });
        if (langResults.length === 0) {
            langResults.push("不具外文能力");
        }
        const finalLangEl = document.getElementById('finalLanguageSkills');
        if (finalLangEl) finalLangEl.value = langResults.join(', ');

        // 駕照組裝
        let licenseResults = [];
        document.querySelectorAll('.license-row').forEach(row => {
            let type = row.getAttribute('data-type');
            let selected = [];
            row.querySelectorAll('.license-chk:checked').forEach(chk => selected.push(chk.value));

            if (selected.length > 0) {
                if (type === "汽(機)車") {
                    licenseResults.push(selected.join('/'));
                } else {
                    licenseResults.push(`${type}(${selected.join('/')})`);
                }
            }
        });
        const finalLicenseEl = document.getElementById('finalDriverLicense');
        if (finalLicenseEl) finalLicenseEl.value = licenseResults.join(', ');

        // 專長組裝
        let specResults = [];
        document.querySelectorAll('.spec-input').forEach(input => {
            if (input.value.trim()) specResults.push(input.value.trim());
        });
        const finalSpecEl = document.getElementById('finalSpecialty');
        if (finalSpecEl) finalSpecEl.value = specResults.join('; ');

        // 證照字串組裝
        let certResults = [];
        const certItems = typeof $!== 'undefined' ?$('.cert-item') : document.querySelectorAll('.cert-item');
        if (typeof $ !== 'undefined') {
            certItems.each(function () {
                const certName = $(this).find('.cert-select').val();
                const certLvl = $(this).find('.cert-level-select').val();
                if (certName) {
                    certResults.push(certLvl ? `${certName}(${certLvl})` : certName);
                }
            });
        } else {
            certItems.forEach(item => {
                const certName = item.querySelector('.cert-select')?.value;
                const certLvl = item.querySelector('.cert-level-select')?.value;
                if (certName) {
                    certResults.push(certLvl ? `${certName}(${certLvl})` : certName);
                }
            });
        }
        const finalCertEl = document.getElementById('finalCertificates');
        if (finalCertEl) finalCertEl.value = certResults.join(', ');

        // 電腦技能組裝
        let compResults = [];
        document.querySelectorAll('.comp-input').forEach(input => {
            if (input.value.trim()) compResults.push(input.value.trim());
        });
        const finalCompEl = document.getElementById('finalComputerSkills');
        if (finalCompEl) finalCompEl.value = compResults.join('; ');

        // =========================================================
        // 🔒 關鍵防呆區域：驗證通過，執行按鈕禁用與 Loading 視窗
        // =========================================================
        if (submitter && submitter.name) {
            const oldHidden = resumeFormEl.querySelector('input[type="hidden"][data-dynamic-submitter]');
            if (oldHidden) oldHidden.remove();

            const hiddenInput = document.createElement('input');
            hiddenInput.type = 'hidden';
            hiddenInput.name = submitter.name;
            hiddenInput.value = submitter.value;
            hiddenInput.setAttribute('data-dynamic-submitter', 'true');
            resumeFormEl.appendChild(hiddenInput);
        }

        resumeFormEl.querySelectorAll('button[type="submit"], input[type="submit"]').forEach(btn => {
            btn.disabled = true;
        });

        const actionText = isDraft ? '暫存中' : '儲存繳交中';
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                title: `${actionText}，請稍候...`,
                text: '資料正在傳送至伺服器，請勿關閉視窗。',
                allowOutsideClick: false,
                allowEscapeKey: false,
                showConfirmButton: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });
        } else {
            if (submitter) {
                submitter.innerText = `${actionText}...`;
            }
        }

        return true;
    });
}

