            }
        });
        if (workRowError) {
            Swal.fire('提示', '已填寫的工作經歷請至少補上「開始日期」', 'warning');
            e.preventDefault();
            return false;
        }

        const workYearsInput = document.getElementById('workYearsInput');
        if (workYearsInput) workYearsInput.value = calcWorkExperienceYears();

        const finalTimeEl = document.getElementById('finalResumeTime');
        if (finalTimeEl) {
