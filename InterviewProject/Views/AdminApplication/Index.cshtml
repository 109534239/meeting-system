@model List<InterviewProject.Models.Resume>

@{
    ViewData["Title"] = "應徵履歷管理";
    string currentFilter = ViewBag.CurrentFilter ?? "全部";
    var aiScores = ViewBag.AiScores as Dictionary<int, int>;
    var aiComments = ViewBag.AiComments as Dictionary<int, string>;
    var memberNames = ViewBag.MemberNames as Dictionary<int, string>;
    var memberPhones = ViewBag.MemberPhones as Dictionary<int, string>;
    var jobTitles = ViewBag.JobTitles as Dictionary<int, string>;
    var jobActiveStatuses = ViewBag.JobActiveStatuses as Dictionary<int, bool> ?? new Dictionary<int, bool>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Job_search.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/HrJob.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/AdminApplication.css" asp-append-version="true" />
}

<div class="page-header">
    <div class="page-header-inner">
        <h1>@ViewBag.JobTitle</h1>
        <p>應徵名單管理 / Resume Management</p>
    </div>
</div>

<div class="hrapp-container">
    @* ── 篩選切換區 (Tabs + 下拉選單) ── *@
    <div class="hrapp-filter-tabs">
        <div class="tab-group">
            <a asp-action="Index"
               asp-route-jobId="@ViewBag.JobId"
               asp-route-statusFilter="全部"
               class="tab-item @(currentFilter == "全部" ? "active" : "")">
                全部履歷
            </a>

            <a asp-action="Index"
               asp-route-jobId="@ViewBag.JobId"
               asp-route-statusFilter="未處理"
               class="tab-item @(currentFilter == "未處理" ? "active" : "")">
                未處理
            </a>

            <a asp-action="Index"
               asp-route-jobId="@ViewBag.JobId"
               asp-route-statusFilter="已處理"
               class="tab-item @(currentFilter == "已處理" ? "active" : "")">
                已處理
            </a>
        </div>

        <div class="job-filter-group">
            <label for="jobFilterSelect" style="font-weight: bold; white-space: nowrap;">篩選職缺：</label>
            <select id="jobFilterSelect" class="form-select" style="padding: 6px 12px; border-radius: 6px; border: 1px solid #ccc;">
                <option value="">全部職缺</option>
                @if (ViewBag.JobList != null)
                {
                    foreach (var job in (List<SelectListItem>)ViewBag.JobList)
                    {
                        <option value="@job.Value" selected="@(job.Selected)">@job.Text</option>
                    }
                }
            </select>
        </div>
    </div>

    @* ── AI 應徵者比較分析 ── *@
    @if (ViewBag.JobId != null && ViewBag.CanStartAiScoring == true)
    {
        int totalCount = ViewBag.AiTotalCount ?? 0;
        int scoredCount = ViewBag.AiScoredCount ?? 0;
        bool isJobActive = ViewBag.IsJobActive == true;

        bool isCompleted =
        !isJobActive &&
        totalCount > 0 &&
        scoredCount == totalCount;

        int? highestScore = ViewBag.AiHighestScore as int?;


        <section class="hrapp-ai-dashboard">

            <!-- 標題與評分狀態 -->
            <div class="hrapp-ai-dashboard-header">
                <h3>AI 應徵者比較分析</h3>

                <span class="hrapp-ai-state @(isCompleted ? "completed" : "pending")">
                    @(isCompleted ? "評分完成" : "評分未完成")
                </span>
            </div>

            <!-- 統計資訊與按鈕：同一排 -->
            <div class="hrapp-ai-content">

                <!-- 左側：統計資訊 -->
                <div class="hrapp-ai-stats">

                    <div class="hrapp-ai-stat">
                        <span>職缺應徵總數</span>
                        <div class="hrapp-ai-stat-value">
                            <strong>@totalCount</strong>
                            <small>人</small>
                        </div>
                    </div>

                    <div class="hrapp-ai-stat">
                        <span>最高分數</span>
                        <div class="hrapp-ai-stat-value">
                            <strong>
                                @(highestScore.HasValue
                                                            ? highestScore.Value.ToString()
                                                            : "—")
                        </strong>
                        <small>分</small>
                    </div>
                </div>

                </div>

                <!-- 右側：查看報告按鈕 -->
                <div class="hrapp-ai-dashboard-footer">
                    @* 🎯 視覺化圖表已移到報告視窗內，只要有評分資料（圖表）就可以開啟 *@
                    <button type="button"
                            id="btnOpenAiReport"
                            class="hrapp-ai-btn hrapp-ai-btn-primary"
                            data-job-id="@ViewBag.JobId"
                            disabled="@(!(isCompleted || ViewBag.HasAiChartData == true))">
                        AI 分析報告與圖表
                    </button>
                </div>

            </div>

        </section>

        }

    <div class="hrapp-cols hrapp-grid-head">
        <div>
            <button type="button"
                    class="hrapp-sort-btn"
                    data-sort-key="time"
                    data-sort="none"
                    title="依應徵時間排序">
                應徵時間 <span class="sort-icon">⇅</span>
            </button>
        </div>
        <div>應徵職缺</div>
        <div>應徵者姓名</div>
        <div>聯絡電話</div>
        <div>最高學歷 / 科系</div>
        <div>工作經驗</div>
        <div class="text-center">
            <button type="button"
                    class="hrapp-sort-btn"
                    data-sort-key="status"
                    data-sort="none"
                    title="依審核狀態排序">
                目前狀態 <span class="sort-icon">⇅</span>
            </button>
        </div>
        <div class="text-center">
            <button type="button"
                    id="btnSortAiScore"
                    class="hrapp-sort-btn"
                    data-sort-key="score"
                    data-sort="none"
                    title="依 AI 分數排序">
                AI 智慧篩選 <span class="sort-icon">⇅</span>
            </button>
        </div>
        <div class="text-center">操作</div>
    </div>

    @* ── 履歷列表資料列 ── *@
    <div class="hrapp-list">
        @if (!Model.Any())
        {
            <div class="hrapp-empty">目前沒有符合篩選條件的履歷。</div>
        }
        else
        {
            foreach (var item in Model)
            {
                bool isUnhandled = (item.Status == "待審核");
                string rowClass = isUnhandled ? "row-unhandled" : "row-handled";

                string statusClass = item.Status == "待審核" ? "status-pending"
                : item.Status == "已通過" ? "status-passed"
                : "status-failed";

                // 🎯 取得 AI 評分
                int? score = aiScores != null && aiScores.TryGetValue(item.Id, out int value) ? value : null;

                bool hasAiScore = score.HasValue && !string.IsNullOrWhiteSpace(item.AiComment);

                string comment = aiComments != null && aiComments.ContainsKey(item.Id) ? aiComments[item.Id] : "暫無評語";

                // 🎯 取得該筆履歷所屬職缺的上下架狀態
                // 若找不到職缺狀態，預設為招募中，避免錯誤開放審核
                bool isJobActive = jobActiveStatuses.TryGetValue(item.Id, out bool active) ? active : true;

                // 🎯 必須「職缺已下架」且「AI 已完成評分與評語」才允許審核
                bool canReview = !isJobActive && hasAiScore && !string.IsNullOrWhiteSpace(item.AiComment);
                string memberName = memberNames != null && memberNames.ContainsKey(item.Id) ? memberNames[item.Id] : "";
                string memberPhone = memberPhones != null && memberPhones.ContainsKey(item.Id) ? memberPhones[item.Id] : "";
                string jobTitle = jobTitles != null && jobTitles.ContainsKey(item.Id) ? jobTitles[item.Id] : "未指定職缺";

                var topEdu = item.Educations != null && item.Educations.Any()
                ? item.Educations.OrderBy(e => e.SortOrder).First()
                : null;

                var topWork = item.WorkExperiences != null && item.WorkExperiences.Any()
                ? item.WorkExperiences.OrderBy(w => w.SortOrder).First()
                : null;

                <div class="hrapp-row hrapp-cols @rowClass @statusClass"
                     data-row-id="@item.Id"
                     data-score="@(hasAiScore? score.Value.ToString() : "")"
                     data-time="@item.ResumeTime.ToString("yyyyMMddHHmmss")"
                     data-status="@item.Status"
                     onclick="location.href='@Url.Action("Details", "AdminApplication", new { id = item.Id })'">

                    @* 1. 應徵時間 *@
                    <div class="apply-time-cell" data-label="應徵時間">
                        <span>@item.ResumeTime.AddHours(-8).ToString("yyyy/MM/dd HH:mm")</span>
                    </div>

                    @* 2. 應徵職缺 *@
                    <div class="job-title-cell" data-label="應徵職缺">
                        <span>@jobTitle</span>
                    </div>

                    @* 3. 應徵者姓名 *@
                    <div class="user-main-info" data-label="姓名">
                        <span class="user-name">@memberName</span>
                    </div>

                    @* 4. 聯絡電話 *@
                    <div class="user-phone-cell" data-label="電話">
                        <span class="user-phone">@memberPhone</span>
                    </div>

                    @* 5. 最高學歷 (注意：外層必須有 data-label，內部不要寫死「最高學歷」標題) *@
                    <div class="user-edu-cell" data-label="最高學歷">
                        <div class="user-edu">
                            <div class="edu-school">@(topEdu?.SchoolName ?? "-")</div>
                            <div class="edu-major">@(topEdu?.Major ?? "") @(string.IsNullOrEmpty(topEdu?.EduLevel) ? "" : $"({topEdu.EduLevel})")</div>
                        </div>
                    </div>

                    @* 6. 工作經驗 (注意：外層必須有 data-label，內部不要寫死「工作經驗」標題) *@
                    <div class="user-exp-cell" data-label="工作經驗">
                        <div class="user-exp">
                            @if (!item.WorkExperienceYears.HasValue || item.WorkExperienceYears.Value <= 0)
                            {
                                <span class="exp-none">(無)</span>
                            }
                            else
                            {
                                <div class="exp-company">@(topWork?.CompanyName ?? "-")</div>
                                <div class="exp-title">@(topWork?.JobTitle ?? "") (@(item.WorkExperienceYears.Value)年)</div>
                            }
                        </div>
                    </div>

                    @* 7. 目前狀態：職缺下架且 AI 評分完成後才開放審核 *@
                    <div class="status-cell" data-label="審核狀態">

                        <select class="status-select @(item.Status == "待審核" ? "select-wait" : item.Status == "已通過" ? "select-pass" : "select-fail")"
                                data-resume-id="@item.Id"
                                disabled="@(!canReview)"
                                title="@(isJobActive ? "職缺尚未下架，暫不開放履歷審核" : !canReview ? "請先完成 AI 履歷評分" : "可修改履歷審核狀態")"
                                onclick="event.stopPropagation();">

                            <option value="待審核" selected="@(item.Status == "待審核")">
                                待審核
                            </option>

                            <option value="已通過" selected="@(item.Status == "已通過")">
                                已通過
                            </option>

                            <option value="未通過" selected="@(item.Status == "未通過")">
                                未通過
                            </option>

                        </select>

                    </div>

                    @* 8. AI 評分 *@
                    <div class="ai-score-cell" data-label="AI 評估">
                        <div class="ai-score-box">
                            @if (hasAiScore)
                            {
                                <span class="ai-num @(score >= 80 ? "high" : score >= 60 ? "mid" : "low")">
                                    @score<span class="ai-pt">分</span>
                                </span>

                                <button type="button"
                                        class="btn-ai-view open-ai-modal"
                                        data-name="@memberName"
                                        data-score="@score"
                                        data-comment="@comment"
                                        onclick="event.stopPropagation();">
                                    查看評語
                                </button>
                            }
                            else
                            {
                                <span class="ai-not-scored">尚未評分</span>
                            }
                        </div>
                    </div>

                    @* 9. 操作按鈕 (移除 text-center) *@
                    <div class="action-btns" data-label="操作">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-detail" onclick="event.stopPropagation();">審查履歷</a>
                    </div>

                </div>
            }
        }
    </div>
</div>

@* ── AI 評語彈跳視窗 (Modal) ── *@
<div id="aiCommentModal" class="ai-modal-overlay">
    <div class="ai-modal-window">
        <div class="ai-modal-header">
            <div class="ai-modal-title-group">
                <span class="ai-modal-icon">🧠</span>
                <div>
                    <h3 id="modalCandidateName">應徵者</h3>
                    <p class="ai-modal-subtitle">AI 智慧適配度報告</p>
                </div>
            </div>
            <button type="button" class="ai-modal-close" id="closeAiModal">&times;</button>
        </div>
        <div class="ai-modal-body">
            <div class="ai-modal-score-badge">
                <span class="score-lbl">AI 綜合評分</span>
                <span id="modalAiScore" class="score-v">0</span>
                <span class="score-unit">分</span>
            </div>
            <div class="ai-modal-comment-card">
                <h4>分析評語回饋：</h4>
                <div id="modalAiComment" class="comment-text-content"></div>
            </div>
        </div>
        <div class="ai-modal-footer">
            <button type="button" class="btn-modal-confirm" id="confirmAiModal">關閉視窗</button>
        </div>
    </div>
</div>



@* ── AI 應徵者比較分析報告 Modal ── *@
<div id="aiReportModal"
     class="hrapp-report-overlay"
     role="dialog"
     aria-modal="true"
     aria-labelledby="aiReportTitle"
     aria-hidden="true">

    <div class="hrapp-report-window hrapp-decision-window">

        <header class="hrapp-report-header">
            <div>
                <h2 id="aiReportTitle">AI 應徵者比較分析報告</h2>
                <p id="aiReportJobTitle"></p>
                <p id="aiReportDepartment"
                   class="hrapp-report-job-meta"></p>
            </div>

            <button type="button"
                    id="closeAiReport"
                    class="hrapp-report-close"
                    aria-label="關閉報告">
                &times;
            </button>
        </header>

        @* 🎯 報告視窗分頁：左邊 AI 分析報告（預設），右邊視覺化圖表 *@
        @* 用 div 而不是 nav，避免被網站版型對 nav（上方導覽列）的全域樣式影響 *@
        <div class="hrapp-report-tabs" role="tablist" aria-label="AI 分析內容">
            <button type="button"
                    class="report-tab active"
                    role="tab"
                    aria-selected="true"
                    aria-controls="report-comparison"
                    data-report-tab="report-comparison">
                AI 分析報告
            </button>
            <button type="button"
                    class="report-tab"
                    role="tab"
                    aria-selected="false"
                    aria-controls="report-charts"
                    data-report-tab="report-charts">
                視覺化圖表
            </button>
        </div>

        <main class="hrapp-report-content">

            <section id="report-comparison"
                     class="report-panel active">

                <div id="comparisonContent">

                    @* 三張統計卡片 *@
                    <div id="aiDecisionStats"
                         class="hrapp-decision-stats"
                         hidden>

                        <div class="hrapp-decision-stat">
                            <span>應徵總人數</span>
                            <strong id="aiDecisionTotal">—</strong>
                            <small>份履歷</small>
                        </div>

                        <div class="hrapp-decision-stat">
                            <span>需求人數</span>
                            <strong id="aiDecisionRequired">—</strong>
                            <small>招募需求</small>
                        </div>

                        <div class="hrapp-decision-stat">
                            <span>優先審查人選</span>
                            <strong id="aiDecisionPriority">—</strong>
                            <small>依既有評分初步篩選</small>
                        </div>
                    </div>

                    <div id="aiDecisionStatus"
                         class="hrapp-decision-status">
                        正在載入報告...
                    </div>

                    @* 一、整體招募分析 *@
                    <section class="hrapp-decision-section"
                             id="aiSection1"
                             hidden>
                        <h3>一、整體招募分析</h3>
                        <div class="hrapp-decision-text"
                             id="aiSection1Text"></div>
                    </section>

                    @* 二、應徵者排名與比較 *@
                    <section class="hrapp-decision-section"
                             id="aiSection2"
                             hidden>
                        <h3>二、應徵者排名與比較</h3>

                        <div class="hrapp-decision-table-wrap">
                            <table class="hrapp-decision-table">
                                <thead>
                                    <tr>
                                        <th>排名</th>
                                        <th>姓名</th>
                                        <th>AI 分數</th>
                                        <th>工作年資</th>
                                        <th>建議</th>
                                    </tr>
                                </thead>
                                <tbody id="aiDecisionRanking"></tbody>
                            </table>
                        </div>

                        <button type="button"
                                id="aiToggleAllCandidates"
                                class="hrapp-decision-toggle"
                                hidden>
                            查看所有應徵者
                        </button>


                        @* 前五名關鍵技能比較 *@
                        <div id="aiTopFiveComparison"
                             class="hrapp-top-five-comparison"
                             hidden>

                            <button type="button"
                                    id="aiToggleTopFive"
                                    class="hrapp-decision-toggle">
                                收合比較資訊
                            </button>

                            <div id="aiTopFiveList"
                                 class="hrapp-top-five-list">
                            </div>

                        </div>


                        <div class="hrapp-decision-text"
                             id="aiSection2Text"></div>
                    </section>

                    @* 三、關鍵候選人比較分析 *@
                    <section class="hrapp-decision-section"
                             id="aiSection3"
                             hidden>
                        <h3>三、關鍵候選人比較分析</h3>
                        <div class="hrapp-decision-text"
                             id="aiSection3Text"></div>
                    </section>

                    @* 四、整體人才優勢與能力缺口 *@
                    <section class="hrapp-decision-section"
                             id="aiSection4"
                             hidden>
                        <h3>四、整體人才優勢與能力缺口</h3>
                        <div class="hrapp-decision-text"
                             id="aiSection4Text"></div>
                    </section>

                    @* 五、綜合建議與後續行動 *@
                    <section class="hrapp-decision-section"
                             id="aiSection5"
                             hidden>
                        <h3>五、綜合建議與後續行動</h3>
                        <div class="hrapp-decision-text"
                             id="aiSection5Text"></div>
                    </section>

                </div>
            </section>

            @* ── 視覺化圖表分頁（原本放在 AI 分析區塊下方的三張圖表） ── *@
            <section id="report-charts"
                     class="report-panel"
                     role="tabpanel">

                @if (ViewBag.HasAiChartData == true)
                {
                    <div class="hrapp-ai-charts">

                        @* 圖表資料（由 Controller 產生的 JSON） *@
                        <script type="application/json" id="aiChartData">@Html.Raw((string)ViewBag.AiChartJson)</script>

                        @* 1. 應徵者分數排名 *@
                        <div class="hrapp-chart-card hrapp-chart-wide">
                            <div class="hrapp-chart-head">
                                <h4>應徵者分數排名</h4>
                                <div class="hrapp-chart-legend">
                                    <span><i class="dot dot-high"></i>80 分以上</span>
                                    <span><i class="dot dot-mid"></i>60–79 分</span>
                                    <span><i class="dot dot-low"></i>未滿 60 分</span>
                                </div>
                            </div>
                            <div class="hrapp-chart-canvas" id="aiRankingWrap">
                                <canvas id="aiRankingChart" role="img" aria-label="應徵者 AI 分數排名長條圖"></canvas>
                            </div>
                            <p class="hrapp-chart-note" id="aiRankingNote">已完成評分 @(ViewBag.AiScoredCount ?? 0) / @(ViewBag.AiTotalCount ?? 0) 人</p>
                        </div>

                        @* 2. 六項能力雷達圖 *@
                        <div class="hrapp-chart-card" id="aiRadarCard">
                            <div class="hrapp-chart-head">
                                <h4>六項能力雷達圖</h4>
                                <select id="aiRadarSelect" class="hrapp-chart-select" aria-label="選擇要查看的應徵者"></select>
                            </div>
                            <div class="hrapp-chart-canvas hrapp-chart-canvas-square">
                                <canvas id="aiRadarChart" role="img" aria-label="應徵者六項能力雷達圖"></canvas>
                            </div>
                            <p class="hrapp-chart-note">以得分率（得分 ÷ 配分）呈現，灰色虛線為全體平均。</p>
                        </div>

                        @* 3. 各項目平均得分率 *@
                        <div class="hrapp-chart-card" id="aiItemAvgCard">
                            <div class="hrapp-chart-head">
                                <h4>各項目平均得分率</h4>
                            </div>
                            <div class="hrapp-chart-canvas hrapp-chart-canvas-square">
                                <canvas id="aiItemAvgChart" role="img" aria-label="各評分項目平均得分率長條圖"></canvas>
                            </div>
                            <p class="hrapp-chart-note" id="aiGapNote"></p>
                        </div>

                        <p class="hrapp-chart-empty" id="aiChartDetailEmpty" hidden>
                            已評分的履歷缺少六項評分明細（可能是舊版評語），暫時無法顯示能力分析圖表。
                        </p>

                    </div>
                }
                else
                {
                    <p class="hrapp-chart-empty">目前尚無 AI 評分資料，暫時無法產生圖表。</p>
                }
            </section>

        </main>

        <footer class="hrapp-report-footer">
            <p>
                AI 分析結果僅供招募決策輔助參考，
                不代表最終錄取決策。
                實際審查結果仍由人資及用人主管決定。
            </p>

            <button type="button"
                    id="confirmCloseAiReport"
                    class="hrapp-ai-btn hrapp-ai-btn-primary">
                關閉報告
            </button>
        </footer>

    </div>
</div>




@section Scripts {
    @Html.AntiForgeryToken()

    @* 🎯 有圖表資料時才載入 Chart.js *@
    @if (ViewBag.HasAiChartData == true)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. AI 評語彈跳視窗
            const modal = document.getElementById("aiCommentModal");
            const closeBtn = document.getElementById("closeAiModal");
            const confirmBtn = document.getElementById("confirmAiModal");
            const modalName = document.getElementById("modalCandidateName");
            const modalScore = document.getElementById("modalAiScore");
            const modalComment = document.getElementById("modalAiComment");

            document.querySelectorAll(".open-ai-modal").forEach(button => {
                button.addEventListener("click", function () {
                    const name = this.getAttribute("data-name");
                    const score = parseInt(this.getAttribute("data-score") || "0");
                    const comment = this.getAttribute("data-comment") || "暫無評語。";

                    modalName.textContent = name + " 的評估報告";
                    modalScore.textContent = score;
                    modalScore.className = "score-v " + (score >= 80 ? "high" : score >= 60 ? "mid" : "low");
                    modalComment.textContent = comment;
                    modal.classList.add("show");
                });
            });

            function hideModal() {
                modal.classList.remove("show");
            }

            closeBtn.addEventListener("click", hideModal);
            confirmBtn.addEventListener("click", hideModal);
            modal.addEventListener("click", function (e) {
                if (e.target === modal) hideModal();
            });

            // 2. 狀態更新 AJAX
            document.querySelectorAll(".status-select").forEach(select => {
                select.addEventListener("change", function () {
                    const resumeId = this.getAttribute("data-resume-id");
                    const newStatus = this.value;
                    const currentSelect = this;
                    const parentRow = document.querySelector(`.hrapp-row[data-row-id="${resumeId}"]`);

                    currentSelect.classList.remove("select-wait", "select-pass", "select-fail");
                    if (parentRow) {
                        // 同步更新排序用的狀態值，下次依狀態排序時才會用到最新狀態
                        parentRow.dataset.status = newStatus;
                        parentRow.classList.remove("row-unhandled", "row-handled", "status-pending", "status-passed", "status-failed");
                    }

                    if (newStatus === "待審核") {
                        currentSelect.classList.add("select-wait");
                        if (parentRow) parentRow.classList.add("row-unhandled", "status-pending");
                    } else if (newStatus === "已通過") {
                        currentSelect.classList.add("select-pass");
                        if (parentRow) parentRow.classList.add("row-handled", "status-passed");
                    } else if (newStatus === "未通過") {
                        currentSelect.classList.add("select-fail");
                        if (parentRow) {
                            parentRow.classList.add("row-handled", "status-failed");
                            const interviewStatusPill = parentRow.querySelector(".status-pill");
                            if (interviewStatusPill) interviewStatusPill.outerHTML = '<span class="text-muted">-</span>';
                        }
                    }

                    // 🎯 UpdateStatus 有 [ValidateAntiForgeryToken]，AJAX 必須在標頭帶上防偽權杖，
                    //    否則伺服器會直接回 HTTP 400，狀態永遠存不進去
                    const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');

                    fetch('@Url.Action("UpdateStatus", "AdminApplication")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': tokenInput ? tokenInput.value : ''
                        },
                        body: JSON.stringify({ id: parseInt(resumeId), status: newStatus })
                    })
                    .then(async response => {
                        let data = null;

                        try {
                            data = await response.json();
                        } catch {
                            // 非 JSON 回應（例如 400 錯誤頁）時，交給下面統一處理
                        }

                        if (!response.ok || !data) {
                            throw new Error((data && data.message) || `伺服器回應錯誤（HTTP ${response.status}）`);
                        }

                        return data;
                    })
                    .then(data => {
                        if (!data.success) {
                            alert("狀態更新失敗：" + data.message);
                            location.reload();
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert("狀態更新失敗：" + error.message);
                        location.reload();
                    });
                });
            });

            // 3. 職缺下拉式選單篩選
            const jobFilterSelect = document.getElementById("jobFilterSelect");
            if (jobFilterSelect) {
                jobFilterSelect.addEventListener("change", function () {
                    const selectedJobId = this.value;
                    const currentStatusFilter = '@currentFilter';
                    let targetUrl = '@Url.Action("Index", "AdminApplication")' + '?statusFilter=' + encodeURIComponent(currentStatusFilter);
                    if (selectedJobId) targetUrl += '&jobId=' + encodeURIComponent(selectedJobId);
                    window.location.href = targetUrl;
                });
            }


            // 4. AI 應徵者比較分析報告 Modal（單一報告版本）
            const reportModal = document.getElementById("aiReportModal");
            const openReportBtn = document.getElementById("btnOpenAiReport");
            const closeReportBtn = document.getElementById("closeAiReport");
            const confirmCloseReport = document.getElementById("confirmCloseAiReport");
            const comparisonContent = document.getElementById("comparisonContent");

            // 顯示 AI 比較分析報告

            // 顯示 AI 招募決策分析報告
            function renderComparison(data) {
                const status = document.getElementById("aiDecisionStatus");
                const stats = document.getElementById("aiDecisionStats");
                const rankingBody = document.getElementById("aiDecisionRanking");
                const toggleButton =
                    document.getElementById("aiToggleAllCandidates");

                const title =
                    document.getElementById("aiReportJobTitle");
                const department =
                    document.getElementById("aiReportDepartment");


                title.textContent = data.jobTitle || "未指定職缺";

                const jobTypeMap = {
                    fulltime: "全職",
                    parttime: "兼職",
                    internship: "實習",
                    "全職": "全職",
                    "兼職": "兼職",
                    "實習": "實習"
                };

                const jobType = jobTypeMap[data.jobType] ||
                    data.jobType ||
                    "";

                department.textContent = [
                    data.department,
                    data.location,
                    jobType
                ].filter(Boolean).join("｜");


                // 重設畫面，避免切換職缺後殘留舊資料
                stats.hidden = true;
                toggleButton.hidden = true;
                rankingBody.replaceChildren();

                for (let i = 1; i <= 5; i++) {
                    document.getElementById(`aiSection${i}`).hidden = true;
                    document.getElementById(`aiSection${i}Text`)
                        .textContent = "";
                }

                if (!data.reportReady) {
                    status.hidden = false;
                    status.textContent =
                        data.comparisonReport ||
                        "AI 比較分析報告尚未完成。";
                    return;
                }

                status.hidden = true;
                stats.hidden = false;

                // 三張統計卡片：全部使用後端資料
                document.getElementById("aiDecisionTotal")
                    .textContent = data.total ?? "—";

                const requiredElement =
                    document.getElementById("aiDecisionRequired");

                requiredElement.textContent =
                    data.requiredCount == null
                        ? "未設定"
                        : data.requiredCount;

                document.getElementById("aiDecisionPriority")
                    .textContent = data.priorityCount ?? "—";

                const candidates = Array.isArray(data.candidates)
                    ? data.candidates
                    : [];

                // 排名表格，預設顯示前五位
                function renderRanking(showAll) {
                    rankingBody.replaceChildren();

                    const visibleCandidates = showAll
                        ? candidates
                        : candidates.slice(0, 5);

                    for (const candidate of visibleCandidates) {
                        const tr = document.createElement("tr");

                        const values = [
                            candidate.rank,
                            candidate.memberName,
                            candidate.aiScore,
                            candidate.workExperienceYears == null
                                ? "未提供"
                                : `${candidate.workExperienceYears} 年`,
                            candidate.recommendation
                        ];

                        for (const value of values) {
                            const td = document.createElement("td");
                            td.textContent = value ?? "—";
                            tr.appendChild(td);
                        }

                        rankingBody.appendChild(tr);
                    }
                }

                renderRanking(false);


                // 前五名關鍵技能比較
                const topFiveContainer =
                    document.getElementById("aiTopFiveComparison");

                const topFiveList =
                    document.getElementById("aiTopFiveList");

                const topFiveToggle =
                    document.getElementById("aiToggleTopFive");

                topFiveList.replaceChildren();

                const topFive = candidates.slice(0, 5);

                if (topFive.length > 0) {
                    topFiveContainer.hidden = false;
                    topFiveList.hidden = false;
                    topFiveToggle.textContent = "收合比較資訊";

                    topFive.forEach((candidate, index) => {
                        const row = document.createElement("div");
                        row.className = "hrapp-top-five-row";

                        const info = document.createElement("div");
                        info.className = "hrapp-top-five-info";

                        const name = document.createElement("strong");
                        name.textContent =
                            `${index + 1}. ${candidate.memberName}`;

                        const skills = document.createElement("p");

                        skills.textContent =
                            Array.isArray(candidate.keySkills) &&
                                candidate.keySkills.length > 0
                                ? candidate.keySkills.join("、")
                                : "履歷未提供專長或電腦技能";

                        const score = document.createElement("strong");
                        score.className = "hrapp-top-five-score";
                        score.textContent = `${candidate.aiScore} 分`;

                        info.appendChild(name);
                        info.appendChild(skills);

                        row.appendChild(info);
                        row.appendChild(score);

                        topFiveList.appendChild(row);
                    });

                    topFiveToggle.onclick = function () {
                        topFiveList.hidden = !topFiveList.hidden;

                        this.textContent = topFiveList.hidden
                            ? "展開比較資訊"
                            : "收合比較資訊";
                    };
                } else {
                    topFiveContainer.hidden = true;
                }


                // 超過五位才顯示展開按鈕
                if (candidates.length > 5) {
                    toggleButton.hidden = false;
                    toggleButton.textContent = "查看所有應徵者";

                    toggleButton.onclick = function () {
                        const showAll =
                            this.textContent === "查看所有應徵者";

                        renderRanking(showAll);

                        this.textContent = showAll
                            ? "收合應徵者名單"
                            : "查看所有應徵者";
                    };
                }

                // 依五大段落標題切割 Gemini 文字
                const report = data.comparisonReport || "";

                const headings = [
                    "一、整體招募分析",
                    "二、應徵者排名與比較",
                    "三、關鍵候選人比較分析",
                    "四、整體人才優勢與能力缺口",
                    "五、綜合建議與後續行動"
                ];

                // 支援標題前方可能出現的 Markdown # 或 **
                const normalizedReport = report
                    .replace(/\r\n/g, "\n")
                    .replace(/^\s*#{1,6}\s*/gm, "")
                    .replace(/\*\*/g, "");

                const positions = headings.map(heading =>
                    normalizedReport.indexOf(heading)
                );

                // 舊報告或非預期格式：完整保留原文，避免內容消失
                if (positions.some(position => position < 0) ||
                    positions.some((position, index) =>
                        index > 0 && position <= positions[index - 1])) {

                    document.getElementById("aiSection1").hidden = false;
                    document.getElementById("aiSection1Text")
                        .textContent = normalizedReport;

                    return;
                }

                headings.forEach((heading, index) => {
                    const start = positions[index] + heading.length;
                    const end = index < headings.length - 1
                        ? positions[index + 1]
                        : normalizedReport.length;

                    const sectionText = normalizedReport
                        .slice(start, end)
                        .trim();

                    document.getElementById(`aiSection${index + 1}`)
                        .hidden = false;

                    document.getElementById(`aiSection${index + 1}Text`)
                        .textContent = sectionText;
                });
            }


            // 關閉報告視窗
            function closeReport() {
                if (!reportModal) return;

                reportModal.classList.remove("show");
                reportModal.setAttribute("aria-hidden", "true");

                openReportBtn?.focus();
            }

            // 報告視窗分頁切換：左邊 AI 分析報告、右邊視覺化圖表
            const reportTabs = Array.from(document.querySelectorAll(".report-tab[data-report-tab]"));

            function switchReportTab(panelId) {
                reportTabs.forEach(tab => {
                    const isActive = tab.dataset.reportTab === panelId;
                    tab.classList.toggle("active", isActive);
                    tab.setAttribute("aria-selected", isActive ? "true" : "false");
                });

                document.querySelectorAll("#aiReportModal .report-panel").forEach(panel => {
                    panel.classList.toggle("active", panel.id === panelId);
                });

                // 切換分頁時回到內容頂端
                const content = reportModal?.querySelector(".hrapp-report-content");
                if (content) content.scrollTop = 0;

                // 圖表要等分頁顯示後才建立，Chart.js 才量得到正確尺寸
                // 圖表出錯時只記錄錯誤，不影響分頁切換
                if (panelId === "report-charts") {
                    try {
                        initAiCharts();
                    } catch (err) {
                        console.error("AI 圖表建立失敗：", err);
                    }
                }
            }

            // 用事件委派綁在視窗上，點到分頁按鈕內的文字也能正確觸發
            reportModal?.addEventListener("click", function (event) {
                const tab = event.target.closest(".report-tab[data-report-tab]");
                if (!tab) return;

                event.preventDefault();
                event.stopPropagation();
                switchReportTab(tab.dataset.reportTab);
            });

            // 開啟報告視窗並取得分析結果
            openReportBtn?.addEventListener("click", async function () {
                if (!reportModal || !comparisonContent) return;

                const jobId = this.dataset.jobId;
                if (!jobId) return;

                reportModal.classList.add("show");
                reportModal.setAttribute("aria-hidden", "false");

                // 每次開啟都先顯示左邊的 AI 分析報告
                switchReportTab("report-comparison");

                document.getElementById("aiDecisionStatus").hidden = false;
                document.getElementById("aiDecisionStatus").textContent =
                    "正在載入 AI 應徵者比較分析報告...";

                try {
                    const url =
                        '@Url.Action("GetAiAnalysisReport", "AdminApplication")'
                        + "?jobId=" + encodeURIComponent(jobId);

                    const response = await fetch(url);

                    if (!response.ok) {
                        let message = "無法載入分析報告。";

                        try {
                            const errorData = await response.json();
                            message = errorData.message || message;
                        } catch {
                            // 非 JSON 回應時使用預設訊息
                        }

                        throw new Error(message);
                    }

                    const data = await response.json();

                    if (!data.success) {
                        throw new Error(
                            data.message || "AI 分析報告載入失敗。"
                        );
                    }

                    document.getElementById("aiTopFiveComparison").hidden = true;

                    renderComparison(data);

                } catch (error) {
                    console.error("AI Report Error:", error);

                    document.getElementById("aiDecisionStats").hidden = true;

                    for (let i = 1; i <= 5; i++) {
                        document.getElementById(`aiSection${i}`).hidden = true;
                    }

                    document.getElementById("aiDecisionStatus").hidden = false;
                    document.getElementById("aiDecisionStatus").textContent =
                        "無法載入 AI 分析報告：" + error.message;
                }
            });

            // 關閉按鈕
            closeReportBtn?.addEventListener("click", closeReport);
            confirmCloseReport?.addEventListener("click", closeReport);

            // 點擊視窗外側關閉
            reportModal?.addEventListener("click", function (event) {
                if (event.target === reportModal) {
                    closeReport();
                }
            });

            // 按 ESC 關閉
            document.addEventListener("keydown", function (event) {
                if (
                    event.key === "Escape" &&
                    reportModal?.classList.contains("show")
                ) {
                    closeReport();
                }
            });

            // 5. 表頭排序（應徵時間 / 目前狀態 / AI 分數）
            //    每次只套用一種排序；點同一個按鈕依序切換：預設方向 → 相反方向 → 恢復原始順序
            const sortButtons = Array.from(document.querySelectorAll(".hrapp-sort-btn[data-sort-key]"));
            const resumeList = document.querySelector(".hrapp-list");

            if (sortButtons.length > 0 && resumeList) {
                const rows = Array.from(resumeList.querySelectorAll(".hrapp-row"));

                // 記住原本順序（後端依應徵時間由新到舊排序）
                rows.forEach((row, i) => row.dataset.originalIndex = i);

                // 審核狀態的排序順序
                const statusRank = { "待審核": 0, "已通過": 1, "未通過": 2 };

                // 各欄位的取值方式、預設排序方向與提示文字
                const sortConfigs = {
                    time: {
                        getValue: row => row.dataset.time ? Number(row.dataset.time) : null,
                        first: "desc",
                        idleTitle: "依應徵時間排序",
                        titles: {
                            desc: "目前：應徵時間由新到舊",
                            asc: "目前：應徵時間由舊到新"
                        }
                    },
                    status: {
                        getValue: row => row.dataset.status in statusRank
                            ? statusRank[row.dataset.status]
                            : null,
                        first: "asc",
                        idleTitle: "依審核狀態排序",
                        titles: {
                            asc: "目前：待審核 → 已通過 → 未通過",
                            desc: "目前：未通過 → 已通過 → 待審核"
                        }
                    },
                    score: {
                        getValue: row => row.dataset.score ? Number(row.dataset.score) : null,
                        first: "desc",
                        idleTitle: "依 AI 分數排序",
                        titles: {
                            desc: "目前：分數由高到低",
                            asc: "目前：分數由低到高"
                        }
                    }
                };

                const icons = { none: "⇅", desc: "↓", asc: "↑" };

                const byOriginal = (a, b) =>
                    a.dataset.originalIndex - b.dataset.originalIndex;

                function setButtonState(btn, state) {
                    const config = sortConfigs[btn.dataset.sortKey];
                    if (!config) return;

                    btn.dataset.sort = state;

                    const icon = btn.querySelector(".sort-icon");
                    if (icon) icon.textContent = icons[state];

                    btn.title = state === "none" ? config.idleTitle : config.titles[state];
                    btn.classList.toggle("active", state !== "none");
                }

                sortButtons.forEach(btn => {
                    const config = sortConfigs[btn.dataset.sortKey];
                    if (!config) return;

                    setButtonState(btn, "none");

                    btn.addEventListener("click", function () {
                        const current = this.dataset.sort || "none";
                        const opposite = config.first === "desc" ? "asc" : "desc";

                        const next = current === "none"
                            ? config.first
                            : current === config.first ? opposite : "none";

                        // 其他欄位的排序按鈕恢復成未排序狀態
                        sortButtons.forEach(other => {
                            if (other !== this) setButtonState(other, "none");
                        });

                        setButtonState(this, next);

                        const sorted = rows.slice().sort((a, b) => {
                            if (next === "none") return byOriginal(a, b);

                            const va = config.getValue(a);
                            const vb = config.getValue(b);

                            // 沒有值的資料（例如尚未評分）永遠排最後
                            if (va === null && vb === null) return byOriginal(a, b);
                            if (va === null) return 1;
                            if (vb === null) return -1;

                            const diff = next === "desc" ? vb - va : va - vb;
                            return diff !== 0 ? diff : byOriginal(a, b); // 相同時維持原順序
                        });

                        // 移動既有節點，原本綁定的事件（查看評語、狀態下拉）都會保留
                        resumeList.append(...sorted);
                    });
                });
            }

            // 6. AI 分數視覺化圖表（Chart.js）
            //    圖表放在報告視窗的「視覺化圖表」分頁，第一次切換到該分頁時才建立
            let aiChartsInitialized = false;

            function initAiCharts() {
                if (aiChartsInitialized) return;
                aiChartsInitialized = true;

                const chartDataEl = document.getElementById("aiChartData");

                // Chart.js 沒有載入成功（例如 CDN 被擋）時，在分頁內顯示提示，而不是一片空白
                if (chartDataEl && !window.Chart) {
                    const chartsWrap = chartDataEl.closest(".hrapp-ai-charts");
                    if (chartsWrap) {
                        chartsWrap.innerHTML =
                            '<p class="hrapp-chart-empty">圖表元件（Chart.js）載入失敗，請確認網路連線後重新整理頁面。</p>';
                    }
                    return;
                }

                if (chartDataEl && window.Chart) {
                    let chartData = {};

                    try {
                        chartData = JSON.parse(chartDataEl.textContent || "{}");
                    } catch (err) {
                        console.error("AI 圖表資料解析失敗：", err);
                    }

                    const chartCandidates = Array.isArray(chartData.candidates) ? chartData.candidates : [];
                    const itemCount = Array.isArray(chartData.items) ? chartData.items.length : 0;

                    // 圖表上使用的簡短項目名稱（順序與後端六項一致）
                    const shortItemNames = ["專業技能", "工作經驗", "學歷科系", "作品集成果", "語文證照", "其他條件"];

                    const COLOR_PRIMARY = "#206c8b";
                    const COLOR_TEXT = "#24354b";
                    const tierColor = s => s >= 80 ? "#2e7d32" : s >= 60 ? "#f57c00" : "#c62828";

                    Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;
                    Chart.defaults.color = "#64748b";

                    // 長條末端顯示數值的小外掛（橫向／直向長條圖共用）
                    const valueLabelPlugin = suffix => ({
                        id: "valueLabel",
                        afterDatasetsDraw(chart) {
                            const ctx = chart.ctx;
                            const horizontal = chart.options.indexAxis === "y";

                            chart.getDatasetMeta(0).data.forEach((bar, i) => {
                                const value = chart.data.datasets[0].data[i];

                                ctx.save();
                                ctx.fillStyle = COLOR_TEXT;
                                ctx.font = "600 12px " + Chart.defaults.font.family;

                                if (horizontal) {
                                    ctx.textAlign = "left";
                                    ctx.textBaseline = "middle";
                                    ctx.fillText(value + suffix, bar.x + 8, bar.y);
                                } else {
                                    ctx.textAlign = "center";
                                    ctx.textBaseline = "bottom";
                                    ctx.fillText(value + suffix, bar.x, bar.y - 4);
                                }

                                ctx.restore();
                            });
                        }
                    });

                    // 6-1. 應徵者分數排名（橫向長條圖，最多顯示前 10 名）
                    const rankingCanvas = document.getElementById("aiRankingChart");

                    if (rankingCanvas && chartCandidates.length > 0) {
                        const MAX_BARS = 10;
                        const topCandidates = chartCandidates.slice(0, MAX_BARS);

                        document.getElementById("aiRankingWrap").style.height =
                            (topCandidates.length * 44 + 48) + "px";

                        if (chartCandidates.length > MAX_BARS) {
                            const rankingNote = document.getElementById("aiRankingNote");
                            if (rankingNote) rankingNote.textContent += `，圖表僅顯示前 ${MAX_BARS} 名`;
                        }

                        new Chart(rankingCanvas, {
                            type: "bar",
                            data: {
                                labels: topCandidates.map(c => c.name),
                                datasets: [{
                                    data: topCandidates.map(c => c.total),
                                    backgroundColor: topCandidates.map(c => tierColor(c.total)),
                                    borderRadius: 6,
                                    barThickness: 22
                                }]
                            },
                            options: {
                                indexAxis: "y",
                                responsive: true,
                                maintainAspectRatio: false,
                                layout: { padding: { right: 48 } },
                                scales: {
                                    x: { min: 0, max: 100, ticks: { stepSize: 20 }, grid: { color: "#edf0f3" } },
                                    y: { grid: { display: false }, ticks: { color: "#334155", font: { size: 13, weight: "600" } } }
                                },
                                plugins: {
                                    legend: { display: false },
                                    tooltip: { callbacks: { label: ctx => ` AI 綜合評分：${ctx.parsed.x} 分` } }
                                }
                            },
                            plugins: [valueLabelPlugin(" 分")]
                        });
                    }

                    // 只有評語中解析得到完整六項明細的應徵者，才納入能力分析
                    const detailedCandidates = chartCandidates.filter(c =>
                        Array.isArray(c.items) &&
                        c.items.length === itemCount &&
                        c.items.every(item => item && item.max >= 0));

                    const radarCard = document.getElementById("aiRadarCard");
                    const avgCard = document.getElementById("aiItemAvgCard");
                    const detailEmpty = document.getElementById("aiChartDetailEmpty");

                    if (itemCount === 0 || detailedCandidates.length === 0) {
                        if (radarCard) radarCard.hidden = true;
                        if (avgCard) avgCard.hidden = true;
                        if (detailEmpty) detailEmpty.hidden = false;
                    } else {
                        // 配分為 0 的項目代表本職缺不採計，不放進圖表
                        const activeIdx = [];
                        for (let i = 0; i < itemCount; i++) {
                            if (detailedCandidates.some(c => c.items[i].max > 0)) activeIdx.push(i);
                        }

                        const rateOf = item => item && item.max > 0
                            ? Math.round(item.score / item.max * 100)
                            : 0;

                        // 兩行標籤：項目名稱 + 配分
                        const itemLabels = activeIdx.map(i =>
                            [shortItemNames[i], `配分 ${detailedCandidates[0].items[i].max}`]);

                        const averageRates = activeIdx.map(i =>
                            Math.round(detailedCandidates.reduce((sum, c) => sum + rateOf(c.items[i]), 0)
                                / detailedCandidates.length));

                        // 6-2. 六項能力雷達圖（可切換應徵者，疊加全體平均）
                        const radarCanvas = document.getElementById("aiRadarChart");
                        const radarSelect = document.getElementById("aiRadarSelect");

                        if (radarCanvas && radarSelect && activeIdx.length >= 3) {
                            detailedCandidates.forEach((c, idx) => {
                                radarSelect.add(new Option(`${c.name}（${c.total} 分）`, String(idx)));
                            });

                            let currentCandidate = detailedCandidates[0];

                            const radarChart = new Chart(radarCanvas, {
                                type: "radar",
                                data: {
                                    labels: itemLabels,
                                    datasets: [
                                        {
                                            label: currentCandidate.name,
                                            data: activeIdx.map(i => rateOf(currentCandidate.items[i])),
                                            borderColor: COLOR_PRIMARY,
                                            backgroundColor: "rgba(32, 108, 139, 0.18)",
                                            pointBackgroundColor: COLOR_PRIMARY,
                                            pointRadius: 3,
                                            borderWidth: 2
                                        },
                                        {
                                            label: "全體平均",
                                            data: averageRates,
                                            borderColor: "#94a3b8",
                                            backgroundColor: "rgba(148, 163, 184, 0.06)",
                                            borderDash: [5, 4],
                                            pointRadius: 2,
                                            borderWidth: 1.5
                                        }
                                    ]
                                },
                                options: {
                                    responsive: true,
                                    maintainAspectRatio: false,
                                    scales: {
                                        r: {
                                            min: 0,
                                            max: 100,
                                            ticks: {
                                                stepSize: 25,
                                                backdropColor: "transparent",
                                                font: { size: 10 },
                                                callback: v => v + "%"
                                            },
                                            grid: { color: "#e2e8f0" },
                                            angleLines: { color: "#e2e8f0" },
                                            pointLabels: { color: "#334155", font: { size: 12 } }
                                        }
                                    },
                                    plugins: {
                                        legend: { position: "bottom", labels: { usePointStyle: true, boxWidth: 8 } },
                                        tooltip: {
                                            callbacks: {
                                                label: ctx => {
                                                    if (ctx.datasetIndex === 0) {
                                                        const item = currentCandidate.items[activeIdx[ctx.dataIndex]];
                                                        return ` ${currentCandidate.name}：${item.score}/${item.max} 分（${ctx.parsed.r}%）`;
                                                    }
                                                    return ` 全體平均：${ctx.parsed.r}%`;
                                                }
                                            }
                                        }
                                    }
                                }
                            });

                            radarSelect.addEventListener("change", function () {
                                currentCandidate = detailedCandidates[Number(this.value)] || detailedCandidates[0];
                                radarChart.data.datasets[0].label = currentCandidate.name;
                                radarChart.data.datasets[0].data = activeIdx.map(i => rateOf(currentCandidate.items[i]));
                                radarChart.update();
                            });
                        } else if (radarCard) {
                            // 採計項目少於三項時無法構成雷達圖
                            radarCard.hidden = true;
                        }

                        // 6-3. 各項目平均得分率（得分率最低者標紅，提示整體能力缺口）
                        const avgCanvas = document.getElementById("aiItemAvgChart");
                        const gapNote = document.getElementById("aiGapNote");

                        if (avgCanvas && activeIdx.length > 0) {
                            const minRate = Math.min(...averageRates);
                            const minPos = averageRates.indexOf(minRate);

                            new Chart(avgCanvas, {
                                type: "bar",
                                data: {
                                    labels: itemLabels,
                                    datasets: [{
                                        data: averageRates,
                                        backgroundColor: averageRates.map((_, idx) =>
                                            idx === minPos ? "#e57373" : "rgba(32, 108, 139, 0.8)"),
                                        borderRadius: 6,
                                        maxBarThickness: 38
                                    }]
                                },
                                options: {
                                    responsive: true,
                                    maintainAspectRatio: false,
                                    layout: { padding: { top: 18 } },
                                    scales: {
                                        y: { min: 0, max: 100, ticks: { stepSize: 25, callback: v => v + "%" }, grid: { color: "#edf0f3" } },
                                        x: { grid: { display: false }, ticks: { autoSkip: false, maxRotation: 0, font: { size: 11 } } }
                                    },
                                    plugins: {
                                        legend: { display: false },
                                        tooltip: { callbacks: { label: ctx => ` 平均得分率：${ctx.parsed.y}%` } }
                                    }
                                },
                                plugins: [valueLabelPlugin("%")]
                            });

                            if (gapNote) {
                                gapNote.textContent = detailedCandidates.length >= 2
                                    ? `本批應徵者在「${shortItemNames[activeIdx[minPos]]}」的平均得分率最低（${minRate}%），建議列為面試重點確認項目。`
                                    : "目前只有 1 位應徵者有完整評分明細，平均值僅供參考。";
                            }
                        } else if (avgCard) {
                            avgCard.hidden = true;
                        }
                    }
                }
            }

        });
    </script>
}
