@model List<InterviewProject.Models.Resume>

@{
    ViewData["Title"] = "應徵履歷管理";
    string currentFilter = ViewBag.CurrentFilter ?? "全部";
    var aiScores = ViewBag.AiScores as Dictionary<int, int>;
    var aiComments = ViewBag.AiComments as Dictionary<int, string>;
    var memberNames = ViewBag.MemberNames as Dictionary<int, string>;
    var memberPhones = ViewBag.MemberPhones as Dictionary<int, string>;
    var jobTitles = ViewBag.JobTitles as Dictionary<int, string>;
    var jobActiveStatuses = ViewBag.JobActiveStatuses as Dictionary<int, bool> ?? new Dictionary<int, bool>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Job_search.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/HrJob.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/AdminApplication.css" asp-append-version="true" />
}

<div class="page-header">
    <div class="page-header-inner">
        <h1>@ViewBag.JobTitle</h1>
        <p>應徵名單管理 / Resume Management</p>
    </div>
</div>

<div class="hrapp-container">
    @* ── 篩選切換區 (Tabs + 下拉選單) ── *@
    <div class="hrapp-filter-tabs">
        <div class="tab-group">
            <a asp-action="Index"
               asp-route-jobId="@ViewBag.JobId"
               asp-route-statusFilter="全部"
               class="tab-item @(currentFilter == "全部" ? "active" : "")">
                全部履歷
            </a>

            <a asp-action="Index"
               asp-route-jobId="@ViewBag.JobId"
               asp-route-statusFilter="未處理"
               class="tab-item @(currentFilter == "未處理" ? "active" : "")">
                未處理 (待審核)
            </a>

            <a asp-action="Index"
               asp-route-jobId="@ViewBag.JobId"
               asp-route-statusFilter="已處理"
               class="tab-item @(currentFilter == "已處理" ? "active" : "")">
                已處理 (已安排面試/錄取等)
            </a>
        </div>

        <div class="job-filter-group">
            <label for="jobFilterSelect" style="font-weight: bold; white-space: nowrap;">篩選職缺：</label>
            <select id="jobFilterSelect" class="form-select" style="padding: 6px 12px; border-radius: 6px; border: 1px solid #ccc;">
                <option value="">全部職缺</option>
                @if (ViewBag.JobList != null)
                {
                    foreach (var job in (List<SelectListItem>)ViewBag.JobList)
                    {
                        <option value="@job.Value" selected="@(job.Selected)">@job.Text</option>
                    }
                }
            </select>
        </div>
    </div>

    @* ── AI 應徵者比較分析 ── *@
    @if (ViewBag.JobId != null && ViewBag.CanStartAiScoring == true)
    {
        int totalCount = ViewBag.AiTotalCount ?? 0;
        int scoredCount = ViewBag.AiScoredCount ?? 0;
        bool isJobActive = ViewBag.IsJobActive == true;

        bool isCompleted =
            !isJobActive &&
            totalCount > 0 &&
            scoredCount == totalCount;

        int? highestScore = ViewBag.AiHighestScore as int?;

        
        <section class="hrapp-ai-dashboard">

            <!-- 標題與評分狀態 -->
            <div class="hrapp-ai-dashboard-header">
                <h3>AI 應徵者比較分析</h3>

                <span class="hrapp-ai-state @(isCompleted ? "completed" : "pending")">
                    @(isCompleted ? "評分完成" : "評分未完成")
                </span>
            </div>

            <!-- 統計資訊與按鈕：同一排 -->
            <div class="hrapp-ai-content">

                <!-- 左側：統計資訊 -->
                <div class="hrapp-ai-stats">

                    <div class="hrapp-ai-stat">
                        <span>職缺應徵總數</span>
                        <div class="hrapp-ai-stat-value">
                            <strong>@totalCount</strong>
                            <small>人</small>
                        </div>
                    </div>

                    <div class="hrapp-ai-stat">
                        <span>最高分數</span>
                        <div class="hrapp-ai-stat-value">
                            <strong>
                                @(highestScore.HasValue
                                    ? highestScore.Value.ToString()
                                    : "—")
                            </strong>
                            <small>分</small>
                        </div>
                    </div>

                </div>

                <!-- 右側：查看報告按鈕 -->
                <div class="hrapp-ai-dashboard-footer">
                    <button type="button"
                            id="btnOpenAiReport"
                            class="hrapp-ai-btn hrapp-ai-btn-primary"
                            data-job-id="@ViewBag.JobId"
                            disabled="@(!isCompleted)">
                        查看 AI 分析報告
                    </button>
                </div>

            </div>

        </section>

    }

    <div class="hrapp-cols hrapp-grid-head">
        <div>應徵時間</div>
        <div>應徵職缺</div>
        <div>應徵者姓名</div>
        <div>聯絡電話</div>
        <div>最高學歷 / 科系</div>
        <div>工作經驗</div>
        <div class="text-center">目前狀態</div>
        <div class="text-center">AI 智慧篩選</div>
        <div class="text-center">操作</div>
    </div>

    @* ── 履歷列表資料列 ── *@
    <div class="hrapp-list">
        @if (!Model.Any())
        {
            <div class="hrapp-empty">目前沒有符合篩選條件的履歷。</div>
        }
        else
        {
            foreach (var item in Model)
            {
                bool isUnhandled = (item.Status == "待審核");
                string rowClass = isUnhandled ? "row-unhandled" : "row-handled";

                string statusClass = item.Status == "待審核" ? "status-pending"
                : item.Status == "已通過" ? "status-passed"
                : "status-failed";

                // 🎯 取得 AI 評分
                int? score = aiScores != null && aiScores.TryGetValue(item.Id, out int value) ? value : null;

                bool hasAiScore = score.HasValue && !string.IsNullOrWhiteSpace(item.AiComment);

                string comment = aiComments != null && aiComments.ContainsKey(item.Id) ? aiComments[item.Id] : "暫無評語";

                // 🎯 取得該筆履歷所屬職缺的上下架狀態
                // 若找不到職缺狀態，預設為招募中，避免錯誤開放審核
                bool isJobActive = jobActiveStatuses.TryGetValue(item.Id, out bool active) ? active : true;

                // 🎯 必須「職缺已下架」且「AI 已完成評分與評語」才允許審核
                bool canReview = !isJobActive && hasAiScore && !string.IsNullOrWhiteSpace(item.AiComment);
                string memberName = memberNames != null && memberNames.ContainsKey(item.Id) ? memberNames[item.Id] : "";
                string memberPhone = memberPhones != null && memberPhones.ContainsKey(item.Id) ? memberPhones[item.Id] : "";
                string jobTitle = jobTitles != null && jobTitles.ContainsKey(item.Id) ? jobTitles[item.Id] : "未指定職缺";

                var topEdu = item.Educations != null && item.Educations.Any()
                ? item.Educations.OrderBy(e => e.SortOrder).First()
                : null;

                var topWork = item.WorkExperiences != null && item.WorkExperiences.Any()
                ? item.WorkExperiences.OrderBy(w => w.SortOrder).First()
                : null;

                <div class="hrapp-row hrapp-cols @rowClass @statusClass"
                     data-row-id="@item.Id"
                     onclick="location.href='@Url.Action("Details", "AdminApplication", new { id = item.Id })'">

                    @* 1. 應徵時間 *@
                    <div class="apply-time-cell" data-label="應徵時間">
                        <span>@item.ResumeTime.AddHours(-8).ToString("yyyy/MM/dd HH:mm")</span>
                    </div>

                    @* 2. 應徵職缺 *@
                    <div class="job-title-cell" data-label="應徵職缺">
                        <span>@jobTitle</span>
                    </div>

                    @* 3. 應徵者姓名 *@
                    <div class="user-main-info" data-label="姓名">
                        <span class="user-name">@memberName</span>
                    </div>

                    @* 4. 聯絡電話 *@
                    <div class="user-phone-cell" data-label="電話">
                        <span class="user-phone">@memberPhone</span>
                    </div>

                    @* 5. 最高學歷 (注意：外層必須有 data-label，內部不要寫死「最高學歷」標題) *@
                    <div class="user-edu-cell" data-label="最高學歷">
                        <div class="user-edu">
                            <div class="edu-school">@(topEdu?.SchoolName ?? "-")</div>
                            <div class="edu-major">@(topEdu?.Major ?? "") @(string.IsNullOrEmpty(topEdu?.EduLevel) ? "" : $"({topEdu.EduLevel})")</div>
                        </div>
                    </div>

                    @* 6. 工作經驗 (注意：外層必須有 data-label，內部不要寫死「工作經驗」標題) *@
                    <div class="user-exp-cell" data-label="工作經驗">
                        <div class="user-exp">
                            @if (!item.WorkExperienceYears.HasValue || item.WorkExperienceYears.Value <= 0)
                            {
                                <span class="exp-none">(無)</span>
                            }
                            else
                            {
                                <div class="exp-company">@(topWork?.CompanyName ?? "-")</div>
                                <div class="exp-title">@(topWork?.JobTitle ?? "") (@(item.WorkExperienceYears.Value)年)</div>
                            }
                        </div>
                    </div>

                    @* 7. 目前狀態：職缺下架且 AI 評分完成後才開放審核 *@
                    <div class="status-cell" data-label="審核狀態">

                        <select class="status-select @(item.Status == "待審核" ? "select-wait" : item.Status == "已通過" ? "select-pass" : "select-fail")"
                                data-resume-id="@item.Id"
                                disabled="@(!canReview)"
                                title="@(isJobActive ? "職缺尚未下架，暫不開放履歷審核" : !canReview ? "請先完成 AI 履歷評分" : "可修改履歷審核狀態")"
                                onclick="event.stopPropagation();">

                            <option value="待審核" selected="@(item.Status == "待審核")">
                                待審核
                            </option>

                            <option value="已通過" selected="@(item.Status == "已通過")">
                                已通過
                            </option>

                            <option value="未通過" selected="@(item.Status == "未通過")">
                                未通過
                            </option>

                        </select>

                    </div>

                    @* 8. AI 評分 *@
                    <div class="ai-score-cell" data-label="AI 評估">
                        <div class="ai-score-box">
                            @if (hasAiScore)
                            {
                                <span class="ai-num @(score >= 80 ? "high" : score >= 60 ? "mid" : "low")">
                                    @score<span class="ai-pt">分</span>
                                </span>

                                <button type="button"
                                        class="btn-ai-view open-ai-modal"
                                        data-name="@memberName"
                                        data-score="@score"
                                        data-comment="@comment"
                                        onclick="event.stopPropagation();">
                                    查看評語
                                </button>
                            }
                            else
                            {
                                <span class="ai-not-scored">尚未評分</span>
                            }
                        </div>
                    </div>

                    @* 9. 操作按鈕 (移除 text-center) *@
                    <div class="action-btns" data-label="操作">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-detail" onclick="event.stopPropagation();">審查履歷</a>
                    </div>

                </div>
            }
        }
    </div>
</div>

@* ── AI 評語彈跳視窗 (Modal) ── *@
<div id="aiCommentModal" class="ai-modal-overlay">
    <div class="ai-modal-window">
        <div class="ai-modal-header">
            <div class="ai-modal-title-group">
                <span class="ai-modal-icon">🧠</span>
                <div>
                    <h3 id="modalCandidateName">應徵者</h3>
                    <p class="ai-modal-subtitle">AI 智慧適配度報告</p>
                </div>
            </div>
            <button type="button" class="ai-modal-close" id="closeAiModal">&times;</button>
        </div>
        <div class="ai-modal-body">
            <div class="ai-modal-score-badge">
                <span class="score-lbl">AI 綜合評分</span>
                <span id="modalAiScore" class="score-v">0</span>
                <span class="score-unit">分</span>
            </div>
            <div class="ai-modal-comment-card">
                <h4>分析評語回饋：</h4>
                <div id="modalAiComment" class="comment-text-content"></div>
            </div>
        </div>
        <div class="ai-modal-footer">
            <button type="button" class="btn-modal-confirm" id="confirmAiModal">關閉視窗</button>
        </div>
    </div>
</div>


@* ── AI 應徵者比較分析報告 Modal ── *@
<div id="aiReportModal"
     class="hrapp-report-overlay"
     role="dialog"
     aria-modal="true"
     aria-labelledby="aiReportTitle"
     aria-hidden="true">

    <div class="hrapp-report-window">

        <header class="hrapp-report-header">
            <div>
                <h2 id="aiReportTitle">AI 應徵者比較分析報告</h2>
                <p>@ViewBag.JobTitle</p>
            </div>

            <button type="button"
                    id="closeAiReport"
                    class="hrapp-report-close"
                    aria-label="關閉報告">
                &times;
            </button>
        </header>

        <nav class="hrapp-report-tabs"
             aria-label="AI 分析報告分頁">

            <button type="button"
                    class="report-tab active"
                    data-tab="ranking">
                面試優先順序
            </button>

            <button type="button"
                    class="report-tab"
                    data-tab="comparison">
                應徵者比較分析
            </button>

            <button type="button"
                    class="report-tab"
                    data-tab="comments">
                個別履歷評估
            </button>

        </nav>

        <main class="hrapp-report-content">

            @* 第一頁：面試優先順序分析 *@
            <section id="report-ranking"
                     class="report-panel active">

                <h5>應徵者面試優先順序分析</h5>

                <p class="report-description">
                    依據 AI 履歷匹配分數由高至低排序，
                    比較各應徵者與職缺需求的匹配程度及分數差距。
                    此順位僅供人資評估參考，不代表正式面試邀約決定。
                </p>

                <div id="rankingContent"></div>

            </section>

            @* 第二頁：跨應徵者比較 *@
            <section id="report-comparison"
                     class="report-panel">

                <h5>應徵者能力與條件比較</h5>

                <p class="report-description">
                    依據職缺需求比較應徵者的專業能力、
                    相關經驗與條件缺口，協助人資進行綜合評估。
                </p>

                <div id="comparisonContent"></div>

            </section>

            @* 第三頁：個別履歷評估 *@
            <section id="report-comments"
                     class="report-panel">

                <h5>個別應徵者履歷評估</h5>

                <p class="report-description">
                    檢視個別應徵者的 AI 評分結果與分析依據，
                    作為後續履歷審查及面試確認的參考。
                </p>

                <label for="reportCandidateSelect">
                    選擇應徵者
                </label>

                <select id="reportCandidateSelect"
                        class="form-select">
                </select>

                <div id="candidateCommentContent"></div>

            </section>

        </main>

        <footer class="hrapp-report-footer">

            <p>
                AI 評估結果僅供輔助參考，
                最終決策由人資負責。
            </p>

            <button type="button"
                    id="confirmCloseAiReport"
                    class="hrapp-ai-btn hrapp-ai-btn-primary">
                關閉報告
            </button>

        </footer>

    </div>
</div>


@section Scripts {
    @Html.AntiForgeryToken()

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. AI 評語彈跳視窗
            const modal = document.getElementById("aiCommentModal");
            const closeBtn = document.getElementById("closeAiModal");
            const confirmBtn = document.getElementById("confirmAiModal");
            const modalName = document.getElementById("modalCandidateName");
            const modalScore = document.getElementById("modalAiScore");
            const modalComment = document.getElementById("modalAiComment");

            document.querySelectorAll(".open-ai-modal").forEach(button => {
                button.addEventListener("click", function () {
                    const name = this.getAttribute("data-name");
                    const score = parseInt(this.getAttribute("data-score") || "0");
                    const comment = this.getAttribute("data-comment") || "暫無評語。";

                    modalName.textContent = name + " 的評估報告";
                    modalScore.textContent = score;
                    modalScore.className = "score-v " + (score >= 80 ? "high" : score >= 60 ? "mid" : "low");
                    modalComment.textContent = comment;
                    modal.classList.add("show");
                });
            });

            function hideModal() {
                modal.classList.remove("show");
            }

            closeBtn.addEventListener("click", hideModal);
            confirmBtn.addEventListener("click", hideModal);
            modal.addEventListener("click", function (e) {
                if (e.target === modal) hideModal();
            });

            // 2. 狀態更新 AJAX
            document.querySelectorAll(".status-select").forEach(select => {
                select.addEventListener("change", function () {
                    const resumeId = this.getAttribute("data-resume-id");
                    const newStatus = this.value;
                    const currentSelect = this;
                    const parentRow = document.querySelector(`.hrapp-row[data-row-id="${resumeId}"]`);

                    currentSelect.classList.remove("select-wait", "select-pass", "select-fail");
                    if (parentRow) {
                        parentRow.classList.remove("row-unhandled", "row-handled", "status-pending", "status-passed", "status-failed");
                    }

                    if (newStatus === "待審核") {
                        currentSelect.classList.add("select-wait");
                        if (parentRow) parentRow.classList.add("row-unhandled", "status-pending");
                    } else if (newStatus === "已通過") {
                        currentSelect.classList.add("select-pass");
                        if (parentRow) parentRow.classList.add("row-handled", "status-passed");
                    } else if (newStatus === "未通過") {
                        currentSelect.classList.add("select-fail");
                        if (parentRow) {
                            parentRow.classList.add("row-handled", "status-failed");
                            const interviewStatusPill = parentRow.querySelector(".status-pill");
                            if (interviewStatusPill) interviewStatusPill.outerHTML = '<span class="text-muted">-</span>';
                        }
                    }

                    fetch('@Url.Action("UpdateStatus", "AdminApplication")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ id: parseInt(resumeId), status: newStatus })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (!data.success) {
                            alert("狀態更新失敗：" + data.message);
                            location.reload();
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert("連線發生錯誤，無法成功儲存狀態。");
                        location.reload();
                    });
                });
            });

            // 3. 職缺下拉式選單篩選
            const jobFilterSelect = document.getElementById("jobFilterSelect");
            if (jobFilterSelect) {
                jobFilterSelect.addEventListener("change", function () {
                    const selectedJobId = this.value;
                    const currentStatusFilter = '@currentFilter';
                    let targetUrl = '@Url.Action("Index", "AdminApplication")' + '?statusFilter=' + encodeURIComponent(currentStatusFilter);
                    if (selectedJobId) targetUrl += '&jobId=' + encodeURIComponent(selectedJobId);
                    window.location.href = targetUrl;
                });
            }

            
            
            // 4. AI 綜合分析報告 Modal
            const reportModal = document.getElementById("aiReportModal");
            const openReportBtn = document.getElementById("btnOpenAiReport");
            const closeReportBtn = document.getElementById("closeAiReport");
            const confirmCloseReport = document.getElementById("confirmCloseAiReport");

            const rankingContent = document.getElementById("rankingContent");
            const comparisonContent = document.getElementById("comparisonContent");
            const candidateSelect = document.getElementById("reportCandidateSelect");
            const commentContent = document.getElementById("candidateCommentContent");

            let reportCandidates = [];

            function makeElement(tag, text, className) {
                const element = document.createElement(tag);
                element.textContent = text ?? "";
                if (className) element.className = className;
                return element;
            }

            function renderCandidateComment(candidate) {
                commentContent.replaceChildren();

                if (!candidate) {
                    commentContent.appendChild(
                        makeElement("p", "目前沒有應徵者資料。")
                    );
                    return;
                }

                const card = makeElement("div", "", "report-comment-card");
                card.appendChild(
                    makeElement("h4", candidate.memberName)
                );
                card.appendChild(
                    makeElement(
                        "strong",
                        candidate.isScored
                            ? `${candidate.aiScore} 分`
                            : "尚未評分"
                    )
                );
                card.appendChild(
                    makeElement(
                        "p",
                        candidate.aiComment || "尚無 AI 評語。",
                        "comment-text-content"
                    )
                );
                commentContent.appendChild(card);
            }

            function renderRanking(candidates) {
                rankingContent.replaceChildren();

                if (!candidates.length) {
                    rankingContent.appendChild(
                        makeElement("p", "目前沒有應徵者資料。")
                    );
                    return;
                }

                // 只納入已完成 AI 評分的應徵者
                const scoredCandidates = candidates
                    .filter(c =>
                        c.isScored &&
                        c.aiScore !== null &&
                        Number.isFinite(Number(c.aiScore))
                    )
                    .sort((a, b) =>
                        Number(b.aiScore) - Number(a.aiScore)
                    );

                if (!scoredCandidates.length) {
                    rankingContent.appendChild(
                        makeElement("p", "目前尚無已完成 AI 評分的應徵者。")
                    );
                    return;
                }

                // 取得最高分數
                const highestScore = Number(scoredCandidates[0].aiScore);

                // 建立表格
                const table = document.createElement("table");
                table.className = "comparison-table";

                const thead = document.createElement("thead");
                const header = document.createElement("tr");

                [
                    "優先順位",
                    "應徵者",
                    "AI 匹配分數",
                    "與最高分差距"
                ].forEach(label => {
                    header.appendChild(makeElement("th", label));
                });

                thead.appendChild(header);
                table.appendChild(thead);

                const tbody = document.createElement("tbody");

                let previousScore = null;
                let currentRank = 0;

                scoredCandidates.forEach((candidate, index) => {
                    const tr = document.createElement("tr");

                    const score = Number(candidate.aiScore);
                    const difference = highestScore - score;

                    // 相同分數採相同順位，例如 1、2、2、4
                    if (previousScore === null || score !== previousScore) {
                        currentRank = index + 1;
                    }

                    previousScore = score;

                    const rankText = candidate.rank != null
                        ? `#${candidate.rank}`
                        : `#${currentRank}`;
                    const scoreText = `${score} 分`;
                    const differenceText =
                        difference === 0
                            ? "0 分"
                            : `${difference} 分`;

                    [
                        rankText,
                        candidate.memberName,
                        scoreText,
                        differenceText
                    ].forEach(value => {
                        tr.appendChild(makeElement("td", value));
                    });

                    tbody.appendChild(tr);
                });

                table.appendChild(tbody);
                rankingContent.appendChild(table);
            }

            function renderComparison(data) {
                comparisonContent.replaceChildren();

                // 必須由後端提供真正的跨應徵者分析文字
                const report = data.comparisonReport;

                if (!report) {
                    comparisonContent.appendChild(
                        makeElement(
                            "p",
                            "目前尚未產生跨應徵者比較分析報告。",
                            "report-description"
                        )
                    );
                    return;
                }

                comparisonContent.appendChild(
                    makeElement("div", report, "report-comparison-text")
                );
            }

            function renderReport(data) {
                reportCandidates = data.candidates || [];

                renderRanking(reportCandidates);
                renderComparison(data);

                candidateSelect.replaceChildren();

                reportCandidates.forEach(candidate => {
                    const option = document.createElement("option");
                    option.value = String(candidate.resumeId);
                    option.textContent = candidate.isScored
                        ? `${candidate.memberName}（${candidate.aiScore} 分）`
                        : `${candidate.memberName}（尚未評分）`;
                    candidateSelect.appendChild(option);
                });

                renderCandidateComment(reportCandidates[0]);
            }

            candidateSelect?.addEventListener("change", function () {
                const candidate = reportCandidates.find(
                    c => String(c.resumeId) === this.value
                );
                renderCandidateComment(candidate);
            });

            document.querySelectorAll(".report-tab").forEach(button => {
                button.addEventListener("click", function () {
                    document.querySelectorAll(".report-tab")
                        .forEach(tab => tab.classList.remove("active"));

                    document.querySelectorAll(".report-panel")
                        .forEach(panel => panel.classList.remove("active"));

                    this.classList.add("active");

                    document.getElementById(
                        `report-${this.dataset.tab}`
                    ).classList.add("active");
                });
            });

            function closeReport() {
                reportModal.classList.remove("show");
                reportModal.setAttribute("aria-hidden", "true");
                openReportBtn?.focus();
            }

            openReportBtn?.addEventListener("click", async function () {
                const jobId = this.dataset.jobId;

                reportModal.classList.add("show");
                reportModal.setAttribute("aria-hidden", "false");

                rankingContent.textContent = "正在載入分析資料...";
                comparisonContent.textContent = "";
                commentContent.textContent = "";

                try {
                    const url =
                        '@Url.Action("GetAiAnalysisReport", "AdminApplication")'
                        + "?jobId=" + encodeURIComponent(jobId);

                    const response = await fetch(url);
                    const data = await response.json();

                    if (!response.ok || !data.success) {
                        throw new Error(data.message || "載入失敗");
                    }

                    renderReport(data);

                } catch (error) {
                    rankingContent.textContent =
                        "無法載入 AI 分析報告：" + error.message;
                }
            });

            closeReportBtn?.addEventListener("click", closeReport);
            confirmCloseReport?.addEventListener("click", closeReport);

            reportModal?.addEventListener("click", function (event) {
                if (event.target === reportModal) closeReport();
            });

            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape" &&
                    reportModal?.classList.contains("show")) {
                    closeReport();
                }
            });



        });
    </script>
}