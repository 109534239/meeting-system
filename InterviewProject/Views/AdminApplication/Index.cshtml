@model List<InterviewProject.Models.Resume>

@{
    ViewData["Title"] = "應徵履歷管理";
    string currentFilter = ViewBag.CurrentFilter ?? "全部";
    var aiScores = ViewBag.AiScores as Dictionary<int, int>;
    var aiComments = ViewBag.AiComments as Dictionary<int, string>;
    var memberNames = ViewBag.MemberNames as Dictionary<int, string>;
    var memberPhones = ViewBag.MemberPhones as Dictionary<int, string>;
    var jobTitles = ViewBag.JobTitles as Dictionary<int, string>;
    var jobActiveStatuses = ViewBag.JobActiveStatuses as Dictionary<int, bool> ?? new Dictionary<int, bool>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Job_search.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/HrJob.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/AdminApplication.css" asp-append-version="true" />
}

<div class="page-header">
    <div class="page-header-inner">
        <h1>@ViewBag.JobTitle</h1>
        <p>應徵名單管理 / Resume Management</p>
    </div>
</div>

<div class="hrapp-container">
    @* ── 篩選切換區 (Tabs + 下拉選單) ── *@
    <div class="hrapp-filter-tabs">
        <div class="tab-group">
            <a asp-action="Index" asp-route-jobId="@ViewBag.JobId" asp-route-statusFilter="全部"
               class="tab-item @(currentFilter == "全部" ? "active" : "")">
                全部履歷
            </a>
            <a asp-action="Index" asp-route-jobId="@ViewBag.JobId" asp-route-statusFilter="未處理"
               class="tab-item @(currentFilter == "未處理" ? "active" : "")">
                未處理 (待審核)
            </a>
            <a asp-action="Index" asp-route-jobId="@ViewBag.JobId" asp-route-statusFilter="已處理"
               class="tab-item @(currentFilter == "已處理" ? "active" : "")">
                已處理 (已安排面試/錄取等)
            </a>
        </div>

        <div class="job-filter-group">
            <label for="jobFilterSelect" style="font-weight: bold; white-space: nowrap;">篩選職缺：</label>
            <select id="jobFilterSelect" class="form-select" style="padding: 6px 12px; border-radius: 6px; border: 1px solid #ccc;">
                <option value="">全部職缺</option>
                @if (ViewBag.JobList != null)
                {
                    foreach (var job in (List<SelectListItem>)ViewBag.JobList)
                    {
                        <option value="@job.Value" selected="@(job.Selected)">@job.Text</option>
                    }
                }
            </select>
        </div>
    </div>

    @* ── AI 履歷批次評分操作區 ── *@
    @if (ViewBag.JobId != null)
    {
        <div class="hrapp-ai-toolbar">
            <div class="hrapp-ai-info">
                <h3>AI 履歷評估</h3>

                @if (ViewBag.IsJobActive == true)
                {
                    <p>職缺目前仍在招募中，請於職缺下架後進行 AI 履歷評分。</p>
                }
                else
                {
                    <p>職缺已下架，可針對此職缺的應徵履歷進行 AI 評估。</p>
                }
            </div>

            <div class="hrapp-ai-actions">
                @if (ViewBag.CanStartAiScoring == true)
                {
                    <button type="button"
                            id="btnBatchAiScore"
                            class="hrapp-ai-btn hrapp-ai-btn-primary">
                        履歷 AI 評分
                    </button>

                    <button type="button"
                            id="btnBatchAiRescore"
                            class="hrapp-ai-btn hrapp-ai-btn-secondary">
                        重新 AI 評分
                    </button>
                }
                else
                {
                    <button type="button"
                            class="hrapp-ai-btn hrapp-ai-btn-primary"
                            disabled>
                        暫不開放 AI 評分
                    </button>
                }
            </div>
        </div>
    }

    @* ── AI 評分進度顯示 ── *@
    <div id="aiScoringProgress"
         style="display:none; margin:16px 0; padding:18px 20px;
        background:#f8fafc; border:1px solid #e2e8f0;
        border-radius:10px;">

        <div style="display:flex; justify-content:space-between;
            align-items:center; margin-bottom:10px;">
            <strong>AI 履歷評分進度</strong>
            <span id="aiProgressText">準備中...</span>
        </div>

        <div style="width:100%; height:10px; background:#e2e8f0;
            border-radius:6px; overflow:hidden;">
            <div id="aiProgressBar"
                 style="width:0%; height:100%; background:#2563eb;
                transition:width .3s;">
            </div>
        </div>

        <p id="aiProgressMessage"
           style="margin:12px 0 0; font-size:14px; color:#475569;">
            正在準備 AI 評分...
        </p>
    </div>

    @* ── 履歷列表 Grid 標頭 (手機版會自動隱藏) ── *@
    <div class="hrapp-cols hrapp-grid-head">
        <div>應徵時間</div>
        <div>應徵職缺</div>
        <div>應徵者姓名</div>
        <div>聯絡電話</div>
        <div>最高學歷 / 科系</div>
        <div>工作經驗</div>
        <div class="text-center">目前狀態</div>
        <div class="text-center">AI 智慧篩選</div>
        <div class="text-center">操作</div>
    </div>

    @* ── 履歷列表資料列 ── *@
    <div class="hrapp-list">
        @if (!Model.Any())
        {
            <div class="hrapp-empty">目前沒有符合篩選條件的履歷。</div>
        }
        else
        {
            foreach (var item in Model)
            {
                bool isUnhandled = (item.Status == "待審核");
                string rowClass = isUnhandled ? "row-unhandled" : "row-handled";

                string statusClass = item.Status == "待審核" ? "status-pending"
                : item.Status == "已通過" ? "status-passed"
                : "status-failed";

                // 🎯 取得 AI 評分
                int? score = aiScores != null && aiScores.TryGetValue(item.Id, out int value) ? value : null;

                bool hasAiScore = score.HasValue && !string.IsNullOrWhiteSpace(item.AiComment);

                string comment = aiComments != null && aiComments.ContainsKey(item.Id) ? aiComments[item.Id] : "暫無評語";

                // 🎯 取得該筆履歷所屬職缺的上下架狀態
                // 若找不到職缺狀態，預設為招募中，避免錯誤開放審核
                bool isJobActive = jobActiveStatuses.TryGetValue(item.Id, out bool active) ? active : true;

                // 🎯 必須「職缺已下架」且「AI 已完成評分與評語」才允許審核
                bool canReview = !isJobActive && hasAiScore && !string.IsNullOrWhiteSpace(item.AiComment);
                string memberName = memberNames != null && memberNames.ContainsKey(item.Id) ? memberNames[item.Id] : "";
                string memberPhone = memberPhones != null && memberPhones.ContainsKey(item.Id) ? memberPhones[item.Id] : "";
                string jobTitle = jobTitles != null && jobTitles.ContainsKey(item.Id) ? jobTitles[item.Id] : "未指定職缺";

                var topEdu = item.Educations != null && item.Educations.Any()
                ? item.Educations.OrderBy(e => e.SortOrder).First()
                : null;

                var topWork = item.WorkExperiences != null && item.WorkExperiences.Any()
                ? item.WorkExperiences.OrderBy(w => w.SortOrder).First()
                : null;

                <div class="hrapp-row hrapp-cols @rowClass @statusClass"
                     data-row-id="@item.Id"
                     onclick="location.href='@Url.Action("Details", "AdminApplication", new { id = item.Id })'">

                    @* 1. 應徵時間 *@
                    <div class="apply-time-cell" data-label="應徵時間">
                        <span>@item.ResumeTime.AddHours(-8).ToString("yyyy/MM/dd HH:mm")</span>
                    </div>

                    @* 2. 應徵職缺 *@
                    <div class="job-title-cell" data-label="應徵職缺">
                        <span>@jobTitle</span>
                    </div>

                    @* 3. 應徵者姓名 *@
                    <div class="user-main-info" data-label="姓名">
                        <span class="user-name">@memberName</span>
                    </div>

                    @* 4. 聯絡電話 *@
                    <div class="user-phone-cell" data-label="電話">
                        <span class="user-phone">@memberPhone</span>
                    </div>

                    @* 5. 最高學歷 (注意：外層必須有 data-label，內部不要寫死「最高學歷」標題) *@
                    <div class="user-edu-cell" data-label="最高學歷">
                        <div class="user-edu">
                            <div class="edu-school">@(topEdu?.SchoolName ?? "-")</div>
                            <div class="edu-major">@(topEdu?.Major ?? "") @(string.IsNullOrEmpty(topEdu?.EduLevel) ? "" : $"({topEdu.EduLevel})")</div>
                        </div>
                    </div>

                    @* 6. 工作經驗 (注意：外層必須有 data-label，內部不要寫死「工作經驗」標題) *@
                    <div class="user-exp-cell" data-label="工作經驗">
                        <div class="user-exp">
                            @if (!item.WorkExperienceYears.HasValue || item.WorkExperienceYears.Value <= 0)
                            {
                                <span class="exp-none">(無)</span>
                            }
                            else
                            {
                                <div class="exp-company">@(topWork?.CompanyName ?? "-")</div>
                                <div class="exp-title">@(topWork?.JobTitle ?? "") (@(item.WorkExperienceYears.Value)年)</div>
                            }
                        </div>
                    </div>

                    @* 7. 目前狀態：職缺下架且 AI 評分完成後才開放審核 *@
                    <div class="status-cell" data-label="審核狀態">

                        <select class="status-select @(item.Status == "待審核" ? "select-wait" : item.Status == "已通過" ? "select-pass" : "select-fail")"
                                data-resume-id="@item.Id"
                                disabled="@(!canReview)"
                                title="@(isJobActive ? "職缺尚未下架，暫不開放履歷審核" : !canReview ? "請先完成 AI 履歷評分" : "可修改履歷審核狀態")"
                                onclick="event.stopPropagation();">

                            <option value="待審核" selected="@(item.Status == "待審核")">
                                待審核
                            </option>

                            <option value="已通過" selected="@(item.Status == "已通過")">
                                已通過
                            </option>

                            <option value="未通過" selected="@(item.Status == "未通過")">
                                未通過
                            </option>

                        </select>

                    </div>

                    @* 8. AI 評分 *@
                    <div class="ai-score-cell" data-label="AI 評估">
                        <div class="ai-score-box">
                            @if (hasAiScore)
                            {
                                <span class="ai-num @(score >= 80 ? "high" : score >= 60 ? "mid" : "low")">
                                    @score<span class="ai-pt">分</span>
                                </span>

                                <button type="button"
                                        class="btn-ai-view open-ai-modal"
                                        data-name="@memberName"
                                        data-score="@score"
                                        data-comment="@comment"
                                        onclick="event.stopPropagation();">
                                    查看評語
                                </button>
                            }
                            else
                            {
                                <span class="ai-not-scored">尚未評分</span>
                            }
                        </div>
                    </div>

                    @* 9. 操作按鈕 (移除 text-center) *@
                    <div class="action-btns" data-label="操作">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-detail" onclick="event.stopPropagation();">審查履歷</a>
                    </div>

                </div>
            }
        }
    </div>
</div>

@* ── AI 評語彈跳視窗 (Modal) ── *@
<div id="aiCommentModal" class="ai-modal-overlay">
    <div class="ai-modal-window">
        <div class="ai-modal-header">
            <div class="ai-modal-title-group">
                <span class="ai-modal-icon">🧠</span>
                <div>
                    <h3 id="modalCandidateName">應徵者</h3>
                    <p class="ai-modal-subtitle">AI 智慧適配度報告</p>
                </div>
            </div>
            <button type="button" class="ai-modal-close" id="closeAiModal">&times;</button>
        </div>
        <div class="ai-modal-body">
            <div class="ai-modal-score-badge">
                <span class="score-lbl">AI 綜合評分</span>
                <span id="modalAiScore" class="score-v">0</span>
                <span class="score-unit">分</span>
            </div>
            <div class="ai-modal-comment-card">
                <h4>分析評語回饋：</h4>
                <div id="modalAiComment" class="comment-text-content"></div>
            </div>
        </div>
        <div class="ai-modal-footer">
            <button type="button" class="btn-modal-confirm" id="confirmAiModal">關閉視窗</button>
        </div>
    </div>
</div>

@section Scripts {
    @Html.AntiForgeryToken()

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. AI 評語彈跳視窗
            const modal = document.getElementById("aiCommentModal");
            const closeBtn = document.getElementById("closeAiModal");
            const confirmBtn = document.getElementById("confirmAiModal");
            const modalName = document.getElementById("modalCandidateName");
            const modalScore = document.getElementById("modalAiScore");
            const modalComment = document.getElementById("modalAiComment");

            document.querySelectorAll(".open-ai-modal").forEach(button => {
                button.addEventListener("click", function () {
                    const name = this.getAttribute("data-name");
                    const score = parseInt(this.getAttribute("data-score") || "0");
                    const comment = this.getAttribute("data-comment") || "暫無評語。";

                    modalName.textContent = name + " 的評估報告";
                    modalScore.textContent = score;
                    modalScore.className = "score-v " + (score >= 80 ? "high" : score >= 60 ? "mid" : "low");
                    modalComment.textContent = comment;
                    modal.classList.add("show");
                });
            });

            function hideModal() {
                modal.classList.remove("show");
            }

            closeBtn.addEventListener("click", hideModal);
            confirmBtn.addEventListener("click", hideModal);
            modal.addEventListener("click", function (e) {
                if (e.target === modal) hideModal();
            });

            // 2. 狀態更新 AJAX
            document.querySelectorAll(".status-select").forEach(select => {
                select.addEventListener("change", function () {
                    const resumeId = this.getAttribute("data-resume-id");
                    const newStatus = this.value;
                    const currentSelect = this;
                    const parentRow = document.querySelector(`.hrapp-row[data-row-id="${resumeId}"]`);

                    currentSelect.classList.remove("select-wait", "select-pass", "select-fail");
                    if (parentRow) {
                        parentRow.classList.remove("row-unhandled", "row-handled", "status-pending", "status-passed", "status-failed");
                    }

                    if (newStatus === "待審核") {
                        currentSelect.classList.add("select-wait");
                        if (parentRow) parentRow.classList.add("row-unhandled", "status-pending");
                    } else if (newStatus === "已通過") {
                        currentSelect.classList.add("select-pass");
                        if (parentRow) parentRow.classList.add("row-handled", "status-passed");
                    } else if (newStatus === "未通過") {
                        currentSelect.classList.add("select-fail");
                        if (parentRow) {
                            parentRow.classList.add("row-handled", "status-failed");
                            const interviewStatusPill = parentRow.querySelector(".status-pill");
                            if (interviewStatusPill) interviewStatusPill.outerHTML = '<span class="text-muted">-</span>';
                        }
                    }

                    fetch('@Url.Action("UpdateStatus", "AdminApplication")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ id: parseInt(resumeId), status: newStatus })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (!data.success) {
                            alert("狀態更新失敗：" + data.message);
                            location.reload();
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert("連線發生錯誤，無法成功儲存狀態。");
                        location.reload();
                    });
                });
            });

            // 3. 職缺下拉式選單篩選
            const jobFilterSelect = document.getElementById("jobFilterSelect");
            if (jobFilterSelect) {
                jobFilterSelect.addEventListener("change", function () {
                    const selectedJobId = this.value;
                    const currentStatusFilter = '@currentFilter';
                    let targetUrl = '@Url.Action("Index", "AdminApplication")' + '?statusFilter=' + encodeURIComponent(currentStatusFilter);
                    if (selectedJobId) targetUrl += '&jobId=' + encodeURIComponent(selectedJobId);
                    window.location.href = targetUrl;
                });
            }

            
            // 4. HR 手動啟動 AI 履歷批次評分
            const btnBatchAiScore = document.getElementById("btnBatchAiScore");
            const aiProgress = document.getElementById("aiScoringProgress");
            const aiProgressText = document.getElementById("aiProgressText");
            const aiProgressBar = document.getElementById("aiProgressBar");
            const aiProgressMessage = document.getElementById("aiProgressMessage");

            if (btnBatchAiScore) {
                btnBatchAiScore.addEventListener("click", async function () {

                    const jobId = document.getElementById("jobFilterSelect")?.value;

                    if (!jobId) {
                        alert("請先選擇要進行 AI 評分的職缺。");
                        return;
                    }

                    if (!confirm("確定要開始此職缺的 AI 履歷評分嗎？\n評分過程可能需要數分鐘，請勿關閉頁面。")) {
                        return;
                    }

                    btnBatchAiScore.disabled = true;
                    btnBatchAiScore.textContent = "AI 評分進行中...";

                    aiProgress.style.display = "block";
                    aiProgressText.textContent = "準備中...";
                    aiProgressBar.style.width = "0%";
                    aiProgressMessage.textContent = "正在取得尚未評分的履歷...";

                    let successCount = 0;
                    let failedCount = 0;
                    let total = 0;
                    const failedMessages = [];

                    try {
                        // 取得此職缺尚未評分的履歷
                        const pendingUrl =
                            '@Url.Action("GetPendingAiScoring", "AdminApplication")'
                            + '?jobId=' + encodeURIComponent(jobId);

                        const pendingResponse = await fetch(pendingUrl);

                        const pendingData = await pendingResponse.json();

                        if (!pendingResponse.ok || !pendingData.success) {
                            throw new Error(pendingData.message || "無法取得待評分履歷。");
                        }

                        const resumeIds = pendingData.resumeIds || [];
                        total = resumeIds.length;

                        if (total === 0) {
                            aiProgressText.textContent = "0 / 0";
                            aiProgressBar.style.width = "100%";
                            aiProgressMessage.textContent = "目前沒有需要進行 AI 評分的履歷。";
                            return;
                        }

                        // 取得 ASP.NET Core 防偽權杖
                        const token = document.querySelector(
                            'input[name="__RequestVerificationToken"]'
                        )?.value;

                        if (!token) {
                            throw new Error("找不到防偽權杖，請重新整理頁面。");
                        }

                        // 逐筆執行 AI 評分
                        for (let i = 0; i < total; i++) {

                            const resumeId = resumeIds[i];

                            aiProgressText.textContent = `${i + 1} / ${total}`;
                            aiProgressMessage.textContent =
                                `正在評估第 ${i + 1} 份履歷，共 ${total} 份...`;

                            try {
                                const formData = new URLSearchParams();
                                formData.append("resumeId", resumeId);
                                formData.append("jobId", jobId);
                                formData.append("__RequestVerificationToken", token);

                                const response = await fetch(
                                    '@Url.Action("ScoreResume", "AdminApplication")',
                                    {
                                        method: "POST",
                                        headers: {
                                            "Content-Type": "application/x-www-form-urlencoded"
                                        },
                                        body: formData.toString()
                                    }
                                );

                                const result = await response.json();

                                if (!response.ok || !result.success) {
                                    failedCount++;
                                    failedMessages.push(
                                        `履歷 ${resumeId}：${result.message || "評分失敗"}`
                                    );
                                } else {
                                    successCount++;
                                }

                            } catch (error) {
                                failedCount++;
                                failedMessages.push(
                                    `履歷 ${resumeId}：${error.message}`
                                );
                                console.error("AI 評分失敗：", error);
                            }

                            // 更新進度
                            const completed = i + 1;
                            const percentage = Math.round(completed / total * 100);

                            aiProgressBar.style.width = `${percentage}%`;
                            aiProgressText.textContent = `${completed} / ${total}`;
                            aiProgressMessage.textContent =
                                `已完成 ${completed} 份，成功 ${successCount} 份，失敗 ${failedCount} 份。`;
                        }

                        if (failedCount === 0) {
                            aiProgressMessage.textContent =
                                `AI 評分完成！共成功評估 ${successCount} 份履歷。`;

                            alert(`AI 評分完成！\n成功：${successCount} 份\n失敗：0 份`);
                        } else {
                            aiProgressMessage.textContent =
                                `AI 評分結束。成功 ${successCount} 份，失敗 ${failedCount} 份。`;

                            alert(
                                `AI 評分結束！\n成功：${successCount} 份\n失敗：${failedCount} 份\n\n`
                                + failedMessages.slice(0, 5).join("\n")
                                + (failedMessages.length > 5 ? "\n其他失敗原因請查看主控台。" : "")
                            );

                            console.warn("AI 評分失敗清單：", failedMessages);
                        }

                        // 重新載入頁面，顯示最新 AI 分數及評語
                        window.location.reload();

                    } catch (error) {
                        console.error("批次 AI 評分錯誤：", error);

                        aiProgressMessage.textContent =
                            "AI 評分無法啟動：" + error.message;

                        alert("AI 評分無法啟動：" + error.message);

                    } finally {
                        btnBatchAiScore.disabled = false;
                        btnBatchAiScore.textContent = "履歷 AI 評分";
                    }
                });
            }

            
            // 5. 批次重新 AI 評分
            const btnBatchAiRescore = document.getElementById("btnBatchAiRescore");

            if (btnBatchAiRescore) {
                btnBatchAiRescore.addEventListener("click", async function () {
                    const jobId = document.getElementById("jobFilterSelect")?.value;

                    if (!jobId) {
                        alert("請先選擇職缺。");
                        return;
                    }

                    if (!confirm(
                        "確定要重新評分此職缺所有已完成 AI 評分、且仍待審核的履歷嗎？\n\n" +
                        "重新評分成功後，將覆蓋原本的 AI 分數與評語。"
                    )) {
                        return;
                    }

                    const token = document.querySelector(
                        'input[name="__RequestVerificationToken"]'
                    )?.value;

                    if (!token) {
                        alert("找不到防偽權杖，請重新整理頁面。");
                        return;
                    }

                    const firstScoreButton = document.getElementById("btnBatchAiScore");

                    btnBatchAiRescore.disabled = true;
                    if (firstScoreButton) firstScoreButton.disabled = true;
                    btnBatchAiRescore.textContent = "重新評分中...";

                    const progress = document.getElementById("aiScoringProgress");
                    const progressText = document.getElementById("aiProgressText");
                    const progressBar = document.getElementById("aiProgressBar");
                    const progressMessage = document.getElementById("aiProgressMessage");

                    if (progress) progress.style.display = "block";
                    if (progressText) progressText.textContent = "準備中...";
                    if (progressBar) progressBar.style.width = "0%";
                    if (progressMessage) {
                        progressMessage.textContent = "正在取得已評分的履歷...";
                    }

                    try {
                        const url =
                            '@Url.Action("GetRescoreCandidates", "AdminApplication")'
                            + '?jobId=' + encodeURIComponent(jobId);

                        const response = await fetch(url);
                        const data = await response.json();

                        if (!response.ok || !data.success) {
                            throw new Error(data.message || "無法取得重新評分清單。");
                        }

                        const resumeIds = data.resumeIds || [];
                        const total = resumeIds.length;

                        if (total === 0) {
                            if (progressText) progressText.textContent = "0 / 0";
                            if (progressMessage) {
                                progressMessage.textContent = "目前沒有需要重新評分的履歷。";
                            }
                            return;
                        }

                        let successCount = 0;
                        let failedCount = 0;
                        const errors = [];

                        for (let i = 0; i < total; i++) {
                            const resumeId = resumeIds[i];

                            if (progressMessage) {
                                progressMessage.textContent =
                                    `正在重新評估第 ${i + 1} / ${total} 份履歷...`;
                            }

                            try {
                                const formData = new URLSearchParams();
                                formData.append("resumeId", resumeId);
                                formData.append("jobId", jobId);
                                formData.append("__RequestVerificationToken", token);

                                const scoreResponse = await fetch(
                                    '@Url.Action("RescoreResume", "AdminApplication")',
                                    {
                                        method: "POST",
                                        headers: {
                                            "Content-Type": "application/x-www-form-urlencoded"
                                        },
                                        body: formData.toString()
                                    }
                                );

                                const result = await scoreResponse.json();

                                if (!scoreResponse.ok || !result.success) {
                                    throw new Error(result.message || "重新評分失敗");
                                }

                                successCount++;

                            } catch (error) {
                                failedCount++;
                                errors.push(`履歷 ${resumeId}：${error.message}`);
                                console.error("重新評分失敗：", error);
                            }

                            const completed = i + 1;

                            if (progressBar) {
                                progressBar.style.width =
                                    `${Math.round(completed / total * 100)}%`;
                            }

                            if (progressText) {
                                progressText.textContent = `${completed} / ${total}`;
                            }

                            if (progressMessage) {
                                progressMessage.textContent =
                                    `成功 ${successCount} 份，失敗 ${failedCount} 份。`;
                            }
                        }

                        if (errors.length > 0) {
                            console.warn("重新評分失敗清單：", errors);
                        }

                        alert(
                            `重新 AI 評分完成！\n成功：${successCount} 份\n失敗：${failedCount} 份` +
                            (errors.length ? "\n\n" + errors.slice(0, 5).join("\n") : "")
                        );

                        window.location.reload();

                    } catch (error) {
                        console.error(error);
                        alert("重新評分無法啟動：" + error.message);

                    } finally {
                        btnBatchAiRescore.disabled = false;
                        if (firstScoreButton) firstScoreButton.disabled = false;
                        btnBatchAiRescore.textContent = "重新 AI 評分";
                    }
                });
            }


        });
    </script>
}