@model List<InterviewProject.Models.Job>

@{
    ViewData["Title"] = "應徵管理";
    var today = DateTime.Today; // 🎯 取得今天日期（只留年月日，不帶時間）
}

@section Styles {
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/HrJob.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Job_search.css" asp-append-version="true" />

    <style>
        @@media (min-width: 993px) {
            .hrjob-cols.staff-cols { grid-template-columns: 85px minmax(200px, 1fr) 85px 135px; }
        }
        @@media (max-width: 992px) {
            .hrjob-row.hrjob-cols.staff-cols > div:nth-child(4) {
                grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 12px 18px;
                padding: 8px 0; border-top: 1px dashed #edf2f5;
            }
        }

        /* 🎯 表頭排序按鈕：外觀與表頭文字一致，只多一個淡色排序箭頭 */
        .hrjob-grid-head button.hrjob-sort-btn {
            all: unset;
            box-sizing: border-box;
            display: inline-flex;
            align-items: center;
            gap: 1px;
            padding: 2px 3px;
            border-radius: 6px;
            font: inherit;
            color: inherit;
            white-space: nowrap;
            cursor: pointer;
            user-select: none;
            transition: background-color 0.15s ease, color 0.15s ease;
        }

            .hrjob-grid-head button.hrjob-sort-btn:hover {
                background-color: #edf4f7;
                color: #206c8b;
            }

            .hrjob-grid-head button.hrjob-sort-btn:focus-visible {
                outline: 2px solid rgba(32, 108, 139, 0.35);
                outline-offset: 1px;
            }

            /* 排序中：主色文字 + 淡底 */
            .hrjob-grid-head button.hrjob-sort-btn.active {
                background-color: #e6f0f4;
                color: #206c8b;
            }

            .hrjob-grid-head button.hrjob-sort-btn .sort-icon {
                font-size: 11px;
                line-height: 1;
                opacity: 0.45;
                transition: opacity 0.15s ease;
            }

            .hrjob-grid-head button.hrjob-sort-btn:hover .sort-icon,
            .hrjob-grid-head button.hrjob-sort-btn.active .sort-icon {
                opacity: 1;
            }

        /* 部門、職缺名稱：按鈕內距往左抵銷，讓文字和下方資料對齊 */
        .hrjob-grid-head > div:nth-child(-n+2) > button.hrjob-sort-btn {
            margin-left: -3px;
        }

        /* 表頭文字一律不換行 */
        .hrjob-grid-head > div {
            white-space: nowrap;
        }

        /* 招募進度、上架／下架日期：多個排序按鈕排成同一行 */
        .hrjob-grid-head .hrjob-sort-group {
            display: flex;
            align-items: center;
            flex-wrap: nowrap;
        }

            .hrjob-grid-head .hrjob-sort-group.text-center {
                justify-content: center;
            }

        .hrjob-sort-sep {
            margin: 0 1px;
            opacity: 0.5;
        }
    </style>
}

<div class="page-header">
    <div class="page-header-inner">
        <h1>應徵管理</h1>
        <p>Application Management</p>
    </div>
</div>

@* 🎯 篩選列 *@
<div class="search-bar">
    <div class="search-inner">
        <div class="search-field">
            <label>部門</label>
            <select id="sel-department">
                <option value="">全部部門</option>
                @if (ViewBag.DepartmentOptions != null)
                {
                    foreach (var dept in (List<string>)ViewBag.DepartmentOptions)
                    {
                        <option value="@dept" selected="@(ViewBag.SelectedDepartment == dept ? "selected" : null)">@dept</option>
                    }
                }
            </select>
        </div>
        <div class="search-field">
            <label>上架狀態</label>
            <select id="sel-status">
                <option value="">全部狀態</option>
                <option value="active" selected="@(ViewBag.SelectedStatus == "active")">上架中</option>
                <option value="inactive" selected="@(ViewBag.SelectedStatus == "inactive")">已下架</option>
            </select>
        </div>
        <div class="search-field">
            <label>日期（落在上架～截止之間）</label>
            <input type="date" id="sel-date" value="@ViewBag.SelectedDate" />
        </div>
        <div class="search-field keyword">
            <label>職缺名稱搜尋</label>
            <input type="text" id="kw-input" value="@ViewBag.Keyword" placeholder="輸入職缺名稱關鍵字" />
        </div>
        <button class="search-btn" type="button" onclick="doSearch()">搜尋</button>
        <button class="reset-btn" type="button" onclick="resetSearch()">重置</button>
    </div>
</div>

<div class="hrjob-page">

    
    @if (TempData["Success"] != null)
    {
        <div class="alert-success">@TempData["Success"]</div>
    }

    @* ── Grid 標頭 ── *@
    <div class="hrjob-cols staff-cols hrjob-grid-head">
        <div>
            <button type="button" class="hrjob-sort-btn" data-sort-key="dept">部門 <span class="sort-icon">⇅</span></button>
        </div>
        <div>
            <button type="button" class="hrjob-sort-btn" data-sort-key="title">職缺名稱 <span class="sort-icon">⇅</span></button>
        </div>
        <div class="text-center">
            <button type="button" class="hrjob-sort-btn" data-sort-key="status">狀態 <span class="sort-icon">⇅</span></button>
        </div>
        <div class="text-center hrjob-sort-group">
            <button type="button" class="hrjob-sort-btn" data-sort-key="created">上架<span class="sort-icon">⇅</span></button><span class="hrjob-sort-sep">/</span><button type="button" class="hrjob-sort-btn" data-sort-key="deadline">下架<span class="sort-icon">⇅</span></button><span>日期</span>
        </div>
    </div>

    @* ── 資料列 ── *@
    <div class="hrjob-list" id="hrjob-list">
        @if (Model != null && Model.Any())
        {
            @foreach (var job in Model)
            {
                // 🎯 動態判定刊登狀態：IsActive 為 false，或是今天日期已超過截止日期 -> 顯示「已下架」
                bool isExpired = today > job.Deadline.Date;
                bool isCurrentlyActive = job.IsActive && !isExpired;

                <div class="hrjob-row hrjob-cols staff-cols" style="cursor:pointer;" data-href="@Url.Action("Index", "AdminApplication", new { jobId = job.Id })" title="點擊查看應徵名單"
                     data-dept="@job.Department"
                     data-title="@job.Title"
                     data-active="@(isCurrentlyActive ? 1 : 0)"
                     data-created="@job.CreatedAt.ToLocalTime().ToString("yyyyMMdd")"
                     data-deadline="@job.Deadline.ToLocalTime().ToString("yyyyMMdd")">

                    @* 1. 部門 *@
                    <div class="hrjob-dept-text">@job.Department</div>

                    @* 2. 職缺名稱與類型 *@
                    @{
                        string bgStyle = job.JobType == "fulltime" ? "background:#e8f4ff; color:#1a6fb5;" :
                        job.JobType == "parttime" ? "background:#fff3e0; color:#e07b3a;" :
                        "background:#e8f5e9; color:#2e7d32;";
                    }

                    <div class="hrjob-title-cell">
                        <span class="job-fulltime" style="@bgStyle">
                            @(job.JobType == "fulltime" ? "全職" : job.JobType == "parttime" ? "兼職" : "實習")
                        </span>
                        <a class="hrjob-title-text" style="text-decoration:none;color:inherit;" href="@Url.Action("Index", "AdminApplication", new { jobId = job.Id })">@job.Title</a>
                    </div>

                    @* 5. 上下架狀態（🎯 根據今天日期與 Deadline 動態判斷） *@
                    <div class="hrjob-status-cell">
                        <span class="btn-toggle @(isCurrentlyActive ? "active" : "inactive")" style="cursor: default;">
                            @(isCurrentlyActive ? "上架中" : "已下架")
                        </span>
                    </div>

                    @* 6. 上架 / 截止日期 *@
                    <div>
                        <div class="hrjob-time-item">
                            <span class="hrjob-time-label">上架：</span>
                            <span class="hrjob-time-time-text">
                                @job.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")
                            </span>
                        </div>
                        <div class="hrjob-time-item">
                            <span class="hrjob-time-label-deadline">截止：</span>
                            <span class="hrjob-time-time-text">@job.Deadline.ToLocalTime().ToString("yyyy/MM/dd")</span>
                        </div>
                    </div>

                </div>
            }
        }
        else
        {
            <div style="padding: 40px; text-align:center; color:#888;">
                目前沒有符合篩選條件的職缺
            </div>
        }
    </div>

    <div class="pagination" id="pagination"></div>
</div>

@section Scripts {
    <script>
        // ============================
        // 篩選
        // ============================
        function doSearch() {
            const department = document.getElementById('sel-department').value;
            const status     = document.getElementById('sel-status').value;
            const date       = document.getElementById('sel-date').value;
            const keyword    = document.getElementById('kw-input').value.trim();

            const params = new URLSearchParams();
            if (department) params.append('department', department);
            if (status)     params.append('status', status);
            if (date)       params.append('date', date);
            if (keyword)    params.append('keyword', keyword);

            window.location.href = '/AdminApplication/Jobs?' + params.toString();
        }

        function resetSearch() {
            window.location.href = '/AdminApplication/Jobs';
        }

        // ============================
        // 分頁
        // ============================
        const PAGE_SIZE = 10;
        let currentPage = 1;

        function getTotalRows() {
            return document.querySelectorAll('#hrjob-list .hrjob-row').length;
        }

        function showPage(page) {
            const rows = document.querySelectorAll('#hrjob-list .hrjob-row');
            const start = (page - 1) * PAGE_SIZE;
            const end = start + PAGE_SIZE;
            rows.forEach((row, idx) => {
                row.style.display = (idx >= start && idx < end) ? '' : 'none';
            });
        }

        function renderPagination() {
            const total = getTotalRows();
            const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));

            if (currentPage > totalPages) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;

            const pg = document.getElementById('pagination');
            if (!pg) return;
            pg.innerHTML = '';

            const prev = document.createElement('button');
            prev.type = 'button';
            prev.className = 'page-arrow';
            prev.innerHTML = '&#8249;';
            prev.onclick = () => { if (currentPage > 1) goPage(currentPage - 1); };
            pg.appendChild(prev);

            for (let i = 1; i <= totalPages; i++) {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'page-num' + (i === currentPage ? ' active' : '');
                btn.textContent = i;
                btn.onclick = () => goPage(i);
                pg.appendChild(btn);
            }

            const next = document.createElement('button');
            next.type = 'button';
            next.className = 'page-arrow';
            next.innerHTML = '&#8250;';
            next.onclick = () => { if (currentPage < totalPages) goPage(currentPage + 1); };
            pg.appendChild(next);

            const countText = document.createElement('span');
            countText.className = 'page-total-count';
            countText.style.marginLeft = '12px';
            countText.style.color = '#666';
            countText.style.fontSize = '14px';
            countText.textContent = `共 ${total} 筆職缺`;
            pg.appendChild(countText);

            showPage(currentPage);
        }

        function goPage(page) {
            currentPage = page;
            renderPagination();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // ============================
        // 表頭排序
        // 每次只套用一種排序；點同一個按鈕依序切換：預設方向 → 相反方向 → 恢復原始順序
        // ============================
        function initSorting() {
            const list = document.getElementById('hrjob-list');
            const sortButtons = Array.from(document.querySelectorAll('.hrjob-sort-btn[data-sort-key]'));
            const rows = Array.from(document.querySelectorAll('#hrjob-list .hrjob-row'));

            if (!list || sortButtons.length === 0 || rows.length === 0) return;

            // 記住原本順序（後端依截止日期由近到遠排序）
            rows.forEach((row, i) => row.dataset.originalIndex = i);

            const textValue = attr => row => {
                const v = (row.dataset[attr] || '').trim();
                return v === '' ? null : v;
            };

            const numberValue = attr => row => {
                const v = row.dataset[attr];
                return v === undefined || v === '' ? null : Number(v);
            };

            // 各欄位的取值方式、資料型態、預設排序方向與提示文字
            const sortConfigs = {
                dept:      { getValue: textValue('dept'),        type: 'text',   first: 'asc',  label: '部門' },
                title:     { getValue: textValue('title'),       type: 'text',   first: 'asc',  label: '職缺名稱' },
                unhandled: { getValue: numberValue('unhandled'), type: 'number', first: 'desc', label: '未處理數量' },
                hired:     { getValue: numberValue('hired'),     type: 'number', first: 'desc', label: '錄取數量' },
                needed:    { getValue: numberValue('needed'),    type: 'number', first: 'desc', label: '需求人數' },
                total:     { getValue: numberValue('total'),     type: 'number', first: 'desc', label: '總履歷數' },
                status:    { getValue: numberValue('active'),    type: 'number', first: 'desc', label: '上架狀態',
                             titles: { desc: '目前：上架中在前', asc: '目前：已下架在前' } },
                created:   { getValue: numberValue('created'),   type: 'number', first: 'desc', label: '上架日期',
                             titles: { desc: '目前：上架日期由新到舊', asc: '目前：上架日期由舊到新' } },
                deadline:  { getValue: numberValue('deadline'),  type: 'number', first: 'asc',  label: '下架日期',
                             titles: { asc: '目前：下架日期由近到遠', desc: '目前：下架日期由遠到近' } }
            };

            const icons = { none: '⇅', desc: '↓', asc: '↑' };

            const byOriginal = (a, b) => a.dataset.originalIndex - b.dataset.originalIndex;

            function titleFor(config, state) {
                if (state === 'none') return `依${config.label}排序`;
                if (config.titles && config.titles[state]) return config.titles[state];
                if (config.type === 'text') return `目前：${config.label}${state === 'asc' ? '遞增' : '遞減'}`;
                return `目前：${config.label}${state === 'desc' ? '由多到少' : '由少到多'}`;
            }

            function setButtonState(btn, state) {
                const config = sortConfigs[btn.dataset.sortKey];
                if (!config) return;

                btn.dataset.sort = state;

                const icon = btn.querySelector('.sort-icon');
                if (icon) icon.textContent = icons[state];

                btn.title = titleFor(config, state);
                btn.classList.toggle('active', state !== 'none');
            }

            sortButtons.forEach(btn => {
                const config = sortConfigs[btn.dataset.sortKey];
                if (!config) return;

                setButtonState(btn, 'none');

                btn.addEventListener('click', function () {
                    const current = this.dataset.sort || 'none';
                    const opposite = config.first === 'desc' ? 'asc' : 'desc';

                    const next = current === 'none'
                        ? config.first
                        : current === config.first ? opposite : 'none';

                    // 其他欄位的排序按鈕恢復成未排序狀態
                    sortButtons.forEach(other => {
                        if (other !== this) setButtonState(other, 'none');
                    });

                    setButtonState(this, next);

                    const sorted = rows.slice().sort((a, b) => {
                        if (next === 'none') return byOriginal(a, b);

                        const va = config.getValue(a);
                        const vb = config.getValue(b);

                        // 沒有值的資料（例如需求人數「不限」）永遠排最後
                        if (va === null && vb === null) return byOriginal(a, b);
                        if (va === null) return 1;
                        if (vb === null) return -1;

                        const diff = config.type === 'text'
                            ? va.localeCompare(vb, 'zh-Hant-TW')
                            : va - vb;

                        const result = next === 'desc' ? -diff : diff;
                        return result !== 0 ? result : byOriginal(a, b); // 相同時維持原順序
                    });

                    // 依新順序重新排列，並回到第一頁重新分頁
                    list.append(...sorted);
                    currentPage = 1;
                    renderPagination();
                });
            });
        }

        document.addEventListener('click', function (e) {
            const row = e.target.closest('.hrjob-row[data-href]');
            if (row && !e.target.closest('a')) window.location.href = row.dataset.href;
        });

        window.addEventListener('load', function () {
            initSorting();
            renderPagination();
        });
    </script>
}