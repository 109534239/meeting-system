@{
    ViewData["Title"] = "招募數據";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Job_search.css" asp-append-version="true" />

    <style>
        /* 擴充進度條顏色支援 */
        .bar i.bar-warning {
            background: #f39c12; /* 待審核 / 等待安排面試 */
        }

        .bar i.bar-blue {
            background: #15803d; /* 已通過 / 已安排面試 (若已通過要改綠色) */
        }

        .bar i.bar-success {
            background: #15803d; /* 已通過 / 已錄取 */
        }

        .bar i.bar-danger {
            background: #b91c1c; /* 未錄取 */
        }

        .bar i.bar-muted {
            background: #b91c1c; /* 未通過 */
        }
    </style>
}

<div class="page-header">
    <div class="page-header-inner">
        <h1>招募數據</h1>
        <p>Recruitment Dashboard</p>
        <small class="text-muted" style="font-size: 12px; font-weight: normal;">
            @ViewData["ViewScope"]
        </small>
    </div>
</div>

<div class="dashboard-wrap">

    <div class="dashboard-summary">
        <div class="summary-card">
            <span class="summary-label">總履歷數</span>
            <strong>@ViewData["TotalResumes"]</strong>
            <p>目前累積應徵履歷</p>
        </div>

        <div class="summary-card warning">
            <span class="summary-label">待審核</span>
            <strong>@ViewData["PendingResumes"]</strong>
            <p>尚未處理的履歷</p>
        </div>

        <div class="summary-card blue">
            <span class="summary-label">面試流程中</span>
            <strong>@ViewData["InterviewCount"]</strong>
            <p>已進入面試流程</p>
        </div>

        <div class="summary-card success">
            <span class="summary-label">錄取率</span>
            <strong>@ViewData["HireRate"]%</strong>
            <p>錄取 / 總履歷</p>
        </div>
    </div>

    <div class="dashboard-grid">
        <!-- 1. 履歷狀態分布 (抓取 Resume.Status) -->
        <div class="dashboard-card">
            <div class="card-title">履歷狀態分布</div>

            <div class="status-list">
                <div class="status-item">
                    <span>待審核</span>
                    <div class="bar"><i class="bar-warning" style="width:@(ViewData["PendingPercent"] ?? "0")%"></i></div>
                    <strong>@(ViewData["PendingResumes"] ?? "0")</strong>
                </div>

                <div class="status-item">
                    <span>已通過</span>
                    <div class="bar"><i class="bar-success" style="width:@(ViewData["InterviewPercent"] ?? "0")%"></i></div>
                    <strong>@(ViewData["PassedResumes"] ?? "0")</strong>
                </div>

                <div class="status-item">
                    <span>未通過</span>
                    <div class="bar"><i class="bar-danger" style="width:@(ViewData["RejectedPercent"] ?? "0")%"></i></div>
                    <strong>@(ViewData["RejectedCount"] ?? "0")</strong>
                </div>
            </div>
        </div>

        <!-- 2. 面試狀態分布 (抓取 Resume.InterviewStatus 與 Resume.AdmissionResult) -->
        <div class="dashboard-card">
            <div class="card-title d-flex justify-content-between align-items-center">
                <span>面試狀態分布</span>
               
            </div>

            <div class="status-list">
                <div class="status-item">
                    <span>已安排面試</span>
                    <div class="bar"><i class="bar-blue" style="width:@(ViewData["InterviewScheduledPercent"] ?? "0")%"></i></div>
                    <strong>@(ViewData["InterviewScheduledCount"] ?? "0")</strong>
                </div>

                <div class="status-item">
                    <span>等待安排面試</span>
                    <div class="bar"><i class="bar-warning" style="width:@(ViewData["WaitingSchedulePercent"] ?? "0")%"></i></div>
                    <strong>@(ViewData["WaitingScheduleCount"] ?? "0")</strong>
                </div>

                <div class="status-item">
                    <span>等待結果中</span>
                    <div class="bar"><i class="bar-warning" style="width:@(ViewData["WaitingResultPercent"] ?? "0")%"></i></div>
                    <strong>@(ViewData["WaitingResultCount"] ?? "0")</strong>
                </div>

                <div class="status-item">
                    <span>已錄取</span>
                    <div class="bar"><i class="bar-success" style="width:@(ViewData["HiredPercent"] ?? "0")%"></i></div>
                    <strong>@(ViewData["HiredCount"] ?? "0")</strong>
                </div>

                <div class="status-item">
                    <span>未錄取</span>
                    <div class="bar"><i class="bar-danger" style="width:@(ViewData["NotHiredPercent"] ?? "0")%"></i></div>
                    <strong>@(ViewData["NotHiredCount"] ?? "0")</strong>
                </div>
            </div>
        </div>
    </div>

    <div class="dashboard-card">
        <div class="card-title">待處理提醒</div>

        <div class="todo-list">
            <div class="todo-item">
                <span class="dot warning"></span>
                <div>
                    <strong>@ViewData["PendingResumes"] 份履歷待審核</strong>
                    <p>請至應徵管理查看候選人資料。</p>
                </div>
            </div>

            <div class="todo-item">
                <span class="dot blue"></span>
                <div>
                    <strong>@ViewData["InterviewCount"] 場面試流程中</strong>
                    <p>請確認面試排程與面試結果。</p>
                </div>
            </div>
        </div>
    </div>

</div>