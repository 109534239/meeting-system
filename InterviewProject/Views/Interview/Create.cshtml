@{
    ViewData["Title"] = "新增面試排程";
    var pendingResumes = ViewBag.PendingResumes as List<InterviewProject.Models.Resume> ?? new List<InterviewProject.Models.Resume>();
    var memberNames = ViewBag.MemberNames as Dictionary<int, string> ?? new Dictionary<int, string>();
    var rooms = ViewBag.Rooms as List<InterviewProject.Models.Room> ?? new List<InterviewProject.Models.Room>();
}

<div class="container mt-4" style="max-width: 700px;">
    <h2>新增面試排程</h2>
    <hr />

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="Create" method="post">

        <div class="mb-4">
            <label class="form-label d-block fw-bold">選擇要求職/面試的求職者 (可複選)</label>
            <div class="border rounded p-3" style="max-height: 250px; overflow-y: auto;">
                @if (ViewBag.PrefilledResumeId != null)
                {
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="resumeIds" value="@ViewBag.PrefilledResumeId" id="prefilled" checked>
                        <label class="form-check-label" for="prefilled">
                            <strong>@(((InterviewProject.Models.Member)ViewBag.PrefilledMember)?.Name)</strong>
                            - 應徵職缺: @ViewBag.PrefilledJob (直接指派)
                        </label>
                    </div>
                }

                @foreach (var r in pendingResumes.Where(x => x.Id != ViewBag.PrefilledResumeId))
                {
                    string name = memberNames.ContainsKey(r.MembersId) ? memberNames[r.MembersId] : "未知";
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="resumeIds" value="@r.Id" id="resume-@r.Id">
                        <label class="form-check-label" for="resume-@r.Id">
                            <strong>@name</strong> - 職缺: @(r.Job?.Title ?? "未知") [狀態: @r.Status]
                        </label>
                    </div>
                }
                @if (!pendingResumes.Any() && ViewBag.PrefilledResumeId == null)
                {
                    <span class="text-muted">目前沒有待審核或通過的履歷可安排面試。</span>
                }
            </div>
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold">選擇面試會議室</label>
            <select name="roomId" class="form-select">
                <option value="">-- 自動隨機建立新會議室 --</option>
                @foreach (var room in rooms)
                {
                    string timeStr = room.StartAt.HasValue ? $" ({room.StartAt.Value:yyyy-MM-dd HH:mm})" : "";
                    <option value="@room.Id">@room.RoomName @timeStr</option>
                }
            </select>
            <small class="text-muted">注意：若選擇自動建立新房間，面試時間將自動同步為該房間的排定起訖時間。</small>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary px-4">確認送出排程</button>
            <a asp-action="Index" class="btn btn-secondary px-4 ms-2">返回列表</a>
        </div>
    </form>
</div>