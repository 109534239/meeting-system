@{
    ViewData["Title"] = "新增面試排程";
    var pendingResumes = ViewBag.PendingResumes as List<InterviewProject.Models.Resume> ?? new List<InterviewProject.Models.Resume>();
    var memberNames = ViewBag.MemberNames as Dictionary<int, string> ?? new Dictionary<int, string>();
    var rooms = ViewBag.Rooms as List<InterviewProject.Models.Room> ?? new List<InterviewProject.Models.Room>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Job_search.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Interview.css" asp-append-version="true" />
}

<div class="page-header">
    <div class="page-header-inner">
        <h1>新增面試排程</h1>
        <p>Create Interview Schedule</p>
    </div>
</div>

<div class="interview-form-wrap">

    @* 錯誤訊息 *@
    @if (TempData["Error"] != null)
    {
        <div class="alert-error">@TempData["Error"]</div>
    }

    <form asp-action="Create" method="post">

        <div class="form-card-grid">

            @* 選擇求職者卡片 *@
            <div class="form-card">
                <div class="section-title">選擇求職者</div>

                <div class="field-item field-item--full">
                    <label class="field-label">選擇要求職 / 面試的求職者（可複選）</label>

                    <div class="resume-check-list">
                        @if (ViewBag.PrefilledResumeId != null)
                        {
                            <label class="resume-check-item selected" for="prefilled">
                                <input class="resume-check-input"
                                       type="checkbox"
                                       name="resumeIds"
                                       value="@ViewBag.PrefilledResumeId"
                                       id="prefilled"
                                       checked />

                                <span class="resume-check-content">
                                    <strong>@(((InterviewProject.Models.Member)ViewBag.PrefilledMember)?.Name)</strong>
                                    <span>應徵職缺：@ViewBag.PrefilledJob</span>
                                    <em>直接指派</em>
                                </span>
                            </label>
                        }

                        @foreach (var r in pendingResumes.Where(x => x.Id != ViewBag.PrefilledResumeId))
                        {
                            string name = memberNames.ContainsKey(r.MembersId) ? memberNames[r.MembersId] : "未知";

                            <label class="resume-check-item" for="resume-@r.Id">
                                <input class="resume-check-input"
                                       type="checkbox"
                                       name="resumeIds"
                                       value="@r.Id"
                                       id="resume-@r.Id" />

                                <span class="resume-check-content">
                                    <strong>@name</strong>
                                    <span>職缺：@(r.Job?.Title ?? "未知")</span>
                                    <em>狀態：@r.Status</em>
                                </span>
                            </label>
                        }

                        @if (!pendingResumes.Any() && ViewBag.PrefilledResumeId == null)
                        {
                            <div class="interview-empty compact">
                                目前沒有待審核或通過的履歷可安排面試。
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* 選擇面試會議室卡片 *@
            <div class="form-card">
                <div class="section-title">選擇面試會議室</div>

                <div class="field-item field-item--full">
                    <label class="field-label">面試會議室</label>

                    <select name="roomId" class="field-input">
                        <option value="">-- 自動隨機建立新會議室 --</option>
                        @foreach (var room in rooms)
                        {
                            string timeStr = room.StartAt.HasValue ? $" ({room.StartAt.Value:yyyy-MM-dd HH:mm})" : "";
                            <option value="@room.Id">@room.RoomName @timeStr</option>
                        }
                    </select>

                    <div class="info-hint">
                        注意：若選擇自動建立新房間，面試時間將自動同步為該房間的排定起訖時間。
                    </div>
                </div>
            </div>

        </div>

        @* 表單操作按鈕列 *@
        <div class="form-actions">
            <a asp-action="Index" class="btn-cancel">
                返回列表
            </a>

            <button type="submit" class="btn-save">
                確認送出排程
            </button>
        </div>
    </form>
</div>