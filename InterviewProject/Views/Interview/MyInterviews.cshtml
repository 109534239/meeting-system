@model List<InterviewProject.Models.InterviewSchedule>
@{
    ViewData["Title"] = "我的面試通知";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Interview.css" asp-append-version="true" />
}

<div class="page-header">
    <div class="page-header-inner">
        <h1>我的面試通知</h1>
        <p>My Interview Schedules</p>
    </div>
</div>

<div class="interview-container">

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">📭</div>
            <p>目前尚無面試安排，請持續關注！</p>
        </div>
    }
    else
    {
        <div class="my-interviews-list">
            @foreach (var s in Model)
            {
                // 🎯 狀態與時間改為從關聯物件讀取
                var currentStatus = s.Resume?.Status ?? "無狀態";
                var startTime = s.Room?.StartAt ?? DateTime.MinValue;

                <div class="interview-card">
                    <div class="card-left">
                        <div class="card-job-title">
                            📋 @(s.Resume?.Job?.Title ?? "未知職缺")
                        </div>

                        <div class="card-meta">
                            <span>📅 @(startTime != DateTime.MinValue ? startTime.ToString("yyyy年MM月dd日 HH:mm") : "時間未定")</span>
                            <span>👤 排程人：@(s.ScheduledByEmployee?.Name ?? "—")</span>
                            <span>
                                <span class="status-badge">@currentStatus</span>
                            </span>
                        </div>

                        @if (!string.IsNullOrEmpty(s.ResultNote))
                        {
                            <div class="card-notes" style="border-left-color: #818cf8;">
                                🏆 <strong>面試評語：</strong>@s.ResultNote
                            </div>
                        }
                    </div>

                    <div style="display:flex; flex-direction:column; align-items:center; gap:6px;">
                        @if (s.Room != null && currentStatus != "已取消" && currentStatus != "面試結束")
                        {
                            <a asp-controller="Room" asp-action="Join"
                               asp-route-code="@s.Room.JitsiRoomName"
                               class="card-room-link" target="_blank">
                                🎥 進入面試
                            </a>
                            <div class="card-room-code">代碼：@s.Room.JitsiRoomName</div>
                        }
                        else
                        {
                            <span style="font-size:12px; color:#6b7280;">@(currentStatus)</span>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
