@model IEnumerable<InterviewProject.Models.InterviewSchedule>

@{
    ViewData["Title"] = "面試排程管理";
}

<div class="container mt-4">
    <h2>面試排程管理</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-primary">新增面試排程</a>
    </div>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>應徵者姓名</th>
                <th>應徵職缺</th>
                <th>面試房間</th>
                <th>面試時間</th>
                <th>目前狀態</th>
                <th>面試分數</th>
                <th>評語備註</th>
                <th>操作動作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@(item.Resume?.Member?.Name ?? "未知")</td>
                    <td>@(item.Resume?.Job?.Title ?? "未知")</td>
                    <td>@(item.Room?.RoomName ?? "未指派房間")</td>
                    <td>
                        @if (item.Room?.StartAt != null && item.Room?.EndAt != null)
                        {
                            <span>@item.Room.StartAt.Value.ToString("yyyy-MM-dd HH:mm") ~ @item.Room.EndAt.Value.ToString("HH:mm")</span>
                        }
                        else
                        {
                            <span class="text-muted">未設定時間</span>
                        }
                    </td>
                    <td>
                        <span class="badge bg-info text-dark">@(item.Resume?.Status ?? "無狀態")</span>
                    </td>
                    <td>
                        @(item.ResultScore.HasValue? item.ResultScore.Value + " 分" : "尚未評分")
                    </td>
                    <td>@(string.IsNullOrEmpty(item.ResultNote) ? "無" : item.ResultNote)</td>
                    <td>
                        <div class="btn-group btn-group-sm">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">編輯</a>

                            @if (item.Resume?.Status == "已安排面試" || item.Resume?.Status == "面試中")
                            {
                                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#completeModal-@item.Id">
                                    面試完成
                                </button>

                                <form asp-action="Cancel" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('確定要取消此面試嗎？求職者狀態將改為不通過');">
                                    <button type="submit" class="btn btn-danger">取消</button>
                                </form>
                            }
                        </div>

                        <div class="modal fade" id="completeModal-@item.Id" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <form asp-action="Complete" method="post">

                                        <input type="hidden" name="id" value="@item.Id" />

                                        <div class="modal-header">
                                            <h5 class="modal-title">填寫面試結果 - @(item.Resume?.Member?.Name ?? "未知")</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>

                                        <div class="modal-body">
                                            <div class="mb-3">
                                                <label class="form-label">面試分數 (0-100) <span class="text-danger">*</span></label>
                                                <input type="number" name="resultScore" class="form-control" min="0" max="100" required placeholder="請打分數" />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">面試評語</label>
                                                <textarea name="resultNote" class="form-control" rows="3" placeholder="請輸入面試評語..."></textarea>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">變更履歷狀態至</label>
                                                <select name="nextStatus" class="form-select">
                                                    <option value="面試結束">面試結束</option>
                                                    <option value="等待結果中">等待結果中</option>
                                                    <option value="錄取">錄取</option>
                                                    <option value="不錄取">不錄取</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
                                            <button type="submit" class="btn btn-success">提交結果</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>