<div class="page-header">
    <div class="page-header-inner">
        <h1>面試管理</h1>
        <p>Interview Management</p>
    </div>
</div>

<div class="interview-manage-wrap">

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-error">@TempData["Error"]</div>
    }

    <div class="tab-bar">
        <button type="button" class="tab-btn active" data-tab="schedule" onclick="switchTab('schedule')">面試排程</button>
        <button type="button" class="tab-btn" data-tab="evaluate" onclick="switchTab('evaluate')">面試評分</button>
    </div>

    @* ══════════════════ 分頁一：面試排程 ══════════════════ *@
    <div class="tab-pane active" id="pane-schedule">
        <div class="interview-table">
            <div class="interview-table-head">
                <div>應徵職缺</div>
                <div>面試時間</div>
                <div>房間代碼</div>
                <div>應徵者</div>
                <div>會議狀態</div>
                <div>操作</div>
            </div>

            @if (Model != null && Model.Any())
            {
                foreach (var room in Model)
                {
                    var candidates = room.Participants?
                    .Where(p => p.Role == InterviewProject.Models.ParticipantRole.Jobseeker)
                    .ToList() ?? new List<InterviewProject.Models.RoomParticipant>();

                    string meetingStatusText = room.MeetingStatus switch
                    {
                        "InProgress" => "進行中",
                        "Ended" => "已結束",
                        _ => "尚未開始"
                    };

                    string meetingStatusClass = room.MeetingStatus switch
                    {
                        "InProgress" => "status-confirmed",
                        "Ended" => "status-done",
                        _ => "status-pending"
                    };

                    <div class="interview-row">
                        <div class="interview-title">
                            @(room.Job?.Title ?? "未指定職缺")
                            @if (hostRoomIds.Contains(room.Id))
                            {
                                <span class="host-badge">主持人</span>
                            }
                        </div>

                        <div class="interview-time" id="time-@room.Id">
                            @if (room.ScheduledAt != null)
                            {
                                <span class="date">@room.ScheduledAt.Value.ToString("yyyy-MM-dd")</span>
                                <span class="time">@room.ScheduledAt.Value.ToString("HH:mm:ss")</span>
                            }
                            else
                            {
                                <span class="text-muted">未設定時間</span>
                            }
                            @if (hostRoomIds.Contains(room.Id) && room.MeetingStatus == "NotStarted")
                            {
                                <button type="button" class="btn-reschedule" onclick="openReschedule(@room.Id)">修改時間</button>
                                <div class="reschedule-box" id="reschedule-@room.Id" style="display:none">
                                    <input type="datetime-local" id="reschedule-input-@room.Id" step="1"
                                           min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ss")" />
                                    <button type="button" class="btn-reschedule-save" onclick="saveReschedule(@room.Id)">更新</button>
                                    <span class="reschedule-msg" id="reschedule-msg-@room.Id"></span>
                                </div>
                            }
                        </div>

                        <div>@room.JitsiRoomName</div>

                        <div class="candidate-list">
                            @if (candidates.Any())
                            {
                                foreach (var c in candidates)
                                {
                                    <span>@(c.Resume?.Member?.Name ?? "未知")</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">尚無應徵者</span>
                            }
                        </div>

                        <div><span class="status-badge @meetingStatusClass">@meetingStatusText</span></div>

                        <div class="interview-actions">
                            @if (canJoin)
                            {
                                @if (room.CanEnter())
                                {
                                    <a class="btn-complete" href="@Url.Action("Join", "Room", new { code = room.JitsiRoomName })">進入面試</a>
                                }
                                else
                                {
                                    <span class="btn-join-disabled" title="@room.StatusText()">@room.StatusText()</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">僅供檢視</span>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="interview-empty">目前沒有任何面試房間</div>
            }
        </div>
    </div>

    @* ══════════════════ 分頁二：面試評分 ══════════════════ *@
    <div class="tab-pane" id="pane-evaluate">
        @if (endedRooms.Any())
        {
            foreach (var room in endedRooms)
            {
                var candidates = room.Participants?
                .Where(p => p.Role == InterviewProject.Models.ParticipantRole.Jobseeker)
                .ToList() ?? new List<InterviewProject.Models.RoomParticipant>();

                <div class="eval-room-card">
                    <div class="eval-room-title">
                        @(room.Job?.Title ?? "未指定職缺")
                        @if (hostRoomIds.Contains(room.Id))
                        {
                            <span class="host-badge">你是這場的主持人</span>
                        }
                    </div>
                    <div class="eval-room-sub">
                        @(room.StartAt?.ToString("yyyy-MM-dd HH:mm") ?? "") ｜ 房間代碼：@room.JitsiRoomName
                    </div>

                    <div class="eval-files">
                        @if (!string.IsNullOrEmpty(room.TranscriptFileName))
                        {
                            <div class="file-item">
                                <span class="file-label">📝 逐字稿</span>
                                <button type="button" class="btn-file-view" onclick="toggleTextPanel('transcript-@room.Id', '@Url.Action("ViewFile", "Room", new { folder = "逐字稿", fileName = room.TranscriptFileName })')">查看</button>
                                <a class="btn-file-download" href="@Url.Action("DownloadFile", "Room", new { folder = "逐字稿", fileName = room.TranscriptFileName })">下載</a>
                            </div>
                        }
                        @{
                            var roomAiFiles = aiAnalysisByRoom.TryGetValue(room.Id, out var aif) ? aif : new List<string>();
                        }
                        @foreach (var aiFileName in roomAiFiles)
                        {
                            // 檔名格式：面試會議_日期_職缺_求職者姓名.txt，取最後一段當標籤
                            var labelName = aiFileName.Replace(".txt", "");
                            var parts = labelName.Split('_');
                            var candidateLabel = parts.Length > 0 ? parts[^1] : labelName;
                            var panelId = "aianalysis-" + room.Id + "-" + aiFileName.GetHashCode().ToString().Replace("-", "n");
                            <div class="file-item">
                                <span class="file-label">🤖 AI分析（@candidateLabel）</span>
                                <button type="button" class="btn-file-view" onclick="toggleTextPanel('@panelId', '@Url.Action("ViewFile", "Room", new { folder = "AI分析", fileName = aiFileName })')">查看</button>
                                <a class="btn-file-download" href="@Url.Action("DownloadFile", "Room", new { folder = "AI分析", fileName = aiFileName })">下載</a>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(room.RecordingFileName))
                        {
                            <div class="file-item">
                                <span class="file-label">🎬 錄影錄音（下方可直接播放）</span>
                                <a class="btn-file-download" href="@Url.Action("DownloadFile", "Room", new { folder = "錄影錄音", fileName = room.RecordingFileName })">下載</a>
                            </div>
                        }
                        @if (string.IsNullOrEmpty(room.TranscriptFileName) && string.IsNullOrEmpty(room.RecordingFileName) && !roomAiFiles.Any())
                        {
                            <span class="text-muted" style="font-size:13px;">尚無檔案</span>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(room.TranscriptFileName))
                    {
                        <pre class="text-panel" id="panel-transcript-@room.Id" style="display:none;"></pre>
                    }
                    @foreach (var aiFileName in roomAiFiles)
                    {
                        var panelId = "aianalysis-" + room.Id + "-" + aiFileName.GetHashCode().ToString().Replace("-", "n");
                        <pre class="text-panel" id="panel-@panelId" style="display:none;"></pre>
                    }

                    @if (!string.IsNullOrEmpty(room.RecordingFileName))
                    {
                        <div class="video-wrap">
                            <video id="video-@room.Id" controls preload="metadata"
                                   src="@Url.Action("ViewFile", "Room", new { folder = "錄影錄音", fileName = room.RecordingFileName })">
                                @if (!string.IsNullOrEmpty(room.TranscriptFileName))
                                {
                                    <track kind="captions" srclang="zh-Hant" label="逐字稿字幕（估算時間，僅供參考）"
                                           src="@Url.Action("TranscriptVtt", "Room", new { roomId = room.Id })" default />
                                }
                                您的瀏覽器不支援影片播放，請改用下載連結。
                            </video>
                            <div class="video-controls-extra">
                                <label>
                                    播放速度：
                                    <select onchange="document.getElementById('video-@room.Id').playbackRate = this.value">
                                        <option value="0.5">0.5x</option>
                                        <option value="0.75">0.75x</option>
                                        <option value="1" selected>1x（正常）</option>
                                        <option value="1.25">1.25x</option>
                                        <option value="1.5">1.5x</option>
                                        <option value="2">2x</option>
                                    </select>
                                </label>
                                <button type="button" onclick="document.getElementById('video-@room.Id').requestFullscreen()">⛶ 全螢幕</button>
                                <span class="video-hint">內建可拖拉進度條／音量／字幕（CC）按鈕；字幕時間為估算值，僅供對照參考</span>
                            </div>
                        </div>
                    }

                    @if (candidates.Any())
                    {
                        foreach (var c in candidates)
                        {
                            var resume = c.Resume;
                            var name = resume?.Member?.Name ?? "未知";
                            var hasMyEval = resume != null && myEvaluations.TryGetValue(resume.Id, out var myEval);
                            var managerEvalsForThisResume = (resume != null && managerEvaluationsByResume.TryGetValue(resume.Id, out var mevals))
                            ? mevals : new List<InterviewProject.Models.InterviewEvaluation>();
                            var roomManagerIds = room.Participants?
                            .Where(p => p.Role == InterviewProject.Models.ParticipantRole.Manager && p.EmployeeId.HasValue)
                            .Select(p => p.EmployeeId!.Value).Distinct().ToList() ?? new List<int>();
                            var evaluatedManagerIdsForResume = managerEvalsForThisResume.Select(e => e.EvaluatorEmployeeId).Distinct().ToList();
                            var allManagersEvaluated = !roomManagerIds.Any() || roomManagerIds.All(id => evaluatedManagerIdsForResume.Contains(id));
                            var managerProgressText = $"{evaluatedManagerIdsForResume.Count(id => roomManagerIds.Contains(id))}/{roomManagerIds.Count}";

                            <div class="eval-candidate">
                                <div class="eval-candidate-name">@name</div>

                                @* 🎯 適性測驗結果：跟逐字稿／影片／AI分析一樣當評分參考 *@
                                @{
                                    var aptitude = resume != null && aptitudeResultsByResume.TryGetValue(resume.Id, out var apt) ? apt : null;
                                }
                                <div class="aptitude-box">
                                    <div class="manager-eval-ref-title">適性測驗結果（參考，1~5分）</div>
                                    @if (aptitude != null)
                                    {
                                        @Html.Raw(BuildRadarSvg(aptitude))
                                    }
                                    else
                                    {
                                        <div class="text-muted" style="font-size:13px;">這位求職者沒有適性測驗結果</div>
                                    }
                                </div>

                                @* 🎯 主持人：無論自己是否已評分，都能看到其他職員的評分紀錄作為參考 *@
                                @if (hostRoomIds.Contains(room.Id))
                                {
                                    <div class="manager-eval-ref">
                                        <div class="manager-eval-ref-title">其他職員評分紀錄（參考）</div>
                                        @if (managerEvalsForThisResume.Any())
                                        {
                                            foreach (var me in managerEvalsForThisResume)
                                            {
                                                <div class="manager-eval-item">
                                                    <span class="manager-eval-name">@(me.EvaluatorEmployee?.Name ?? "未知職員")</span>
                                                    <span class="manager-eval-score">@me.Score 分</span>
                                                    <span class="manager-eval-comment">@(string.IsNullOrWhiteSpace(me.Comment) ? "（無評語）" : me.Comment)</span>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="manager-eval-item" style="border-top:none;">尚無其他職員評分</div>
                                        }
                                    </div>
                                }

                                @if (hasMyEval)
                                {
                                    <div class="eval-done">✅ 你已評分：@myEvaluations[resume!.Id].Score 分 － @(myEvaluations[resume.Id].Comment ?? "（無評語）")</div>
                                }
                                else if (resume != null)
                                {
                                    <div class="eval-form">
                                        <select id="score-@resume.Id">
                                            <option value="" selected disabled>請選擇</option>
                                            <option value="5">5 分（優秀）</option>
                                            <option value="4">4 分（良好）</option>
                                            <option value="3">3 分（普通）</option>
                                            <option value="2">2 分（待加強）</option>
                                            <option value="1">1 分（不合適）</option>
                                        </select>
                                        <textarea id="comment-@resume.Id" placeholder="評語（必填）" required></textarea>
                                        <button type="button" onclick="submitEvaluation(@room.Id, @resume.Id)">送出評分</button>
                                        <span class="reschedule-msg" id="eval-msg-@resume.Id"></span>
                                    </div>
                                }

                                @* 🎯 改版：主持人不用等所有職員評完分，可以直接決定；職員評分只是參考。
                                   送出後先通知 HR，由 HR 通知求職者。 *@
                                @if (hostRoomIds.Contains(room.Id) && resume != null)
                                {
                                    <div class="admission-actions" style="margin-top:10px;">
                                        @if (room.ResultSubmittedAt != null)
                                        {
                                            var shown = !string.IsNullOrEmpty(resume.PendingAdmissionResult) ? resume.PendingAdmissionResult : resume.AdmissionResult;
                                            <span class="admission-result" style="color:@(shown == "錄取" ? "#2e7d32" : "#c0392b");">
                                                @(shown == "錄取" ? "✅" : "❌") 已送出：@shown
                                                @(resume.AdmissionResult == "錄取" || resume.AdmissionResult == "未錄取" ? "（HR 已通知求職者）" : "（等 HR 通知求職者）")
                                            </span>
                                        }
                                        else
                                        {
                                            if (!string.IsNullOrEmpty(resume.PendingAdmissionResult))
                                            {
                                                <div class="eval-pending-manager">目前決定：<b>@resume.PendingAdmissionResult</b>（全部決定好後，請到本場最下方按「送出並通知 HR」；送出前可改）</div>
                                            }
                                            else if (!allManagersEvaluated)
                                            {
                                                <div class="eval-pending-manager">職員評分進度：@managerProgressText（僅供參考，不影響你直接決定）</div>
                                            }
                                            <button type="button" class="btn-admit" onclick="setAdmission(@room.Id, @resume.Id, '錄取')">錄取</button>
                                            <button type="button" class="btn-reject" onclick="setAdmission(@room.Id, @resume.Id, '未錄取')">未錄取</button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted">這場面試沒有求職者資料</div>
                    }

                    @* 🎯 主持人決定好每位求職者後，送出並寄 email 通知 HR，由 HR 通知求職者 *@
                    @if (hostRoomIds.Contains(room.Id) && candidates.Any())
                    {
                        <div style="margin-top:14px;padding-top:12px;border-top:1px dashed #cfd6df;">
                            @if (room.ResultSubmittedAt != null)
                            {
                                <span class="eval-pending-manager">✅ 已於 @room.ResultSubmittedAt.Value.ToString("yyyy-MM-dd HH:mm") 送出錄取結果並通知 HR</span>
                            }
                            else
                            {
                                <button type="button" class="btn-admit" onclick="submitResults(@room.Id)">送出錄取結果並通知 HR</button>
                                <span class="reschedule-msg" id="submit-msg-@room.Id"></span>
                            }
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div class="interview-empty">目前沒有已結束、待評分的面試</div>
        }
    </div>

</div>

@section Scripts {
    <script>
        function switchTab(tab) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.toggle('active', b.dataset.tab === tab));
            document.getElementById('pane-schedule').classList.toggle('active', tab === 'schedule');
            document.getElementById('pane-evaluate').classList.toggle('active', tab === 'evaluate');
        }

        function openReschedule(roomId) {
            const box = document.getElementById('reschedule-' + roomId);
            box.style.display = box.style.display === 'none' ? 'flex' : 'none';
        }

        async function saveReschedule(roomId) {
            const input = document.getElementById('reschedule-input-' + roomId);
            const msg = document.getElementById('reschedule-msg-' + roomId);
            if (!input.value) { msg.textContent = '請先選擇時間'; return; }
            msg.textContent = '';
            try {
                const res = await fetch('/Interview/UpdateScheduledAt', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'roomId=' + roomId + '&newTime=' + encodeURIComponent(input.value)
                });
                const data = await res.json();
                if (data.success) { location.reload(); }
                else { msg.textContent = data.message || '更新失敗'; }
            } catch (err) {
                msg.textContent = '更新失敗，請稍後再試';
            }
        }

        async function submitEvaluation(roomId, resumeId) {
            const scoreEl = document.getElementById('score-' + resumeId);
            const commentEl = document.getElementById('comment-' + resumeId);
            const msg = document.getElementById('eval-msg-' + resumeId);
            const score = scoreEl.value;
            const comment = commentEl.value.trim();

            msg.textContent = '';
            scoreEl.classList.remove('input-error');
            commentEl.classList.remove('input-error');

            // 🎯 前端驗證：分數必選、評語必填
            if (!score) {
                msg.textContent = '請選擇分數';
                scoreEl.classList.add('input-error');
                scoreEl.focus();
                return;
            }
            if (!comment) {
                msg.textContent = '評語為必填，請輸入評語';
                commentEl.classList.add('input-error');
                commentEl.focus();
                return;
            }

            try {
                const res = await fetch('/Interview/SubmitEvaluation', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'roomId=' + roomId + '&resumeId=' + resumeId + '&score=' + score + '&comment=' + encodeURIComponent(comment)
                });
                const data = await res.json();
                if (data.success) { location.reload(); }
                else {
                    msg.textContent = data.message || '送出失敗';
                    if ((data.message || '').includes('分數')) scoreEl.classList.add('input-error');
                    if ((data.message || '').includes('評語')) commentEl.classList.add('input-error');
                }
            } catch (err) {
                msg.textContent = '送出失敗，請稍後再試';
            }
        }

        // 🎯 逐字稿/AI分析「查看」：抓一次內容後快取起來，切換顯示/隱藏面板，不用每次都重新下載
        const textPanelCache = {};
        async function toggleTextPanel(id, url) {
            const panel = document.getElementById('panel-' + id);
            if (!panel) return;

            if (panel.style.display === 'none') {
                if (!(id in textPanelCache)) {
                    panel.textContent = '讀取中…';
                    panel.style.display = 'block';
                    try {
                        const res = await fetch(url);
                        textPanelCache[id] = await res.text();
                    } catch (err) {
                        textPanelCache[id] = '讀取失敗，請改用「下載」查看';
                    }
                }
                panel.textContent = textPanelCache[id];
                panel.style.display = 'block';
            } else {
                panel.style.display = 'none';
            }
        }

        async function submitResults(roomId) {
            if (!confirm('確定要送出這場面試的錄取結果並通知 HR 嗎？送出後無法再修改。')) return;
            const msg = document.getElementById('submit-msg-' + roomId);
            try {
                const res = await fetch('/Interview/SubmitResults', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'roomId=' + roomId
                });
                const data = await res.json();
                if (data.success) { location.reload(); }
                else if (msg) { msg.textContent = data.message || '送出失敗'; }
            } catch (err) {
                if (msg) msg.textContent = '送出失敗，請稍後再試';
            }
        }

        async function setAdmission(roomId, resumeId, result) {
            if (!confirm('確定要把這位求職者決定為「' + result + '」嗎？')) return;
            try {
                const res = await fetch('/Interview/SetAdmission', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'roomId=' + roomId + '&resumeId=' + resumeId + '&result=' + encodeURIComponent(result)
                });
                const data = await res.json();
                if (data.success) { location.reload(); }
                else { alert(data.message || '操作失敗'); }
            } catch (err) {
                alert('操作失敗，請稍後再試');
            }
        }
    </script>
}
