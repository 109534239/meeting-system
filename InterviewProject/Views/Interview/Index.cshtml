@model IEnumerable<InterviewProject.Models.Room>

@{
    ViewData["Title"] = "面試管理";
    string role = ViewBag.CurrentRole as string ?? "";
    bool canJoin = role == "manager";
    int myEmployeeId = ViewBag.CurrentEmployeeId is int i ? i : 0;
    var myEvaluations = ViewBag.MyEvaluations as Dictionary<int, InterviewProject.Models.InterviewEvaluation>
                         ?? new Dictionary<int, InterviewProject.Models.InterviewEvaluation>();
    var managerEvaluationsByResume = ViewBag.ManagerEvaluationsByResume as Dictionary<int, List<InterviewProject.Models.InterviewEvaluation>>
                         ?? new Dictionary<int, List<InterviewProject.Models.InterviewEvaluation>>();
    var aiAnalysisByRoom = ViewBag.AiAnalysisByRoom as Dictionary<int, List<string>>
                         ?? new Dictionary<int, List<string>>();
    var endedRooms = (Model ?? new List<InterviewProject.Models.Room>()).Where(r => r.MeetingStatus == "Ended").ToList();
    // 🎯 改版：主持人是每場面試各自指定的，所以要一間房一間房判斷「我是不是這場的主持人」
    var hostRoomIds = ViewBag.HostRoomIds as HashSet<int> ?? new HashSet<int>();
    // 🎯 改版：求職者的適性測驗結果（評分時參考）
    var aptitudeResultsByResume = ViewBag.AptitudeResultsByResume as Dictionary<int, InterviewProject.Models.AptitudeTestResult>
                         ?? new Dictionary<int, InterviewProject.Models.AptitudeTestResult>();
}

@functions {
    // 適性測驗五個構面的雷達圖（分數 1~5）
    static string BuildRadarSvg(InterviewProject.Models.AptitudeTestResult t)
    {
        var labels = new[] { "抗壓性", "團隊合作", "積極主動", "可靠負責", "溝通表達" };
        var values = new[] { t.StressToleranceScore, t.TeamworkScore, t.ProactivenessScore, t.ReliabilityScore, t.CommunicationScore };
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        double cx = 130, cy = 115, r = 80;
        var sb = new System.Text.StringBuilder();
        sb.Append("<svg viewBox='0 0 260 230' width='260' height='230' xmlns='http://www.w3.org/2000/svg' role='img' aria-label='適性測驗雷達圖'>");
        for (int level = 1; level <= 5; level++)
        {
            var pts = new List<string>();
            for (int i = 0; i < 5; i++)
            {
                double a = -Math.PI / 2 + i * 2 * Math.PI / 5;
                pts.Add((cx + r * level / 5.0 * Math.Cos(a)).ToString("0.##", ci) + "," + (cy + r * level / 5.0 * Math.Sin(a)).ToString("0.##", ci));
            }
            sb.Append("<polygon points='" + string.Join(" ", pts) + "' fill='none' stroke='#d0d7de' stroke-width='1'/>");
        }
        var dataPts = new List<string>();
        for (int i = 0; i < 5; i++)
        {
            double a = -Math.PI / 2 + i * 2 * Math.PI / 5;
            sb.Append("<line x1='" + cx.ToString(ci) + "' y1='" + cy.ToString(ci) + "' x2='" + (cx + r * Math.Cos(a)).ToString("0.##", ci) + "' y2='" + (cy + r * Math.Sin(a)).ToString("0.##", ci) + "' stroke='#d0d7de'/>");
            var v = Math.Max(0, Math.Min(5, values[i]));
            dataPts.Add((cx + r * v / 5.0 * Math.Cos(a)).ToString("0.##", ci) + "," + (cy + r * v / 5.0 * Math.Sin(a)).ToString("0.##", ci));
            double lx = cx + (r + 18) * Math.Cos(a), ly = cy + (r + 18) * Math.Sin(a) + 4;
            var anchor = Math.Abs(Math.Cos(a)) < 0.3 ? "middle" : (Math.Cos(a) > 0 ? "start" : "end");
            sb.Append("<text x='" + lx.ToString("0.##", ci) + "' y='" + ly.ToString("0.##", ci) + "' font-size='12' text-anchor='" + anchor + "' fill='#444'>" + labels[i] + " " + values[i].ToString("0.0", ci) + "</text>");
        }
        sb.Append("<polygon points='" + string.Join(" ", dataPts) + "' fill='rgba(52,120,246,0.25)' stroke='#3478f6' stroke-width='2'/>");
        sb.Append("</svg>");
        return sb.ToString();
    }
}

