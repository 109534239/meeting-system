@model InterviewProject.Models.InterviewSchedule

@{
    ViewData["Title"] = "編輯面試結果與排程";
    var rooms = ViewBag.Rooms as List<InterviewProject.Models.Room> ?? new List<InterviewProject.Models.Room>();
}

<div class="container mt-4" style="max-width: 600px;">
    <h2>編輯面試結果與排程</h2>
    <hr />

    <form asp-action="Edit" method="post">
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="bg-light p-3 rounded mb-4">
            <h5>基本資料</h5>
            <p class="mb-1"><strong>求職者姓名：</strong> @(Model.Resume?.Member?.Name ?? "未知")</p>
            <p class="mb-0"><strong>應徵職缺：</strong> @(Model.Resume?.Job?.Title ?? "未知")</p>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">指派面試會議室</label>
            <select name="roomId" class="form-select">
                @foreach (var room in rooms)
                {
                    <!option value="@room.Id" @(Model.RoomId == room.Id ? "selected" : "")>
                    @room.RoomName @(room.StartAt.HasValue ? $"({room.StartAt.Value:yyyy-MM-dd HH:mm})" : "")
                    </!option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">求職履歷狀態更新</label>
            <select name="resumeStatus" class="form-select">
                <!option value="已安排面試" @(Model.Resume?.Status == "已安排面試" ? "selected" : "")>已安排面試</!option>
                <!option value="面試中" @(Model.Resume?.Status == "面試中" ? "selected" : "")>面試中</!option>
                <!option value="面試結束" @(Model.Resume?.Status == "面試結束" ? "selected" : "")>面試結束</!option>
                <!option value="等待結果中" @(Model.Resume?.Status == "等待結果中" ? "selected" : "")>等待結果中</!option>
                <!option value="錄取" @(Model.Resume?.Status == "錄取" ? "selected" : "")>錄取</!option>
                <!option value="不錄取" @(Model.Resume?.Status == "不錄取" ? "selected" : "")>不錄取</!option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">面試評分 (0 ~ 100)</label>
            <input type="number" name="resultScore" class="form-control" min="0" max="100" value="@Model.ResultScore" placeholder="請打分數" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">面試評語 / 結論備註</label>
            <textarea name="resultNote" class="form-control" rows="4" placeholder="請輸入面試評語...">@Model.ResultNote</textarea>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-success px-4">儲存更新</button>
            <a asp-action="Index" class="btn btn-secondary px-4 ms-2">取消返回</a>
        </div>
    </form>
</div>