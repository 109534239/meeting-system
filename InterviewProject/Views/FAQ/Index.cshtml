@model IEnumerable<InterviewProject.Models.FAQ>

@{
    ViewData["Title"] = "求職問題";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Faq.css" asp-append-version="true" />
}

<!-- PAGE HEADER -->
<div class="page-header">
    <div class="page-header-label">FAQ</div>
    <h1>求職 Q&amp;A</h1>
    <p>求職過程中有任何疑問，歡迎參考以下常見問題</p>
</div>

<main class="main">

    @if (TempData["Error"] != null)
    {
        <div class="alert-error">
            @TempData["Error"]
        </div>
    }

    <!-- FAQ -->
    <section>
        <div class="section-header">
            <h2>常見問題</h2>
            <p>Frequently Asked Questions</p>
            <div class="section-divider"></div>
        </div>

        <div class="faq-list">
            @if (Model != null && Model.Any())
            {
                int index = 1;

                foreach (var item in Model)
                {
                    <div class="faq-item">
                        <button class="faq-question" type="button" onclick="toggleFaq(this)">
                            <span class="faq-q-text">
                                <span class="faq-q-num">@index</span>
                                @item.Question
                            </span>
                            <span class="faq-arrow">&#8964;</span>
                        </button>

                        <div class="faq-answer">
                            <div class="faq-answer-inner">
                                @Html.Raw(item.Answer.Replace("\n", "<br />"))
                            </div>
                        </div>
                    </div>

                    index++;
                }
            }
            else
            {
                <div class="faq-empty">
                    目前尚未上架常見問題。
                </div>
            }
        </div>
    </section>
</main>

<!-- CONTACT FORM -->
<section class="contact-section">
    <div class="contact-intro">
        <div class="section-header">
            <h2>找不到答案？</h2>
            <p>歡迎填寫以下表單，我們將盡快與您聯繫</p>
            <div class="section-divider"></div>
        </div>
    </div>

    <form asp-controller="FAQ" asp-action="SubmitReport" method="post">
        @Html.AntiForgeryToken()

        <!-- 姓名 -->
        <div class="form-group">
            <label>姓名 <span class="required">*</span></label>
            <input type="text"
                    name="Name"
                    class="form-control"
                    placeholder="請填入您的姓名"
                    required />
        </div>

        <!-- 電子信箱 -->
        <div class="form-group">
            <label>電子信箱 <span class="required">*</span></label>

            <input type="email"
                name="Email"
                class="form-control"
                placeholder="請輸入電子信箱"
                required />
        </div>
        
        <!-- 問題類別 / 信件主旨 -->
        <div class="form-group">
            <div class="form-row">
                <div>
                    <label style="margin-bottom:6px; display:block;">
                        問題類別 <span class="required">*</span>
                    </label>

                    <select name="Category" class="form-control" required>
                        <option value="">請選擇</option>
                        <option value="投遞履歷相關">投遞履歷相關</option>
                        <option value="面試流程相關">面試流程相關</option>
                        <option value="薪資福利相關">薪資福利相關</option>
                        <option value="實習機會相關">實習機會相關</option>
                        <option value="其他問題">其他問題</option>
                    </select>
                </div>

                <div>
                    <label style="margin-bottom:6px; display:block;">
                        信件主旨 <span class="required">*</span>
                    </label>

                    <input type="text"
                            name="Subject"
                            class="form-control"
                            placeholder="請輸入主旨"
                            required />
                </div>
            </div>
        </div>

        <!-- 信件內容 -->
        <div class="form-group">
            <label>信件內容 <span class="required">*</span></label>
            <textarea name="Content"
                        class="form-control"
                        placeholder="請描述您想反應的內容"
                        required></textarea>
        </div>

        <!-- 同意條款 -->
        <div class="checkbox-row">
            <input type="checkbox"
                    id="agree"
                    name="agree"
                    value="true" />

            <label for="agree">
                我同意 <a href="#">個人資料保護法定應告知事項</a>
            </label>
        </div>

        <!-- 送出 -->
        <div class="submit-wrap">
            <button type="submit" class="btn-submit">
                送出
            </button>
        </div>
    </form>
</section>

@if (TempData["Success"] != null)
{
    <div id="toast-success" class="toast-success">
        <div class="toast-icon">
            ✓
        </div>
        <div class="toast-content">
            <div class="toast-title">
                已成功送出
            </div>
            <div class="toast-message">
                我們已收到您的問題，人資將於 1～3 個工作天內與您聯繫。
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function toggleFaq(btn) {
            const item = btn.closest('.faq-item');
            const isOpen = item.classList.contains('open');

            document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));

            if (!isOpen) {
                item.classList.add('open');
            }
        }

        // ==============================
        // 成功送出 Toast：10 秒後自動消失
        // ==============================
        const toast = document.getElementById("toast-success");

        if (toast) {
            setTimeout(() => {
                toast.classList.add("toast-hide");

                setTimeout(() => {
                    toast.remove();
                }, 400);
            }, 10000);
        }
    </script>
}