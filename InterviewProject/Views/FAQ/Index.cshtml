@model IEnumerable<InterviewProject.Models.FAQ>

@{
    ViewData["Title"] = "求職問題";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Faq.css" asp-append-version="true" />

    <style>
        /* 未勾選同意條款的錯誤提示：沿用 Faq.css 的 .toast-success 版型（置中、進出場動畫），
                   這裡只疊加紅色系配色，不重複定義位置/動畫，避免跟 Faq.css 衝突 */
        .toast-error {
            border-left: 4px solid #e53935;
        }

            .toast-error .toast-icon {
                background: #e53935;
            }

        /* 勾選框沒勾時，讓該列輕輕晃動，提醒使用者注意（Faq.css 沒有這個效果，額外補上） */
        .checkbox-row.shake {
            animation: shake 0.3s;
        }

        @@keyframes shake {
            0%, 100% {
                transform: translateX(0);
            }

            25% {
                transform: translateX(-4px);
            }

            75% {
                transform: translateX(4px);
            }
        }
    </style>
}

<!-- PAGE HEADER -->
<div class="page-header">
    <div class="page-header-label">FAQ</div>
    <h1>求職 Q&amp;A</h1>
    <p>求職過程中有任何疑問，歡迎參考以下常見問題</p>
</div>

<main class="main">

    @if (TempData["Error"] != null)
    {
        <div class="alert-error">
            @TempData["Error"]
        </div>
    }

    <!-- FAQ -->
    <section>
        <div class="section-header">
            <h2>常見問題</h2>
            <p>Frequently Asked Questions</p>
            <div class="section-divider"></div>
        </div>

        <div class="faq-list">
            @if (Model != null && Model.Any())
            {
                int index = 1;

                foreach (var item in Model)
                {
                    <div class="faq-item">
                        <button class="faq-question" type="button" onclick="toggleFaq(this)">
                            <span class="faq-q-text">
                                <span class="faq-q-num">@index</span>
                                @item.Question
                            </span>
                            <span class="faq-arrow">&#8964;</span>
                        </button>

                        <div class="faq-answer">
                            <div class="faq-answer-inner">
                                @Html.Raw(item.Answer.Replace("\n", "<br />"))
                            </div>
                        </div>
                    </div>

                    index++;
                }
            }
            else
            {
                <div class="faq-empty">
                    目前尚未上架常見問題。
                </div>
            }
        </div>
    </section>
</main>

<!-- CONTACT FORM -->
<section class="contact-section">
    <div class="contact-intro">
        <div class="section-header">
            <h2>找不到答案？</h2>
            <p>歡迎填寫以下表單，我們將盡快與您聯繫</p>
            <div class="section-divider"></div>
        </div>
    </div>

    <form asp-controller="FAQ" asp-action="SubmitReport" method="post" id="faqContactForm">
        @Html.AntiForgeryToken()

        <!-- 姓名 -->
        <div class="form-group">
            <label>姓名 <span class="required">*</span></label>
            <input type="text"
                    name="Name"
                    class="form-control"
                    placeholder="請填入您的姓名"
                    required />
        </div>

        <!-- 電子信箱 -->
        <div class="form-group">
            <label>電子信箱 <span class="required">*</span></label>

            <input type="email"
                name="Email"
                class="form-control"
                placeholder="請輸入電子信箱"
                required />
        </div>
        
        <!-- 問題類別 / 信件主旨 -->
        <div class="form-group">
            <div class="form-row">
                <div>
                    <label style="margin-bottom:6px; display:block;">
                        問題類別 <span class="required">*</span>
                    </label>

                    <select name="Category" class="form-control" required>
                        <option value="">請選擇</option>
                        <option value="投遞履歷相關">投遞履歷相關</option>
                        <option value="面試流程相關">面試流程相關</option>
                        <option value="薪資福利相關">薪資福利相關</option>
                        <option value="實習機會相關">實習機會相關</option>
                        <option value="其他問題">其他問題</option>
                    </select>
                </div>

                <div>
                    <label style="margin-bottom:6px; display:block;">
                        信件主旨 <span class="required">*</span>
                    </label>

                    <input type="text"
                            name="Subject"
                            class="form-control"
                            placeholder="請輸入主旨"
                            required />
                </div>
            </div>
        </div>

        <!-- 信件內容 -->
        <div class="form-group">
            <label>信件內容 <span class="required">*</span></label>
            <textarea name="Content"
                        class="form-control"
                        placeholder="請描述您想反應的內容"
                        required></textarea>
        </div>

        <!-- 同意條款 -->
        <div class="checkbox-row">
            <input type="checkbox"
                    id="agree"
                    name="agree"
                    value="true" />

            <label for="agree">
                我同意 <a href="#">個人資料保護法定應告知事項</a>
            </label>
        </div>

        <!-- 送出 -->
        <div class="submit-wrap">
            <button type="submit" class="btn-submit">
                送出
            </button>
        </div>
    </form>
</section>

<!-- 未勾選同意條款時的錯誤提示（前端攔截，避免資料遺失） -->
<div id="toast-agree-error" class="toast-success toast-error" style="display:none;">
    <div class="toast-icon">
        !
    </div>
    <div class="toast-content">
        <div class="toast-title">
            尚未勾選同意事項
        </div>
        <div class="toast-message">
            請先勾選「我同意個人資料保護法定應告知事項」後再送出表單。
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div id="toast-success" class="toast-success">
        <div class="toast-icon">
            ✓
        </div>
        <div class="toast-content">
            <div class="toast-title">
                已成功送出
            </div>
            <div class="toast-message">
                我們已收到您的問題，人資將於 1～3 個工作天內與您聯繫。
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function toggleFaq(btn) {
            const item = btn.closest('.faq-item');
            const isOpen = item.classList.contains('open');

            document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));

            if (!isOpen) {
                item.classList.add('open');
            }
        }

        // ==============================
        // 成功送出 Toast：10 秒後自動消失
        // ==============================
        const toast = document.getElementById("toast-success");

        if (toast) {
            setTimeout(() => {
                toast.classList.add("toast-hide");

                setTimeout(() => {
                    toast.remove();
                }, 400);
            }, 10000);
        }

        // ==============================
        // 送出前檢查是否已勾選同意條款
        // 未勾選時：攔截送出、不重新整理頁面（表單資料不會消失），並跳出提示
        // ==============================
        const faqForm = document.getElementById("faqContactForm");
        const agreeCheckbox = document.getElementById("agree");
        const agreeErrorToast = document.getElementById("toast-agree-error");

        function showAgreeError() {
            if (!agreeErrorToast) return;

            agreeErrorToast.style.display = "flex";
            agreeErrorToast.classList.remove("toast-hide");

            // 讓同意勾選列輕輕晃動，提醒使用者注意
            const checkboxRow = agreeCheckbox.closest(".checkbox-row");
            if (checkboxRow) {
                checkboxRow.classList.remove("shake");
                void checkboxRow.offsetWidth; // 觸發 reflow，讓動畫可以重複播放
                checkboxRow.classList.add("shake");
            }

            // 捲動到勾選欄位位置，讓使用者看得到
            agreeCheckbox.scrollIntoView({ behavior: "smooth", block: "center" });

            // 5 秒後自動消失
            clearTimeout(agreeErrorToast._hideTimer);
            agreeErrorToast._hideTimer = setTimeout(() => {
                agreeErrorToast.classList.add("toast-hide");
                setTimeout(() => {
                    agreeErrorToast.style.display = "none";
                }, 400);
            }, 5000);
        }

        if (faqForm && agreeCheckbox) {
            faqForm.addEventListener("submit", function (e) {
                if (!agreeCheckbox.checked) {
                    e.preventDefault();
                    showAgreeError();
                }
            });

            // 使用者勾選後，若提示還顯示中就自動隱藏
            agreeCheckbox.addEventListener("change", function () {
                if (agreeCheckbox.checked && agreeErrorToast) {
                    agreeErrorToast.classList.add("toast-hide");
                    setTimeout(() => {
                        agreeErrorToast.style.display = "none";
                    }, 400);
                }
            });
        }
    </script>
}